<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    
    <!-- Package Metadata (Private) -->
    <Authors>Javad Seyedi</Authors>
    <Company>Private</Company>
    <Copyright>Copyright (c) 2024-present Javad Seyedi. All rights reserved.</Copyright>
    <PackageLicenseExpression></PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryType>git</RepositoryType>
    <PackageTags>bpms;workflow;bpmn;private;neo</PackageTags>
    <Description>Neo BPMS - Business Process Management System (Private)</Description>
    <IsPackable>true</IsPackable>
    
    <!-- SourceLink -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    
    <!-- Versioning -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    
    <!-- Disable NuGet vulnerability audit to prevent build failures when offline -->
    <EnableNuGetAudit>false</EnableNuGetAudit>
    <NuGetAuditMode>none</NuGetAuditMode>
  </PropertyGroup>
</Project>