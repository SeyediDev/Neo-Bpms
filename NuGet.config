<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Local Neo packages for development -->
    <add key="local-neo" value="D:\LocalNuGetPackages" />
    
    <!-- NuGet.org for other packages -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>


