@using Neo.Bpms.UI.Resources.Resources
@using Neo.Bpms.UI.MVC.Helpers
<link href="~/Content/common-assets-includes/features/design/bpmn/css/viewer/app.css" rel="stylesheet">
<div id="bpmnModal" class="modal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-xl" role="document" style="width: 98%; height: 90vh;">
        <div class="modal-content">
            <div class="modal-header">
	           <h5 id="processName" class="modal-title"></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div dir="ltr" class="modal-body" style="height: 80vh;">
                <div class="content" id="js-drop-zone">
                    @*                    <div class="message error">*@
                    @*                        <div class="note">*@
                    @*                            <p>Ooops, we could not display the BPMN 2.0 diagram.</p>*@
                    @*                            <div class="details">*@
                    @*                                <span>cause of the problem</span>*@
                    @*                                <pre></pre>*@
                    @*                            </div>*@
                    @*                        </div>*@
                    @*                    </div>*@
                    <div class="canvas" id="js-canvas"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">
                    @ViewTexts.Close
                </button>
            </div>
        </div>
    </div>
</div>
@*<script src="~/Scripts/common-assets-includes/features/bpmn-viewer/index.min.js"></script>*@
@*<script src="~/Scripts/common-assets-includes/features/bpmn-viewer/bpmn-viewer-use.js"></script>*@
