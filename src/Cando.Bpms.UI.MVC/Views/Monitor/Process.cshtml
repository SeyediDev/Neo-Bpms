@functions
{
	void RenderNameColumn(ResourceViewModel resource)
	{
		var reousrceName = resource.Name;
		if (reousrceName == null)
		{
			<td class="table-danger">تعریف نشده</td>
		}
		else
		{
			<td>
				@(reousrceName)
			</td>
		}
	}

	void ColorIndexClass(ElementViewModel element)
	{
		@:class="id-@element.ColorIndex"
	}

	void RenderFlowElements(List<FlowElementViewModel> flowElements, int max)
	{
		var index = 0;
		foreach (var flowElement in flowElements)
		{
			var colspan = "";
			if (flowElements.Count < max && ((flowElements.Count - 1) == index))
			{
				colspan = "colspan=" + (max - flowElements.Count + 1) + "";
			}
			index++;
			<td @colspan @{ColorIndexClass(flowElement.Element);}>
				@flowElement.Element.Name @(flowElement.StateId > 0 ? ("(" + flowElement.StateId + ")") : "")
				@flowElement.Condition
			</td>
		}
		if (flowElements.Count == 0)
		{
			if (max == 0)
			{
				<td class="table-danger">ایزوله</td>
			}
			else
			{
				var colspan = "";
				if (max > 1)
				{
					colspan = "colspan=" + max + "";
				}
				<td @colspan></td>
			}
		}
	}

	async Task RenderElement(ElementViewModel element, string title)
	{
		var colspan = "";
		if (element.Colspan > 1)
		{
			colspan = "colspan=" + element.Colspan + "";
		}
		<td @{ColorIndexClass(element);} @colspan>
			@if (!string.IsNullOrEmpty(element.ProcessLink))
			{
				<a class="btn btn-info" href="~/Monitor/Process?processId=@element.ProcessLink">
					@title
				</a>
			}
			else
			{
				@title
			}
		</td>
	}
}