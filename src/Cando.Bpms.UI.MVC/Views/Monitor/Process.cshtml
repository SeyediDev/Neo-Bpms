
@using Neo.Bpms.Infrastructure.Features.Bpms.Processes.Managers.Dto
@using Neo.Bpms.UI.MVC
@using Neo.Bpms.UI.MVC.Controls
@using Neo.Bpms.UI.MVC.PartialModels
@using Neo.Bpms.UI.MVC.PartialModels.Common
@model List<ProcessViewModel>

@{
	ViewBag.Title = "فرآیندها";
	var pageName = ViewBag.PagePackId as string;
	var pageIcon = PageIconHelper.GetPageMenuIcon(pageName);
}
<link rel="stylesheet" href="~/Content/common-assets-includes/common-plugins/global/ladda/ladda-themeless.min.css"/>
@if (Model.Count > 1)
{
	<partial name="Common/TopBar" model="new TopBarModel {Title = ViewBag.Title, PageIcon = pageIcon}"/>
}
@foreach (var process in Model)
{
	<br/>
	<a class="btn btn-success" href="~/Monitor/Process?processId=@process.Id">
		<h3>@process.Name</h3>
	</a>
	<a class="btn btn-info" href="~/Process/WorkItems?ProcessId=@process.Id">کارتابل</a>
	<a class="btn btn-primary" href="~/Process/Design?ProcessId=@process.Id">طراحی</a>
	<a class="btn btn-warning" href="~/Process/DownloadProcess?ProcessId=@process.Id">BPMN2.XML</a>
	<table class="table" style="width: 50%">
		<tbody>
		<tr>
			<th>شناسه فرآیند :</th>
			<td>@process.Id</td>
			<th>موجودیت : </th>
			<td>@process.EntityId</td>
		</tr>

		@foreach (var manager in process.Managers)
		{
			<tr>
				<th>مدیر فرآیند</th>
				@{
					RenderNameColumn(manager);
				}
				<td>@(manager.Type)</td>
				<td>@(manager.Code)</td>
				<td>@(manager.Claim)</td>
			</tr>
		}
		</tbody>
	</table>
	<table class="table" style="width: 50%">
		<tbody>
		@if (process.InputParams.Count > 0)
		{
			<tr>
				<th>پارامترهای ورودی</th>
				@foreach (var param in process.InputParams)
				{
					<td>@param</td>
				}
			</tr>
		}
		@if (process.OuputParams.Count > 0)
		{
			<tr>
				<th>پارامترهای خروجی</th>
				@foreach (var param in process.OuputParams)
				{
					<td>@param</td>
				}
			</tr>
		}
		@if (process.Properties.Count > 0)
		{
			<tr>
				<th>فیلدهای فرآیند</th>
				@foreach (var param in process.Properties)
				{
					<td>@param</td>
				}
			</tr>
		}
		</tbody>

	</table>
	<table class="table" style="width: 100%">
		<thead>
		<tr>
			<th></th>
			<th>انجام دهنده</th>
			<th colspan="@(1 + process.Lanes.Max(lane => lane.Colspan))">جریان کار</th>
		</tr>
		</thead>
		<tbody>
		@foreach (var lane in process.Lanes)
		{
			<tr>
				<td rowspan="5">@lane.Name</td>
				@{
					RenderNameColumn(lane.Performer);
				}
				<td>ورودی ها :</td>
				@foreach (var element in lane.Elements)
				{
					<td></td>
					RenderFlowElements(element.Inputs, element.Colspan);
				}
			</tr>
			<tr>
				<td>@lane.Performer.Type</td>
				<td rowspan="3">المان ها :</td>
				@foreach (var element in lane.Elements)
				{
					<td></td>
					await RenderElement(element, element.Id);
				}
			</tr>
			<tr>
				<td>@lane.Performer.Code</td>
				@foreach (var element in lane.Elements)
				{
					<td></td>
                    await RenderElement(element, element.Name);
                }
			</tr>
			<tr>
				<td>@lane.Performer.Claim</td>
				@foreach (var element in lane.Elements)
				{
					<td></td>
                    await RenderElement(element, element.Type);
                }
			</tr>
			<tr>
				<td>@lane.ParentId</td>
				<td>خروجی ها :</td>
				@foreach (var element in lane.Elements)
				{
					<td></td>
					RenderFlowElements(element.Outputs, element.Colspan);
				}
			</tr>
			<tr>
				<td colspan="@(3 + lane.Colspan)"></td>
			</tr>
		}
		</tbody>
	</table>
}


