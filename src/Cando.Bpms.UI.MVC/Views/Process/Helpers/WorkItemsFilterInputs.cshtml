	<div class="col-lg-3 col-md-3 col-sm-6" style="min-height: 53px;">
		<div>
			<label for="bOffered">پیشنهادی</label>
		</div>
		<input type="checkbox" value="True" name="__Offered" id="bOffered"
		       data-default-value="checked"
		       @(Model.currentFilter.Offered ? "checked=\"checked\"" : "")/>
	</div>

	<div class="col-lg-3 col-md-3 col-sm-6" style="min-height: 53px;">
		<div>
			<label for="bAllocated">تخصیص یافته</label>
		</div>
		<input type="checkbox" value="True" name="__Allocated" id="bAllocated"
		       data-default-value="checked"
		       @(Model.currentFilter.Allocated ? "checked=\"checked\"" : "")/>
	</div>
	<div class="col-lg-3 col-md-3 col-sm-6" style="min-height: 53px;">
		<div>
			<label for="bSuspended">صف انتظار</label>
		</div>
		<input type="checkbox" value="True" name="__Suspended" id="bSuspended"
		       data-default-value="checked"
		       @(Model.currentFilter.Suspended ? "checked=\"checked\"" : "")/>
	</div>
	<div class="col-lg-3 col-md-3 col-sm-6" style="min-height: 53px;">
		<div>
			<label for="finished">خاتمه یافته</label>
		</div>
		<input type="checkbox" value="True" name="__Finished" id="finished"
		       @(Model.currentFilter.Finished ? "checked=\"checked\"" : "")/>
	</div>

	<input type="hidden" name="__Created" value="@Model.currentFilter.Created.ToString()">
	<input type="hidden" name="__PageType" value="@Model.currentFilter.PageType"/>
	<input type="hidden" id="just-restorable-tasks" name="__JustRestorableTasks" value="@Model.currentFilter.JustRestorableTasks.ToString()"/>
</div>