@using Neo.Bpms.UI.Resources.Resources
@{
    ViewBag.Title = ViewTexts.ServerSideError;
    var Error = ViewBag.Error == null ? ViewTexts.ServerInternalError : ViewBag.Error;
    var inIframe = Context.Items["InIframe"] as bool? ?? false;
    if (inIframe)
    {
        Layout = null;
    }
}

@if (inIframe)
{
    <partial name="Layout/MinimalIframeIncludes"/>
}

<img class="d-block mx-auto"
     style="max-height: 90vh; max-width: 100%;"
     src="~/Content/common-assets-includes/images/errors/500Error.gif" alt=@ViewTexts.ServerInternalError>
<div class="alert alert-danger text-2x" style="text-align: center">@Error</div>
