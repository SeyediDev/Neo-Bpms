@using Neo.Bpms.Domain.Entities.Cmmn.UI
@using Neo.Bpms.Domain.Model.Project
@using Neo.Bpms.Domain.Model.UI
@using Neo.Bpms.UI.MVC.Controls
@using Neo.Bpms.Infrastructure.Features.Cmmn.Reports
@using Neo.Bpms.UI.MVC.PartialModels
@using Neo.Bpms.UI.MVC.PartialModels.Report
@model ReportData

@{
    Layout = null;
    var calendar = ProjectDefinition.Project.DefaultCalendar;
    var reportInfo = Model;
    var matrixRoutines = new Neo.Bpms.Infrastructure.Features.Cmmn.Reports.Matrix.MatrixRoutines(reportInfo);
    var matrixData = matrixRoutines.GetMatrixData();
    var drillDownSubReports = reportInfo.structure.SubReports.Where(sr => sr.Type == Report.SubReportType.DrillDown).ToList();
    var isDrillDown = ViewBag.DrillDown ?? false;
    var canDesign = ViewBag.CanDesign ?? false;
    var reportKey = reportInfo.structure.ConfigId;
    var bFromDashboard = ViewBag.bFromDashboard ?? false;
}

<partial name="~/Views/Report/Helpers/WindowTopJs.cshtml" model="new WindowTopJsModel {drillDownSubReports = drillDownSubReports, reportKey = reportKey, reportInfo = reportInfo, filterValues = ViewBag.FilterValues}" />

<div class="col-md-12" style="overflow-x: auto;">
    @* @if ((drillDownCount >= 1) || canDesign) *@
    @* { *@
    @* <div width="50" style="text-align: center; direction: rtl;"> *@
    @if (canDesign && !bFromDashboard && !isDrillDown && reportInfo.Config.IsSubReport)
    {
        <partial name="~/Views/Report/Helpers/RenderDesignTools.cshtml" model="new RenderDesignToolsModel {report = reportInfo, forInlineSubReport = true}" />
    }
    @* </div> *@
    @* } *@

    @MatrixReportRenderer.DrawMatrix(matrixData, reportKey, calendar)

</div>

<partial name="~/Views/Report/Helpers/PartialsCommon.cshtml" model="new PartialsCommonModel {reportInfo = Model}" />