{
  "name": "@neo/admin-panel-core",
  "version": "1.0.0",
  "description": "Neo BPMS Admin Panel Core - Reusable SPA Infrastructure",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./auth": {
      "import": "./dist/auth/index.mjs",
      "require": "./dist/auth/index.js",
      "types": "./dist/auth/index.d.ts"
    },
    "./api": {
      "import": "./dist/api/index.mjs",
      "require": "./dist/api/index.js",
      "types": "./dist/api/index.d.ts"
    },
    "./state": {
      "import": "./dist/state/index.mjs",
      "require": "./dist/state/index.js",
      "types": "./dist/state/index.d.ts"
    },
    "./layout": {
      "import": "./dist/layout/index.mjs",
      "require": "./dist/layout/index.js",
      "types": "./dist/layout/index.d.ts"
    },
    "./hooks": {
      "import": "./dist/hooks/index.mjs",
      "require": "./dist/hooks/index.js",
      "types": "./dist/hooks/index.d.ts"
    },
    "./components": {
      "import": "./dist/components/index.mjs",
      "require": "./dist/components/index.js",
      "types": "./dist/components/index.d.ts"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:lib": "tsup src/index.ts --format cjs,esm --dts --clean",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.5.0",
    "react-redux": "^9.2.0",
    "axios": "^1.7.9",
    "react-router-dom": "^7.1.1",
    "jwt-decode": "^4.0.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-jalali": "^4.1.0-0",
    "framer-motion": "^11.15.0",
    "react-hook-form": "^7.54.2",
    "@hookform/resolvers": "^3.9.1",
    "zod": "^3.24.1",
    "react-hot-toast": "^2.4.1",
    "@tanstack/react-query": "^5.62.8"
  },
  "devDependencies": {
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tsup": "^8.3.5",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "vitest": "^2.1.8",
    "@testing-library/react": "^16.1.0",
    "tailwindcss": "^3.4.17",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "neo",
    "bpms",
    "admin-panel",
    "react",
    "typescript",
    "redux-toolkit"
  ],
  "author": "Neo BPMS Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}

