
@using Neo.Bpms.Domain.Entities.Cmmn.UI

@using Neo.Bpms.Domain.Model.Project
@using Neo.Bpms.Domain.Model.UI
@using Neo.Bpms.Domain.Models.Cmmn.UI.Reports
@using Neo.Bpms.Infrastructure.Features.Cmmn.Reports
@using Neo.Bpms.UI.MVC.Helpers

@model ReportData

@{
    Layout = null;
    var structure = Model.Structure;
    var calendar = ProjectDefinition.Project.DefaultCalendar;
    ViewBag.IsIframeReport = true;
}
<partial name="Layout/MinimalIframeIncludes"/>

@using (Html.BeginForm("IframeReport", "Report",
    new
    {
        structure.NamespaceId,
        structure.EntityId,
        ReportId = structure.Form_ReportId,
        structure.ConfigId
    }, FormMethod.Post,true, new { enctype = "multipart/form-data", id = "filter-form", @class="m-0" }))
{
	@Html.Hidden("ParentReportIds", structure.ParentReportIds)
    @Html.Hidden("calendar", calendar)
    <input type="hidden" name="newPage" value="1" />
    <input type="hidden" name="Page" value="@ViewBag.Page" />
    <input type="hidden" id="soValues" name="sortFields" value="@ViewBag.SortFields" />

    <div class="row no-margin-row" id="ReportBody">
        <div class="col-md-12 col-sm-12 p-0 reportBody">
            @if (Model != null)
            {
                switch (structure.ReportViewType)
                {
                    case ReportViewType.Chart:
                        switch (structure.ChartType)
                        {
                            case ChartType.IranMap:
                                @Html.Partial("~/Views/Report/Map/_IranMap.cshtml", Model)
                                break;
                            case ChartType.WorldMap:
                                @Html.Partial("~/Views/Report/Map/_WorldMap.cshtml", Model)
                                break;
                            case ChartType.BpmnDiagram:
                                @Html.Partial("~/Views/Report/Charts/_bpmn.cshtml", Model)
                                break;
                            default:
                                <div style="direction: ltr !important;">
                                    @Html.Partial("~/Views/Report/Charts/_chartView.cshtml", Model)
                                </div>
                                break;
                        }
                        break;
                    default:
                        <div>
                            @Html.Partial("~/Views/Report/ListView/_listView.cshtml", Model)
                        </div>
                        break;
                }
            }
        </div>
    </div>

    @* Report Feature Scripts - Modular Structure *@
    <partial name="Partials/_Scripts.report-filter" />
    <partial name="Partials/_Scripts.report-popular-filters" />
    <partial name="Partials/_Scripts.report-toggles" />
    <partial name="Partials/_Scripts.report-modal-zindex" />
    <partial name="Partials/_Scripts.report-modals" />
    <partial name="Partials/_Scripts.report-filter-parameter" />
    <partial name="Partials/_Scripts.report-refresh" />
    <partial name="Partials/_Scripts.report-config" />
    <partial name="Partials/_Scripts.report-events" />
    <script src="@CommonBundles.IndexPagesJsBundle" asp-append-version="true"></script>
}

<script src="@CommonBundles.FlagsJsBundle" asp-append-version="true"></script>
