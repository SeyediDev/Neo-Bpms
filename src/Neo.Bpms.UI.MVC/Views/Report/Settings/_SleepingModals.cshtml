@using Neo.Bpms.UI.Resources.Resources
@using Neo.Bpms.Domain.Model.Project
@using Neo.Bpms.UI.MVC.PartialModels.Filter
@using Neo.Bpms.Domain.Features.Security
@model             ReportData

@{
	var calendar = ProjectDefinition.Project.DefaultCalendar;
	var canScheduleReports = ViewBag.CanScheduleReports ?? false;
	// دریافت نقش‌های فعال کانفیگ
	var activeConfig = Model.Config ?? Model.Structure.Configs?.FirstOrDefault(cfg => cfg.ConfigId == Model.Structure.ConfigId);
	var activeRoles = activeConfig?.Roles ?? new List<string>();
	// دریافت اطلاعات نقش‌ها برای نمایش نام فارسی
	var allRolesInfo = ViewBag.ClubRoles as List<ClubRoleInfo> ?? new List<ClubRoleInfo>();
	// فیلتر کردن فقط نقش‌های فعال کانفیگ
	var availableRoles = allRolesInfo.Where(r => activeRoles.Contains(r.Name)).ToList();
}

<div class="modal fade keep-side-navi" id="config-config-modal" tabindex="-1" role="dialog" aria-labelledby="config-config-modal-label">
	<div class="modal-dialog" role="document">
		<div class="modal-content">
			<div class="modal-header">
				<h4 class="modal-title" id="config-config-modal-label">@ViewTexts.ConfigSettings</h4>
				<button type="button" class="close" data-dismiss="modal" aria-label="Close">
					<span aria-hidden="true">&times;</span>
				</button>
			</div>
			<div class="modal-body">
				<form>
					<input name="ConfiggingConfigId" type="hidden" value=""/>

					<div class="form-group">
						<label for="config-config-alias">
							@ViewTexts.Name:
						</label>
						<input class="form-control" id="config-config-alias" name="alias" type="text" value=""/>
					</div>
					<div class="form-group">
						<div class="custom-control custom-checkbox custom-checkbox-inline">
							<input class="custom-control-input" id="config-config-isdefault" name="isdefault" type="checkbox"/>
							<label class="custom-control-label" for="config-config-isdefault">
								@ViewTexts.Default
							</label>
						</div>
					</div>

					@if (ViewBag.CanPublishConfigs)
					{
						<div class="form-group">
							<div class="col-form-label">
								@ViewTexts.AccessLevel:
							</div>
							<div class="custom-control custom-radio custom-control-inline">
								<input class="custom-control-input" type="radio" name="access" id="configAccessPersonal" value="0" onchange="ConfigConfig.showOrHideUserGroupsCombo()">
								<label class="custom-control-label" for="configAccessPersonal">
									@ViewTexts.Personal
								</label>
							</div>
							<div class="custom-control custom-radio custom-control-inline">
								<input class="custom-control-input" type="radio" name="access" id="configAccessPublic" value="1" onchange="ConfigConfig.showOrHideUserGroupsCombo()">
								<label class="custom-control-label" for="configAccessPublic">
									@ViewTexts.Public
								</label>
							</div>
							<div class="custom-control custom-radio custom-control-inline">
								<input class="custom-control-input" type="radio" name="access" id="configAccessUserGroup" value="2" onchange="ConfigConfig.showOrHideUserGroupsCombo()">
								<label class="custom-control-label" for="configAccessUserGroup">
									@ViewTexts.ForSpecificUserGroup
								</label>
							</div>
						</div>

						<div class="user-group-div form-group">
							<label for="config-config-userGroup">
								@ViewTexts.UserGroup:
							</label>
							<select class="form-control" id="config-config-userGroup" name="userGroup">
								<option value="0"></option>
								@foreach (var userGroup in Model.Structure.UserGroups)
								{
									<option value="@userGroup.Id">
										@userGroup.Name
									</option>
								}
							</select>
						</div>
					}
				</form>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-dismiss="modal">@ViewTexts.Close</button>
				<button type="button" class="btn btn-primary" onclick="ConfigConfig.submitForm()">@ViewTexts.Save</button>
			</div>
		</div>
	</div>
</div>

<partial name="Common/FolderConfigModal" model="ViewBag.CanPublishConfigs"/>

@if (canScheduleReports)
{
	<div class="modal fade keep-side-navi" id="scheduled-report-modal" tabindex="-1" role="dialog" aria-labelledby="scheduled-report-modal-label">
	<div class="modal-dialog modal-xl" role="document">
	<div class="modal-content modern-modal">
	<div class="modal-header modern-modal-header">
		<div class="d-flex align-items-center">
			<svg style="width:24px;height:24px;margin-left:12px;color:#1869AA;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<circle cx="12" cy="12" r="10"/>
				<polyline points="12 6 12 12 16 14"/>
			</svg>
			<h4 class="modal-title mb-0">@ViewTexts.ScheduleSettings: @Model.Structure.Name</h4>
		</div>
		<button type="button" class="close" data-dismiss="modal" aria-label="Close">
			<span aria-hidden="true">&times;</span>
		</button>
	</div>
	<div class="modal-body modern-modal-body">
	<form id="schedule-form">
	<input type="hidden" id="schedule-id" value=""/>
	
	@* Basic Information Section *@
	<div class="form-section">
		<div class="section-header">
			<h5 class="section-title">
				<i class="fa fa-info-circle"></i> اطلاعات پایه
			</h5>
		</div>
		<div class="section-content">
			<div class="row">
				<div class="col-md-6">
					<div class="form-group">
						<label for="scheduled-report-name" class="form-label">
							<i class="fa fa-tag"></i> @ViewTexts.Name
						</label>
						<input class="form-control modern-input" id="scheduled-report-name" name="name" type="text" value="" placeholder="نام زمانبندی"/>
					</div>
				</div>
				<div class="col-md-3">
					<div class="form-group">
						<label for="schedule-type" class="form-label">
							<i class="fa fa-calendar-alt"></i> @ViewTexts.ScheduleType
						</label>
						<select class="form-control modern-select schedule-type-select" id="schedule-type" name="scheduleType" onchange="showOrHideJobScheduleFeatures();">
							<option value="1">@ViewTexts.Once</option>
							<option value="2">@ViewTexts.Repetetive</option>
						</select>
					</div>
				</div>
				<div class="col-md-3">
					<div class="form-group">
						<label class="form-label">&nbsp;</label>
						<div class="custom-control custom-switch">
							<input type="checkbox" class="custom-control-input" name="isDisable" id="schedule-is-disabled" value="0">
							<label class="custom-control-label" for="schedule-is-disabled">
								@ViewTexts.Disabled
							</label>
						</div>
					</div>
				</div>
			</div>
			<div class="row scheduled-report-DateTime">
				<div class="col-md-6">
					<div class="form-group">
						<label for="scheduled-report-date" class="form-label">
							<i class="fa fa-calendar"></i> @ViewTexts.Day
						</label>
						<input class="form-control modern-input dateField date-input @calendar" dont-convert="true" id="scheduled-report-date" name="date" type="text" value=""/>
					</div>
				</div>
				<div class="col-md-6">
					<div class="form-group">
						<label for="scheduled-report-time" class="form-label">
							<i class="fa fa-clock"></i> @ViewTexts.Hour
						</label>
						<input class="form-control modern-input time-input" id="scheduled-report-time" name="time" type="time" value=""/>
					</div>
				</div>
			</div>
		</div>
	</div>
	@* Repeat Period Section *@
	<div class="form-section">
		<div class="section-header">
			<h5 class="section-title">
				<i class="fa fa-redo"></i> @ViewTexts.RepeatPeriod
			</h5>
		</div>
		<div class="section-content">
			<fieldset class="job-frequency">
			<div class="row">
				<div class="col-md-12">
					<div class="form-group">
						<label class="form-label">تکرار</label>
						<div class="d-flex align-items-center gap-3">
							<span class="text-muted">هر</span>
							<input class="form-control modern-input repetition-input" id="scheduled-report-repetition" name="every" type="number" value="" min="1"/>
							<select class="form-control modern-select frequency-select" id="schedule-job-frequency" name="jobfrequency" onchange="showOrHideJobScheduleFeatures();">
								<option value="1">@ViewTexts.Day</option>
								<option value="2">@ViewTexts.Week</option>
								<option value="3" data-toggle="tooltip" title="ماه میلادی">@ViewTexts.Month</option>
							</select>
						</div>
					</div>
				</div>
			</div>
			<div class="form-group week-days">
				<label class="form-label">روزهای هفته</label>
				<div class="week-days-container">
					<div class="week-day-item">
						<input type="checkbox" name="onWeekDays" id="onWeekDays1" value="1" class="week-day-checkbox">
						<label for="onWeekDays1" class="week-day-label">شنبه</label>
					</div>
					<div class="week-day-item">
						<input type="checkbox" name="onWeekDays" id="onWeekDays2" value="2" class="week-day-checkbox">
						<label for="onWeekDays2" class="week-day-label">یکشنبه</label>
					</div>
					<div class="week-day-item">
						<input type="checkbox" name="onWeekDays" id="onWeekDays4" value="4" class="week-day-checkbox">
						<label for="onWeekDays4" class="week-day-label">دوشنبه</label>
					</div>
					<div class="week-day-item">
						<input type="checkbox" name="onWeekDays" id="onWeekDays8" value="8" class="week-day-checkbox">
						<label for="onWeekDays8" class="week-day-label">سه‌شنبه</label>
					</div>
					<div class="week-day-item">
						<input type="checkbox" name="onWeekDays" id="onWeekDays16" value="16" class="week-day-checkbox">
						<label for="onWeekDays16" class="week-day-label">چهارشنبه</label>
					</div>
					<div class="week-day-item">
						<input type="checkbox" name="onWeekDays" id="onWeekDays32" value="32" class="week-day-checkbox">
						<label for="onWeekDays32" class="week-day-label">پنجشنبه</label>
					</div>
					<div class="week-day-item">
						<input type="checkbox" name="onWeekDays" id="onWeekDays64" value="64" class="week-day-checkbox">
						<label for="onWeekDays64" class="week-day-label">جمعه</label>
					</div>
				</div>
			</div>
			<div class="form-group month-frequency">
				<label class="form-label">تنظیمات ماهانه</label>
				<div class="row">
					<div class="col-md-6">
						<div class="custom-control custom-radio mb-2">
							<input class="custom-control-input day-of-month" type="radio" name="monthFrequency" id="monthFreq1" value="1" onclick="showOrHideJobScheduleFeatures();">
							<label class="custom-control-label" for="monthFreq1">روز ماه</label>
						</div>
						<input class="form-control modern-input day-of-month-input" id="scheduled-report-dayOfMonth" name="dayOfMonth" type="number" value="" disabled placeholder="روز ماه (1-31)"/>
					</div>
					<div class="col-md-6">
						<div class="custom-control custom-radio mb-2">
							<input class="custom-control-input mf" type="radio" name="monthFrequency" id="monthFreq2" value="2" onclick="showOrHideJobScheduleFeatures();"/>
							<label class="custom-control-label" for="monthFreq2">در هفته مشخص</label>
						</div>
						<div class="d-flex gap-2">
							<select class="form-control modern-select week-counter-select" id="week-counter" name="monthlyFrequency" disabled>
								<option value="1">اولین</option>
								<option value="2">دومین</option>
								<option value="3">سومین</option>
								<option value="4">چهارمین</option>
								<option value="5">آخرین</option>
							</select>
							<select class="form-control modern-select weekday-select" name="WeekDays" disabled>
								<option value="1">شنبه</option>
								<option value="2">یکشنبه</option>
								<option value="3">دوشنبه</option>
								<option value="4">سه شنبه</option>
								<option value="5">چهارشنبه</option>
								<option value="6">پنجشنبه</option>
								<option value="7">جمعه</option>
								<option value="8">روز کاری</option>
								<option value="9">آخر هفته</option>
							</select>
						</div>
					</div>
				</div>
			</div>
		</fieldset>
	</div>
	
	@* Daily Frequency Section *@
	<div class="form-section">
		<div class="section-header">
			<h5 class="section-title">
				<i class="fa fa-clock"></i> زمان گزارش گیری در روز
			</h5>
		</div>
		<div class="section-content">
			<fieldset class="daily-frequency">
			<div class="row">
				<div class="col-md-6">
					<div class="custom-control custom-radio mb-3">
						<input type="radio" class="custom-control-input specific-time" name="dailyFrequency" id="dailyFreq1" value="1" onclick="showOrHideJobScheduleFeatures();">
						<label class="custom-control-label" for="dailyFreq1">در ساعت مشخص</label>
					</div>
					<input class="form-control modern-input time-input" id="daily-frequency-hour" name="time" type="time" value=""/>
				</div>
				<div class="col-md-6">
					<div class="custom-control custom-radio mb-3">
						<input type="radio" class="custom-control-input hourly-every" name="dailyFrequency" id="dailyFreq2" value="2" onclick="showOrHideJobScheduleFeatures();">
						<label class="custom-control-label" for="dailyFreq2">هر چند ساعت</label>
					</div>
					<div class="d-flex align-items-center gap-2">
						<input class="form-control modern-input hourly-every-input" id="scheduled-report-hourlyEvery" type="number" value="" disabled placeholder="تعداد"/>
						<span class="text-muted">@ViewTexts.Hour</span>
					</div>
				</div>
			</div>
			<div class="row mt-3">
				<div class="col-md-6">
					<label for="scheduled-report-starttime" class="form-label">ساعت شروع</label>
					<input class="form-control modern-input time-input" id="scheduled-report-starttime" name="startTime" type="time" value="" disabled/>
				</div>
				<div class="col-md-6">
					<label for="scheduled-report-endtime" class="form-label">ساعت پایان</label>
					<input class="form-control modern-input time-input" id="scheduled-report-endtime" name="endTime" type="time" value="" disabled/>
				</div>
			</div>
		</fieldset>
	</div>
	
	@* Duration Section *@
	<div class="form-section">
		<div class="section-header">
			<h5 class="section-title">
				<i class="fa fa-calendar-check"></i> طول دوره گزارش گیری
			</h5>
		</div>
		<div class="section-content">
			<fieldset class="duration">
				<div class="row">
				<div class="col-md-6">
					<div class="form-group">
						<label for="scheduled-report-startdate" class="form-label">تاریخ شروع</label>
						<input class="form-control modern-input dateField date-input @calendar" dont-convert="true" id="scheduled-report-startdate" name="startDate" type="text" value=""/>
					</div>
				</div>
				<div class="col-md-6">
					<div class="form-group">
						<label for="scheduled-report-enddate" class="form-label">تاریخ منقضی شدن</label>
						<input class="form-control modern-input dateField date-input @calendar" dont-convert="true" id="scheduled-report-enddate" name="endDate" type="text" value=""/>
					</div>
				</div>
				</div>
			</fieldset>
		</div>
	</div>
	
	@* Output Settings Section *@
	<div class="form-section">
		<div class="section-header">
			<h5 class="section-title">
				<i class="fa fa-paper-plane"></i> تعیین عملیات و خروجی
			</h5>
		</div>
		<div class="section-content">
			<fieldset>
			<div class="row">
				<div class="col-md-6">
					<div class="form-group">
						<label for="output-type" class="form-label">
							<i class="fa fa-file-export"></i> نوع خروجی گزارش
						</label>
						<select class="form-control modern-select" id="output-type" name="outputType" onchange="showOrHideJobScheduleFeatures();">
							<option value="2">ایمیل</option>
							<option value="4">پیامک</option>
							<option value="5">اطلاع رسانی</option>
							<option value="1">دایرکتوری فایل</option>
							<option value="3">پیوست سابقه</option>
						</select>
					</div>
				</div>
				<div class="col-md-6">
					<div class="form-group">
						<label for="file-type" class="form-label">
							<i class="fa fa-file"></i> فرمت گزارش
						</label>
						<select class="form-control modern-select" id="file-type" name="fileType">
							<option value="1">HTML</option>
							<option value="2">Excel</option>
							<option value="3">Text</option>
							<option value="4">CSV</option>
						</select>
					</div>
				</div>
			</div>
			<div class="row">
				<div class="col-md-6">
					<div class="form-group">
						<label for="action-name" class="form-label">عنوان در خروجی</label>
						<input class="form-control modern-input" id="action-name" name="actionName" type="text" value="" placeholder="عنوان گزارش"/>
					</div>
				</div>
				<div class="col-md-6">
					<div class="form-group">
						<label for="max-record" class="form-label">حداکثر تعداد رکورد</label>
						<input class="form-control modern-input max-record-input" id="max-record" name="maxRecord" min="0" max="100000" type="number" value="" placeholder="تعداد رکورد"/>
					</div>
				</div>
			</div>
			<div class="row user-group-div">
				<div class="col-md-6">
					<div class="form-group">
						<label for="scheduled-report-roles" class="form-label">
							<i class="fa fa-user-tag"></i> نقش
						</label>
						<select class="form-control modern-select" id="scheduled-report-roles" name="roles" multiple>
							@if (availableRoles != null && availableRoles.Any())
							{
								@foreach (var role in availableRoles)
								{
									<option value="@role.Name">
										@role.DisplayName
									</option>
								}
							}
							else
							{
								<option disabled>هیچ نقشی در این کانفیگ تعریف نشده است</option>
							}
						</select>
						<small class="form-text text-muted">می‌توانید چند نقش را انتخاب کنید (با نگه داشتن Ctrl)</small>
					</div>
				</div>
				<div class="col-md-6">
					<div class="form-group">
						<label for="scheduled-report-user" class="form-label">
							<i class="fa fa-user"></i> ارسال به کاربر
						</label>
						<input class="form-control modern-input" id="scheduled-report-user" name="user" type="text" value="" placeholder="نام کاربری"/>
					</div>
				</div>
			</div>
			<div class="row output-type">
				<div class="col-md-6">
					<div class="form-group">
						<label for="destination-user-name" class="form-label">نام کاربری (دایرکتوری)</label>
						<input class="form-control modern-input" id="destination-user-name" type="text" value="" placeholder="نام کاربری"/>
					</div>
				</div>
				<div class="col-md-6">
					<div class="form-group">
						<label for="destination-password" class="form-label">رمز عبور (دایرکتوری)</label>
						<input class="form-control modern-input" id="destination-password" type="password" value="" placeholder="رمز عبور"/>
					</div>
				</div>
			</div>
			<div class="form-group output-type">
				<label for="destination-path" class="form-label">
					<i class="fa fa-folder"></i> مسیر خروجی
				</label>
				<input class="form-control modern-input" id="destination-path" type="text" value="" placeholder="\\TetaScheduledReport" dir="ltr"/>
			</div>
		</fieldset>
	</div>
	</form>
	</div>
	<div class="modal-footer modern-modal-footer">
		<button type="button" class="btn btn-outline-secondary" data-dismiss="modal">
			<i class="fa fa-times"></i> انصراف
		</button>
		<button type="button" id="schedule-without-filter-submit" class="btn btn-outline-success" onclick="ScheduledReport.submitForm(false)">
			<i class="fa fa-save"></i> ذخیره بدون تغییر فیلتر
		</button>
		<button type="button" class="btn btn-primary" onclick="ScheduledReport.submitForm(true)">
			<i class="fa fa-save"></i> ذخیره به همراه فیلتر
		</button>
	</div>
	</div>
	</div>
	</div>
}

<partial name="Filter/FilterConfigModal" model="new FilterConfigModalModel {hasConfig = true, canPublishConfigs = ViewBag.CanPublishConfigs}"/>

<div class="modal fade" id="reportConfigModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content" style="height: 450px;">
			<div class="modal-header">
				<span class="modal-title" id="myModalLabel">
					@ViewTexts.ReportAddNewConfig
				</span>
				<button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
			</div>
			<div class="modal-body" style="height: 75%;">
				@ViewTexts.Loading...
			</div>
		</div>
	</div>
</div>

<partial name="~/Views/Report/Settings/AddSubReportModal.cshtml"/>

<style>
	.label-right { text-align: right !important; }
	
	/* Modern Modal Styles */
	.modern-modal {
		border-radius: 12px;
		overflow: hidden;
	}
	
	.modern-modal-header {
		background: linear-gradient(135deg, #1869AA 0%, #1e88e5 100%);
		color: white;
		border-bottom: none;
		padding: 20px 25px;
	}
	
	.modern-modal-header .modal-title {
		color: white;
		font-weight: 600;
		font-size: 18px;
	}
	
	.modern-modal-header .close {
		color: white;
		opacity: 0.9;
		text-shadow: none;
	}
	
	.modern-modal-header .close:hover {
		opacity: 1;
	}
	
	.modern-modal-body {
		padding: 25px;
		max-height: 75vh;
