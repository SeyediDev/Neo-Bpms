@using Neo.Bpms.Domain.Entities.Cmmn.UI
@using Neo.Bpms.Domain.Model.UI
@using Neo.Bpms.Domain.Models.Cmmn.UI.Reports
@model             PossibleSubReportSelections

@{
	Layout = null;
}
<partial name="Layout/MinimalIframeIncludes" />

<style>
	th {
		text-align: center;
		vertical-align: middle;
	}

	td {
		font-size: small;
		text-align: center;
		vertical-align: middle;
	}
</style>
@using (Html.BeginForm("AddSubReport", "Report", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
	<input type="hidden" name="NamespaceId" value="@Model.NamespaceId" />
	<input type="hidden" name="EntityId" value="@Model.EntityId" />
	<input type="hidden" name="ReportId" value="@Model.ReportId" />
	<input type="hidden" name="ConfigId" value="@Model.ConfigId" />

	<input type="hidden" name="type" value="@ViewBag.SubReportType" />
	<input type="hidden" name="SubNamespaceId" />
	<input type="hidden" name="SubEntityId" />
	<input type="hidden" name="SubReportId" />
	<input type="hidden" name="associationName" />
	CurrentSubReports();
	await DisplayType();
	PossibleSubReports();
	await PossibleDashboards();
	await NewSubReportDetails();
	<script>
		function viewChanged(ct) {
			var val = $(ct).val();
			if (val === "2")
				$("#nCharts").parent("div").slideDown();
			else {
				$("#nCharts").parent("div").slideUp();
			}
			if (val === "4") {
				$("#DashboardData").slideDown();
				$("#SubReportData").slideUp();
			} else {
				$("#DashboardData").slideUp();
				$("#SubReportData").slideDown();
			}
		}

		function addNewDashboardConfig(ct) {
			$(ct).closest("form").submit();
			$(ct).closest("iframe").remove();
		}

		function addNewConfig(ct) {
			$(ct).closest("form").submit();
			$(ct).closest("iframe").remove();
		}
		function submitSubReport() {
			console.log('call shodam');
			var $selectedSubreportOption = $('#PossibleSubReportsSelect').find('option:selected');
			var associationname = $selectedSubreportOption.data("associationname");
			var entityid = $selectedSubreportOption.data("entityid");
			var namespaceid = $selectedSubreportOption.data("namespaceid");
			var subreportid = $selectedSubreportOption.val();
			//var type = $(data).attr("data-srtype");
			$("input[name='SubNamespaceId']").val(namespaceid);
			$("input[name='SubEntityId']").val(entityid);
			$("input[name='SubReportId']").val(subreportid);
			$("input[name='associationName']").val(associationname);
			$("input[name='SubNamespaceId']").closest("form").submit();
		}
		function selectRow() {
			var $selectedSubreportOption = $('#PossibleSubReportsSelect').find('option:selected');
			var sName = $selectedSubreportOption.text().trim();
			$("input[name='SubReportName']").val(sName);
		}

		function deleteSubConfig(configId) {
			var entityId = $("input[name='EntityId']").val();
			var namespaceId = $("input[name='NamespaceId']").val();
			var reportId = $("input[name='ReportId']").val();
			var ajaxParams = {
				NamespaceId: namespaceId,
				EntityId: entityId,
				ReportId: reportId,
				ConfigId: configId
			};
			$.ajax({
				type: 'POST',
				url: window.top.rootUrl + 'Report/DeleteConfig',
				data: ajaxParams,
				headers: AddAntiForgeryToken(),
				success: function (res) {
					$('tr[data-configid="' + configId + '"]').remove();
				},
				error: function (e) {
					window.top.toast.error(window.tetaI18n.t('Error Occured'));
				}
			});
		}

		function changeSubConfigType(configId) {
			if (!confirm(window.tetaI18n.t('SureToChangeSubConfigType')))
				return;
			$.ajax({
				type: "POST",
				url: window.top.rootUrl + "Report/ChangeSubConfigType?ConfigId=" + configId,
				headers: AddAntiForgeryToken(),
				success: function (res) {
					if (res) {
						var $el = $('tr[data-configid="' + configId + '"]');
						$el.remove();
						window.top.toast.success(window.tetaI18n.t('SubConfigTypeChanged'));
					}
				},
				error: function (e) {
					window.top.toast.error(window.tetaI18n.t('Error Occured'));
				}
			});
		}

		function renameSubConfig(configId) {
			var $el = $('tr[data-configid="' + configId + '"] td.subconfig-name');

			var newName = prompt(window.tetaI18n.t('EnterSubConfigName'), $el.text().trim());

			if (newName) {
				var entityId = $("input[name='EntityId']").val();
				var namespaceId = $("input[name='NamespaceId']").val();
				var reportId = $("input[name='ReportId']").val();
				var ajaxParams = {
					newName: newName,
					ConfigId: configId,
					EntityId: entityId,
					NamespaceId: namespaceId,
					ReportId: reportId
				};
				$.ajax({
					type: "POST",
					url: window.top.rootUrl + "Report/RenameConfig",
					data: ajaxParams,
					headers: AddAntiForgeryToken(),
					success: function (res) {
						if (res) {
							$el.text(newName);
						}
					},
					error: function (e) {
						window.top.toast.error(window.tetaI18n.t('Error Occured'));
					}
				});
			}
		}
	</script>
	var message = ViewBag.message;
	if (message != null)
	{
		<hr />
		<span id="cbMsg">@message</span>
	}
}

@functions{

	async Task DisplayType()
	{
		<h5>@ViewTexts.AddPossibleSubReport</h5>
		<div style="margin-top: 10px;">
			<label for="ViewTypeSelect">@ViewTexts.DisplayType</label>
			<span style="padding-left: 20px;"> :</span>
			<select id="ViewTypeSelect" name="viewType" class="form-control" onchange="viewChanged(this)">
				<option selected="selected" value="0">@ViewTexts.List</option>
				<option value="1">@ViewTexts.GroupedList</option>
				<option value="2">@ViewTexts.Chart</option>
				@if (ViewBag.SubReportType != Report.SubReportType.SubReport)
				{
					<option value="4">@ViewTexts.Dashboard</option>
				}
				<option value="3">@ViewTexts.WorldMap</option>
				<option value="5">@ViewTexts.IranMap</option>
			</select>
			<br />
		</div>
	}

	void CurrentSubReports()
	{
		<h5>@ViewTexts.CurrentSubReports</h5>
		<table class="table table-striped table-bordered">
			<thead>
				<tr>
					<th>
						@ViewTexts.SubReportName
					</th>
					<th>
						@ViewTexts.Operation
					</th>
				</tr>
			</thead>
			<tbody>

				@foreach (var subconfig in Model.SubReports)
				{
					if (subconfig.Type != ViewBag.SubReportType)
					{
						continue;
					}

					<tr data-configid="@subconfig.ConfiguredReport.ConfigId">
						<td class="subconfig-name" style="font-size: 13px;">
							@subconfig.ConfiguredReport.Name
						</td>
						<td style="font-size: 13px;">
							<i class="fa fa-times text-danger mouse-pointer"
								title="@ViewTexts.Delete"
								cid='@subconfig.ConfiguredReport.ConfigId'
								onclick="deleteSubConfig('@subconfig.ConfiguredReport.ConfigId')">
							</i>
							<i class="fa fa-edit text-success mouse-pointer"
								alias="@subconfig.ConfiguredReport.Name"
								title="@ViewTexts.Rename"
								cid='@subconfig.ConfiguredReport.ConfigId'
								onclick="renameSubConfig('@subconfig.ConfiguredReport.ConfigId')">
							</i>
							<i class="fa fa-arrow-circle-right text-warning mouse-pointer changeSubConfingType"
								title="@ViewTexts.ChangeSubReportType"
								cid='@subconfig.ConfiguredReport.ConfigId'
								onclick="changeSubConfigType('@subconfig.ConfiguredReport.ConfigId')">
							</i>
						</td>
					</tr>
				}


			</tbody>
		</table>
	}

	void PossibleSubReports()
	{
		<div id="SubReportData">
			<label for="PossibleSubReportsSelect">
				@ViewTexts.SubReport
			</label>
			<select id="PossibleSubReportsSelect" class="form-control" onchange="selectRow()">
				@Html.EditorFor(x => x.PossibleSubReports)
			</select>
			<label for="PossibleSubReportsSelect" style="margin-top: 10px;">
				@ViewTexts.SubReportName
			</label>
			<input type="text" name="SubReportName" class="form-control" placeholder="@ViewTexts.SubReportName" />
		</div>
	}

	async Task NewSubReportDetails()
	{
		<div style="display: none;">
			<span style="padding-left: 20px;">@ViewTexts.ChartType :</span>
			<select class="form-control" id="nCharts" name="chartType">
				<option selected="selected" value="@ChartType.Area">@ChartType.Area</option>
				<option value="@ChartType.Bar">Bar</option>
				<option value="@ChartType.Column">Column</option>
				<option value="@ChartType.Line">Line</option>
				<option value="@ChartType.Pie">Pie</option>
				<option value="@ChartType.Spline">Spline</option>
				<option value="@ChartType.Areaspline">Areaspline</option>
				<option value="@ChartType.Scatter">Scatter</option>
			</select>
		</div>
		@*<input type="button" class="btn btn-primary" value="@ViewTexts.Submit" onclick="submit(this)"/>*@
        <button type="button" onclick="submitSubReport()" style="margin-top: 10px;background-color: #10B981;border-color: #10B981;border-radius: 8px;color: #FFFFFF;" class="form-control btn btn-primary">
            @ViewTexts.Submit
        </button>
	}

	async Task PossibleDashboards()
	{
		<div id="DashboardData" style="display: none;">
			<label for="DashboardConfigId">@ViewTexts.Dashboard</label>
			<select id="DashboardConfigId" class="form-control" name="dashboardConfigId">
				@foreach (var dashboardConfig in Model.DashboardConfigs)
				{
					<option value="@dashboardConfig.Id">@dashboardConfig.Name</option>
				}
			</select>
		</div>
	}

}