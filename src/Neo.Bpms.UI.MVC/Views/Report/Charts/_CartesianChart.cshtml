@using System
@using System.Linq
@using Neo.Bpms.Domain.Entities.Cmmn
@using Neo.Bpms.Domain.Models.Cmmn.UI.Reports
@using Neo.Bpms.Infrastructure.Features.Cmmn.Reports
@using Neo.Bpms.UI.MVC.PartialModels.Report
@model ChartScriptModel

@{
    var idx = Model.Idx;
    var reportInfo = Model.ReportInfo;
    var chartTitle = Model.ChartTitle;
    var showTitle = Model.ShouldShowTitle;
    var hr = new HighchartRenderer(reportInfo);
    // Ensure ChartType is set - default to 'column' if None, Line (default), or invalid
    // Line is the default value in ConfiguredReport, so we treat it as unset and use Column
    var chartTypeValue = reportInfo.Structure.ChartType;
    var chartType = (chartTypeValue != ChartType.None && chartTypeValue != ChartType.Line) 
        ? chartTypeValue.ToString().ToLower() 
        : "column";
    var aggregationCount = reportInfo.AggregationColumns.Count();
    var hasSingleAggregation = aggregationCount == 1;
    var hasMultipleAggregations = aggregationCount > 1;
    var isMatrix = reportInfo.Structure.SelectedColumns.Count(s => s.aggrType == eAggregationFunctions.InColumn) > 1 &&
                   reportInfo.Structure.SelectedColumns.Count(s => s.aggrType == eAggregationFunctions.GroupByItem) > 0;
    var drilldownConfigs = reportInfo?.Structure?.SubReports?.Count(sr => sr.Type == Report.SubReportType.DrillDown) ?? 0;
    var chartConfigId = reportInfo?.Structure?.ConfigId ?? string.Empty;
    var advancedOptionsRaw = Model.Structure?.GetReportProperty((long)ReportConfigProperty.ChartAdvancedOptions) ?? string.Empty;
    var advancedOptions = advancedOptionsRaw.Split(',', StringSplitOptions.RemoveEmptyEntries)
        .Select(o => o.Trim().ToLower())
        .ToList();
    var stackingMode = advancedOptions.Contains("percent")
        ? "percent"
        : advancedOptions.Contains("stacked")
            ? "normal"
            : string.Empty;
    var smoothLines = advancedOptions.Contains("smooth");
    var overlayLine = advancedOptions.Contains("line-overlay");
    var enableMarkers = advancedOptions.Contains("markers");
    var showDataLabels = advancedOptions.Contains("labels");
}

<script type="text/javascript">
	var rotateVal = -40;
	var chartType = '@chartType';
	if (chartType === 'bar') {
		rotateVal = -1;
	}

	var chartCategories = @hr.GetCategories();
	var renderedSeries = @hr.GetSeries();
	var isMatrixChart = @(isMatrix ? "true" : "false");
	var hasSingleAggregationSeries = @(hasSingleAggregation ? "true" : "false");
	var hasMultipleAggregationSeries = @(hasMultipleAggregations ? "true" : "false");
	var reportDataKey = '@idx';
	var drilldownConfigId = '@chartConfigId';
	var subReportsCount = @drilldownConfigs;
	var stackingMode = '@stackingMode';
	var enableSmoothLines = @(smoothLines ? "true" : "false");
	var overlayLineEnabled = @(overlayLine ? "true" : "false");
	var markersEnabled = @(enableMarkers ? "true" : "false");
	var dataLabelsEnabled = @(showDataLabels ? "true" : "false");
	
	// Check if data is empty
	var hasData = chartCategories && chartCategories.length > 0 && renderedSeries && renderedSeries.length > 0 && 
	              renderedSeries.some(function(series) { return series.data && series.data.length > 0; });
	
	if (!hasData) {
		console.warn('Chart data is empty. Categories:', chartCategories, 'Series:', renderedSeries);
		console.warn('Report rows count:', @(reportInfo.Rows?.Count() ?? 0));
	}

	function mergeSeriesOptions(series, extraOptions) {
		if (typeof Highcharts !== 'undefined' && Highcharts.merge) {
			return Highcharts.merge(series, extraOptions);
		}
		return Object.assign({}, series, extraOptions);
	}

	if (enableSmoothLines && (chartType === 'line' || chartType === 'area')) {
		for (var smoothIndex = 0; smoothIndex < renderedSeries.length; smoothIndex++) {
			renderedSeries[smoothIndex] = mergeSeriesOptions(renderedSeries[smoothIndex], {
				type: 'spline',
				marker: { enabled: markersEnabled }
			});
		}
	}

	if (overlayLineEnabled && renderedSeries.length > 1) {
		var overlayIndex = renderedSeries.length - 1;
		renderedSeries[overlayIndex] = mergeSeriesOptions(renderedSeries[overlayIndex], {
			type: 'spline',
			lineWidth: 3,
			marker: { enabled: true }
		});
	}

	function getReportRows() {
		if (!window.top || !window.top.reportsData) {
			return null;
		}
		return window.top.reportsData[reportDataKey] || null;
	}

	function resolveMatrixTooltip(pointContext) {
		if (!isMatrixChart || !hasSingleAggregationSeries) {
			return null;
		}

		var seriesIndex = typeof pointContext.colorIndex !== 'undefined'
			? parseInt(pointContext.colorIndex)
			: (pointContext.series && typeof pointContext.series.index !== 'undefined'
				? parseInt(pointContext.series.index)
				: 0);
		if (isNaN(seriesIndex) || seriesIndex < 0 || seriesIndex >= renderedSeries.length) {
			seriesIndex = 0;
		}

		var seriesElement = renderedSeries[seriesIndex];
		if (!seriesElement || !seriesElement.rowIdsIndex) {
			return null;
		}

		var pointIndex = parseInt(pointContext.index);
		if (isNaN(pointIndex) || pointIndex < 0 || pointIndex >= seriesElement.rowIdsIndex.length) {
			return null;
		}

		var rowIdIndex = seriesElement.rowIdsIndex[pointIndex];
		if (typeof rowIdIndex !== 'number' || rowIdIndex < 0) {
			return null;
		}

		var rows = getReportRows();
		if (!rows || rows.length <= rowIdIndex) {
			return null;
		}

		var tooltipValues = rows[rowIdIndex]["tooltipValues"];
		if (!tooltipValues || !tooltipValues.length) {
			return null;
		}

		var tooltipResult = "";
		for (var i = 0; i < tooltipValues.length; i++) {
			tooltipResult += tooltipFormatter(tooltipValues[i]);
		}
		return tooltipResult;
	}

	function resolveStandardTooltip(pointContext) {
		var rows = getReportRows();
		if (!rows) {
			return null;
		}

		var seriesIndex = typeof pointContext.colorIndex !== 'undefined'
			? parseInt(pointContext.colorIndex)
			: (pointContext.series && typeof pointContext.series.index !== 'undefined'
				? parseInt(pointContext.series.index)
				: 0);
		if (isNaN(seriesIndex) || seriesIndex < 0 || seriesIndex >= renderedSeries.length) {
			seriesIndex = 0;
		}
		var seriesElement = renderedSeries[seriesIndex];

		var candidateIndex = parseInt(pointContext.index);
		var rowIndex = candidateIndex;
		if (seriesElement && seriesElement.rowIdsIndex && seriesElement.rowIdsIndex.length > candidateIndex) {
			var mapped = seriesElement.rowIdsIndex[candidateIndex];
			if (typeof mapped === 'number' && mapped >= 0) {
				rowIndex = mapped;
			}
		}

		if (isNaN(rowIndex) || rowIndex < 0 || rowIndex >= rows.length) {
			return null;
		}

		var tooltipRows = rows[rowIndex]["tooltipValues"];
		if (!tooltipRows || !tooltipRows.length) {
			return null;
		}

		var aggregationIndex = typeof pointContext.colorIndex !== 'undefined'
			? parseInt(pointContext.colorIndex)
			: (pointContext.series && typeof pointContext.series.index !== 'undefined'
				? parseInt(pointContext.series.index)
				: 0);
		if (isNaN(aggregationIndex) || aggregationIndex < 0 || aggregationIndex >= tooltipRows.length) {
			aggregationIndex = 0;
		}

		return tooltipFormatter(tooltipRows[aggregationIndex] || tooltipRows[0]);
	}

	function resolveSharedTooltip(pointContext) {
		if (!hasMultipleAggregationSeries || isMatrixChart) {
			return null;
		}

		var rows = getReportRows();
		if (!rows) {
			return null;
		}

		var sampleSeries = renderedSeries[0];
		var candidateIndex = parseInt(pointContext.index);
		var rowIndex = candidateIndex;
		if (sampleSeries && sampleSeries.rowIdsIndex && sampleSeries.rowIdsIndex.length > candidateIndex) {
			var mapped = sampleSeries.rowIdsIndex[candidateIndex];
			if (typeof mapped === 'number' && mapped >= 0) {
				rowIndex = mapped;
			}
		}
		if (isNaN(rowIndex) || rowIndex < 0 || rowIndex >= rows.length) {
			return null;
		}

		var tooltipRows = rows[rowIndex]["tooltipValues"];
		if (!tooltipRows || !tooltipRows.length) {
			return null;
		}

		var combinedTooltip = "";
		for (var i = 0; i < tooltipRows.length; i++) {
			combinedTooltip += tooltipFormatter(tooltipRows[i]);
		}
		return combinedTooltip;
	}

	function buildNumericFallbackTooltip(pointContext) {
		var items = {};
		var label = (pointContext.series && pointContext.series.name) ? pointContext.series.name : '';
		var valueText = (typeof Highcharts !== 'undefined' && Highcharts.numberFormat)
			? Highcharts.numberFormat(pointContext.y, 0)
			: (pointContext.y != null ? String(pointContext.y) : '');
		if (!label) {
			// Try to use Y axis title when there is a single aggregation
			try {
				var chart = pointContext.series && pointContext.series.chart;
				var yTitle = chart && chart.yAxis && chart.yAxis[0] && chart.yAxis[0].axisTitle && chart.yAxis[0].axisTitle.textStr;
				label = yTitle || '';
			} catch (e) { /* ignore */ }
		}
		items[label] = valueText;
		return tooltipFormatter(items);
	}

	function resolveRowData(pointContext) {
		var rows = getReportRows();
		if (!rows) {
			return null;
		}

		if (isMatrixChart && hasSingleAggregationSeries) {
			var seriesIndex = typeof pointContext.colorIndex !== 'undefined'
				? parseInt(pointContext.colorIndex)
				: (pointContext.series && typeof pointContext.series.index !== 'undefined'
					? parseInt(pointContext.series.index)
					: 0);
			var seriesElement = renderedSeries[seriesIndex];
			if (!seriesElement || !seriesElement.rowIdsIndex) {
				return null;
			}
			var mappedRowIndex = seriesElement.rowIdsIndex[parseInt(pointContext.index)];
			if (typeof mappedRowIndex === 'number' && mappedRowIndex >= 0 && rows.length > mappedRowIndex) {
				return rows[mappedRowIndex];
			}
			return null;
		}

		var resolvedIndex = parseInt(pointContext.index);
		if (isNaN(resolvedIndex) || resolvedIndex < 0 || resolvedIndex >= rows.length) {
			return null;
		}
		return rows[resolvedIndex];
	}

	function openMasterDetail(pointContext, nativeEvent) {
		if (!subReportsCount) {
			return;
		}

		var rowData = resolveRowData(pointContext);
		if (!rowData || !rowData.ids) {
			return;
		}

		var parentFilter = window.top.reportInfo && window.top.reportInfo[drilldownConfigId]
			? window.top.reportInfo[drilldownConfigId]["parentFilter"]
			: null;

		var anchorElement = nativeEvent && nativeEvent.target
			? nativeEvent.target
			: (pointContext.graphic && pointContext.graphic.element);

		openSubReportFrame2(subReportsCount,
			rowData.ids,
			drilldownConfigId,
			parentFilter,
			anchorElement,
			nativeEvent);
	}

	(function() {
		// Check if data is empty before rendering chart
		var hasData = chartCategories && chartCategories.length > 0 && renderedSeries && renderedSeries.length > 0 && 
		              renderedSeries.some(function(series) { return series.data && series.data.length > 0; });
		
		if (!hasData) {
			console.warn('Chart data is empty. Categories:', chartCategories, 'Series:', renderedSeries);
			console.warn('Report rows count:', @(reportInfo.Rows?.Count() ?? 0));
			
			// Show message in chart container
			var container = document.getElementById("container_@(idx)");
			if (container) {
				container.innerHTML = '<div style="display: flex; align-items: center; justify-content: center; height: 100%; flex-direction: column; padding: 40px; text-align: center; color: #64748b; font-family: Vazir, Yekan, Tahoma, Arial, sans-serif;">' +
					'<svg style="width: 64px; height: 64px; margin-bottom: 16px; opacity: 0.5;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">' +
					'<path d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z"></path>' +
					'<path d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0"></path>' +
					'</svg>' +
					'<h3 style="font-size: 18px; font-weight: 600; margin-bottom: 8px; color: #334155;">داده‌ای برای نمایش وجود ندارد</h3>' +
					'<p style="font-size: 14px; color: #64748b; margin: 0;">لطفاً فیلترها را بررسی کنید یا گزارش را دوباره بارگذاری کنید.</p>' +
					'</div>';
				return;
			}
		}
		
		// Persian font family - Vazir or fallback to system fonts
		var persianFont = "'Vazir', 'Yekan', 'Tahoma', 'Arial', sans-serif";
		
		var autoDataLabels = dataLabelsEnabled || hasMultipleAggregationSeries;
		var container_chartCorrectiveAction = new Highcharts.Chart({
			credits: {
				enabled: false
			},
			chart: {
				renderTo: "container_@(idx)",
				type: '@chartType',
				marginBottom: 150,
				style: {
					fontFamily: persianFont
				}
			},
			title: {
				text: '@(showTitle ? chartTitle : "")',
				style: {
					fontFamily: persianFont
				}
			},
			xAxis: {
				categories: chartCategories,
				labels: {
					rotation: rotateVal,
					align: '',
					direction: 'rtl',
					useHTML: true,
					style: {
						fontFamily: persianFont
					}
				}
			},
			legend: {
				enabled: hasMultipleAggregationSeries,
				layout: 'horizontal',
				align: 'center',
				verticalAlign: 'bottom',
				itemStyle: {
					fontFamily: persianFont
				}
			},
			tooltip: {
				shared: hasMultipleAggregationSeries && !isMatrixChart,
				style: {
					fontFamily: persianFont
				},
				formatter: function() {
					var matrixTooltip = resolveMatrixTooltip(this);
					if (matrixTooltip) {
						return matrixTooltip;
					}

					var sharedTooltip = resolveSharedTooltip(this);
					if (sharedTooltip) {
						return sharedTooltip;
					}

					var standardTooltip = resolveStandardTooltip(this);
					if (standardTooltip && typeof standardTooltip === 'string' && standardTooltip.trim() !== '') {
						return standardTooltip;
					}

					// Fallback to numeric value from the point if structured tooltip cannot be resolved
					var numericFallback = buildNumericFallbackTooltip(this);
					if (numericFallback && numericFallback.trim() !== '') {
						return numericFallback;
					}

					return tooltipFormatterItem('', window.tetaI18n ? window.tetaI18n.t('No Record') : '');
				},
				useHTML: true
			},
			yAxis: {
				@if (hr.YAxisIsTimespan)
				{
					<text>
				labels: {
					formatter: function() {
						return window.TimeSpanManager.toDisplayText(this.value, { displayMilliseconds: false });
					},
					style: {
						fontFamily: persianFont
					}
				},
					</text>
				}
				@if (!hr.YAxisIsTimespan)
				{
					<text>
				labels: {
					style: {
						fontFamily: persianFont
					}
				},
					</text>
				}
				title: {
					text: @hr.GetYAxisName(),
					style: {
						fontFamily: persianFont
					}
				}
			},
			colors: ['#6366f1', '#fe6a35', '#eeca34', '#06aed4', '#2b72fb' ,'#058DC7', '#50B432', '#ED561B', '#DDDF00', '#24CBE5', '#64E572', '#FF9655', '#FFF263', '#6AF9C4'],
			series: renderedSeries,
			plotOptions: {
				series: {
					cursor: subReportsCount ? 'pointer' : 'default',
					stacking: stackingMode || undefined,
					marker: {
						enabled: markersEnabled
					},
					dataLabels: {
						enabled: autoDataLabels,
						style: {
							fontFamily: persianFont
						},
						formatter: function() {
							if (!autoDataLabels) {
								return null;
							}
							if (stackingMode === 'percent' && typeof this.percentage !== 'undefined') {
								return Highcharts.numberFormat(this.percentage, 0) + '%';
							}
							var valueText = Highcharts.numberFormat(this.y, 0);
							if (hasMultipleAggregationSeries) {
								return this.series.name + ': ' + valueText;
							}
							return valueText;
						}
					},
					point: {
						events: {
							click: function(event) {
								openMasterDetail(this, event);
							}
						}
					}
				},
				column: {
					colorByPoint: stackingMode ? false : !hasMultipleAggregationSeries
				}
			}
		});
	})();
</script>
