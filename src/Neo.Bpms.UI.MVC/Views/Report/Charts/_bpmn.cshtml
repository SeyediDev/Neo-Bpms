@using Microsoft.AspNetCore.Html
@using Neo.Bpms.Domain.Entities.Cmmn
@using Neo.Bpms.Domain.Entities.Cmmn.UI
@using Neo.Bpms.Domain.Model.Project
@using Neo.Bpms.Domain.Model.UI
@using Neo.Bpms.Domain.Models.Cmmn
@using Neo.Bpms.Domain.Models.Cmmn.Fields
@using Neo.Bpms.Infrastructure.Features.Cmmn.Reports
@using Neo.Bpms.UI.MVC.Controls
@using Neo.Bpms.UI.MVC.PartialModels
@using Neo.Bpms.UI.MVC.PartialModels.Report
@using Newtonsoft.Json

@model ReportData
@{
	var calendar = ProjectDefinition.Project.DefaultCalendar;
	var reportInfo = Model;
	var canDesign = ViewBag.CanDesign ?? false;
	var isDrillDown = ViewBag.DrillDown ?? false;
	var reportKey = reportInfo.Structure.ConfigId;
	var bFromDashboard = ViewBag.bFromDashboard ?? false;
	var drilldownSubReports = reportInfo.Structure.SubReports.Where(sr => sr.Type == Report.SubReportType.DrillDown).ToList();

	var process = Model.Structure.FilterValues.GetString("Process");
	if (string.IsNullOrEmpty(process))
	{
		//throw new Exception("Bpmn diagram needs WorkflowId in its filter.");
	}
	var processVersion = Model.Structure.FilterValues.GetString("ProcessVersion");
}

<link rel="stylesheet" href="~/Content/common-assets-includes/features/design/bpmn/css/diagram-js.css"/>
<link rel="stylesheet" href="~/Content/common-assets-includes/features/design/bpmn/vendor/bpmn-font/css/bpmn-embedded.css"/>
<link rel="stylesheet" href="~/Content/common-assets-includes/features/report/bpmn-diagram/app.css"/>

@if (canDesign && !bFromDashboard && !isDrillDown && Model.Config.IsSubReport)
{
	<partial name="~/Views/Report/Helpers/RenderDesignTools.cshtml" model="new RenderDesignToolsModel {report = Model, forInlineSubReport = true}"/>
}

@{
	var parameters = reportInfo.Structure.SelectedColumns.Where(s =>
		//s.aggrType != eAggregationFunctions.InColumn &&
		s.aggrType != eAggregationFunctions.GroupByItem &&
		s.ColumnName != "FlowNodeId").Select(sc => new
		{
			id = sc.ColumnTypeName, //todo correct?
			name = sc.Alias,
			type = sc.FieldType == TVariableTypes.DayHourMinute ? /*"duration-ms"*/ "duration-time-span" : ""
		});
	var data = reportInfo.Rows.Select(r => new
	{
		id = r.Data["Ids"],
		parameters = reportInfo.Structure.SelectedColumns.Where(s =>
			s.aggrType != eAggregationFunctions.GroupByItem &&
			s.ColumnName != "FlowNodeId").Select(columnInfo => new
			{
				id = columnInfo.ColumnTypeName,
				value = r.Data.GetDouble(columnInfo.ColumnTypeName)
			})
	});
}

<div class="canvas" id="teta-canvas" style="height: 70vh; direction: ltr;">
</div>
<script src="~/Scripts/common-assets-includes/features/report/bpmn-diagram/index.min.js"></script>
<script>
	var downloadUrl = window.top.rootUrl +
		'Process/DownloadProcessVersion?processId=@process&@(string.IsNullOrEmpty(processVersion) ? "" : "versionId=" + processVersion)';
	$.get(downloadUrl,
		function(result) {
			window.TetaBpmnModule.showCharts({
				xml: result.xml,
				containerSelector: '#teta-canvas',
				type: 'bars',
				data: @(new HtmlString(JsonConvert.SerializeObject(data))),
				parameters: @(new HtmlString(JsonConvert.SerializeObject(parameters)))
			});
		});
</script>

<partial name="~/Views/Report/Helpers/WindowTopJs.cshtml" model="new WindowTopJsModel {drillDownSubReports = drilldownSubReports, reportKey = reportKey, reportInfo = reportInfo, filterValues = ViewBag.FilterValues as ElasticObject}"/>


<script>
	var diagramData = {};
	var diagramInfo = {};

	@{
		//var heatColumn = reportInfo.structure.SelectedColumns.FirstOrDefault(s => s.aggrType != eAggregationFunctions.GroupByItem && s.aggrType != eAggregationFunctions.InColumn);
		var nodeIdColumn = reportInfo.Structure.SelectedColumns.FirstOrDefault(s => s.aggrType != eAggregationFunctions.GroupByItem && s.aggrType == eAggregationFunctions.InColumn && s.ColumnName == "FlowNodeId");
		var subReportsCount = reportInfo.Structure.SubReports.Count(sr => sr.Type == Report.SubReportType.DrillDown);
	}
	var subReportsCount = @subReportsCount;
	var reportKey = "@reportKey";

	@foreach (var row in reportInfo.Rows)
	{
		var nodeId = row.Data[nodeIdColumn != null ? nodeIdColumn.ColumnTypeName : "FlowNodeId"];
		if (nodeId == null || string.IsNullOrEmpty(nodeId.ToString()))
		{
			continue;
		}
		var rowIds = row.Data.GetString("Ids").Split(',')[0];
		double colorValue = 0;

		//if (colorColumn != null)
		//{
		//    colorValue = row.Data.GetDouble(colorColumn.ColumnTypeName);
		//}
		var str = "diagramData['" + nodeId + "']=" + colorValue + ";\n";
		str += "diagramInfo['" + nodeId + "']={};\n";
		str += "diagramInfo['" + nodeId + "']['ids']='" + rowIds + "';\n";
		str += "diagramInfo['" + nodeId + "']['tooltipValues']={};\n";
		var columns = reportInfo.Structure.SelectedColumns.Where(s =>
			//s.aggrType != eAggregationFunctions.InColumn &&
			s.aggrType != eAggregationFunctions.GroupByItem &&
			s.ColumnName != "Iso2");
		foreach (var colInfo in columns)
		{
			var value = ReportRenderer.GetCelValue(colInfo, row);
			var val = TableHelper.CreateCellElement(value, colInfo, calendar);
			str += "diagramInfo['" + nodeId + "']['tooltipValues']['" + colInfo.Alias + "'] = '" + val + "';";
		}
		@(new HtmlString(str))
	}

	//todo read mapMarkers from diagramInfo


	var showTip = function(event, label, code) {
		var countryName = $(label).text();
		if (!code) {
			code = countryName;
		}

		$(label).empty();
		$(label).css('min-width', '200px');
		$(label)
			.append($("<span/>",
				{
					'html': countryName,
					'style':
						' font-size: 1.5em; margin-top:3px; float: ' +
							+
							'; color: #FFFADC'
				}));
		if (!!diagramInfo[code]) {
			var tooltipsObj = diagramInfo[code]["tooltipValues"];
			$(label).append($("<hr/>", { 'style': 'margin: 3px 0;' }));
			for (var field in tooltipsObj) {
				if (tooltipsObj.hasOwnProperty(field)) {
					$(label)
						.append($("<span/>",
							{
								'html': field +
									' : ' +
									'<span style="color: #f7eeb9;">' +
									tooltipsObj[field] +
									'</span>',
								'class': 'teta-bidi'
							}));
					$(label).append($("<br/>"));
				}
			}
		}
	};

	var showMarkerTip = function(event, label, code) {
		showTip(event, label, mapMarkers[code].code);
	}

	var showDrillDown = function(event, code, docObj) {
	}

	var showMarkerDrillDown = function(event, code) {
		showDrillDown(event, mapMarkers[code].code, this);
	}
</script>
<partial name="~/Views/Report/Helpers/PartialsCommon.cshtml" model="new PartialsCommonModel {reportInfo = Model}"/>