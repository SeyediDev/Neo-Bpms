@using System.Text.Encodings.Web
@using Neo.Bpms.Domain.Entities.Cmmn
@using Neo.Bpms.Domain.Models.Cmmn.UI.ConfiguredItems
@using Neo.Bpms.Domain.Models.Cmmn.UI.Components
@using Neo.Bpms.Domain.Models.Cmmn.UI.Reports
@using Neo.Bpms.Infrastructure.Features.Cmmn.Reports
@using Neo.Bpms.UI.MVC.PartialModels.Report
@model ChartScriptModel

@{
    var idx = Model.Idx;
    var reportInfo = Model.ReportInfo;
    var structure = Model.Structure;
    var metricValue = reportInfo.GetMetricBoxValue();
    var widget = ViewBag.CurrentWidget as ConfiguredDashboard.ConfigWidget;
    var iconClass = structure.GetReportProperty((long)ReportConfigProperty.IconClass);
    if (string.IsNullOrWhiteSpace(iconClass))
    {
        iconClass = widget?.GetPropertyValue(eControlPropertyId.IconClass);
    }
    iconClass ??= "fal fa-info-circle";
    var backgroundColor = structure.GetReportProperty((long)ReportConfigProperty.BackgroundColor);
    if (string.IsNullOrWhiteSpace(backgroundColor))
    {
        backgroundColor = widget?.GetPropertyValue(eControlPropertyId.BackgroundColor);
    }
    backgroundColor ??= "#2563EB";
    var textsColor = structure.GetReportProperty((long)ReportConfigProperty.TextColor);
    if (string.IsNullOrWhiteSpace(textsColor))
    {
        textsColor = widget?.GetPropertyValue(eControlPropertyId.Color);
    }
    textsColor ??= "#ffffff";
    var metricTitle = structure?.Name;
    var encodedIconClass = JavaScriptEncoder.Default.Encode(iconClass);
    var encodedMetricTitle = JavaScriptEncoder.Default.Encode(metricTitle ?? string.Empty);
}

<script type="text/javascript">
	window.NeoMetrics.create('#container_@(idx)',
		{
			iconClass: '@encodedIconClass',
			value: '@metricValue',
			title: '@encodedMetricTitle',
			backgroundColor: '@backgroundColor',
			textsColor: '@textsColor'
		});
</script>
