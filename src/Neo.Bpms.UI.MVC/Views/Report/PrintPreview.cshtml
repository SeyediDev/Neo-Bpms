@using Neo.Bpms.Domain.Entities.Cmmn.UI
@using Neo.Bpms.Domain.Model.UI
@using Neo.Bpms.Domain.Models.Cmmn.UI.Reports
@using Neo.Bpms.UI.MVC.Helpers
@using Neo.Bpms.UI.Resources.Resources
@model ReportData
@{
	 var structure = Model.Structure;
	 Layout = null;
	 ViewBag.IsPrintPreview = true;
}
<!DOCTYPE html>
<html mozNoMarginBoxes>
<head>
	 <meta name="viewport" content="width=device-width" />
	 <title>@ViewTexts.PrintPreview @Model.Structure.Name</title>
	 <link href="~/Content/common-assets-includes/common-plugins/global/print/print.css" rel="stylesheet" />
	 <link rel="stylesheet" href="~/Content/common-assets-includes/fonts/pfont/yekan-persian-digits.css">
	 <style type="text/css" media="print">
		 @@page {
			size: auto; /* auto is the initial value */
			margin: 0; /* this affects the margin in the printer settings */
		 }

		 html {
			background-color: #FFFFFF;
			margin: 0px; /* this affects the margin on the HTML before sending to printer */
		 }
	 </style>
</head>

<body>
	 @if (Model != null)
	 {
		  switch (structure.ReportViewType)
		  {
				case ReportViewType.Chart:
				<script src="@CommonBundles.JqueryAloneJsBundle" asp-append-version="true"></script>
				 if (structure.ChartType == ChartType.IranMap)
				 {
	 	 	 	 	 @Html.Partial("~/Views/Report/Map/_IranMap.cshtml", Model)
				 }
				 else if (structure.ChartType == ChartType.WorldMap)
				 {
	 	 	 	 	 @Html.Partial("~/Views/Report/Map/_WorldMap.cshtml", Model)
				 }
			else
			{
	 	 	 <div style="direction: ltr !important;">
	 	 	 	 @Html.Partial("~/Views/Report/Charts/_chartView.cshtml", Model)
	 	 </div>
	}
	break;
default:
@Html.Partial("~/Views/Report/ListView/_printPreviewListView.cshtml", Model)
break;
}
}
</body>
</html>
