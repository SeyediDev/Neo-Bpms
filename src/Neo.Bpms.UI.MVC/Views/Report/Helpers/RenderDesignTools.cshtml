@using Neo.Bpms.Domain.Entities.Cmmn.UI
@using Neo.Bpms.Domain.Model.UI
@using Neo.Bpms.UI.Resources.Resources
@using Neo.Common.Extensions
@model Neo.Bpms.UI.MVC.PartialModels.Report.RenderDesignToolsModel
@{
	var structure = Model.report.structure;

	if (Model.forInlineSubReport)
	{
		@:<div class="inline-sub-design hidden">
	}
	<div class="dropdown inline-dropdown
		  @(Model.forInlineSubReport ? "inline-sub-design hidden" : "")">
		<a title="@ViewTexts.Settings" href="#" id="design-menu" onclick="toggleDesignSettings(event); return false;"
           class="top-bar-anchor-icon text-success icons-tables">
             <svg   style="width: 16px;height: 16px;vertical-align: middle;" viewBox="0 0 16 16">
                <use xlink:href="/Content/common-assets-includes/icons/svgSprite.svg#setting-blue" />
             </svg>
		</a>
	</div>
	if (Model.forInlineSubReport)
	{
		@:</div>
	}
}