@using Neo.Bpms.Infrastructure.Features.Cmmn.Reports
@using Neo.Bpms.Domain.Models.Cmmn.UI.Reports
@model ReportData

@{
	var drilldownSubReports = Model.Structure.SubReports.Where(sr => sr.Type == Report.SubReportType.DrillDown).ToList();
}

<div class="map-report-container">
	<div class="map-left-panel">
		@if (Model.Structure.ChartType == ChartType.IranMap || Model.Structure.ChartType == ChartType.WorldMap)
		{
			var tableTitle = Model.Structure.ChartType == ChartType.IranMap ? "جدول استان‌ها" : "جدول کشورها";
			<button id="map-toggle-panel-btn" class="map-toggle-panel-btn" title="نمایش/مخفی کردن @tableTitle">
				<span id="map-toggle-panel-icon">◀</span> @tableTitle
			</button>
		}
		<div id="map-info-panel-top" class="map-info-panel-top">
			<h4>@(Model.Structure.ChartType == ChartType.IranMap ? "اطلاعات استان انتخاب شده" : "اطلاعات کشور انتخاب شده")</h4>
			<div id="map-info-content-top"></div>
		</div>
		<div id="world-map" class="world-map-container">
		</div>
	</div>
	<div id="map-right-panel" class="map-right-panel">
		<div id="map-data-table" class="map-data-table">
			<div class="map-table-search">
				<input type="text" id="map-table-search-input" placeholder="جستجو در جدول..." />
				@if ((Model.Structure.ChartType == ChartType.IranMap || Model.Structure.ChartType == ChartType.WorldMap) && drilldownSubReports.Count > 0)
				{
					<div style="margin-top: 8px; font-size: 11px; color: #6c757d; text-align: center;">
						💡 برای مشاهده گزارش زیرمجموعه: دوبار کلیک روی ردیف
					</div>
				}
			</div>
			<table>
				<thead>
					<tr id="map-table-header"></tr>
				</thead>
				<tbody id="map-table-body"></tbody>
			</table>
			<div id="map-table-stats" class="map-table-stats"></div>
		</div>
	</div>
</div>

<div id="map-drilldown-overlay" class="map-drilldown-overlay"></div>
<div id="map-drilldown-panel" class="map-drilldown-panel">
	<div class="map-drilldown-header">
		<h3 id="map-drilldown-title">گزارش زیرمجموعه</h3>
		<button class="map-drilldown-close" onclick="closeMapDrillDown()">×</button>
	</div>
	<div class="map-drilldown-content" id="map-drilldown-content">
		<div style="text-align: center; padding: 40px; color: #6c757d;">
			<div style="font-size: 48px; margin-bottom: 20px;">⏳</div>
			<div>در حال بارگذاری...</div>
		</div>
	</div>
</div>

<div class="map-debug-panel collapsed" id="map-debug-panel">
	<div class="map-debug-header">
		<span>🛠️ اطلاعات دیباگ نقشه</span>
		<div>
			<button type="button" id="map-debug-toggle">نمایش/مخفی</button>
			<button type="button" id="map-debug-copy">کپی</button>
		</div>
	</div>
	<pre id="map-debug-output">در انتظار بارگذاری...</pre>
</div>

