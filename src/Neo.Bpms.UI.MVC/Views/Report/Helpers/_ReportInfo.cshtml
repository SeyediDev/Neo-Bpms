@*
    Partial view for Report Info functionality
    Contains JavaScript functions and CSS for report information tooltip
*@
;
@using Neo.Bpms.Domain.Models.Cmmn.UI.Reports

@* JavaScript functions are now in Report.js *@

<style>
    .report-info-panel {
        position: fixed !important;
        background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%) !important;
        border: 2px solid #e2e8f0 !important;
        border-radius: 12px !important;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15) !important;
        padding: 16px !important;
        z-index: 10000 !important;
        min-width: 280px !important;
        max-width: 320px !important;
        backdrop-filter: blur(10px) !important;
        animation: slideDown 0.3s ease-out !important;
        display: none !important;
        flex-direction: column !important;
        gap: 8px !important;
    }

    .report-info-panel.show {
        display: flex !important;
    }

    .report-info-item {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 4px 0;
    }

    .report-info-icon {
        font-size: 16px;
        width: 20px;
        text-align: center;
    }

    .report-info-label {
        font-weight: 600;
        color: #374151;
        min-width: 80px;
    }

    .report-info-value {
        color: #6b7280;
        font-weight: 500;
    }

    @@keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* آیکن اطلاعات گزارش - رنگ سبز */
    .top-page .icons a.text-success {
        color: #28a745 !important;
    }

    .top-page .icons a.text-success:hover {
        color: #19692c !important;
    }
</style>

@using Neo.Bpms.Domain.Entities.Cmmn
@using Neo.Bpms.Domain.Entities.Cmmn.UI
@using Neo.Bpms.UI.MVC.Controllers
@using Neo.Bpms.UI.Resources.Resources

@inject ControllerMethods controllerMethods;
@inject ReportFilterName reportFilterName;

@model ReportData
@{
    var structure = Model.Structure;
    var modalKey = structure.ConfigId;
    var calendar = ProjectDefinition.Project.DefaultCalendar;
}
<!-- پنل اطلاعات گزارش (مخفی) -->
<div class="report-info-panel" id="reportInfoPanel">
    <div class="report-info-item">
        <span class="report-info-icon">📅</span>
        <span class="report-info-label">@ViewTexts.ReportingDate:</span>
        <span class="report-info-value">
            @{
                DateTime dt = DateTime.Now;
                var dStr = "";
                if (dt.Year > 1900)
                {
                    if (calendar == "shamsi")
                    {
                        var pc = new PersianCalendar();
                        dStr = pc.GetYear(dt).ToString() + '/' + pc.GetMonth(dt) + '/' + pc.GetDayOfMonth(dt);
                    }
                    else
                    {
                        dStr = dt.Year.ToString() + '/' + dt.Month + '/' + dt.Day;
                    }
                }
            }
            @dStr
        </span>
    </div>
    <div class="report-info-item">
        <span class="report-info-icon">🕐</span>
        <span class="report-info-label">@ViewTexts.ReportingTime:</span>
        <span class="report-info-value">
            @{
                var tStr = dt.Hour.ToString() + ':' + dt.Minute;
            }
            @tStr
        </span>
    </div>
    <div class="report-info-item">
        <span class="report-info-icon">⚡</span>
        <span class="report-info-label">@ViewTexts.QueryTime:</span>
        <span class="report-info-value">
            @{
                var qTime = Model.QueryInfo.QueryTime;
                qTime = Convert.ToInt32(qTime / 10000) * 10000;
                var t = TimeSpan.FromTicks(qTime);
                var sec = t.TotalSeconds;
            }
            @sec @ViewTexts.Seconds
        </span>
    </div>
    @{
        var filterText = await reportFilterName.GetConfigFilterNames(structure.NamespaceId,
        structure.EntityId, structure.Form_ReportId, structure.ConfigId,
        structure.FilterValues, structure.ParentReportIds, structure.CombosData,
        controllerMethods.DecodeFilterValues(ViewBag.ParentFilterValues), structure.Fields,
        ViewBag.User, CultureHelper.GetCurrentNeutralCulture());
        if (!string.IsNullOrEmpty(filterText))
        {
            <div class="report-info-item">
                <span class="report-info-icon">🔍</span>
                <span class="report-info-label">@ViewTexts.Filter:</span>
                <span class="report-info-value">@filterText</span>
            </div>
        }
        @if (Model.Structure.ReportViewType == ReportViewType.GroupByList)
        {
            var groupByNames = ReportController.GetGroupBys(structure);
            <div class="report-info-item">
                <span class="report-info-icon">🔢</span>
                <span class="report-info-label">@ViewTexts.OrderedBy:</span>
                <span class="report-info-value">
                    @for (var i = 0; i < groupByNames.Count; i++)
                    {
                        if (i != 0)
                        {
                            <span> - </span>
                        }


                        @groupByNames[i].Alias
                        var orderType = "(" + (groupByNames[i].Descending ? ViewTexts.Descending : ViewTexts.Ascending) + ")";
                        @orderType
                    }
                </span>
            </div>
        }
    }
</div>
