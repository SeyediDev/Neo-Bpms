@using Neo.Bpms.UI.MVC.PartialModels.Report
@using Neo.Bpms.UI.MVC.PartialModels.Filter

@inject IControlsRenderer controlsRenderer;

@model ReportData

@{
    var structure = Model.Structure;
    var options = new RendererOptions
    {
        IsFilter = true
    };
    ControlsRendererData controlsRendererData = new(structure, ViewBag.FilterValues, options, ViewBag.user, Url);
}

@if (structure.Fields != null && structure.Fields.Count > 0)
{
    <!-- Filter Tooltip Panel -->
    <div id="filterTooltipPanel" class="filter-tooltip-panel" style="display: none;">
        <!-- Popular Filters Section -->
        <div class="popular-filters-section" style="margin-bottom: 20px; padding-bottom: 20px; border-bottom: 1px solid #e2e8f0;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 style="margin: 0; font-weight: 600; color: #2d3748;">@ViewTexts.UsefulFilters</h6>
                <button type="button" class="btn btn-sm btn-outline-primary" onclick="FilterTreeManager.newFolder()" title="@ViewTexts.AddFolder">
                    <i class="fa fa-folder-plus"></i> @ViewTexts.AddFolder
                </button>
            </div>
            <div class="search-box mb-3">
                <div class="input-group">
                    <div class="input-group-prepend">
                        <span class="input-group-text"><i class="fa fa-search"></i></span>
                    </div>
                    <input type="text" class="form-control" id="popular-filters-search-input" placeholder="@ViewTexts.Search" />
                </div>
            </div>
            <div id="popular-filters-tree" class="report-tree-container" style="min-height: 200px; max-height: 300px; overflow-y: auto;"></div>
        </div>
        
        <!-- Main Filter Controls -->
        <div class="modern-filter-content">
            @{
                var htmlInputStr = controlsRenderer.Render(controlsRendererData);
            }
            @htmlInputStr
        </div>
        <div class="modern-filter-buttons">
            <partial name="Common/FilterEraseButton" />
            @if (ViewBag.ScheduledId != null && ViewBag.ScheduledId > 0)
            {
                <button type="button" onclick="ScheduledReport.saveFilterValues(@(ViewBag.ScheduledId ?? 0));" class="btn btn-outline-warning">
                    <span>@ViewTexts.SaveScheduleFilter @(ViewBag.ScheduledName ?? "")</span>
                </button>
            }
            <partial name="Filter/FilterSaveButtons" model="new FilterSaveButtonsModel{filterId = ViewBag.FilterId, filterName = ViewBag.FilterName}" />
            <partial name="Filter/ApplyButton" />
            <input type="submit" id="submitBtn" value="" style="display:none; position:absolute; left:-9999px;" aria-hidden="true" />
        </div>
    </div>

    <style>
        /* ===== Filter Tooltip Panel ===== */
        .filter-tooltip-panel {
          position: fixed !important;
          background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%) !important;
          border: 2px solid #e2e8f0 !important;
          border-radius: 12px !important;
          box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15) !important;
          padding: 20px !important;
          z-index: 10000 !important;
          min-width: 600px !important;
          width: 95% !important;
          backdrop-filter: blur(10px) !important;
          animation: slideDown 0.3s ease-out !important;
          display: none !important;
          flex-direction: column !important;
          gap: 16px !important;
        }

        .filter-tooltip-panel.show {
          display: flex !important;
        }

        .filter-tooltip-panel .modern-form {
          display: block !important;
          margin: 0 !important;
          padding: 0 !important;
        }

        .filter-tooltip-panel .modern-filter-wrapper {
          margin-bottom: 16px !important;
        }

        .filter-tooltip-panel .modern-filter-buttons {
          display: flex !important;
          gap: 8px !important;
          justify-content: flex-end !important;
          margin-top: 16px !important;
          padding-top: 16px !important;
          border-top: 1px solid #e2e8f0 !important;
        }

        .filter-tooltip-panel .btn {
          padding: 8px 16px !important;
          font-size: 14px !important;
          border-radius: 6px !important;
          transition: all 0.2s ease !important;
        }

        .filter-tooltip-panel .btn:hover {
          transform: translateY(-1px) !important;
          box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1) !important;
        }
        
        .filter-tooltip-panel .btn-primary {
          background-color: #3b82f6 !important;
          border-color: #3b82f6 !important;
          color: #ffffff !important;
        }
        
        .filter-tooltip-panel .btn-primary:hover {
          background-color: #2563eb !important;
          border-color: #2563eb !important;
          color: #ffffff !important;
        }
        
        .filter-tooltip-panel .btn-outline-warning {
          color: #f59e0b !important;
          border-color: #f59e0b !important;
          background-color: transparent !important;
        }
        
        .filter-tooltip-panel .btn-outline-warning:hover {
          background-color: #f59e0b !important;
          color: #ffffff !important;
        }
    </style>

    <script>
        // Filter Tooltip Functions
        function toggleFilterTooltip(event) {
            console.log('toggleFilterTooltip called');
            event.preventDefault();
            event.stopPropagation();

            const panel = document.getElementById('filterTooltipPanel');
            const toggle = event.target.closest('a');
            
            console.log('Panel found:', !!panel);
            console.log('Toggle found:', !!toggle);

            if (panel && toggle) {
                // Hide all other tooltips first
                const allPanels = document.querySelectorAll('.filter-tooltip-panel');
                allPanels.forEach(p => {
                    if (p !== panel) {
                        p.classList.remove('show');
                    }
                });

                // Toggle current panel
                if (!panel.classList.contains('show')) {
                    console.log('Showing filter tooltip');
                    panel.classList.add('show');
                    toggle.classList.add('active');
                    
                    // Position tooltip below the filter icon
                    const toggleRect = toggle.getBoundingClientRect();
                    panel.style.position = 'fixed';
                    panel.style.top = (toggleRect.bottom + 8) + 'px';
                    panel.style.left = toggleRect.left + 'px';
                    panel.style.right = 'auto';
                    panel.style.transform = 'none';
                    panel.style.zIndex = '10000';
                    
                    // Adjust if goes off-screen horizontally
                    const panelWidth = Math.min(800, window.innerWidth * 0.95);
                    const rightEdge = toggleRect.left + panelWidth;
                    if (rightEdge > window.innerWidth) {
                        panel.style.left = (window.innerWidth - panelWidth - 16) + 'px';
                    }
                    
                    // Adjust if goes off-screen vertically
                    const panelHeight = 400; // estimated height
                    const bottomEdge = toggleRect.bottom + 8 + panelHeight;
                    if (bottomEdge > window.innerHeight) {
                        panel.style.top = (toggleRect.top - panelHeight - 8) + 'px';
                    }
                    
                    console.log('Filter tooltip shown');
                    
                    // Initialize popular filters tree
                    initializePopularFiltersTree();
                    
                    // Initialize multi-select after showing tooltip
                    initializeMultiSelectInTooltip();
                } else {
                    console.log('Hiding filter tooltip');
                    panel.classList.remove('show');
                    toggle.classList.remove('active');
                    console.log('Filter tooltip hidden');
                }
            } else {
                console.error('Panel or toggle not found');
            }
        }

        // Close tooltip when clicking outside
        document.addEventListener('click', function(e) {
            if (!e.target.closest('[onclick*="toggleFilterTooltip"]') && !e.target.closest('#filterTooltipPanel')) {
                const panel = document.getElementById('filterTooltipPanel');
                const toggle = document.querySelector('[onclick*="toggleFilterTooltip"]');
                if (panel && panel.classList.contains('show')) {
                    panel.classList.remove('show');
                    if (toggle) {
                        toggle.classList.remove('active');
                    }
                    console.log('Filter tooltip hidden by outside click');
                }
            }
        });
        
        // Function to collect all filter values for reports
        function collectReportFilterValues() {
            const filterForm = document.getElementById('filter-form');
            if (!filterForm) return;
            
            console.log('Report Tooltip: Collecting filter values...');
            
            // Find all filter inputs (including hidden ones)
            const allFilterInputs = document.querySelectorAll('#filterTooltipPanel input, #filterTooltipPanel select, #filterTooltipPanel textarea');
            
            allFilterInputs.forEach(function(input) {
                // Ensure input is associated with form
                input.setAttribute('form', 'filter-form');
                
                // For hidden inputs or inputs with special handling
                if (input.type === 'hidden' || input.style.display === 'none') {
                    console.log('Report Tooltip: Found hidden input:', input.name, '=', input.value);
                } else {
                    console.log('Report Tooltip: Found visible input:', input.name, '=', input.value);
                }
                
                // For select elements, ensure values are properly set
                if (input.tagName === 'SELECT') {
                    const selectedOptions = Array.from(input.selectedOptions).map(option => option.value);
                    console.log('Report Tooltip: Select values for', input.name, ':', selectedOptions);
                }
            });
            
            // Also check for any dynamically created inputs
            const dynamicInputs = document.querySelectorAll('input[name*="FilterParameter"], input[name*="[]"]');
            dynamicInputs.forEach(function(input) {
                if (!input.getAttribute('form')) {
                    input.setAttribute('form', 'filter-form');
                    console.log('Report Tooltip: Associated dynamic input:', input.name, '=', input.value);
                }
            });
        }

        // Submit filter function for report tooltip
        function submitReportFilter() {
            console.log('Report Tooltip: Submitting filter...');

            // Collect all filter values and ensure they're properly associated
            collectReportFilterValues();

            // Hide the tooltip first
            const panel = document.getElementById('filterTooltipPanel');
            const toggle = document.querySelector('[onclick*="toggleFilterTooltip"]');
            if (panel && panel.classList.contains('show')) {
                panel.classList.remove('show');
                if (toggle) {
                    toggle.classList.remove('active');
                }
            }

            // Submit the form
            const form = document.getElementById('filter-form');
            if (form) {
                console.log('Report Tooltip: Submitting form with filter values...');
                form.submit();
            } else {
                console.error('Report Tooltip: Filter form not found');
            }
        }
        
        // Make it globally available for report pages
        window.submitFilter = submitReportFilter;
        
        // Initialize popular filters tree
        function initializePopularFiltersTree() {
            var $popularFiltersTree = $('#popular-filters-tree');
            if ($popularFiltersTree.length && !$popularFiltersTree.data('initialized')) {
                if (typeof window.filtersTree !== 'undefined') {
                    $popularFiltersTree.jstree({
                        'core': {
                            'data': window.filtersTree,
                            "check_callback": true
                        },
                        "contextmenu": {
                            "select_node": false,
                            'items': function(node) {
                                if (typeof FilterTreeManager !== 'undefined' && FilterTreeManager.getContextMenu) {
                                    return FilterTreeManager.getContextMenu(node);
                                }
                                return {};
                            }
                        },
                        "types": {
                            "default": {
                                "icon": (window.top && window.top.rootUrl ? window.top.rootUrl : '') + "Content/common-assets-includes/icons/folder.svg",
                                "valid_children": ["default", "filter"]
                            },
                            "filter": {
                                "icon": "fa fa-filter",
                                "valid_children": []
                            }
                        },
                        "conditionalselect": function (node, event) {
                            if (node.type === 'default')
                                return true;
                            if (typeof FilterConfig !== 'undefined' && FilterConfig.navigateTo) {
                                FilterConfig.navigateTo(node.data.filterId);
                            }
                            return false;
                        },
                        "plugins": ["dnd", "contextmenu", "types", "conditionalselect", "wholerow", "search", "state"]
                    });
                    
                    $('#popular-filters-search-input').off('keyup').on('keyup', function() {
                        $popularFiltersTree.jstree('search', $(this).val());
                    });
                    
                    $popularFiltersTree.data('initialized', true);
                }
            }
        }
        
        // Initialize multi-select when tooltip is shown
        function initializeMultiSelectInTooltip() {
            console.log('Initializing multi-select in tooltip...');
            
            // Wait a bit for DOM to be ready
            setTimeout(function() {
                // Ensure all filter inputs are associated with the form
                const filterForm = document.getElementById('filter-form');
                if (filterForm) {
                    const filterInputs = document.querySelectorAll('#filterTooltipPanel input, #filterTooltipPanel select, #filterTooltipPanel textarea');
                    filterInputs.forEach(function(input) {
                        input.setAttribute('form', 'filter-form');
                        console.log('Associated input with form:', input.name || input.id);
                    });
                }
                
                // Check if modern multi-select is available
                if (typeof window.initializeReportModernMultiSelect === 'function') {
                    console.log('Calling initializeReportModernMultiSelect...');
                    window.initializeReportModernMultiSelect();
                } else {
                    console.log('initializeReportModernMultiSelect not available');
                }
            }, 100);
        }
    </script>
}
