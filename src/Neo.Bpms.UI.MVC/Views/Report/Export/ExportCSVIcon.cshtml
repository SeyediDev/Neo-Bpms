@using Neo.Bpms.UI.Resources.Resources
@model             ReportStructure
<a class="top-bar-anchor-icon icons-tables" title="@ViewTexts.CSVExport" href="#" role="button" onclick="exportExcel()">
    <svg style="width: 16px;height: 16px;vertical-align: middle;" viewBox="0 0 16 16">
        <use xlink:href="/Content/common-assets-includes/icons/svgSprite.svg#csv-document-blue" />
    </svg>
</a>
<script>
	function exportCSV() {
		window.location = window.top.rootUrl +
			'Report/ExportToCSV?' +
			$('#filter-form').serialize() +
			'&NamespaceId=@Model.NamespaceId' +
			'&EntityId=@Model.EntityId' +
			'&ReportId=@Model.Form_ReportId' +
			'&ConfigId=@Model.ConfigId';
	}
</script>