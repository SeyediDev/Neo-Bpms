@using System.Globalization;
@using System.Text.Encodings.Web;
@using Neo.Bpms.Domain.Entities.Cmmn
@using Neo.Bpms.Domain.Entities.Cmmn.UI

@using Neo.Bpms.Domain.Model.Project
@using Neo.Bpms.Domain.Model.UI;
@using Neo.Bpms.Domain.Models.Cmmn
@using Neo.Bpms.Domain.Models.Cmmn.UI.Components
@using Neo.Bpms.Domain.Models.Cmmn.UI.ConfiguredItems;
@using Neo.Bpms.Domain.Models.Cmmn.UI.Reports
@using Neo.Bpms.Infrastructure.Features.Cmmn.Reports
@using Neo.Bpms.UI.MVC.Controllers
@using Neo.Bpms.UI.MVC.Controls
@using Neo.Bpms.UI.MVC.Helpers
@using Neo.Bpms.UI.MVC.PartialModels
@using Neo.Bpms.UI.MVC.PartialModels.Report
@inject ReportConfigBackupRestore reportConfigBackupRestore;
@inject ReportFilterName reportFilterName;
@inject ControllerMethods controllerMethods;


@model ReportData

@{

    void RenderChartTypeOption(ChartType chartType, ChartType selectedChartType)
    {
        //var editorBug = ":(";
        <!option value="@chartType" @(selectedChartType == chartType ? "selected=\" selected\"" : "" )>
            @chartType
        </!option>
    }

    Func<dynamic, HelperResult> RenderChartTypeSelector =
    @<select class="form-control" name="SelectedChartType" onchange="this.form.submit()">
	    @{
                RenderChartTypeOption(ChartType.Area, item.Structure.ChartType);
                RenderChartTypeOption(ChartType.Bar, item.Structure.ChartType);
                RenderChartTypeOption(ChartType.Column, item.Structure.ChartType);
                RenderChartTypeOption(ChartType.Line, item.Structure.ChartType);
                RenderChartTypeOption(ChartType.Pie, item.Structure.ChartType);
                RenderChartTypeOption(ChartType.Spline, item.Structure.ChartType);
                RenderChartTypeOption(ChartType.Areaspline, item.Structure.ChartType);
                RenderChartTypeOption(ChartType.Scatter, item.Structure.ChartType);
                RenderChartTypeOption(ChartType.Treemap, item.Structure.ChartType);
                RenderChartTypeOption(ChartType.Gauge, item.Structure.ChartType);
                RenderChartTypeOption(ChartType.MetricBox, item.Structure.ChartType);
            }
        </select>;

Layout = null;
var reportInfo = Model;
var structure = reportInfo.Structure;
var chartTitle = reportInfo.Structure.Name;
var isPrintPreview = ViewBag.IsPrintPreview ?? false;
var isDrillDown = ViewBag.DrillDown ?? false;
var bFromDashboard = ViewBag.bFromDashboard ?? false;
bool isIframeReport = ViewBag.IsIframeReport ?? false;
var widgetHeight = ViewBag.widgetHeight ?? 450;
var selectedColumns = structure.SelectedColumns.Where(sel => sel.aggrType != eAggregationFunctions.GroupByItem).ToList();
var canDesign = ViewBag.CanDesign ?? false;
string idx = reportInfo.Structure.ConfigId + "CNT" + (ViewBag.Counter ?? '0');
var calendar = ProjectDefinition.Project.DefaultCalendar;

var drillDownSubReports = reportInfo.Structure.SubReports.Where(sr => sr.Type == Report.SubReportType.DrillDown).ToList();
}

<partial name="~/Views/Report/Helpers/WindowTopJs.cshtml" model="new WindowTopJsModel {drillDownSubReports = drillDownSubReports, reportKey = reportInfo.Structure.ConfigId, reportInfo = reportInfo, filterValues = ViewBag.FilterValues as ElasticObject}" />

@if (ViewBag.ChartsAssetsIncluded == null || bFromDashboard)
{
    if (!bFromDashboard)
    {
        ViewBag.ChartsAssetsIncluded = true;
    }
    <script>
        // Prevent Highcharts from being loaded multiple times (Error #16)
        if (typeof window.HighchartsLoaded === 'undefined') {
            window.HighchartsLoaded = true;
        }
    </script>
    <script>
        // Ensure global configs exist when layout is not used (e.g., iframes/standalone)
        if (typeof window.tetaConfigs === 'undefined') {
            window.tetaConfigs = {
                neutralCulture: '@CultureHelper.GetCurrentNeutralCulture()',
                isRtl: @(CultureHelper.IsRightToLeft() ? "true" : "false"),
                version: ''
            };
        }
    </script>
    <script src="@CommonBundles.ChartsJsBundle" asp-append-version="true"></script>
    @if (reportInfo.Structure.ChartType == ChartType.Treemap)
    {
        <script src="~/Scripts/common-assets-includes/common-plugins/global/high-charts/treemap.js" asp-append-version="true"></script>
    }
    if (!bFromDashboard && !isIframeReport)
    {
        <script src="@CommonBundles.HighChartsExportJsBundle" asp-append-version="true"></script>
    }
}

@if (isDrillDown && !Model.Config.IsInlineSubReport)
{
    <partial name="~/Views/Report/Helpers/DrillDownHead.cshtml" model="new DrillDownHeadModel {reportInfo = Model, canDesign = canDesign, inFormContent = RenderChartTypeSelector(Model)}" />
}

<div class="col-md-12">
    @if (!isPrintPreview)
    {
        if (canDesign && !isDrillDown && !bFromDashboard && !isIframeReport && Model.Config.IsSubReport)
        {
            <partial name="~/Views/Report/Helpers/RenderDesignTools.cshtml" model="new RenderDesignToolsModel {report = Model, forInlineSubReport = true}" />
            <br />
        }
        if (!isDrillDown && !bFromDashboard && !isIframeReport && !Model.Config.IsInlineSubReport)
        {
            @RenderChartTypeSelector(reportInfo)
        }
    }

    @if (isPrintPreview && !Model.Config.IsSubReport)
    {
        <table cellpadding="0" cellspacing="0" style="width: 100%; direction: rtl;">
            <thead>
                <tr>
                    <th class="inf" colspan="@selectedColumns.Count">
                        <table style="width: 100%">
                            <tbody>
                                <tr>
                                    <td width="100px;">
                                        <img class="img1" src="@Url.Content(SpecificCommonlyNeededAssets.GetImage("report-header-logo"))" width="100" height="100" />
                                    </td>
                                    <td>
                                        <span class="reportNameSpan">@ViewBag.companyName</span>
                                    </td>
                                    <td>
                                        <span class="valueSpan">@structure.Name</span>
                                        <br />
                                        @{
                                            var fStr = await reportFilterName.GetConfigFilterNames(structure.NamespaceId,
                                                structure.EntityId, structure.Form_ReportId, structure.ConfigId,
                                                structure.FilterValues, structure.ParentReportIds, structure.CombosData,
                                                controllerMethods.DecodeFilterValues(ViewBag.ParentFilterValues), structure.Fields, ViewBag.User,
                                                CultureHelper.GetCurrentNeutralCulture());
                                            if (!string.IsNullOrEmpty(fStr))
                                            {
                                                <span class="titleSpan">@ViewTexts.FilteredBy: </span>
                                                <span class="valueSpan">@fStr</span>
                                                <br />
                                            }
                                        }
                                        @{
                                            var str = ReportController.GetGroupByNames(structure);
                                        }
                                        @if (Model.Structure.ReportViewType == ReportViewType.GroupByList)
                                        {
                                            <span class="titleSpan">@ViewTexts.GroupedBy: </span>
                                            <span class="valueSpan">@str</span>
                                        }
                                    </td>
                                    <td style="text-align: right; width: 150px;">
                                        @{
                                            DateTime dt = DateTime.Now;
                                            var dStr = "";
                                            var tStr = "";
                                            if (dt.Year > 1900)
                                            {
                                                if (calendar == "shamsi")
                                                {
                                                    var pc = new PersianCalendar();
                                                    dStr = pc.GetYear(dt).ToString() + '/' + pc.GetMonth(dt) + '/' + pc.GetDayOfMonth(dt);
                                                }
                                                else
                                                {
                                                    dStr = dt.Year.ToString() + '/' + dt.Month + '/' + dt.Day;
                                                }
                                                tStr = dt.Hour.ToString() + ':' + dt.Minute;
                                            }
                                        }
                                        <span class="titleSpan">@ViewTexts.ReportingDate: </span><span class="valueSpan">@dStr</span>
                                        <br />
                                        <span class="titleSpan">@ViewTexts.ReportingTime: </span><span class="valueSpan">@tStr</span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </th>
                </tr>

            </thead>
        </table>
        <br />
    }
    @{ var containerHeight = isIframeReport ? "100vh" : ((bFromDashboard ? widgetHeight : "600") + "px"); }
    <div id="container_@idx" class="report-main-box report-ovh" style="width: 100%; height: @containerHeight;"></div>
</div>
@{
    var shouldShowChartTitle = !isIframeReport && !bFromDashboard;
    var chartScriptModel = new ChartScriptModel(idx, reportInfo, calendar, chartTitle, shouldShowChartTitle);
}

@if (reportInfo.Structure.ChartType == ChartType.Treemap)
{
    <partial name="~/Views/Report/Charts/_TreemapChart.cshtml" model="chartScriptModel" />
}
else
{
    <partial name="~/Views/Report/Charts/_ReportDataTooltips.cshtml" model="chartScriptModel" />

    if (reportInfo.Structure.ChartType == ChartType.Gauge)
    {
        <partial name="~/Views/Report/Charts/_GaugeChart.cshtml" model="chartScriptModel" />
    }
    else if (reportInfo.Structure.ChartType == ChartType.MetricBox)
    {
        <partial name="~/Views/Report/Charts/_MetricBoxChart.cshtml" model="chartScriptModel" />
    }
    else if (reportInfo.Structure.ChartType == ChartType.Pie)
    {
        <partial name="~/Views/Report/Charts/_PieChart.cshtml" model="chartScriptModel" />
    }
    else
    {
        <partial name="~/Views/Report/Charts/_CartesianChart.cshtml" model="chartScriptModel" />
    }
}

<partial name="~/Views/Report/Helpers/PartialsCommon.cshtml" model="new PartialsCommonModel {reportInfo = Model}" />











