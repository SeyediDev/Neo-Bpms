@using System.Globalization;
@using Neo.Bpms.Domain.Entities.Cmmn
@using Neo.Bpms.Domain.Entities.Cmmn.UI

@using Neo.Bpms.Domain.Model.Project
@using Neo.Bpms.Domain.Model.UI;
@using Neo.Bpms.Domain.Models.Cmmn
@using Neo.Bpms.Domain.Models.Cmmn.UI.Reports
@using Neo.Bpms.Infrastructure.Features.Cmmn.Reports
@using Neo.Bpms.UI.MVC.Controllers
@using Neo.Bpms.UI.MVC.Controls
@using Neo.Bpms.UI.MVC.Helpers
@using Neo.Bpms.UI.MVC.PartialModels
@using Neo.Bpms.UI.MVC.PartialModels.Report
@inject ReportConfigBackupRestore reportConfigBackupRestore;
@inject ReportFilterName reportFilterName;
@inject ControllerMethods controllerMethods;


@model ReportData

@{

    void RenderChartTypeOption(Report.ChartType chartType, Report.ChartType selectedChartType)
    {
        //var editorBug = ":(";
        <!option value="@chartType" @(selectedChartType == chartType ? "selected=\" selected\"" : "" )>
            @chartType
        </!option>
    }

    Func<dynamic, HelperResult> RenderChartTypeSelector =
    @<select class="form-control" name="SelectedChartType" onchange="this.form.submit()">
	    @{
                RenderChartTypeOption(Report.ChartType.Area, item.structure.ChartType);
                RenderChartTypeOption(Report.ChartType.Bar, item.structure.ChartType);
                RenderChartTypeOption(Report.ChartType.Column, item.structure.ChartType);
                RenderChartTypeOption(Report.ChartType.Line, item.structure.ChartType);
                RenderChartTypeOption(Report.ChartType.Pie, item.structure.ChartType);
                RenderChartTypeOption(Report.ChartType.Spline, item.structure.ChartType);
                RenderChartTypeOption(Report.ChartType.Areaspline, item.structure.ChartType);
                RenderChartTypeOption(Report.ChartType.Scatter, item.structure.ChartType);
                RenderChartTypeOption(Report.ChartType.Treemap, item.structure.ChartType);
                RenderChartTypeOption(Report.ChartType.Gauge, item.structure.ChartType);
                RenderChartTypeOption(Report.ChartType.MetricBox, item.structure.ChartType);
            }
        </select>;

Layout = null;
var reportInfo = Model;
var structure = reportInfo.structure;
var chartTitle = reportInfo.structure.Name;
var isPrintPreview = ViewBag.IsPrintPreview ?? false;
var isDrillDown = ViewBag.DrillDown ?? false;
var bFromDashboard = ViewBag.bFromDashboard ?? false;
bool isIframeReport = ViewBag.IsIframeReport ?? false;
var widgetHeight = ViewBag.widgetHeight ?? 450;
var selectedColumns = structure.SelectedColumns.Where(sel => sel.aggrType != eAggregationFunctions.GroupByItem).ToList();
var canDesign = ViewBag.CanDesign ?? false;
string idx = reportInfo.structure.ConfigId + "CNT" + (ViewBag.Counter ?? '0');
var calendar = ProjectDefinition.Project.DefaultCalendar;

var drillDownSubReports = reportInfo.structure.SubReports.Where(sr => sr.Type == Report.SubReportType.DrillDown).ToList();
}

<partial name="~/Views/Report/Helpers/WindowTopJs.cshtml" model="new WindowTopJsModel {drillDownSubReports = drillDownSubReports, reportKey = reportInfo.structure.ConfigId, reportInfo = reportInfo, filterValues = ViewBag.FilterValues as ElasticObject}" />

@if (ViewBag.ChartsAssetsIncluded == null || bFromDashboard)
{
    if (!bFromDashboard)
    {
        ViewBag.ChartsAssetsIncluded = true;
    }
    <script>
        // Prevent Highcharts from being loaded multiple times (Error #16)
        if (typeof window.HighchartsLoaded === 'undefined') {
            window.HighchartsLoaded = true;
    </script>
    <script src="@CommonBundles.ChartsJsBundle" asp-append-version="true"></script>
    if (!bFromDashboard && !isIframeReport)
    {
        <script src="@CommonBundles.HighChartsExportJsBundle" asp-append-version="true"></script>
    }
    <script>
        }
    </script>
}

@if (isDrillDown && !Model.Config.IsInlineSubReport)
{
    <partial name="~/Views/Report/Helpers/DrillDownHead.cshtml" model="new DrillDownHeadModel {reportInfo = Model, canDesign = canDesign, inFormContent = RenderChartTypeSelector(Model)}" />
}

<div class="col-md-12">
    @if (!isPrintPreview)
    {
        if (canDesign && !isDrillDown && !bFromDashboard && !isIframeReport && Model.Config.IsSubReport)
        {
            <partial name="~/Views/Report/Helpers/RenderDesignTools.cshtml" model="new RenderDesignToolsModel {report = Model, forInlineSubReport = true}" />
            <br />
        }
        if (!isDrillDown && !bFromDashboard && !isIframeReport && !Model.Config.IsInlineSubReport)
        {
            @RenderChartTypeSelector(reportInfo)
        }
    }

    @if (isPrintPreview && !Model.Config.IsSubReport)
    {
        <table cellpadding="0" cellspacing="0" style="width: 100%; direction: rtl;">
            <thead>
                <tr>
                    <th class="inf" colspan="@selectedColumns.Count">
                        <table style="width: 100%">
                            <tbody>
                                <tr>
                                    <td width="100px;">
                                        <img class="img1" src="@Url.Content(SpecificCommonlyNeededAssets.GetImage("report-header-logo"))" width="100" height="100" />
                                    </td>
                                    <td>
                                        <span class="reportNameSpan">@ViewBag.companyName</span>
                                    </td>
                                    <td>
                                        <span class="valueSpan">@structure.Name</span>
                                        <br />
                                        @{
                                            var fStr = await reportFilterName.GetConfigFilterNames(structure.NamespaceId,
                                                structure.EntityId, structure.Form_ReportId, structure.ConfigId,
                                                structure.FilterValues, structure.ParentReportIds, structure.CombosData,
                                                controllerMethods.DecodeFilterValues(ViewBag.ParentFilterValues), structure.Fields, ViewBag.User,
                                                CultureHelper.GetCurrentNeutralCulture());
                                            if (!string.IsNullOrEmpty(fStr))
                                            {
                                                <span class="titleSpan">@ViewTexts.FilteredBy: </span>
                                                <span class="valueSpan">@fStr</span>
                                                <br />
                                            }
                                        }
                                        @{
                                            var str = ReportController.GetGroupByNames(structure);
                                        }
                                        @if (Model.structure.ReportViewType == ReportViewType.GroupByList)
                                        {
                                            <span class="titleSpan">@ViewTexts.GroupedBy: </span>
                                            <span class="valueSpan">@str</span>
                                        }
                                    </td>
                                    <td style="text-align: right; width: 150px;">
                                        @{
                                            DateTime dt = DateTime.Now;
                                            var dStr = "";
                                            var tStr = "";
                                            if (dt.Year > 1900)
                                            {
                                                if (calendar == "shamsi")
                                                {
                                                    var pc = new PersianCalendar();
                                                    dStr = pc.GetYear(dt).ToString() + '/' + pc.GetMonth(dt) + '/' + pc.GetDayOfMonth(dt);
                                                }
                                                else
                                                {
                                                    dStr = dt.Year.ToString() + '/' + dt.Month + '/' + dt.Day;
                                                }
                                                tStr = dt.Hour.ToString() + ':' + dt.Minute;
                                            }
                                        }
                                        <span class="titleSpan">@ViewTexts.ReportingDate: </span><span class="valueSpan">@dStr</span>
                                        <br />
                                        <span class="titleSpan">@ViewTexts.ReportingTime: </span><span class="valueSpan">@tStr</span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </th>
                </tr>

            </thead>
        </table>
        <br />
    }
    <div id="container_@idx" class="report-main-box report-ovh" style="width: 100%; height: @(GetContainerHeight(bFromDashboard, widgetHeight, isIframeReport));"></div>
</div>

@if (reportInfo.structure.ChartType == Report.ChartType.Treemap)
{
    TreeMapScripts(idx, reportInfo, calendar, chartTitle, !isIframeReport);
}
else
{
    ReportDataTooltipsScript(idx, reportInfo, calendar);

    if (reportInfo.structure.ChartType == Report.ChartType.Gauge)
    {
        GaugeScripts(idx, reportInfo, structure, chartTitle, !isIframeReport);
    }
    else if (reportInfo.structure.ChartType == Report.ChartType.MetricBox)
    {
        MetricBoxScript(idx, reportInfo, structure);
    }
    else if (reportInfo.structure.ChartType == Report.ChartType.Pie)
    {
        PieChartScript(idx, chartTitle, reportInfo, !isIframeReport);
    }
    else
    {
        BarAndFriendsChartsScript(idx, chartTitle, reportInfo, !isIframeReport);
    }
}

<partial name="~/Views/Report/Helpers/PartialsCommon.cshtml" model="new PartialsCommonModel {reportInfo = Model}" />

@functions{




    void TreeMapScripts(string idx, ReportData reportInfo, string calendar, string chartTitle, bool showTitle)
    {
        <script>
			var reportData = grabReportData('@idx');

			@{
		var colorColumn = reportInfo.structure.SelectedColumns.FirstOrDefault(s =>
			s.aggrType != eAggregationFunctions.GroupByItem && s.aggrType != eAggregationFunctions.InColumn);
		var categoryColumn = reportInfo.structure.SelectedColumns.FirstOrDefault(
			col => col.aggrType == eAggregationFunctions.InColumn);
		var subReportsCount = reportInfo.structure.SubReports.Count(sr => sr.Type == Report.SubReportType.DrillDown);
		var ii = 0;
		var categoryColumnTypeName = categoryColumn != null ? categoryColumn.ColumnTypeName : null;


		foreach (var row in reportInfo.Rows)
		{
			var rowIds = row.Data["Ids"];
			double colorValue = 0;
			var categoryValue = "";
			if (categoryColumnTypeName != null)
			{
				categoryValue = (row.Data[categoryColumnTypeName] ?? "").ToString();
			}

			if (colorColumn != null)
			{
				colorValue = row.Data.GetDouble(colorColumn.ColumnTypeName);
			}

			<text>
			var rowData = reportData[@ii] = {};
				rowData['name'] = '@categoryValue';
				rowData['value'] = @colorValue;
				rowData['colorValue'] = @colorValue;
				rowData['ids'] = '@rowIds';
				rowData['tooltipValues'] = {};</text>

			var columns = reportInfo.structure.SelectedColumns.Where(s =>
				s.aggrType != eAggregationFunctions.GroupByItem);
			foreach (var colInfo in columns)
			{
				var value = ReportRenderer.GetCelValue(colInfo, row);
				var val = TableHelper.CreateCellElement(value, colInfo, true, calendar);
				@:rowData['tooltipValues']['@colInfo.Alias'] = '@val';
			}

			ii++;
		}
			}


			$(document)
				.ready(function() {
					var a = new Highcharts.Chart({
						credits: {
							enabled: false
						},
						chart: {
							renderTo: 'container_@(idx)',
							type: 'treemap'
						},
						title: {
							text: '@(showTitle ? chartTitle : "")'
						},
						tooltip: {
							formatter: function() {
								var tooltipsObj = this.point.tooltipValues;
								return tooltipFormatter(tooltipsObj);
							},
							useHTML: true
						},
						colorAxis: {
							minColor: '#FFFFFF',
							maxColor: Highcharts.getOptions().colors[0],
							labels: {
								//                            enabled: true,
								formatter: function() {
									var xMillion = (+this.value) / 1000000;
									if (xMillion >= 1) {
										return Math.round(xMillion) + "m";
									}
									var xKilo = (+this.value) / 1000;
									if (xKilo >= 1) {
										return Math.round(xKilo) + "k";
									}
									return ((Math.round(this.value) == this.value) ? this.value : this.value.toFixed(2));
								}
							}
						},
						plotOptions: {
							series: {
								events: {
									click: function(event) {
										openSubReportFrame2(@subReportsCount,
											event.point.ids,
											'@reportInfo.structure.ConfigId',
											window.top.reportInfo['@reportInfo.structure.ConfigId']["parentFilter"],
											event.toElement,
											event);
									}
								}
							}
						},
						series: [
							{
								layoutAlgorithm: 'squarified',
								data: window.top.reportsData['@idx'],
								dataLabels: {
									formatter: function() {
										if (this.point.node.pointValues) {
//                                        console.log(this.point.name + " height:" + this.point.node.pointValues.height);
//                                        console.log(this.point.name + " width:" + this.point.node.pointValues.width);

											var heightDependentSize = Math.round(this.point.node.pointValues.height * 0.5);
											var pointName = this.point.name;
											//                                        console.log('heightDependentSize: ' + heightDependentSize);
											//                                        var widthCharactersRatioSize =
											//                                            this.point.node.pointValues.width / (pointName.length || 1);
											var constDesiredRatio = 1; //2
											var maxCharsLength = this.point.node.pointValues.width / constDesiredRatio;

											if (pointName.length > maxCharsLength) {
												pointName = pointName.substr(0, (maxCharsLength - 2) || 1);
											}
//                                        console.log(pointName);
											var heightFontSize = heightDependentSize;
											var fontSize = heightFontSize > 14 ? heightFontSize : 14;

											fontSize = (fontSize > 20 ? 20 : fontSize);
//                                        console.log('finalFontSize: ' + fontSize);

											return "<div style='direction:ltr;'><span style='font-size:" +
												+ fontSize +
												"px;'>" +
												pointName +
												"</span></div>";
										}
										return "";
									},
									useHTML: true
								}
							}
						]
					});
				});
        </script>
    }

    void ReportDataTooltipsScript(string idx, ReportData reportInfo, string calendar)
    {
        <script>
			var reportData = grabReportData('@idx');
			@{
		var ii = 0;
		foreach (var row in reportInfo.Rows)
		{
			var rowIds = row.Data["Ids"];
			<text>
			var rowData = reportData[@ii] = {};
				rowData['ids'] = '@rowIds';
				rowData['tooltipValues'] = [];</text>


			var columns = reportInfo.structure.SelectedColumns.Where(s =>
				s.aggrType != eAggregationFunctions.GroupByItem && s.aggrType != eAggregationFunctions.InColumn
				).ToList();
			var tooltips = reportInfo.structure.SelectedColumns.Where(s =>
				s.aggrType != eAggregationFunctions.GroupByItem && s.IsTooltip).ToList();
			var columnTitles = reportInfo.structure.SelectedColumns
				.Where(s => s.aggrType == eAggregationFunctions.InColumn).ToList();

			var columnIndex = -1;
			foreach (var colInfo in columns)
			{
				columnIndex++;

				if (colInfo.IsTooltip)
				{
					continue;
				}
				@:rowData['tooltipValues'][@columnIndex] = {};


				foreach (var columnTitle in columnTitles)
				{
					var titleValue = ReportRenderer.GetCelValue(columnTitle, row);
					var titleVal =
						TableHelper.CreateCellElement(titleValue, columnTitle, true, calendar);
					@:rowData['tooltipValues'][@columnIndex]['@columnTitle.Alias'] = '@titleVal';
				}

				var value = ReportRenderer.GetCelValue(colInfo, row);
				var val = TableHelper.CreateCellElement(value, colInfo, true, calendar);
				@:rowData['tooltipValues'][@columnIndex]['@colInfo.Alias'] = '@val';


				foreach (var tooltipField in tooltips)
				{
					var tooltipValue = ReportRenderer.GetCelValue(tooltipField, row);
					var tooltipVal = TableHelper.CreateCellElement(tooltipValue, tooltipField, true,
						calendar);
					@:rowData['tooltipValues'][@columnIndex]['@tooltipField.Alias'] = '@tooltipVal';
				}
			}

			ii++;
		}
			}


        </script>
    }

    void GaugeScripts(string idx, ReportData reportInfo, ReportStructure structure, string chartTitle, bool showTitle)
    {
        <script type="text/javascript">
			var gaugeInfo = {};
			gaugeInfo.levels = [];
			gaugeInfo.data = [];
			gaugeInfo.range = { from: 0, to: 100 };
			gaugeInfo.unit = '';
			gaugeInfo.categoryName = '';
			@{
		var levelIndex = 0;
		var row = reportInfo.Rows.Count > 0 ? reportInfo.Rows[0] : null;

		var gaugeValueColumn = reportInfo.structure.SelectedColumns.FirstOrDefault(s =>
			s.aggrType != eAggregationFunctions.GroupByItem &&
			s.aggrType !=
			eAggregationFunctions
				.InColumn); //If anybody desires to get a chand aghrabei gauge, He/She should write a foreach
		double gaugeValue = 0;
		if (gaugeValueColumn != null && row != null)
		{
			gaugeValue = (gaugeValueColumn.aggrType == eAggregationFunctions.Formula)
				? Convert.ToDouble(row.Data[gaugeValueColumn.ColumnTypeName] ?? 0)
				: row.Data.GetDouble(gaugeValueColumn.ColumnTypeName);
		}

		var categoryColumn = reportInfo.structure.SelectedColumns.FirstOrDefault(
			col => col.aggrType == eAggregationFunctions.InColumn);

		var categoryValue = "";
		if (categoryColumn != null && row != null)
		{
			categoryValue = (row.Data[categoryColumn.ColumnTypeName] ?? "").ToString();
		}
			}

			gaugeInfo.data = [@gaugeValue.ToString("#.##")];
			gaugeInfo.categoryName = '@categoryValue';
			@{
		if (structure.Levels != null)
		{
			foreach (var level in structure.Levels)
			{
				double minValue = 0;
				double maxValue = 0;
				if (row != null)
				{
					minValue = level.MinType == ValueRange.ValueType.Field
						? row.Data.GetDouble(level.MinValue)
						: Convert.ToDouble(level.MinValue);
					maxValue = level.MinType == ValueRange.ValueType.Field
						? row.Data.GetDouble(level.MaxValue)
						: Convert.ToDouble(level.MaxValue);
				}
				<text>gaugeInfo.levels[@levelIndex] =
			{
				from: @minValue,
				to: @maxValue,
				color: '@level.Color'
			};</text>

				levelIndex++;
			}
		}

		if (structure.ValueRange != null)
		{
			double minValue = 0;
			double maxValue = 100;
			if (row != null)
			{
				minValue = structure.ValueRange.MinType == ValueRange.ValueType.Field
					? row.Data.GetDouble(structure.ValueRange.MinValue)
					: Convert.ToDouble(structure.ValueRange.MinValue);
				maxValue = structure.ValueRange.MaxType == ValueRange.ValueType.Field
					? row.Data.GetDouble(structure.ValueRange.MaxValue)
					: Convert.ToDouble(structure.ValueRange.MaxValue);
			}
			@:gaugeInfo.range = { from: @minValue, to: @maxValue };
		}

		var unit = structure.GetReportProperty((long) ReportConfigProperty.Unit);
		if (unit != null)
		{
			@:gaugeInfo.unit = '@unit';
		}
			}


			$(function() {
				Highcharts.chart("container_@(idx)",
					{
						credits: {
							enabled: false
						},
						chart: {
							type: 'gauge',
							plotBackgroundColor: null,
							plotBackgroundImage: null,
							plotBorderWidth: 0,
							plotShadow: false
						},
						title: {
							text: '@(showTitle ? chartTitle : "")'
						},
						pane: {
							startAngle: -150,
							endAngle: 150,
							background: [
								{
									backgroundColor: {
										linearGradient: { x1: 0, y1: 0, x2: 0, y2: 1 },
										stops: [
											[0, '#FFF'],
											[1, '#333']
										]
									},
									borderWidth: 0,
									outerRadius: '109%'
								}, {
									backgroundColor: {
										linearGradient: { x1: 0, y1: 0, x2: 0, y2: 1 },
										stops: [
											[0, '#333'],
											[1, '#FFF']
										]
									},
									borderWidth: 1,
									outerRadius: '107%'
								}, {
								}, {
									backgroundColor: '#DDD',
									borderWidth: 0,
									outerRadius: '105%',
									innerRadius: '103%'
								}
							]
						},
						tooltip: {
							formatter: function() {
								var tooltipsObj =
									window.top.reportsData['@idx'][parseInt(this.point.index)]["tooltipValues"][parseInt(
										this.point.colorIndex)];
								return tooltipFormatter(tooltipsObj);
							},
							useHTML: true
						},
						yAxis: {
							min: gaugeInfo.range.from,
							max: gaugeInfo.range.to,
							minorTickInterval: 'auto',
							minorTickWidth: 1,
							minorTickLength: 10,
							minorTickPosition: 'inside',
							minorTickColor: '#666',
							tickPixelInterval: 30,
							tickWidth: 2,
							tickPosition: 'inside',
							tickLength: 10,
							tickColor: '#666',
							labels: {
								step: 2,
								rotation: 'auto'
							},
							title: {
								text: gaugeInfo.unit
							},
							plotBands: gaugeInfo.levels
						},
						series: [
							{
								name: gaugeInfo.categoryName,
								data: gaugeInfo.data
							}
						]
					});
			});
        </script>
    }

    void MetricBoxScript(string idx, ReportData reportInfo, ReportStructure structure)
    {
        var row = reportInfo.Rows.Count > 0 ? reportInfo.Rows[0] : null; //todo needs refactor It's same as gauge or not?

        var singleValueColumn = reportInfo.structure.SelectedColumns.FirstOrDefault(s =>
            s.aggrType != eAggregationFunctions.GroupByItem &&
            s.aggrType !=
            eAggregationFunctions
                .InColumn); //If anybody desires to get a chand aghrabei gauge, He/She should write a foreach
        double singleValue = 0;
        var singleColumnAlias = "";
        if (singleValueColumn != null)
        {
            singleColumnAlias = singleValueColumn.Alias;

            if (row == null)
            {
                singleValue = 0;
            }
            else
            {
                singleValue = (singleValueColumn.aggrType == eAggregationFunctions.Formula)
                    ? Convert.ToDouble(row.Data[singleValueColumn.ColumnTypeName] ?? 0)
                    : row.Data.GetDouble(singleValueColumn.ColumnTypeName);
            }
        }

        <script type="text/javascript">
			window.TetaMetrics.create('#container_@(idx)',
				{
					iconClass: '@structure.GetReportProperty((long) ReportConfigProperty.IconClass)',
					value: '@(singleValueColumn != null ? singleValue.ToString("0.##") : "")',
					title: '@singleColumnAlias',
					backgroundColor: '#2563EB',
					textsColor: '@structure.GetReportProperty((long) ReportConfigProperty.TextColor)'
				});
        </script>
    }

    void PieChartScript(string idx, string chartTitle, ReportData reportInfo, bool showTitle)
    {
        var hr = new HighchartRenderer(reportInfo);

            <script type="text/javascript">
				$(document)
					.ready(function() {
						var colors = Highcharts.getOptions().colors,
							categories = @hr.GetCategories(),
							data = @hr.GetSeries(),
							browserData = [],
							i,
							dataLen = data.length > 0 ? data[0].data.length : null;
                        var newColor = ['#6366f1', '#fe6a35', '#eeca34', '#06aed4', '#2b72fb','#058DC7', '#50B432', '#ED561B', '#DDDF00', '#24CBE5', '#64E572', '#FF9655', '#FFF263', '#6AF9C4']
						if (data.length > 0) {
							for (i = 0; i < dataLen; i += 1) {
								browserData.push({
									name: categories[i],
									y: data[0].data[i],
                                    color: newColor[i]
                                    //color: colors[i % 10]
								});
							}
							var container_chartCorrectiveAction = new Highcharts.Chart({
								credits: {
									enabled: false
								},
								chart: {
									renderTo: "container_@(idx)",
									type: 'pie'
								},
								title: {
									text: '@(showTitle ? chartTitle : "")'
								},
								tooltip: {
									formatter: function() {
										var tooltipsObj = window.top.reportsData['@idx'][parseInt(this.point.index)][
											"tooltipValues"][0];
										return tooltipFormatter(tooltipsObj);
									},
									useHTML: true
								},
								legend: {
									enabled: false
								},
								series: [
									{
										name: data[0].name,
										data: browserData,
										useHTML: true,
										dataLabels: {
											formatter: function() {
												return this.point.name;
											}
										}
									}
								]
							});
						}
					});
            </script>
    }

    void BarAndFriendsChartsScript(string idx, string chartTitle,
        ReportData reportInfo, bool showTitle)
    {
        var hr = new HighchartRenderer(reportInfo);
        var chartType = reportInfo.structure.ChartType.ToString().ToLower();

        
            <script type="text/javascript">
				var rotateVal = -40;
				var chartType = '@chartType';
				if (chartType == 'bar') {
					rotateVal = -1;
				}
				(function() {
					var container_chartCorrectiveAction = new Highcharts.Chart({
						credits: {
							enabled: false
						},
						chart: {
							renderTo: "container_@(idx)",
							type: '@chartType',
							marginBottom: 150
						},
						title: {
							text: '@(showTitle ? chartTitle : "")'
						},
						xAxis: {
							categories: @hr.GetCategories(),
							labels: {
								rotation: rotateVal,
								align: '',
								direction: 'rtl',
								useHTML: true
							}
						},
						legend: {
							enabled: false
						},
						tooltip: {
							formatter: function() {
								var tooltipsObj = {};
								var hasAgg = @(reportInfo.AggregationColumns.Count() == 1 ? "true" : "false");
								var isMatrix =
									@(reportInfo.structure.SelectedColumns.Count(s => s.aggrType == eAggregationFunctions.InColumn) > 1 &&
									  reportInfo.structure.SelectedColumns.Count(s => s.aggrType == eAggregationFunctions.GroupByItem) > 0
										? "true"
										: "false");
								if (isMatrix && hasAgg) {
									var seriesElement = @(hr.GetSeries())[parseInt(this.point.colorIndex)];
									var rowIdIndex = seriesElement.rowIdsIndex[parseInt(this.point.index)];
									var tooltipsFormatter = "";
									if (rowIdIndex >= 0) {
										var idx = '@idx';
										var tooltipsObjs = window.top.reportsData[idx][rowIdIndex]["tooltipValues"];
										var tooltipsObjsLength = tooltipsObjs.length;
										for (var itooltipsObj = 0; itooltipsObj < tooltipsObjsLength; itooltipsObj++) {
											tooltipsFormatter += tooltipFormatter(tooltipsObjs[itooltipsObj]);
										}
									} else {
										tooltipsFormatter +=
											tooltipFormatterItem(seriesElement.fieldName, seriesElement.name) +
											tooltipFormatterItem("", window.tetaI18n.t('No Record'));
									}
									return tooltipsFormatter;
								} else {
									tooltipsObj =
										window.top.reportsData['@idx'][parseInt(this.point.index)]["tooltipValues"][
											parseInt(
												this.point.colorIndex)];
								}
								return tooltipFormatter(tooltipsObj);
							},
							useHTML: true
						},
						yAxis: {
							@if (hr.YAxisIsTimespan)
							{
								<text>
							labels: {
								formatter: function() {
									return window.TimeSpanManager.toDisplayText(this.value, { displayMilliseconds: false });
								}
							},
								</text>
							}
							title: {
								text: @hr.GetYAxisName()
							}
						},
                        colors: ['#6366f1', '#fe6a35', '#eeca34', '#06aed4', '#2b72fb' ,'#058DC7', '#50B432', '#ED561B', '#DDDF00', '#24CBE5', '#64E572', '#FF9655', '#FFF263', '#6AF9C4'],
						series: @hr.GetSeries(),
                        plotOptions: {
                            column: {
                                colorByPoint: true
                            }
                        }
					});
				})();
            </script>
    }


        private static string GetContainerHeight(bool bFromDashboard, int widgetHeight, bool isIframeReport)
        {
            return isIframeReport ? "100vh" :
                ((bFromDashboard ? widgetHeight : "600") + "px");
        }

}