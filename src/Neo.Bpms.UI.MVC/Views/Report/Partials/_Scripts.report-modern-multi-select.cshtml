                    // Clear badge when no overflow
                    $overflowBadge.empty();
                    $overflowBadge.attr('data-visible', 'false');
                }
                
                console.log('[ModernMultiSelect] renderSelectedItems completed. Visible chips:', $itemsContainer.children('.modern-multi-select-item').length, 'Overflow chips:', $overflowPopover.children('.modern-multi-select-item').length);
                console.log('[ModernMultiSelect] Overflow badge visible:', $overflowBadge.attr('data-visible'), 'Badge content:', $overflowBadge.html());
                
                // All styles are handled by CSS - no need for inline styles
                // Dynamic max-width for items container based on overflow
                if (overflowCount > 0) {
                    $itemsContainer.css('max-width', 'calc(100% - 100px)');
