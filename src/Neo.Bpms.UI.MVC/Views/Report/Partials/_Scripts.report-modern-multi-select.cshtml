    // Initialize custom modern multi-select control
    function initializeCustomModernMultiSelect($control, $hiddenInput) {
        const $input = $control.find('.modern-multi-select-input');
        const $itemsContainer = $control.find('.modern-multi-select-items');
        const $searchInput = $control.find('.modern-multi-select-search');
        const $dropdown = $control.find('.modern-multi-select-dropdown');
        const $options = $control.find('.modern-multi-select-options');
        const $arrow = $control.find('.modern-multi-select-arrow');
        
        let isOpen = false;
        let selectedValues = [];
        let allOptions = [];
        let isLoading = false;
        
        // Parse initial values - handle both string and array
        const initialValue = $hiddenInput.val();
        if (initialValue) {
            if (typeof initialValue === 'string') {
                // String value - split by comma
                selectedValues = initialValue.split(',').filter(v => v.trim() !== '');
            } else if (Array.isArray(initialValue)) {
                // Already an array - just use it
                selectedValues = initialValue.filter(v => v && v !== '');
            } else {
                // Single value - convert to array
                selectedValues = [String(initialValue)];
            }
        }
        
        console.log('[ModernMultiSelect Custom] Initialized with values:', selectedValues, 'for control:', $control.data('field-name'));
        
        // Load data from API
        function loadData() {
            if (isLoading) return;
            isLoading = true;
            
            const fieldName = $control.data('field-name');
            const isRemote = $control.data('is-remote');
            const filterFormula = $control.data('filter-formula');
            
            // Show loading state
            $options.html('<div class="modern-multi-select-loading">در حال بارگذاری...</div>');
            
            // Prepare request data
            const requestData = {
                fieldName: fieldName,
                isRemote: isRemote,
                filterFormula: filterFormula,
                searchTerm: $searchInput.val() || ''
            };
            
            // Call GetComboData API
            $.ajax({
                url: window.top.rootUrl + 'Form/GetComboData',
                type: 'POST',
                data: requestData,
                headers: window.AddAntiForgeryToken(),
                success: function(response) {
                    if (response && response.data) {
                        allOptions = response.data;
                        renderOptions();
                        updateOptionStates();
                    }
                    isLoading = false;
                },
                error: function(xhr, status, error) {
                    $options.html('<div class="modern-multi-select-error">خطا در بارگذاری داده‌ها</div>');
                    isLoading = false;
                }
            });
        }
        
        // Render options
        function renderOptions() {
            $options.empty();
            allOptions.forEach(option => {
                const $option = $(`
                    <div class="modern-multi-select-option" data-value="${option.value}">
                        <div class="modern-multi-select-option-checkbox"></div>
                        <div class="modern-multi-select-option-text">${option.text}</div>
                    </div>
                `);
                $options.append($option);
            });
        }
        
        // Update hidden input
        function updateHiddenInput() {
            $hiddenInput.val(selectedValues.join(',')).trigger('change');
        }
        
        // Render selected items
        function renderSelectedItems() {
            $itemsContainer.empty();
            selectedValues.forEach(value => {
                const option = allOptions.find(opt => opt.value === value);
                if (option) {
                    const $item = $(`
                        <div class="modern-multi-select-item" data-value="${value}">
                            <span class="modern-multi-select-item-text">${option.text}</span>
                            <span class="modern-multi-select-item-remove">×</span>
                        </div>
                    `);
                    $itemsContainer.append($item);
                }
            });
        }
        
        // Update option states
        function updateOptionStates() {
            $options.find('.modern-multi-select-option').each(function() {
                const $option = $(this);
                const value = $option.data('value');
                const isSelected = selectedValues.includes(value);
                
                $option.toggleClass('selected', isSelected);
            });
        }
        
        // Toggle dropdown
        function toggleDropdown() {
            isOpen = !isOpen;
            $control.toggleClass('open', isOpen);
            $dropdown.toggle(isOpen);
            
            if (isOpen) {
                $searchInput.focus();
                if (allOptions.length === 0) {
                    loadData();
                } else {
                    updateOptionStates();
                }
            }
        }
        
        // Close dropdown
        function closeDropdown() {
            isOpen = false;
            $control.removeClass('open');
            $dropdown.hide();
            $searchInput.val('');
        }
        
        // Add item
        function addItem(value) {
            if (!selectedValues.includes(value)) {
                selectedValues.push(value);
                renderSelectedItems();
                updateOptionStates();
                updateHiddenInput();
            }
        }
        
        // Remove item
        function removeItem(value) {
            selectedValues = selectedValues.filter(v => v !== value);
            renderSelectedItems();
            updateOptionStates();
            updateHiddenInput();
        }
        
        // Filter options
        function filterOptions(searchTerm) {
            if (searchTerm && searchTerm.length > 0) {
                // Reload data with search term
                loadData();
            } else {
                // Show all options
                renderOptions();
                updateOptionStates();
            }
        }
        
        // Event handlers
        $input.on('click', function(e) {
            e.stopPropagation();
            toggleDropdown();
        });
        
        $arrow.on('click', function(e) {
            e.stopPropagation();
            toggleDropdown();
        });
        
        // Add debounce for search input to wait for user to finish typing
        let searchTimeout = null;
        $searchInput.on('input', function() {
            const searchTerm = $(this).val();
            
            // Clear previous timeout
            if (searchTimeout) {
                clearTimeout(searchTimeout);
            }
            
            // Wait 500ms after user stops typing before searching
            searchTimeout = setTimeout(function() {
                console.log('[ModernMultiSelect Custom] 🔍 Search debounced, filtering with term:', searchTerm);
                filterOptions(searchTerm);
            }, 500); // 500ms delay
        });
        
        $searchInput.on('keydown', function(e) {
            if (e.key === 'Escape') {
                closeDropdown();
            }
        });
        
        // Option click
        $options.on('click', '.modern-multi-select-option', function(e) {
            e.stopPropagation();
            const $option = $(this);
            const value = $option.data('value');
            
            if (selectedValues.includes(value)) {
                removeItem(value);
            } else {
                addItem(value);
            }
        });
        
        // Remove item click
        $itemsContainer.on('click', '.modern-multi-select-item-remove', function(e) {
            e.stopPropagation();
            const $item = $(this).closest('.modern-multi-select-item');
            const value = $item.data('value');
            removeItem(value);
        });
        
        // Close on outside click
        $(document).on('click', function(e) {
            if (!$control.is(e.target) && $control.has(e.target).length === 0) {
                closeDropdown();
            }
        });
        
        // Listen for external changes (e.g., from clear filter button)
        // This allows external code to clear the select and have the visual control update
        $hiddenInput.on('change.external', function() {
            const newValue = $hiddenInput.val();
            if (!newValue || newValue.trim() === '') {
                // Clear all selections
                selectedValues = [];
                renderSelectedItems();
                updateOptionStates();
            } else {
                // Update selections from hidden input
                selectedValues = newValue.split(',').filter(v => v.trim() !== '');
                renderSelectedItems();
                updateOptionStates();
            }
        });
        
        // Also listen for regular change events on hidden input
        $hiddenInput.on('change', function() {
            const newValue = $hiddenInput.val();
            if (!newValue || newValue.trim() === '') {
                selectedValues = [];
            } else {
                selectedValues = newValue.split(',').filter(v => v.trim() !== '');
            }
            renderSelectedItems();
            updateOptionStates();
        });
        
        // Initialize
        renderSelectedItems();
    }
    
    // Function to apply filter values to already initialized Modern Multi-Select controls
    // This is called after filter values are loaded from server (e.g., when popular filter is selected)
    function applyFilterValuesToControls() {
        console.log('[ModernMultiSelect] Applying filter values to controls...');
        
        // Instead of re-initializing (which causes errors for remote data selects),
        // we'll trigger change events on select elements to update the controls
        // This is safer and doesn't break remote data loading
        
        // For already initialized controls, trigger change.externalUpdate event on select element
        // The control should listen to this and update itself
        $('#filterTooltipPanel select[data-modern-multi-select-converted="true"]').each(function() {
            const $select = $(this);
            const currentValue = $select.val();
            
            // Trigger change.externalUpdate event to update the control
            // This event is specifically for external updates (like from popular filters)
            $select.trigger('change.externalUpdate');
            console.log('[ModernMultiSelect] Triggered externalUpdate for select:', $select.attr('name'), 'value:', currentValue);
        });
        
        // Also handle custom Modern Multi-Select controls (those with data-field-name)
        $('.modern-multi-select-control[data-field-name]').each(function() {
            const $control = $(this);
            const fieldName = $control.data('field-name');
            const $hiddenInput = $(`#field-${fieldName}`);
            
            if ($hiddenInput.length > 0) {
                const hiddenValue = $hiddenInput.val();
                // Only trigger if there's a value
                if (hiddenValue && hiddenValue.trim() !== '') {
                    // Trigger change event to update the control
                    $hiddenInput.trigger('change.external');
                    console.log('[ModernMultiSelect] Triggered change for custom control:', fieldName, 'value:', hiddenValue);
                }
            }
        });
        
        // For controls that haven't been initialized yet, initialize them
        // This handles the case where filter values are loaded before controls are initialized
        setTimeout(function() {
            // Only initialize controls that haven't been converted yet
            const uninitializedSelects = $('#filterTooltipPanel select:not([data-modern-multi-select-converted="true"])');
            if (uninitializedSelects.length > 0) {
                console.log('[ModernMultiSelect] Initializing', uninitializedSelects.length, 'uninitialized controls');
                initializeModernMultiSelect();
            }
        }, 100);
    }
    
    // Export for global access
    window.applyFilterValuesToControls = applyFilterValuesToControls;
    
    // Export for global access - Available immediately when this script loads
    // CRITICAL: This must be available before popular-filters.cshtml runs
    window.initializeReportModernMultiSelect = initializeModernMultiSelect;
    
    // Verify function is exported immediately
    if (typeof window.initializeReportModernMultiSelect !== 'function') {
        throw new Error('Failed to export initializeReportModernMultiSelect');
    }
    
    // Auto-initialize when document is ready (if ModernMultiSelect is available)
    $(document).ready(function() {
        // Wait a bit to ensure ModernMultiSelect plugin is loaded
        setTimeout(function() {
            if (typeof ModernMultiSelect !== 'undefined') {
                initializeModernMultiSelect();
                
                // After initialization, wait for filter values to be loaded from server
                // This is especially important when a popular filter is selected and page reloads
                // Try multiple times with increasing delays to ensure values are loaded
                [200, 500, 800, 1200, 2000].forEach(function(delay) {
                    setTimeout(function() {
                        // Check if any select elements have values that need to be applied
                        const selectsWithValues = $('#filterTooltipPanel select[data-modern-multi-select-converted="true"]').filter(function() {
                            const val = $(this).val();
                            return val && val.length > 0 && (Array.isArray(val) ? val.length > 0 : val !== '');
                        });
                        
                        if (selectsWithValues.length > 0) {
                            console.log('[ModernMultiSelect] Found', selectsWithValues.length, 'selects with values, applying to controls...');
                            applyFilterValuesToControls();
                        }
                    }, delay);
                });
            }
            // Note: If ModernMultiSelect is not available, initialization will happen when called
        }, 100);
    });
    
})(jQuery);
</script>

