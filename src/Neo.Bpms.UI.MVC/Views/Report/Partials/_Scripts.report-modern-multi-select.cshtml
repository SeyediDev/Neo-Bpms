    (function() {
        if (typeof window.initializeReportModernMultiSelect !== 'function') {
            console.error('[ReportMultiSelect] ❌ Verification FAILED: initializeReportModernMultiSelect is NOT available!');
            console.error('[ReportMultiSelect] This will cause filter multi-select to fail.');
        }
    })();
</script>

