                    $searchInput[0].style.setProperty('visibility', 'visible', 'important');
                    $searchInput[0].style.setProperty('opacity', '1', 'important');
                    
                    // Ensure options container is visible
                    $options[0].style.setProperty('display', 'block', 'important');
                    $options[0].style.setProperty('visibility', 'visible', 'important');
                    $options[0].style.setProperty('opacity', '1', 'important');
                    
                    // CRITICAL: Check if we need to load data or can use cached data
                    const hasCache = Object.keys(searchCache).length > 0 || Object.keys(optionsCache).length > 0;
                    const needsLoad = isRemote && !dataLoaded && allOptions.length <= 1 && !hasCache;
                    
                    console.log('[ModernMultiSelect] 🔍 Opening dropdown - Decision point', {
                        fieldName: fieldName,
                        isRemote: isRemote,
                        dataLoaded: dataLoaded,
                        allOptionsLength: allOptions.length,
                        hasCache: hasCache,
                        searchCacheSize: Object.keys(searchCache).length,
                        optionsCacheSize: Object.keys(optionsCache).length,
                        needsLoad: needsLoad,
                        isLoading: isLoading
                    });
                    
                    if (needsLoad) {
                        console.log('[ModernMultiSelect] 🌐 Opening dropdown - need to load data from server');
                        loadDataFromServer('');
                        // Note: renderOptions will be called after data loads
                    } else if (allOptions.length > 1 || hasCache) {
                        // We have options or cache, render them
                        console.log('[ModernMultiSelect] ✅ Opening dropdown - rendering existing options/cache');
                        
                        // If we have cache but no options, try to load from cache first
                        if (allOptions.length <= 1 && hasCache) {
                            loadDataFromServer(''); // This will use cache
                        } else {
                            renderOptions();
                        }
                    } else {
                        // No options at all
                        console.log('[ModernMultiSelect] ⚠️ Opening dropdown - no options available');
                        $options.html('<div style="padding: 20px; text-align: center; color: #64748b;">گزینه‌ای موجود نیست</div>');
