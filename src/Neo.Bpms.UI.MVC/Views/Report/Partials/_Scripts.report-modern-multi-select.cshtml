                    $overflowPopover[0].style.setProperty('visibility', 'hidden', 'important');
                    $overflowPopover[0].style.setProperty('opacity', '0', 'important');
                    $overflowPopover[0].style.setProperty('pointer-events', 'none', 'important');
                }
                $overflowPopover.hide();
                $overflowBadge.removeClass('active');
                $overflowPopoverContent.empty(); // Clear content when closed
            }
            
            // Open overflow popover - Show all selected items in card view
            function openOverflowPopover() {
                // Clear previous content
                $overflowPopoverContent.empty();
                
                // Render ALL selected items in popover (card view)
                if (selectedValues.length > 0) {
                    selectedValues.forEach(function(val) {
                        // CRITICAL: Use cache first, then allOptions, then select element
                        let option = getOptionByValue(val);
                        
                        // Fallback: if option not found, try to get it from the select element's options
                        if (!option) {
                            const $selectOption = $select.find('option[value="' + val + '"]');
                            if ($selectOption.length > 0) {
                                const text = $selectOption.text().trim() || val;
                                option = {
                                    value: val,
                                    text: text
                                };
                                // Add to cache for future use
                                addToCache(val, text);
                            } else {
                                // Fallback to raw value if no option found
                                option = {
                                    value: val,
                                    text: val + ' (ID)'
                                };
                            }
                        }
                        
                        if (option) {
                            const $chip = createChipElement(val, option, true);
                            $overflowPopoverContent.append($chip);
                        }
                    });
                }
                // Calculate position relative to the main input control
                const inputOffset = $input.offset();
                const wrapperOffset = $wrapper.offset();
                const popoverWidth = 320; // Fixed width for popover
                
                // Position popover below the main input, aligned to its left edge (in RTL, this is visual right)
                const topPosition = ($input.position().top + $input.outerHeight() + 4); // 4px margin below input
                const leftPosition = 0; // Aligned to the left edge of the wrapper
                
                // Use setProperty for !important to override CSS
                if ($overflowPopover.length > 0 && $overflowPopover[0]) {
                    $overflowPopover[0].style.setProperty('display', 'flex', 'important');
                    $overflowPopover[0].style.setProperty('visibility', 'visible', 'important');
                    $overflowPopover[0].style.setProperty('opacity', '1', 'important');
                    $overflowPopover[0].style.setProperty('pointer-events', 'auto', 'important');
                }
                
                $overflowPopover.css({
                    'top': topPosition + 'px',
                    'left': leftPosition + 'px',
                    'right': 'auto', // Ensure right is not set
                    'max-width': popoverWidth + 'px',
                    'max-height': Math.min(400, $(window).height() - 100) + 'px' // Max 400px or viewport height - 100px
                });
                
                $overflowBadge.addClass('active');
            }
            
            // Update input height based on content (fixed at 38px for single line)
            function updateInputHeight() {
                // Fixed height for single line - no need to calculate
                $input.css({
                    'height': '38px',
                    'min-height': '38px',
                    'max-height': '38px'
                });
            }
            
            // Create a chip element
            function createChipElement(value, option, isInPopover) {
                const chipText = (option && option.text) ? option.text : value;
                const $item = $('<div class="modern-multi-select-item' + (isInPopover ? ' popover-item' : '') + '" data-value="' + value + '"></div>');
                $item.html('<span>' + chipText + '</span><span class="modern-multi-select-item-remove">×</span>');
                return $item;
            }
            
            // Render selected items with overflow handling
            function renderSelectedItems() {
                if ($itemsContainer.length === 0) {
                    return;
                }
                
                // CRITICAL: Validate that we're rendering for the correct combo
                const wrapperFieldName = $wrapper.attr('data-field-name');
                const wrapperComboId = $wrapper.attr('data-combo-instance-id');
                
                if (wrapperFieldName !== thisFieldName) {
                    console.error('[ModernMultiSelect] ❌ CRITICAL MISMATCH in renderSelectedItems!', {
                        wrapperFieldName: wrapperFieldName,
                        expectedFieldName: thisFieldName,
                        wrapperComboId: wrapperComboId,
                        expectedComboId: thisComboInstanceId,
                        selectedValues: selectedValues
                    });
                    return; // Don't render - something is wrong
                }
                
                // CRITICAL: Also verify against stored data
                const storedFieldName = $select.data('field-name-stored');
                if (storedFieldName && storedFieldName !== thisFieldName) {
                    console.error('[ModernMultiSelect] ❌ CRITICAL: Select element field mismatch!', {
                        storedFieldName: storedFieldName,
                        expectedFieldName: thisFieldName
                    });
                    return;
                }
                
                console.log('[ModernMultiSelect] 🎨 renderSelectedItems for', thisFieldName, ':', selectedValues, 'ComboId:', thisComboInstanceId);
                
                // Clear containers
                $itemsContainer.empty();
                // Don't clear popover content here - it will be populated when badge is clicked
                // CRITICAL: Don't close popover if it's currently open (user is removing items)
                const isPopoverOpen = $overflowBadge.hasClass('active') && 
                                    $overflowPopover.is(':visible') &&
                                    $overflowPopover[0] && 
                                    $overflowPopover[0].style.getPropertyValue('display') !== 'none';
                
                if (!isPopoverOpen) {
                    // Only clear and close if popover is not open
                    $overflowPopoverContent.empty();
                    closeOverflowPopover();
                }
                // Don't clear badge if popover is open - it will be updated by remove handler
                if (!isPopoverOpen) {
                    $overflowBadge.empty();
                    $overflowBadge.attr('data-visible', 'false');
                }
                
                if (selectedValues.length === 0) {
                    $itemsContainer.html('<span style="color: #94a3b8;">--- انتخاب کنید ---</span>');
                    updateInputHeight();
                    return;
                }
                
                // Prepare all chips data
                const allChips = [];
                selectedValues.forEach(function(value) {
                    const valueStr = String(value);
                    
                    // CRITICAL: Use cache first for better performance and consistency
                    let option = getOptionByValue(valueStr);
                    
                    // If option not found in cache, try to get it from the select element's options
                    if (!option) {
                        const $selectOption = $select.find('option[value="' + value + '"]');
                        if ($selectOption.length > 0) {
                            const text = $selectOption.text().trim() || value;
                            option = {
                                value: value,
                                text: text
                            };
                            // Add to cache for future use
                            addToCache(value, text);
                        } else {
                            // Fallback: use value as text with indicator
                            option = {
                                value: value,
                                text: value + ' (ID)'
                            };
                        }
                    }
                    
                    allChips.push({ value: value, option: option });
                });
                
                // First, render all chips temporarily to calculate visible count
                allChips.forEach(function(chipData) {
                    const $chip = createChipElement(chipData.value, chipData.option, false);
                    $itemsContainer.append($chip);
                });
                
                // Force a reflow to measure
                $itemsContainer[0].offsetHeight;
                
                // Calculate how many chips can fit
                const visibleCount = calculateVisibleChipsCount();
                const overflowCount = selectedValues.length - visibleCount;
                // Clear and render only visible chips
                $itemsContainer.empty();
                
                if (overflowCount > 0) {
                    // Render visible chips
                    for (let i = 0; i < visibleCount; i++) {
                        const chipData = allChips[i];
                        const $chip = createChipElement(chipData.value, chipData.option, false);
                        $itemsContainer.append($chip);
                    }
                    
                    // Render overflow badge - just show count, no "بیشتر" text
                    $overflowBadge.html('<span>+' + overflowCount + '</span>');
                    $overflowBadge.attr('data-visible', 'true');
                    $overflowBadge.css({
                        'display': 'flex', // Force show
                        'margin-left': 'auto' // Push to right
                    });
                    
                    // Render ALL chips in popover (card view shows all selections)
                    if (!isPopoverOpen) {
                        allChips.forEach(function(chipData) {
                            const $chip = createChipElement(chipData.value, chipData.option, true);
                            $overflowPopoverContent.append($chip);
                        });
                    }
                } else {
                    // Render all chips (no overflow)
                    allChips.forEach(function(chipData) {
                        const $chip = createChipElement(chipData.value, chipData.option, false);
                        $itemsContainer.append($chip);
                    });
                    // Clear badge when no overflow
                    $overflowBadge.empty();
                    $overflowBadge.attr('data-visible', 'false');
                }
                // All styles are handled by CSS - no need for inline styles
                // Dynamic max-width for items container based on overflow
                if (overflowCount > 0) {
                    $itemsContainer.css('max-width', 'calc(100% - 100px)');
                } else {
                    $itemsContainer.css('max-width', 'calc(100% - 30px)');
                }
                
                // Update height
                updateInputHeight();
            }
            
            // Update input height based on content (fixed at 38px for single line)
            function updateInputHeight() {
                // Fixed height for single line - no need to calculate
                $input.css({
                    'height': '38px',
                    'min-height': '38px',
                    'max-height': '38px'
                });
