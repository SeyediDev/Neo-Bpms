                }
                
                // Prepare all chips data
                const allChips = [];
                selectedValues.forEach(function(value) {
                    const valueStr = String(value);
                    let option = allOptions.find(function(opt) { 
                        return String(opt.value) === valueStr || opt.value == value || String(opt.value) == valueStr; 
                    });
                    
                    // If option not found, try to get it from the select element's options
                    if (!option) {
                        const $selectOption = $select.find('option[value="' + value + '"]');
                        if ($selectOption.length > 0) {
