                    });
                    if (!option) {
                        const $selectOption = $select.find('option[value="' + val + '"]');
                        if ($selectOption.length > 0) {
                            option = {
                                value: val,
                                text: $selectOption.text().trim() || val
                            };
                        } else {
                            option = { value: val, text: val };
                        }
                    }
                    if (option) {
                        allChips.push({ value: val, option: option });
                    }
                });
                
                // Render visible chips
                for (let i = 0; i < Math.min(visibleCount, allChips.length); i++) {
                    const chipData = allChips[i];
                    const $chip = createChipElement(chipData.value, chipData.option, false);
                    $itemsContainer.append($chip);
                }
                
                // Update badge count
                const overflowCount = selectedValues.length - visibleCount;
                if (overflowCount > 0) {
                    $overflowBadge.html('<span>+' + overflowCount + '</span>');
                    $overflowBadge.attr('data-visible', 'true');
                } else {
                    $overflowBadge.empty();
                    $overflowBadge.attr('data-visible', 'false');
                    // Only close if no items left at all
                    if (selectedValues.length === 0) {
                        closeOverflowPopover();
                    }
                }
                
                // CRITICAL: Ensure popover stays open
                if ($overflowPopover.length > 0 && $overflowPopover[0]) {
                    $overflowPopover[0].style.setProperty('display', 'flex', 'important');
                    $overflowPopover[0].style.setProperty('visibility', 'visible', 'important');
                    $overflowPopover[0].style.setProperty('opacity', '1', 'important');
                    $overflowPopover[0].style.setProperty('pointer-events', 'auto', 'important');
                }
                $overflowBadge.addClass('active'); // Ensure badge stays active
                
                console.log('[ModernMultiSelect] Popover should stay open, content count:', $overflowPopoverContent.children().length);
                
                return false;
            });
            
            // Prevent input click from closing dropdown when clicking on items container or remove button
            $itemsContainer.off('click.preventToggle').on('click.preventToggle', function(e) {
                // If clicking on remove button or item, prevent toggle
                if ($(e.target).closest('.modern-multi-select-item-remove').length > 0 ||
                    $(e.target).closest('.modern-multi-select-item').length > 0) {
                    e.stopPropagation();
                    return false;
                }
            });
            
            // Close popover when clicking outside (but not when clicking remove button)
            $(document).on('click.modernMultiSelectOverflow_' + fieldName, function(e) {
                // Don't close if clicking on remove button or inside popover
                if ($(e.target).closest('.modern-multi-select-item-remove').length > 0) {
                    return; // Don't close when clicking remove button
                }
                
                if (!$overflowPopover.is(e.target) && 
                    $overflowPopover.has(e.target).length === 0 &&
                    !$overflowBadge.is(e.target) &&
                    $overflowBadge.has(e.target).length === 0) {
                    closeOverflowPopover();
                }
            });
            
            // Close on outside click - Use namespace to avoid conflicts
            $(document).on('click.modernMultiSelect_' + fieldName, function(e) {
                if (!$wrapper.is(e.target) && $wrapper.has(e.target).length === 0) {
                    closeDropdown();
                    closeOverflowPopover();
                }
            });
            
            // Initialize
            renderSelectedItems();
            updateInputHeight(); // Set initial height
            // Only render options if we have them (don't render empty state initially)
            if (allOptions.length > 1) {
                renderOptions(); // Render options initially so they're ready when dropdown opens
            }
            
            // Force show wrapper and ensure it's visible with inline styles
            $wrapper.attr('style', 'display: block !important; visibility: visible !important; opacity: 1 !important; width: 100% !important; position: relative !important; margin-bottom: 12px !important; clear: both !important;');
            $input.attr('style', 'display: flex !important; align-items: flex-start !important; justify-content: flex-start !important; min-height: 38px !important; height: auto !important; max-height: none !important; padding: 8px 12px !important; border: 1px solid #e2e8f0 !important; border-radius: 6px !important; background: white !important; cursor: pointer !important; flex-wrap: wrap !important; overflow: hidden !important; width: 100% !important; box-sizing: border-box !important; position: relative !important;');
            
            // Ensure select is completely hidden
            $select.attr('style', 'display: none !important; position: absolute !important; left: -9999px !important; opacity: 0 !important; visibility: hidden !important; width: 0 !important; height: 0 !important;');
            
            console.log('[ModernMultiSelect] Successfully converted select:', $select.attr('name'));
            console.log('[ModernMultiSelect] Wrapper visible:', $wrapper.is(':visible'), 'Display:', $wrapper.css('display'), 'Computed:', window.getComputedStyle($wrapper[0]).display);
            console.log('[ModernMultiSelect] Select hidden:', $select.is(':hidden'), 'Display:', $select.css('display'));
            
            // Debug: Verify wrapper is in DOM and visible
            setTimeout(function() {
                const wrapperInDOM = $.contains(document.body, $wrapper[0]) || $('#filterTooltipPanel').find($wrapper).length > 0;
                const computedDisplay = window.getComputedStyle($wrapper[0]).display;
                const computedVisibility = window.getComputedStyle($wrapper[0]).visibility;
                console.log('[ModernMultiSelect] Wrapper in DOM:', wrapperInDOM, 'Computed display:', computedDisplay, 'Computed visibility:', computedVisibility, 'for:', $select.attr('name'));
                if (!wrapperInDOM || computedDisplay === 'none') {
                    console.error('[ModernMultiSelect] Wrapper not visible! DOM:', wrapperInDOM, 'Display:', computedDisplay);
                }
            }, 100);
        });
        
        console.log('[ModernMultiSelect] Finished converting', allSelects.length, 'selects');
    }
    
    // Initialize custom modern multi-select control
    function initializeCustomModernMultiSelect($control, $hiddenInput) {
        const $input = $control.find('.modern-multi-select-input');
        const $itemsContainer = $control.find('.modern-multi-select-items');
        const $searchInput = $control.find('.modern-multi-select-search');
        const $dropdown = $control.find('.modern-multi-select-dropdown');
        const $options = $control.find('.modern-multi-select-options');
        const $arrow = $control.find('.modern-multi-select-arrow');
        
        let isOpen = false;
        let selectedValues = [];
        let allOptions = [];
        let isLoading = false;
        
        // Parse initial values
        const initialValue = $hiddenInput.val();
        if (initialValue) {
            selectedValues = initialValue.split(',').filter(v => v.trim() !== '');
        }
        
        // Load data from API
        function loadData() {
            if (isLoading) return;
            isLoading = true;
            
            const fieldName = $control.data('field-name');
            const isRemote = $control.data('is-remote');
            const filterFormula = $control.data('filter-formula');
            
            // Show loading state
            $options.html('<div class="modern-multi-select-loading">در حال بارگذاری...</div>');
            
            // Prepare request data
            const requestData = {
                fieldName: fieldName,
                isRemote: isRemote,
                filterFormula: filterFormula,
                searchTerm: $searchInput.val() || ''
            };
            
            // Call GetComboData API
            $.ajax({
                url: window.top.rootUrl + 'Form/GetComboData',
                type: 'POST',
                data: requestData,
                headers: window.AddAntiForgeryToken(),
                success: function(response) {
                    if (response && response.data) {
                        allOptions = response.data;
                        renderOptions();
                        updateOptionStates();
                    }
                    isLoading = false;
                },
                error: function(xhr, status, error) {
                    $options.html('<div class="modern-multi-select-error">خطا در بارگذاری داده‌ها</div>');
                    isLoading = false;
                }
            });
        }
        
        // Render options
        function renderOptions() {
            $options.empty();
            allOptions.forEach(option => {
                const $option = $(`
                    <div class="modern-multi-select-option" data-value="${option.value}">
                        <div class="modern-multi-select-option-checkbox"></div>
                        <div class="modern-multi-select-option-text">${option.text}</div>
                    </div>
                `);
                $options.append($option);
            });
        }
        
        // Update hidden input
        function updateHiddenInput() {
            $hiddenInput.val(selectedValues.join(',')).trigger('change');
        }
        
        // Render selected items
        function renderSelectedItems() {
            $itemsContainer.empty();
            selectedValues.forEach(value => {
                const option = allOptions.find(opt => opt.value === value);
                if (option) {
                    const $item = $(`
                        <div class="modern-multi-select-item" data-value="${value}">
                            <span class="modern-multi-select-item-text">${option.text}</span>
                            <span class="modern-multi-select-item-remove">×</span>
                        </div>
                    `);
                    $itemsContainer.append($item);
                }
            });
        }
        
        // Update option states
        function updateOptionStates() {
            $options.find('.modern-multi-select-option').each(function() {
                const $option = $(this);
                const value = $option.data('value');
                const isSelected = selectedValues.includes(value);
                
                $option.toggleClass('selected', isSelected);
            });
        }
        
        // Toggle dropdown
        function toggleDropdown() {
            isOpen = !isOpen;
            $control.toggleClass('open', isOpen);
            $dropdown.toggle(isOpen);
            
            if (isOpen) {
                $searchInput.focus();
                if (allOptions.length === 0) {
                    loadData();
                } else {
                    updateOptionStates();
                }
            }
        }
        
        // Close dropdown
        function closeDropdown() {
            isOpen = false;
            $control.removeClass('open');
            $dropdown.hide();
            $searchInput.val('');
        }
        
        // Add item
        function addItem(value) {
            if (!selectedValues.includes(value)) {
                selectedValues.push(value);
                renderSelectedItems();
                updateOptionStates();
                updateHiddenInput();
            }
        }
        
        // Remove item
        function removeItem(value) {
            selectedValues = selectedValues.filter(v => v !== value);
            renderSelectedItems();
            updateOptionStates();
            updateHiddenInput();
        }
        
        // Filter options
        function filterOptions(searchTerm) {
            if (searchTerm && searchTerm.length > 0) {
                // Reload data with search term
                loadData();
            } else {
                // Show all options
                renderOptions();
                updateOptionStates();
            }
        }
        
        // Event handlers
        $input.on('click', function(e) {
            e.stopPropagation();
            toggleDropdown();
        });
        
        $arrow.on('click', function(e) {
            e.stopPropagation();
            toggleDropdown();
        });
        
        $searchInput.on('input', function() {
            const searchTerm = $(this).val();
            filterOptions(searchTerm);
        });
        
        $searchInput.on('keydown', function(e) {
            if (e.key === 'Escape') {
                closeDropdown();
            }
        });
        
        // Option click
        $options.on('click', '.modern-multi-select-option', function(e) {
            e.stopPropagation();
            const $option = $(this);
            const value = $option.data('value');
            
            if (selectedValues.includes(value)) {
                removeItem(value);
            } else {
                addItem(value);
            }
        });
        
        // Remove item click
        $itemsContainer.on('click', '.modern-multi-select-item-remove', function(e) {
            e.stopPropagation();
            const $item = $(this).closest('.modern-multi-select-item');
            const value = $item.data('value');
            removeItem(value);
        });
        
        // Close on outside click
        $(document).on('click', function(e) {
            if (!$control.is(e.target) && $control.has(e.target).length === 0) {
                closeDropdown();
            }
        });
        
        // Initialize
        renderSelectedItems();
    }
    
    // Export for global access - Available immediately when this script loads
    // CRITICAL: This must be available before popular-filters.cshtml runs
    window.initializeReportModernMultiSelect = initializeModernMultiSelect;
    
    // Verify function is exported immediately
    if (typeof window.initializeReportModernMultiSelect !== 'function') {
        console.error('[ReportMultiSelect] ❌ FAILED to export initializeReportModernMultiSelect!');
        throw new Error('Failed to export initializeReportModernMultiSelect');
    }
    
    // Auto-initialize when document is ready (if ModernMultiSelect is available)
    $(document).ready(function() {
        // Wait a bit to ensure ModernMultiSelect plugin is loaded
        setTimeout(function() {
            if (typeof ModernMultiSelect !== 'undefined') {
                initializeModernMultiSelect();
            }
            // Note: If ModernMultiSelect is not available, initialization will happen when called
        }, 100);
    });
    
})(jQuery);
</script>

