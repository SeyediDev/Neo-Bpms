            // Calculate how many chips can fit in the container
            function calculateVisibleChipsCount() {
                // Get container width
                const containerWidth = $input.width() || $input[0].offsetWidth || 300;
                const arrowWidth = 30; // Space for arrow
                const badgeWidth = 90; // Space for overflow badge (estimate)
                const padding = 24; // Left + right padding
                
                // First pass: try without badge
                let availableWidth = containerWidth - arrowWidth - padding;
                const testChips = $itemsContainer.find('.modern-multi-select-item');
                
                if (testChips.length > 0) {
                    let totalWidth = 0;
                    let count = 0;
                    const maxTestCount = Math.min(20, testChips.length);
                    
                    // Try fitting chips without badge
                    for (let i = 0; i < maxTestCount; i++) {
                        const chipWidth = $(testChips[i]).outerWidth(true) || 120; // Include margin
                        totalWidth += chipWidth;
                        count++;
                        
                        if (totalWidth > availableWidth) {
                            // Need badge, recalculate with badge space
                            availableWidth = containerWidth - arrowWidth - badgeWidth - padding;
                            totalWidth = 0;
                            count = 0;
                            
                            // Recalculate with badge space
                            for (let j = 0; j < maxTestCount; j++) {
                                const chipWidth2 = $(testChips[j]).outerWidth(true) || 120;
                                totalWidth += chipWidth2;
                                count++;
                                
                                if (totalWidth > availableWidth) {
                                    return Math.max(1, count - 1);
                                }
                            }
                            
                            return Math.min(selectedValues.length, count);
                        }
                    }
                    
                    // All chips fit without badge
                    return Math.min(selectedValues.length, count);
                }
                
                // Fallback: estimate based on average chip width
                const avgChipWidth = 120;
                const estimatedCount = Math.floor(availableWidth / avgChipWidth);
                return Math.max(1, Math.min(selectedValues.length, estimatedCount));
            }
            
