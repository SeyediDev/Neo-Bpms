            // Close dropdown
            function closeDropdown() {
                if (!isOpen) return; // Already closed
                isOpen = false;
                // CRITICAL: Reset isLoading when closing dropdown to prevent stuck state
                isLoading = false;
                $wrapper.removeClass('open');
                $dropdown.css({
                    'display': 'none',
                    'visibility': 'hidden',
                    'opacity': '0'
                });
                $searchInput.val('');
                // Clear search filter if not remote
                if (!isRemote && allOptions.length > 1) {
                    renderOptions(); // Restore all options
                }
            }
            
            // Filter options
            function filterOptions(searchTerm) {
                if (isRemote) {
                    // For remote data, reload from server with search term
                    loadDataFromServer(searchTerm);
                } else {
                    // For local data, filter in memory
                    const filtered = allOptions.filter(function(option) {
                        if (!option || !option.text) return false;
                        return option.text.toLowerCase().includes(searchTerm.toLowerCase());
                    });
                    
                    $options.empty();
                    if (filtered.length === 0) {
                        $options.html('<div style="padding: 20px; text-align: center; color: #64748b;">نتیجه‌ای یافت نشد</div>');
                    } else {
                        filtered.forEach(function(option) {
                            const isSelected = selectedValues.includes(option.value);
                            const $option = $('<div class="modern-multi-select-option' + (isSelected ? ' selected' : '') + '" data-value="' + (option.value || '') + '"></div>');
                            $option.html('<span>' + (isSelected ? '✓' : '') + '</span><span>' + option.text + '</span>');
                            $options.append($option);
                        });
                    }
                }
            }
            
            // Event handlers - Use event delegation for dynamic content
            $input.on('click', function(e) {
                // Don't toggle if clicking on remove button or item
                if ($(e.target).closest('.modern-multi-select-item-remove').length > 0 ||
                    $(e.target).closest('.modern-multi-select-item').length > 0) {
                    return false;
                }
                
                e.preventDefault();
                e.stopPropagation();
                toggleDropdown();
            });
            
            $arrow.on('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                toggleDropdown();
            });
            
            // Prevent dropdown from closing when clicking inside
            $dropdown.on('click', function(e) {
                e.stopPropagation();
                // Allow clicks to propagate to options
                if ($(e.target).closest('.modern-multi-select-option').length > 0) {
                    return true; // Let option click handler work
                }
            });
            
            // Ensure dropdown and options are clickable
            $dropdown.css('pointer-events', 'auto');
            $options.css('pointer-events', 'auto');
            
            // Add debounce for search input to wait for user to finish typing
            let searchTimeout = null;
            $searchInput.on('input', function() {
                const searchTerm = $(this).val();
                
                // Clear previous timeout
                if (searchTimeout) {
                    clearTimeout(searchTimeout);
                }
                
                // Wait 500ms after user stops typing before searching
                searchTimeout = setTimeout(function() {
                    console.log('[ModernMultiSelect] 🔍 Search debounced, filtering with term:', searchTerm, 'Field:', fieldName);
                    filterOptions(searchTerm);
                }, 500); // 500ms delay
            });
            
            $searchInput.on('keydown', function(e) {
                if (e.key === 'Escape') {
                    closeDropdown();
                }
            });
            
            // Use event delegation for options (they're dynamically created)
            // CRITICAL: Use direct event binding on options container, not wrapper
            $options.on('click', '.modern-multi-select-option', function(e) {
                e.preventDefault();
                e.stopPropagation();
                e.stopImmediatePropagation();
                
                const $option = $(this);
                const value = $option.data('value');
                if (value === '' || value === null || value === undefined) {
                    // Empty option - clear all selections
                    selectedValues = [];
                } else if (selectedValues.includes(value)) {
                    // Deselect if already selected
                    selectedValues = selectedValues.filter(function(v) { return v !== value && v !== ''; });
                } else {
                    // Select new value - remove empty option if exists
                    selectedValues = selectedValues.filter(function(v) { return v !== ''; });
                    selectedValues.push(value);
                    console.log('Filter Panel: After push, selectedValues =', selectedValues);
                }
                console.log('Filter Panel: Calling renderSelectedItems with selectedValues:', selectedValues);
                renderSelectedItems();
                renderOptions();
                updateSelect();
                updateInputHeight(); // Update height after selection
                
                // Don't close dropdown on selection (allow multiple selections)
                return false;
            });
            
            // Also bind on wrapper as fallback
            $wrapper.on('click', '.modern-multi-select-option', function(e) {
                e.preventDefault();
                e.stopPropagation();
                e.stopImmediatePropagation();
                
                const $option = $(this);
                const value = $option.data('value');
                if (value === '' || value === null || value === undefined) {
                    selectedValues = [];
                } else {
                    // Use loose equality to handle type mismatches
                    const isAlreadySelected = selectedValues.some(function(v) { 
                        return String(v) === String(value) || v == value; 
                    });
                    
                    if (isAlreadySelected) {
                        selectedValues = selectedValues.filter(function(v) { 
                            return String(v) !== String(value) && v != value && v !== ''; 
                        });
                    } else {
                        selectedValues = selectedValues.filter(function(v) { return v !== ''; });
                        selectedValues.push(value);
                    }
                }
                renderSelectedItems();
                renderOptions();
                updateSelect();
                updateInputHeight(); // Update height after selection
                
