                    $dropdown[0].style.setProperty('margin-top', '0px', 'important'); // Compact: remove empty gap above search box
                    $dropdown[0].style.setProperty('max-height', '324px', 'important'); /* Reduced by 10%: 360px * 0.9 = 324px */
                    $dropdown[0].style.setProperty('overflow', 'hidden', 'important'); /* Hidden to allow overflow-y to work */
                    $dropdown[0].style.setProperty('overflow-y', 'auto', 'important'); /* Scroll on dropdown - search stays fixed */
                    $dropdown[0].style.setProperty('overflow-x', 'hidden', 'important');
                    $dropdown[0].style.setProperty('height', 'auto', 'important');
                    $dropdown[0].style.setProperty('min-height', '135px', 'important'); /* Reduced by 10%: 150px * 0.9 = 135px */
                    
                    // Ensure search input is visible
