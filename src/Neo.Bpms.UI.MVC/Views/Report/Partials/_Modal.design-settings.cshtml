@using Neo.Bpms.Domain.Entities.Cmmn.UI

@using Neo.Bpms.Domain.Models.Cmmn.UI.Reports
@using Neo.Bpms.UI.Resources.Resources
@model ReportData

@{
    var structure = Model.Structure;
}

<style>
    /* Design Settings Modal - Bootstrap Modal Style */
    /* CRITICAL: Ensure modal container itself has correct dimensions and positioning */
    #designSettingsModal.modal.show,
    #designSettingsModal.modal.fade.show {
        display: block !important;
        position: fixed !important;
        top: 0 !important;
        left: 0 !important;
        width: 100% !important;
        height: 100% !important;
        z-index: 10080 !important;
        overflow-x: hidden !important;
        overflow-y: auto !important;
    }
    
    #designSettingsModal .modal-dialog {
        max-width: 420px !important;
        width: 420px !important;
        min-width: 320px !important;
        margin: 1.75rem auto !important;
        display: block !important;
        position: relative !important;
        transform: none !important;
    }
    
    #designSettingsModal .modal-content {
        border-radius: 16px;
        border: none;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
        overflow: hidden;
        display: block !important;
        width: 100% !important;
        min-height: 200px !important;
        position: relative !important;
    }
    
    #designSettingsModal .modal-header {
        background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
        color: white;
        border-bottom: none;
        padding: 20px;
    }
    
    #designSettingsModal .modal-title {
        font-size: 18px;
        font-weight: 700;
    }
    
    #designSettingsModal .modal-body {
        padding: 16px;
        max-height: 500px;
        overflow-y: auto;
    }

    /* Sections */

    .design-settings-section {
        margin-bottom: 20px;
    }

    .design-settings-section:last-child {
        margin-bottom: 0;
    }

    .design-settings-section-title {
        font-size: 14px;
        font-weight: 600;
        color: #374151;
        margin-bottom: 12px;
        padding-bottom: 8px;
        border-bottom: 1px solid #e5e7eb;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .design-settings-link {
        display: flex;
        align-items: center;
        padding: 12px 16px;
        margin-bottom: 8px;
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        text-decoration: none;
        color: inherit;
        transition: all 0.2s ease;
        cursor: pointer;
    }

    .design-settings-link:hover {
        background: #f8fafc;
        border-color: #3b82f6;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(59, 130, 246, 0.15);
        text-decoration: none;
        color: inherit;
    }

    .design-settings-link:active {
        transform: translateY(0);
        box-shadow: 0 2px 6px rgba(59, 130, 246, 0.2);
    }

    .design-settings-link-icon {
        width: 40px;
        height: 40px;
        background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-left: 12px;
        flex-shrink: 0;
    }

    .design-settings-link:hover .design-settings-link-icon {
        background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%);
    }

    .design-settings-link-icon svg,
    .design-settings-link-icon i {
        color: #6b7280;
        transition: color 0.2s ease;
    }

    .design-settings-link:hover .design-settings-link-icon svg,
    .design-settings-link:hover .design-settings-link-icon i {
        color: #3b82f6;
    }

    .design-settings-link-content {
        flex: 1;
        min-width: 0;
    }

    .design-settings-link-title {
        font-size: 15px;
        font-weight: 600;
        color: #1f2937;
        margin-bottom: 2px;
        line-height: 1.3;
    }

    .design-settings-link-desc {
        font-size: 12px;
        color: #6b7280;
        line-height: 1.4;
    }

    .design-settings-link-arrow {
        font-size: 16px;
        color: #9ca3af;
        margin-right: 8px;
        transition: all 0.2s ease;
    }

    .design-settings-link:hover .design-settings-link-arrow {
        color: #3b82f6;
        transform: translateX(2px);
    }

    /* Scrollbar */
    #designSettingsModal .modal-body::-webkit-scrollbar {
        width: 6px;
    }

    #designSettingsModal .modal-body::-webkit-scrollbar-track {
        background: #f1f5f9;
        border-radius: 3px;
    }

    #designSettingsModal .modal-body::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 3px;
    }

    #designSettingsModal .modal-body::-webkit-scrollbar-thumb:hover {
        background: #94a3b8;
    }
</style>

<!-- Design Settings Modal -->
<div class="modal fade" id="designSettingsModal" tabindex="-1" role="dialog" aria-labelledby="designSettingsModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="designSettingsModalLabel">تنظیمات گزارش</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="color: white; opacity: 0.9;">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
        <div class="design-settings-section">
            <div class="design-settings-section-title">تنظیمات اصلی</div>
            
            <a class="design-settings-link" href="#" data-action="open-modal-from-design-settings" data-target="#columnsSettingsModal-@structure.ConfigId">
                <div class="design-settings-link-icon">
                    <svg style="width: 20px;height: 20px;vertical-align: middle;" viewBox="0 0 24 24">
                        <use xlink:href="/Content/common-assets-includes/icons/svgSprite.svg#setting-row-icon" />
                    </svg>
                </div>
                <div class="design-settings-link-content">
                    <div class="design-settings-link-title">تنظیمات ستون‌ها</div>
                    <div class="design-settings-link-desc">مدیریت نمایش ستون‌ها</div>
                </div>
                <div class="design-settings-link-arrow">→</div>
            </a>
            
            <a class="design-settings-link" href="#" data-action="open-modal-from-design-settings" data-target="#ordersSettingsModal-@structure.ConfigId">
                <div class="design-settings-link-icon">
                    <svg style="width: 20px;height: 20px;vertical-align: middle;" viewBox="0 0 24 24">
                        <use xlink:href="/Content/common-assets-includes/icons/svgSprite.svg#setting-order-icon" />
                    </svg>
                </div>
                <div class="design-settings-link-content">
                    <div class="design-settings-link-title">تنظیمات ترتیب</div>
                    <div class="design-settings-link-desc">مدیریت مرتب‌سازی داده‌ها</div>
                </div>
                <div class="design-settings-link-arrow">→</div>
            </a>
            
            @if (structure.ReportViewType.In(ReportViewType.List, ReportViewType.GroupByList))
            {
                <a class="design-settings-link" href="#" data-action="open-modal-from-design-settings" data-target="#colorsSettingsModal-@structure.ConfigId">
                    <div class="design-settings-link-icon">
                        <svg style="width: 20px;height: 20px;vertical-align: middle;" viewBox="0 0 24 24">
                            <use xlink:href="/Content/common-assets-includes/icons/svgSprite.svg#setting-color-icon" />
                        </svg>
                    </div>
                    <div class="design-settings-link-content">
                        <div class="design-settings-link-title">تنظیمات رنگ</div>
                        <div class="design-settings-link-desc">مدیریت رنگ‌بندی سطرهای گزارش</div>
                    </div>
                    <div class="design-settings-link-arrow">→</div>
                </a>
            }
            
            @if (structure.ReportViewType == ReportViewType.Chart && structure.ChartType.In(ChartType.Gauge, ChartType.MetricBox))
            {
                <a class="design-settings-link" href="#" data-action="open-modal-from-design-settings" data-target="#reportSettingsModal-@structure.ConfigId">
                    <div class="design-settings-link-icon">
                        <i class="fa fa-area-chart"></i>
                    </div>
                    <div class="design-settings-link-content">
                        <div class="design-settings-link-title">تنظیمات چارت</div>
                        <div class="design-settings-link-desc">مدیریت نمودارها</div>
                    </div>
                    <div class="design-settings-link-arrow">→</div>
                </a>
            }
        </div>
        
        <div class="design-settings-section">
            <div class="design-settings-section-title">گزارشات فرعی</div>
            
            @if (structure.ReportViewType.In(ReportViewType.List, ReportViewType.GroupByList))
            {
                <a class="design-settings-link" href="#" data-action="open-subreport-modal" data-subreport-type="inline" data-namespace="@Html.Raw(structure.NamespaceId)" data-entity="@Html.Raw(structure.EntityId)" data-report="@Html.Raw(structure.Form_ReportId)" data-config="@Html.Raw(structure.ConfigId)">
                    <div class="design-settings-link-icon">
                        <svg style="width: 20px;height: 20px;vertical-align: middle;" viewBox="0 0 24 24">
                            <use xlink:href="/Content/common-assets-includes/icons/svgSprite.svg#setting-internal-icon" />
                        </svg>
                    </div>
                    <div class="design-settings-link-content">
                        <div class="design-settings-link-title">گزارش فرعی داخلی</div>
                        <div class="design-settings-link-desc">افزودن گزارش فرعی درون صفحه</div>
                    </div>
                    <div class="design-settings-link-arrow">→</div>
                </a>
            }
            
            <a class="design-settings-link" href="#" data-action="open-subreport-modal" data-subreport-type="linked" data-namespace="@Html.Raw(structure.NamespaceId)" data-entity="@Html.Raw(structure.EntityId)" data-report="@Html.Raw(structure.Form_ReportId)" data-config="@Html.Raw(structure.ConfigId)">
                <div class="design-settings-link-icon">
                    <svg style="width: 20px;height: 20px;vertical-align: middle;" viewBox="0 0 24 24">
                        <use xlink:href="/Content/common-assets-includes/icons/svgSprite.svg#setting-link-icon" />
                    </svg>
                </div>
                <div class="design-settings-link-content">
                    <div class="design-settings-link-title">گزارش فرعی پیوندی</div>
                    <div class="design-settings-link-desc">افزودن گزارش فرعی پیوندی</div>
                </div>
                <div class="design-settings-link-arrow">→</div>
            </a>
        </div>
            </div>
        </div>
    </div>
</div>
