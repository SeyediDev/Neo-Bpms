@* report-modals.js - Modal Functions for Report Pages *@
<script>
/**
 * report-modals.js
 * Modal Functions for Report Pages
 */

// Toggle Report Designs Modal - Make it globally accessible
window.toggleReportDesignsModal = function(event) {
    if (event) {
        event.preventDefault();
        event.stopPropagation();
    }
    
    const modal = document.getElementById('report-designs-modal');
    if (!modal) {
        console.warn('Report designs modal not found');
        return;
    }
    
    const isShowing = modal.classList.contains('show');
    
    if (!isShowing) {
        modal.classList.add('show');
        document.body.style.overflow = 'hidden';
        
        // Initialize tree if not already initialized
        var $configsTree = $('#configs-tree-modal');
        if ($configsTree.length && !$configsTree.data('initialized')) {
            if (typeof window.configsTree !== 'undefined') {
                $configsTree.jstree({
                    'core': {
                        'data': window.configsTree,
                        "check_callback": true
                    },
                    "contextmenu": {
                        "select_node": false,
                        'items': function(node) {
                            if (typeof ConfigsTreeManager !== 'undefined' && ConfigsTreeManager.getContextMenu) {
                                return ConfigsTreeManager.getContextMenu(node);
                            }
                            return {};
                        }
                    },
                    "types": {
                        "default": {
                            "icon": (window.top && window.top.rootUrl ? window.top.rootUrl : '') + "Content/common-assets-includes/icons/folder.svg",
                            "valid_children": ["default", "Chart", "Chart.Column", "Chart.Bar", "Chart.Line", "Chart.Area", "Chart.Pie", "Chart.Spline", "Chart.Areaspline", "Chart.Scatter", "Chart.Treemap", "Chart.Gauge", "Chart.MetricBox", "Chart.IranMap", "Chart.WorldMap", "Chart.BpmnDiagram", "List", "ReportList", "GroupByList"]
                        },
                        "Chart": {
                            "icon": "fa fa-bar-chart",
                            "valid_children": []
                        },
                        // Chart types with specific icons based on GetChartType normalization
                        // GetChartType normalizes: IranMap/WorldMap/Treemap -> Treemap, others -> Column
                        "Chart.Column": { "icon": "fa fa-bar-chart", "valid_children": [] },
                        "Chart.Bar": { "icon": "fa fa-bar-chart", "valid_children": [] },
                        "Chart.Line": { "icon": "fa fa-line-chart", "valid_children": [] },
                        "Chart.Area": { "icon": "fa fa-area-chart", "valid_children": [] },
                        "Chart.Pie": { "icon": "fa fa-pie-chart", "valid_children": [] },
                        "Chart.Spline": { "icon": "fa fa-line-chart", "valid_children": [] },
                        "Chart.Areaspline": { "icon": "fa fa-area-chart", "valid_children": [] },
                        "Chart.Scatter": { "icon": "fa fa-dot-circle-o", "valid_children": [] },
                        "Chart.Treemap": { "icon": "fa fa-sitemap", "valid_children": [] }, // Normalized from IranMap/WorldMap/Treemap
                        "Chart.Gauge": { "icon": "fa fa-tachometer", "valid_children": [] },
                        "Chart.MetricBox": { "icon": "fa fa-cube", "valid_children": [] },
                        "Chart.IranMap": { "icon": "fa fa-map", "valid_children": [] },
                        "Chart.WorldMap": { "icon": "fa fa-globe", "valid_children": [] },
                        "Chart.BpmnDiagram": { "icon": "fa fa-project-diagram", "valid_children": [] },
                        "List": {
                            "icon": "fa fa-list",
                            "valid_children": []
                        },
                        "ReportList": {
                            "icon": "fa fa-list",
                            "valid_children": []
                        },
                        "GroupByList": {
                            "icon": "fa fa-table",
                            "valid_children": []
                        }
                    },
                    "conditionalselect": function (node, event) {
                        if (node.type === 'default')
                            return false;
                        // Allow selection and navigate to config
                        var navigateToConfig = function(configId) {
                            // Try multiple ways to access ConfigsTreeManager
                            if (typeof ConfigsTreeManager !== 'undefined' && ConfigsTreeManager.goToConfig) {
                                ConfigsTreeManager.goToConfig(configId);
                            } else if (typeof window.ConfigsTreeManager !== 'undefined' && window.ConfigsTreeManager.goToConfig) {
                                window.ConfigsTreeManager.goToConfig(configId);
                            } else if (window.top && typeof window.top.ConfigsTreeManager !== 'undefined' && window.top.ConfigsTreeManager.goToConfig) {
                                window.top.ConfigsTreeManager.goToConfig(configId);
                            } else {
                                // Fallback: direct navigation using PageAddressManager
                                var currentFilterId = (typeof FilterConfig !== 'undefined' && FilterConfig.getCurrentPageFilterId) ? FilterConfig.getCurrentPageFilterId() : null;
                                var queryParams = (typeof window.PageAddressManager !== 'undefined' && window.PageAddressManager.getQueryParameters) 
                                    ? window.PageAddressManager.getQueryParameters() 
                                    : '';
                                var url = 'Report?' + queryParams + '&ConfigId=' + configId + (currentFilterId ? ('&FilterId=' + currentFilterId) : '');
                                if (window.top && window.top.PageAddressManager && window.top.PageAddressManager.navigateTo) {
                                    window.top.PageAddressManager.navigateTo(url);
                                } else if (window.PageAddressManager && window.PageAddressManager.navigateTo) {
                                    window.PageAddressManager.navigateTo(url);
                                } else {
                                    window.location.href = url;
                                }
                            }
                        };
                        // Navigate after a short delay to allow visual selection feedback
                        setTimeout(function() {
                            navigateToConfig(node.id);
                        }, 150);
                        // Return true to allow selection (visual feedback)
                        return true;
                    },
                    "plugins": ["dnd", "contextmenu", "types", "conditionalselect", "wholerow", "search", "state"]
                });
                
                $('#configs-search-input-modal').off('keyup').on('keyup', function() {
                    $configsTree.jstree('search', $(this).val());
                });
                
                $configsTree.data('initialized', true);
            }
        }
    } else {
        modal.classList.remove('show');
        document.body.style.overflow = '';
    }
};

// Toggle Scheduling Modal - Make it globally accessible
window.toggleSchedulingModal = function(event) {
    if (event) {
        event.preventDefault();
        event.stopPropagation();
    }
    
    const modal = document.getElementById('scheduling-modal');
    if (!modal) {
        console.warn('Scheduling modal not found');
        return;
    }
    
    const isShowing = modal.classList.contains('show');
    
    if (!isShowing) {
        modal.classList.add('show');
        document.body.style.overflow = 'hidden';
        
        // Initialize tree if not already initialized
        var $scheduledTree = $('#scheduled-reports-tree-modal');
        if ($scheduledTree.length && !$scheduledTree.data('initialized')) {
            if (typeof window.scheduledReportsTree !== 'undefined') {
                $scheduledTree.jstree({
                    'core': {
                        'data': window.scheduledReportsTree,
                        "check_callback": true
                    },
                    "plugins": ["types", "wholerow", "state"]
                });
                $scheduledTree.data('initialized', true);
            }
        }
    } else {
        modal.classList.remove('show');
        document.body.style.overflow = '';
    }
};

// Open column settings modal with proper z-index management
window.openColumnSettingsModal = function(modalKey) {
    const modalId = 'columnsSettingsModal-' + modalKey;
    const modal = document.getElementById(modalId);
        
    if (modal) {
        // Use Bootstrap modal if available
        if (typeof $ !== 'undefined' && $.fn.modal) {
            $(modal).modal('show');
        } else {
            // Fallback to manual opening
            modal.style.display = 'block';
            modal.classList.add('show');
            modal.setAttribute('aria-hidden', 'false');
            
            // Get highest z-index and set new one
            const highestZIndex = typeof window.getHighestModalZIndex === 'function' 
                ? window.getHighestModalZIndex() 
                : 1050;
            const newZIndex = highestZIndex + 10;
            modal.style.zIndex = newZIndex.toString();
            
            // Create backdrop with proper z-index
            const backdrop = document.createElement('div');
            backdrop.className = 'modal-backdrop fade show';
            backdrop.id = 'modal-backdrop-' + modalKey;
            backdrop.style.zIndex = (newZIndex - 1).toString();
            document.body.appendChild(backdrop);
            
            document.body.classList.add('modal-open');
        }
            
        console.log('Column settings modal opened:', modalId);
    } else {
        console.error('Modal not found:', modalId);
    }
};
    
// Close modal function with proper cleanup
window.closeModal = function(modalId) {
    const modal = document.getElementById(modalId);
    if (modal) {
        // Use Bootstrap modal if available
        if (typeof $ !== 'undefined' && $.fn.modal) {
            $(modal).modal('hide');
        } else {
            // Fallback to manual closing
            modal.style.display = 'none';
            modal.classList.remove('show');
            modal.setAttribute('aria-hidden', 'true');
            
            // Remove backdrop
            const backdropId = 'modal-backdrop-' + modalId.replace('columnsSettingsModal-', '');
            const backdrop = document.getElementById(backdropId);
            if (backdrop) {
                backdrop.remove();
            }
            
            // Check if there are other open modals
            const remainingModals = document.querySelectorAll('.modal.show');
            if (remainingModals.length === 0) {
                document.body.classList.remove('modal-open');
            }
        }
    }
};

// Open config frame
$(document).ready(function() {
    $("#openConfigFrame").click(function() {
        $("#reportConfigModal .modal-body").html(
            "<iframe src='" +
            window.top.rootUrl +
            "Report/AddNewConfig?" +
            window.PageAddressManager.getQueryParameters()
            +
            "' style='width:100%; height:100%;' frameborder='0' allowtransparency='true'></iframe>");
        $('#reportConfigModal').modal('show');
    });
    
    // Handle Add Config button click in report-designs-modal
    // Use event delegation to handle dynamically added buttons
    $(document).on('click', '#btn-add-config-modal', function(e) {
        e.preventDefault();
        e.stopPropagation();
        
        console.log('btn-add-config-modal clicked');
        
        // Try to get ConfigsTreeManager from appropriate scope
        var manager = null;
        var managerSource = '';
        
        // Check window.top first (most likely location)
        if (window.top && window.top.ConfigsTreeManager) {
            if (typeof window.top.ConfigsTreeManager.showAddConfigModal === 'function') {
                manager = window.top.ConfigsTreeManager;
                managerSource = 'window.top';
            } else {
                console.warn('window.top.ConfigsTreeManager exists but showAddConfigModal is not a function');
            }
        }
        
        // Check current window
        if (!manager && window.ConfigsTreeManager) {
            if (typeof window.ConfigsTreeManager.showAddConfigModal === 'function') {
                manager = window.ConfigsTreeManager;
                managerSource = 'window';
            } else {
                console.warn('window.ConfigsTreeManager exists but showAddConfigModal is not a function');
            }
        }
        
        // Check global scope
        if (!manager && typeof ConfigsTreeManager !== 'undefined') {
            if (typeof ConfigsTreeManager.showAddConfigModal === 'function') {
                manager = ConfigsTreeManager;
                managerSource = 'global';
            } else {
                console.warn('ConfigsTreeManager exists but showAddConfigModal is not a function');
            }
        }
        
        if (manager) {
            console.log('Calling showAddConfigModal from', managerSource);
            try {
                manager.showAddConfigModal();
            } catch (error) {
                console.error('Error calling showAddConfigModal:', error);
                alert('Error opening modal: ' + error.message);
            }
        } else {
            console.error('ConfigsTreeManager not found or showAddConfigModal not available');
            console.log('window.top.ConfigsTreeManager:', window.top && window.top.ConfigsTreeManager);
            console.log('window.ConfigsTreeManager:', window.ConfigsTreeManager);
            console.log('ConfigsTreeManager:', typeof ConfigsTreeManager);
            alert('ConfigsTreeManager not available. Please refresh the page.');
        }
    });
    
    // Also handle the old onclick attribute if it still exists (for backward compatibility)
    $(document).on('click', '[onclick*="showAddConfigModal"]', function(e) {
        e.preventDefault();
        e.stopPropagation();
        console.log('Old onclick handler detected, redirecting to new handler');
        $('#btn-add-config-modal').trigger('click');
    });
    
    // Wait for ConfigsTreeManager to be available, then remove any onclick attributes
    var checkConfigsTreeManager = setInterval(function() {
        var manager = null;
        if (window.top && window.top.ConfigsTreeManager && typeof window.top.ConfigsTreeManager.showAddConfigModal === 'function') {
            manager = window.top.ConfigsTreeManager;
        } else if (window.ConfigsTreeManager && typeof window.ConfigsTreeManager.showAddConfigModal === 'function') {
            manager = window.ConfigsTreeManager;
        }
        
        if (manager) {
            clearInterval(checkConfigsTreeManager);
            // Remove onclick attribute from button if it exists
            var $btn = $('#btn-add-config-modal');
            if ($btn.length > 0 && $btn.attr('onclick')) {
                console.log('Removing onclick attribute from btn-add-config-modal');
                $btn.removeAttr('onclick');
            }
        }
    }, 100);
    
    // Stop checking after 5 seconds
    setTimeout(function() {
        clearInterval(checkConfigsTreeManager);
    }, 5000);
    
    // Global fallback function for onclick attribute
    window.showAddConfigModalFallback = function() {
        console.log('showAddConfigModalFallback called from onclick');
        var manager = null;
        if (window.top && window.top.ConfigsTreeManager && typeof window.top.ConfigsTreeManager.showAddConfigModal === 'function') {
            manager = window.top.ConfigsTreeManager;
        } else if (window.ConfigsTreeManager && typeof window.ConfigsTreeManager.showAddConfigModal === 'function') {
            manager = window.ConfigsTreeManager;
        }
        
        if (manager) {
            manager.showAddConfigModal();
        } else {
            console.error('ConfigsTreeManager not available in fallback');
            alert('ConfigsTreeManager not available. Please refresh the page.');
        }
    };
});
</script>

