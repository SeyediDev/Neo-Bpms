@using System.Linq
@using Neo.Bpms.Domain.Models.Cmmn.UI.ConfiguredItems
@using Neo.Bpms.Domain.Models.Cmmn.UI.Reports
@using Neo.Bpms.Infrastructure.Features.Cmmn.Forms.Common
@using Neo.Bpms.UI.MVC.PartialModels.Filter
@using Newtonsoft.Json
@using Microsoft.AspNetCore.Html
@model ReportData
	
@{
    var structure = Model?.Structure;
    var canDesign = ViewBag.CanDesign ?? false;
    var canPublishConfigs = ViewBag.CanPublishConfigs ?? false;
    var canScheduleReports = ViewBag.CanScheduleReports ?? false;
    
    var configsDictionary = new HtmlString(JsonConvert.SerializeObject((structure?.Configs ?? new List<ConfiguredReport>()).Select(cfg => new
    {
        Key = cfg.ConfigId,
        Value = new
        {
            alias = cfg.Name,
            access = cfg.AccessLevel,
            isdefault = cfg.IsDefault,
            folderId = cfg.FolderId,
            userGroup = cfg.Roles?.LastOrDefault()
        }
    }).ToDictionary(g => g.Key, g => g.Value)));

    var configsTree = new HtmlString(JsonConvert.SerializeObject(structure?.ConfigsTree ?? new List<ConfigTreeItem>()));
    var scheduledReportsTree = new HtmlString(JsonConvert.SerializeObject(structure?.ScheduledReportsTree ?? new List<ConfigTreeItem>()));
}

@* Initialize JavaScript Variables *@
<script>
    @if (structure != null)
    {
        @await Html.PartialAsync("Common/SetPageAddress", structure);
    }
    
    var configsJson = @Html.Raw(configsDictionary);
    var configsTree = @configsTree;
    var scheduledReportsTree = @scheduledReportsTree;
    
    @if (structure != null)
    {
        @await Html.PartialAsync("Filter/SetFiltersTreeData", new SetFiltersTreeDataModel { structure = structure });
    }
    
    var jsCanPublishConfigs = @(canPublishConfigs ? "true" : "false");
    var jsCanDesign = @(canDesign ? "true" : "false");
    
    // Add Anti-Forgery Token function
    window.AddAntiForgeryToken = function () {
        return { "__RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val() };
    };
</script>

@* FOUC Prevention Script *@
<script>
	(function() {
		// Apply styles to any elements that might have been rendered
		var applyStyles = function() {
			var elements = document.querySelectorAll('.icons-tables, .top-bar-anchor-icon, #sideNavi, .side-navi-item, .side-navi-data');
			for (var i = 0; i < elements.length; i++) {
				elements[i].style.display = 'none';
			}
		};
		
		// Apply immediately
		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', applyStyles);
		} else {
			applyStyles();
		}
		
		// Also apply after a short delay to catch any dynamically added elements
		setTimeout(applyStyles, 0);
		setTimeout(applyStyles, 50);
	})();
</script>

@* Functions are now loaded from report-toggles.js and report-modals.js in _Bundles.cshtml *@
@* No need for early definitions since JavaScript loads before HTML now *@

@* Modal and other JavaScript functions are now in Report.js *@

@* Page Ready Script - Show Icons After Styles Loaded (Page-specific, kept here) *@
<script>
    // Show icons and tabs after page is fully loaded to prevent FOUC
    (function() {
        var iconsShown = false;
        
        function showIconsAndTabs() {
            if (iconsShown) return;
            iconsShown = true;
            
            // Force a reflow to ensure styles are applied
            document.body.offsetHeight;
            
            // Add the class to show elements
            document.body.classList.add('page-ready');
            
            // Force another reflow
            document.body.offsetHeight;
            
            console.log('Page ready - Icons shown');
        }
        
        function checkStylesheetsLoaded() {
            var stylesheets = document.querySelectorAll('link[rel="stylesheet"]');
            var loadedCount = 0;
            var totalCount = stylesheets.length;
            
            if (totalCount === 0) {
                return true;
            }
            
            for (var i = 0; i < stylesheets.length; i++) {
                var sheet = stylesheets[i];
                try {
                    if (sheet.sheet) {
                        loadedCount++;
                    } else if (sheet.readyState === 'complete' || sheet.readyState === 'loaded') {
                        loadedCount++;
                    }
                } catch (e) {
                    loadedCount++;
                }
            }
            
            return loadedCount === totalCount;
        }
        
        // Method 1: Wait for window load (all resources including CSS)
        if (document.readyState === 'complete') {
            setTimeout(function() {
                if (checkStylesheetsLoaded()) {
                    showIconsAndTabs();
                } else {
                    setTimeout(showIconsAndTabs, 300);
                }
            }, 100);
        } else {
            window.addEventListener('load', function() {
                setTimeout(function() {
                    if (checkStylesheetsLoaded()) {
                        showIconsAndTabs();
                    } else {
                        setTimeout(showIconsAndTabs, 200);
                    }
                }, 200);
            });
        }
        
        // Method 2: Check when DOM is ready and stylesheets are loaded
        function checkAndShow() {
            if (checkStylesheetsLoaded()) {
                setTimeout(showIconsAndTabs, 300);
            } else {
                setTimeout(checkAndShow, 100);
            }
        }
        
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', function() {
                setTimeout(checkAndShow, 200);
            });
        } else {
            setTimeout(checkAndShow, 200);
        }
        
        // Fallback: Show after maximum delay (2 seconds)
        setTimeout(function() {
            showIconsAndTabs();
        }, 2000);
    })();
</script>

