	/* Override any min-height: 100vh on containers within report pages */
	#ReportContainer .row.no-margin-row,
	#ReportContainer .no-margin-row {
		min-height: auto !important;
		height: auto !important;
		padding-bottom: 0 !important;
		margin-bottom: 0 !important;
	}
	
	/* Remove padding/margin from form elements */
	body.report-page form,
	body.report-page #filter-form {
		margin-bottom: 0 !important;
		padding-bottom: 0 !important;
	}
	
	/* Ensure no extra space after ReportContainer */
	#ReportContainer:last-child,
	#ReportContainer + * {
		margin-top: 0 !important;
		padding-top: 0 !important;
		margin-bottom: 0 !important;
		padding-bottom: 0 !important;
	}
	
	/* Remove any extra spacing at the bottom */
	body:has(#ReportContainer) > *:last-child,
	body.report-page > *:last-child {
		margin-bottom: 0 !important;
		padding-bottom: 0 !important;
	}
</style>

@* Add class to body and html for browsers without :has() support + Fix scroll *@
<script>
	(function() {
		if (document.getElementById('ReportContainer')) {
			document.documentElement.classList.add('report-page');
			document.body.classList.add('report-page');
			
			// Fix page-body if it exists
			var pageBody = document.getElementById('page-body');
			if (pageBody) {
				pageBody.style.minHeight = 'auto';
				pageBody.style.height = 'auto';
				pageBody.style.paddingBottom = '0';
				pageBody.style.marginBottom = '0';
			}
			
			// Remove any extra padding/margin from body and html
			document.documentElement.style.minHeight = 'auto';
			document.documentElement.style.height = 'auto';
			document.documentElement.style.paddingBottom = '0';
			document.documentElement.style.marginBottom = '0';
			
			document.body.style.minHeight = 'auto';
			document.body.style.height = 'auto';
			document.body.style.paddingBottom = '0';
			document.body.style.marginBottom = '0';
			
			// Fix ReportContainer
			var reportContainer = document.getElementById('ReportContainer');
			if (reportContainer) {
				reportContainer.style.minHeight = 'auto';
				reportContainer.style.height = 'auto';
				reportContainer.style.paddingBottom = '0';
				reportContainer.style.marginBottom = '0';
			}
			
			// Fix customDiv
			var customDiv = reportContainer ? reportContainer.querySelector('.customDiv') : null;
			if (customDiv) {
				customDiv.style.paddingBottom = '0';
				customDiv.style.marginBottom = '0';
			}
			
			// Remove padding/margin from last child elements after page loads
			setTimeout(function() {
				var lastChild = document.body.lastElementChild;
				if (lastChild && lastChild.id !== 'ReportContainer') {
					lastChild.style.marginBottom = '0';
					lastChild.style.paddingBottom = '0';
				}
				
				// Also check for footer
				var footer = document.querySelector('.footer');
				if (footer) {
					footer.style.marginBottom = '0';
					footer.style.paddingBottom = '0';
					footer.style.height = 'auto';
					footer.style.minHeight = 'auto';
				}
			}, 100);
		}
	})();
</script>


