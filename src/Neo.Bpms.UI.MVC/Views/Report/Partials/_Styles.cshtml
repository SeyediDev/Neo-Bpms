@* Modal Z-Index Management Styles *@
<style>
    /* Ensure modals can have dynamic z-index */
    .modal {
        z-index: 1050 !important; /* Bootstrap default, will be overridden by JS */
    }
    
    .modal-backdrop {
        z-index: 1040 !important; /* Bootstrap default, will be overridden by JS */
    }
    
    /* Support for nested modals - each nested modal gets higher z-index */
    .modal.show {
        position: fixed !important;
    }
    
    /* Ensure modal-dialog is positioned correctly */
    .modal.show .modal-dialog {
        position: relative !important;
        z-index: inherit !important;
    }
    
    /* Multiple backdrops support */
    .modal-backdrop + .modal-backdrop {
        /* Each additional backdrop should be behind the previous one */
    }
</style>

@* Modal Styles for Report Designs and Scheduling - Scoped to prevent conflicts *@
<style>
    /* Report Modal Styles - Unique namespace to prevent conflicts with included CSS */
    /* These styles are specific to report page modals and won't conflict with other modals */
    #report-designs-modal.report-modal,
    #scheduling-modal.report-modal {
        position: fixed !important;
        top: 0 !important;
        left: 0 !important;
        width: 100% !important;
        height: 100% !important;
        background: rgba(0, 0, 0, 0.5) !important;
        z-index: 10000 !important;
        display: none !important;
        align-items: center !important;
        justify-content: center !important;
        backdrop-filter: blur(4px) !important;
    }
    
    #report-designs-modal.report-modal.show,
    #scheduling-modal.report-modal.show {
        display: flex !important;
    }
    
    #report-designs-modal .report-modal-content,
    #scheduling-modal .report-modal-content {
        background: #ffffff !important;
        border-radius: 12px !important;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2) !important;
        width: 90% !important;
        max-width: 800px !important;
        max-height: 85vh !important;
        display: flex !important;
        flex-direction: column !important;
        overflow: hidden !important;
        animation: report-modal-slide-in 0.3s ease !important;
        position: relative !important;
        z-index: 10001 !important;
    }
    
    /* Ensure buttons in modal are above modal content */
    #report-designs-modal .btn-group,
    #report-designs-modal .btn,
    #scheduling-modal .btn-group,
    #scheduling-modal .btn {
        position: relative !important;
        z-index: 10002 !important;
    }
    
    /* Ensure reportConfigModal has high z-index when shown */
    #reportConfigModal.modal.show {
        z-index: 10050 !important;
    }
    
    #reportConfigModal.modal.show ~ .modal-backdrop {
        z-index: 10049 !important;
    }
    
    /* Ensure new-folder-modal has high z-index when shown - higher than report-designs-modal (10000) */
    #new-folder-modal.modal.show,
    #new-folder-modal.modal.fade.show,
    #new-folder-modal.modal {
        z-index: 10070 !important;
    }
    
    /* Ensure backdrop for new-folder-modal is above report-designs-modal */
    /* When new-folder-modal is shown, its backdrop should be above report-designs-modal backdrop */
    body.modal-open .modal-backdrop:last-of-type {
        z-index: 10069 !important;
    }
    
    /* Specific backdrop for new-folder-modal - ensure it's above report-designs-modal */
    #new-folder-modal.modal.show ~ .modal-backdrop,
    #new-folder-modal.modal.show + .modal-backdrop {
        z-index: 10069 !important;
    }
    
    /* Fix radio buttons overlapping issue in new-folder-modal */
    #new-folder-modal .custom-control {
        position: relative !important;
        z-index: auto !important;
        display: inline-block !important;
        margin-right: 1rem !important;
    }
    
    #new-folder-modal .custom-control-input {
        position: absolute !important;
        z-index: 1 !important;
        opacity: 0 !important;
    }
    
    #new-folder-modal .custom-control-label {
        position: relative !important;
        z-index: 2 !important;
        cursor: pointer !important;
    }
    
    #new-folder-modal .custom-control-inline {
        display: inline-block !important;
        margin-right: 1rem !important;
    }
    
    /* Ensure buttons in report-designs-modal are clickable even when new-folder-modal backdrop is shown */
    #report-designs-modal.report-modal.show {
        z-index: 10000 !important;
    }
    
    #report-designs-modal .report-modal-content {
        z-index: 10001 !important;
    }
    
    #report-designs-modal .btn-group,
    #report-designs-modal .btn {
        z-index: 10002 !important;
        position: relative !important;
    }
    
    @@keyframes report-modal-slide-in {
        from {
            opacity: 0;
            transform: translateY(-20px) scale(0.95);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }
    
    #report-designs-modal .report-modal-header,
    #scheduling-modal .report-modal-header {
        padding: 20px 24px !important;
        border-bottom: 1px solid #e9ecef !important;
        display: flex !important;
        justify-content: space-between !important;
        align-items: center !important;
        background: linear-gradient(135deg, #1869AA 0%, #3b82f6 100%) !important;
        color: #ffffff !important;
    }
    
    #report-designs-modal .report-modal-header h5,
    #scheduling-modal .report-modal-header h5 {
        margin: 0 !important;
        font-size: 18px !important;
        font-weight: 600 !important;
    }
    
    #report-designs-modal .report-modal-close,
    #scheduling-modal .report-modal-close {
        background: rgba(255, 255, 255, 0.2) !important;
        border: none !important;
        color: #ffffff !important;
        width: 32px !important;
        height: 32px !important;
        border-radius: 50% !important;
        cursor: pointer !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        transition: all 0.2s ease !important;
    }
    
    #report-designs-modal .report-modal-close:hover,
    #scheduling-modal .report-modal-close:hover {
        background: rgba(255, 255, 255, 0.3) !important;
        transform: rotate(90deg) !important;
    }
    
    #report-designs-modal .report-modal-body,
    #scheduling-modal .report-modal-body {
        padding: 20px 24px !important;
        overflow-y: auto !important;
        flex: 1 !important;
    }
    
    #report-designs-modal .report-tree-container,
    #scheduling-modal .report-tree-container {
        min-height: 300px !important;
        padding: 12px !important;
        background: #f8f9fa !important;
        border-radius: 8px !important;
        border: 1px solid #e9ecef !important;
    }
    
    #report-designs-modal .search-box,
    #scheduling-modal .search-box {
        margin-bottom: 16px !important;
    }
    
    /* Responsive - Scoped to report modals only */
    @@media (max-width: 768px) {
        #report-designs-modal .report-modal-content,
        #scheduling-modal .report-modal-content {
            width: 95% !important;
            max-height: 90vh !important;
        }
        
        #report-designs-modal .report-modal-header,
        #scheduling-modal .report-modal-header {
            padding: 16px 20px !important;
        }
        
        #report-designs-modal .report-modal-body,
        #scheduling-modal .report-modal-body {
            padding: 16px 20px !important;
        }
        
        /* Responsive icons - Scoped to report page only */
        .reportHeader .top-page .icons,
        .top-page .icons {
            flex-wrap: wrap !important;
            gap: 4px !important;
        }
        
        .reportHeader .top-page .icons a,
        .top-page .icons a {
            min-width: 40px !important;
            width: 40px !important;
            height: 40px !important;
            padding: 6px !important;
        }
        
        .reportHeader .top-page .icons svg,
        .top-page .icons svg {
            width: 18px !important;
            height: 18px !important;
        }
    }
    
    /* Smooth scrollbar - Scoped to report tree containers */
    #report-designs-modal .report-tree-container::-webkit-scrollbar,
    #scheduling-modal .report-tree-container::-webkit-scrollbar {
        width: 8px !important;
    }
    
    #report-designs-modal .report-tree-container::-webkit-scrollbar-track,
    #scheduling-modal .report-tree-container::-webkit-scrollbar-track {
        background: #f1f1f1 !important;
        border-radius: 4px !important;
    }
    
    #report-designs-modal .report-tree-container::-webkit-scrollbar-thumb,
    #scheduling-modal .report-tree-container::-webkit-scrollbar-thumb {
        background: #cbd5e0 !important;
        border-radius: 4px !important;
    }
    
    #report-designs-modal .report-tree-container::-webkit-scrollbar-thumb:hover,
    #scheduling-modal .report-tree-container::-webkit-scrollbar-thumb:hover {
        background: #a0aec0 !important;
    }
</style>

@* Critical CSS to prevent FOUC - Must be at the very top *@
<style id="fouc-prevention-style">
	/* CSS Variables for icon sizes - Prevents size changes */
	:root {
		--report-icon-size: 42px;
		--report-icon-svg-size: 22px;
		--report-icon-svg-small-size: 20px;
		--report-icon-border-radius: 8px;
	}
	
	/* Hide icons, tabs, and side navigation initially - Critical inline styles */
	.icons-tables,
	.top-bar-anchor-icon,
	.sideNavi-top-bar .icons-tables,
	.side-navi-body .icons-tables,
	#sideNavi,
	.side-navi-item,
	.side-navi-data {
		display: none !important;
	}
	
	/* Critical: Set icon sizes immediately to prevent FOUC */
	.icons-tables,
	.top-bar-anchor-icon {
		width: var(--report-icon-size) !important;
		height: var(--report-icon-size) !important;
		min-width: var(--report-icon-size) !important;
		min-height: var(--report-icon-size) !important;
		max-width: var(--report-icon-size) !important;
		max-height: var(--report-icon-size) !important;
		box-sizing: border-box !important;
	}
	
	.icons-tables svg,
	.top-bar-anchor-icon svg {
		width: var(--report-icon-svg-size) !important;
		height: var(--report-icon-svg-size) !important;
		max-width: var(--report-icon-svg-size) !important;
		max-height: var(--report-icon-svg-size) !important;
		box-sizing: border-box !important;
	}
	
	/* Specific size for smaller icons (16px) */
	.top-bar-anchor-icon svg {
		width: var(--report-icon-svg-small-size) !important;
		height: var(--report-icon-svg-small-size) !important;
		max-width: var(--report-icon-svg-small-size) !important;
		max-height: var(--report-icon-svg-small-size) !important;
	}
	
	/* Show side navigation after page is ready with critical styles */
	body.page-ready #sideNavi {
		display: block !important;
		position: fixed !important;
		right: 50px !important;
		z-index: 30000 !important;
	}
	
	body.page-ready .side-navi-item {
		display: inline-block !important;
		position: absolute !important;
		left: 20px !important;
		width: 150px !important;
		height: 50px !important;
		transform: rotate(-90deg) !important;
		transform-origin: left top 0 !important;
		cursor: pointer !important;
		box-shadow: 0px 0px 5px #888888 !important;
		border-radius: 5px 5px 0 0 !important;
		background-color: white !important;
		pointer-events: auto !important;
		z-index: 30002 !important;
	}
	
	body.page-ready .side-navi-item.active {
		background-color: #f8f9fa !important;
	}
	
	body.page-ready .side-navi-item > div {
		text-align: center !important;
		font-size: smaller !important;
	}
	
	body.page-ready .side-navi-data {
		position: absolute !important;
		top: 0 !important;
		left: 50px !important;
		width: 400px !important;
		height: 100vh !important;
		box-shadow: 0px 0px 5px #888888 !important;
		z-index: 30001 !important;
		background-color: white !important;
		overflow: visible !important;
	}
	
	body.page-ready .side-navi-tab {
		display: none !important;
	}
	
	body.page-ready .side-navi-tab.active {
		display: block !important;
		width: 100% !important;
		height: 100% !important;
	}
	
	/* Show icons and tabs after page is ready with critical styles */
	/* Scoped to report page only to prevent conflicts */
	/* Using CSS variables to ensure consistent sizing */
	body.page-ready .reportHeader .icons-tables,
	body.page-ready .top-page .icons-tables {
		display: inline-flex !important;
		align-items: center !important;
		justify-content: center !important;
		width: var(--report-icon-size) !important;
		height: var(--report-icon-size) !important;
		min-width: var(--report-icon-size) !important;
		min-height: var(--report-icon-size) !important;
		max-width: var(--report-icon-size) !important;
		max-height: var(--report-icon-size) !important;
		border-radius: var(--report-icon-border-radius) !important;
		opacity: 1 !important;
		transition: all 0.2s ease !important;
		margin: 0 4px !important;
		box-sizing: border-box !important;
	}
	
	body.page-ready .reportHeader .top-bar-anchor-icon,
	body.page-ready .top-page .top-bar-anchor-icon,
	body.page-ready .sideNavi-top-bar .icons-tables,
	body.page-ready .side-navi-body .icons-tables {
		display: inline-block !important;
		width: var(--report-icon-size) !important;
		height: var(--report-icon-size) !important;
		min-width: var(--report-icon-size) !important;
		min-height: var(--report-icon-size) !important;
		max-width: var(--report-icon-size) !important;
		max-height: var(--report-icon-size) !important;
		opacity: 1 !important;
		transition: opacity 0.2s ease-in !important;
		color: #1869AA !important;
		cursor: pointer !important;
		text-decoration: none !important;
		vertical-align: middle !important;
		box-sizing: border-box !important;
	}
	
	/* Ensure design-menu button is always visible when page is ready */
	/* Override any inline styles that might hide it */
	body.page-ready #design-menu,
	body.page-ready .inline-dropdown #design-menu,
	body.page-ready .dropdown.inline-dropdown #design-menu {
		display: inline-block !important;
		visibility: visible !important;
		opacity: 1 !important;
	}
	
	/* Force display even if inline style is set */
	#design-menu[style*="display: none"],
	#design-menu[style*="display:none"] {
		display: inline-block !important;
	}
	
	body.page-ready .reportHeader .icons-tables svg,
	body.page-ready .top-page .icons-tables svg {
		width: var(--report-icon-svg-size) !important;
		height: var(--report-icon-svg-size) !important;
		max-width: var(--report-icon-svg-size) !important;
		max-height: var(--report-icon-svg-size) !important;
		display: block !important;
		box-sizing: border-box !important;
	}
	
	body.page-ready .reportHeader .top-bar-anchor-icon svg,
	body.page-ready .top-page .top-bar-anchor-icon svg {
		display: inline-block !important;
		width: var(--report-icon-svg-small-size) !important;
		height: var(--report-icon-svg-small-size) !important;
		max-width: var(--report-icon-svg-small-size) !important;
		max-height: var(--report-icon-svg-small-size) !important;
		vertical-align: middle !important;
		box-sizing: border-box !important;
	}
	
	body.page-ready .reportHeader .icons-tables.text-success,
	body.page-ready .reportHeader .top-bar-anchor-icon.text-success,
	body.page-ready .top-page .icons-tables.text-success,
	body.page-ready .top-page .top-bar-anchor-icon.text-success {
		color: #28a745 !important;
	}
	
	body.page-ready .reportHeader .icons-tables.text-primary,
	body.page-ready .reportHeader .top-bar-anchor-icon.text-primary,
	body.page-ready .top-page .icons-tables.text-primary,
	body.page-ready .top-page .top-bar-anchor-icon.text-primary {
		color: #1869AA !important;
	}
	
	body.page-ready .reportHeader .icons-tables.text-danger,
	body.page-ready .reportHeader .top-bar-anchor-icon.text-danger,
	body.page-ready .top-page .icons-tables.text-danger,
	body.page-ready .top-page .top-bar-anchor-icon.text-danger {
		color: #dc3545 !important;
	}
	
	/* Ensure scheduling icon is rightmost (last in RTL) - Scoped to report page */
	.reportHeader .icons,
	.top-page .icons {
		display: flex !important;
		padding-right: 28px !important;
		padding-left: 8px !important;
	}
	
	.reportHeader .scheduling-icon-rightmost,
	.top-page .scheduling-icon-rightmost {
		order: -1 !important;
	}
	
	@@keyframes pulse {
		0% {
			transform: scale(1);
		}
		50% {
			transform: scale(1.05);
		}
		100% {
			transform: scale(1);
		}
	}
</style>

