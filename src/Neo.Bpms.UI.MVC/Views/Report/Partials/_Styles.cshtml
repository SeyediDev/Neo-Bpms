@* Critical CSS to prevent FOUC - Must be at the very top *@
<style id="fouc-prevention-style">
	/* CSS Variables for icon sizes - Prevents size changes */
	:root {
		--report-icon-size: 42px;
		--report-icon-svg-size: 22px;
		--report-icon-svg-small-size: 20px;
		--report-icon-border-radius: 8px;
	}
	
	/* Hide icons, tabs, and side navigation initially - Critical inline styles */
	.icons-tables,
	.top-bar-anchor-icon,
	.sideNavi-top-bar .icons-tables,
	.side-navi-body .icons-tables,
	#sideNavi,
	.side-navi-item,
	.side-navi-data {
		display: none !important;
	}
	
	/* Critical: Set icon sizes immediately to prevent FOUC */
	.icons-tables,
	.top-bar-anchor-icon {
		width: var(--report-icon-size) !important;
		height: var(--report-icon-size) !important;
		min-width: var(--report-icon-size) !important;
		min-height: var(--report-icon-size) !important;
		max-width: var(--report-icon-size) !important;
		max-height: var(--report-icon-size) !important;
		box-sizing: border-box !important;
	}
	
	.icons-tables svg,
	.top-bar-anchor-icon svg {
		width: var(--report-icon-svg-size) !important;
		height: var(--report-icon-svg-size) !important;
		max-width: var(--report-icon-svg-size) !important;
		max-height: var(--report-icon-svg-size) !important;
		box-sizing: border-box !important;
	}
	
	/* Specific size for smaller icons (16px) */
	.top-bar-anchor-icon svg {
		width: var(--report-icon-svg-small-size) !important;
		height: var(--report-icon-svg-small-size) !important;
		max-width: var(--report-icon-svg-small-size) !important;
		max-height: var(--report-icon-svg-small-size) !important;
