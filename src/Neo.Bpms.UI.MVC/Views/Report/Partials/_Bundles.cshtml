@{
    var canScheduleReports = ViewBag.CanScheduleReports ?? false;
}

@* Required JavaScript Bundles *@
<script src="@CommonBundles.SideNaviJsBundle" asp-append-version="true"></script>
<link href="@CommonBundles.JsTreeCssBundle" asp-append-version="true" rel="stylesheet" />
<script src="@CommonBundles.JsTreeJsBundle" asp-append-version="true"></script>
<script src="@CommonBundles.FlagsJsBundle" asp-append-version="true"></script>
<script src="@CommonBundles.TreeFoldersJsBundle" asp-append-version="true"></script>
<script src="@CommonBundles.ReportConfigsTreeJsBundle" asp-append-version="true"></script>
@* Report Design Bundle - Contains SubReportManager *@
<script src="@CommonBundles.ReportDesignJsBundle" asp-append-version="true"></script>

@if (canScheduleReports)
{
    <script src="@CommonBundles.ReportSchedulesTreeJsBundle" asp-append-version="true"></script>
}

<script src="@CommonBundles.FiltersTreeJsBundle" asp-append-version="true"></script>
<script src="~/CommonAssets/bundles/report-tree-cleanup.js" asp-append-version="true"></script>

@* Report Feature Scripts - Modular Structure (loaded in dependency order) *@
@* All scripts are embedded as partial views to avoid path issues *@
@* Load multi-select scripts BEFORE popular-filters so initializeReportModernMultiSelect is available *@
<script src="~/Scripts/common-assets-includes/features/modern/modern-multi-select.js"></script>
@await Html.PartialAsync("Partials/_Scripts.report-modern-multi-select")
<partial name="Partials/_Scripts.filter" />
<partial name="Partials/_Scripts.popular-filters" />
<partial name="Partials/_Scripts.toggles" />
<partial name="Partials/_Scripts.modal-zindex" />
<partial name="Partials/_Scripts.modal-designs" />
<partial name="Partials/_Scripts.modal-scheduling" />
<partial name="Partials/_Scripts.modal-column-settings" />
<partial name="Partials/_Scripts.modal-column-settings-functions" />
<partial name="Partials/_Scripts.modal-order-settings-functions" />
<partial name="Partials/_Scripts.modal-colors-settings-functions" />
<partial name="Partials/_Scripts.modal-add-config" />
<partial name="Partials/_Scripts.filter-parameter" />
<partial name="Partials/_Scripts.refresh" />
<partial name="Partials/_Scripts.config" />
<partial name="Partials/_Scripts.report-settings" />
@* Event Manager must be loaded AFTER all functions are defined *@
<partial name="Partials/_Scripts.event-manager" />
<partial name="Partials/_Scripts.events" />

@* Multi-select scripts moved above to load before popular-filters *@
<script src="@CommonBundles.LaddaJsBundle" asp-append-version="true"></script>
<link rel="stylesheet" href="~/Content/common-assets-includes/common-plugins/global/ladda/ladda-themeless.min.css" />
<script src="@CommonBundles.IndexPagesJsBundle" asp-append-version="true"></script>
<script src="~/Content/common-assets-includes/features/filter/boolean-button-group.js" asp-append-version="true"></script>
@* Verification script - Ensure all required functions are loaded *@
<script>
    (function() {
        // Global error handler to catch undefined variable errors
        window.addEventListener('error', function(event) {
            // Suppress "is not defined" errors for common namespace/entity IDs that might be used as variables
            if (event.message && event.message.includes('is not defined')) {
                var errorMessage = event.message;
                // Check if it's a common namespace/entity ID being used incorrectly
                if (errorMessage.match(/\b(Customers|Entities|Reports|Configs)\s+is not defined/i)) {
                    console.warn('Report: Suppressed error (likely from bundle):', errorMessage);
                    event.preventDefault(); // Prevent error from breaking execution
                    return false;
                }
            }
        }, true); // Use capture phase
        
        var requiredFunctions = [
            'toggleReportInfo',
            'toggleRefreshSettings',
            'toggleFilterTooltip',
            'toggleDesignSettings',
            'toggleReportDesignsModal',
            'toggleSchedulingModal',
            'hideDesignSettingsTooltip',
            'submitReportFilter',
            'openColumnSettingsModal',
            'closeModal',
            'toggleFilterParameterTooltip',
            'selectFilterParameter',
            'deleteConfigId'
        ];
        
        var missingFunctions = [];
        requiredFunctions.forEach(function(funcName) {
            if (typeof window[funcName] === 'undefined') {
                missingFunctions.push(funcName);
            }
        });
        
        if (missingFunctions.length > 0) {
            console.error('Report: Missing required functions:', missingFunctions);
        } else {
            console.log('Report: All required functions loaded successfully');
        }
        
        // Verify initializeReportModernMultiSelect is loaded (critical for filter tooltip)
        if (typeof window.initializeReportModernMultiSelect !== 'function') {
            console.error('Report: initializeReportModernMultiSelect NOT loaded! Filter multi-select will not work.');
        }
    })();
</script>

