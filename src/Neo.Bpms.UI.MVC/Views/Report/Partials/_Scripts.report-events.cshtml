@* report-events.js - Additional Event Handlers for Report Pages *@
<script>
/**
 * report-events.js
 * Additional Event Handlers for Report Pages
 * Note: Main event handling is done by ReportEventManager (report-event-manager.cshtml)
 */

$(document).ready(function() {
    // Direct event listener for design settings button as fallback
    // This ensures the button works even if Event Manager has issues
    setTimeout(function() {
        const designMenuButton = document.getElementById('design-menu');
        if (designMenuButton) {
            console.log('Adding direct event listener to design-menu button');
            
            // Ensure button is visible (remove inline display:none if exists)
            if (designMenuButton.style.display === 'none') {
                designMenuButton.style.display = '';
                console.log('Removed display:none from design-menu button');
            }
            
            designMenuButton.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                console.log('Direct click handler for design-menu');
                if (typeof window.toggleDesignSettings === 'function') {
                    window.toggleDesignSettings(e);
                } else {
                    console.error('toggleDesignSettings function not found in direct handler');
                }
            });
        } else {
            console.warn('design-menu button not found');
        }
    }, 100);
    
    // Also ensure button is visible when page is ready
    if (document.body.classList.contains('page-ready')) {
        setTimeout(function() {
            const designMenuButton = document.getElementById('design-menu');
            if (designMenuButton && designMenuButton.style.display === 'none') {
                designMenuButton.style.display = '';
                console.log('Page ready: Removed display:none from design-menu button');
            }
        }, 200);
    }
    
    // Watch for changes to design-menu button display property
    setTimeout(function() {
        const designMenuButton = document.getElementById('design-menu');
        if (designMenuButton && typeof MutationObserver !== 'undefined') {
            const observer = new MutationObserver(function(mutations) {
                mutations.forEach(function(mutation) {
                    if (mutation.type === 'attributes' && mutation.attributeName === 'style') {
                        if (designMenuButton.style.display === 'none') {
                            designMenuButton.style.display = '';
                            console.log('MutationObserver: Removed display:none from design-menu button');
                        }
                    }
                });
            });
            observer.observe(designMenuButton, {
                attributes: true,
                attributeFilter: ['style']
            });
        }
    }, 300);
    
    // Close modals when clicking on backdrop
    document.addEventListener('click', function(e) {
        const designsModal = document.getElementById('report-designs-modal');
        const schedulingModal = document.getElementById('scheduling-modal');
        
        if (designsModal && e.target === designsModal) {
            if (typeof window.toggleReportDesignsModal === 'function') {
                window.toggleReportDesignsModal(null);
            }
        }
        
        if (schedulingModal && e.target === schedulingModal) {
            if (typeof window.toggleSchedulingModal === 'function') {
                window.toggleSchedulingModal(null);
            }
        }
    });
    
    // Fix dropdown positioning
    const dropdownToggles = document.querySelectorAll('[data-toggle="dropdown"]');
    dropdownToggles.forEach(function(toggle) {
        toggle.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            
            const dropdown = this.nextElementSibling;
            if (dropdown && dropdown.classList.contains('dropdown-menu')) {
                const rect = this.getBoundingClientRect();
                dropdown.style.position = 'fixed';
                dropdown.style.top = (rect.bottom + 5) + 'px';
                dropdown.style.left = (rect.left) + 'px';
                dropdown.style.zIndex = '999999';
                dropdown.classList.toggle('show');
            }
        });
    });
});
</script>

