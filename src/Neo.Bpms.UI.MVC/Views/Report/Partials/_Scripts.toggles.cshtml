@* report-toggles.js - Toggle Functions for Report Info, Filter, Refresh Settings, and Design Settings *@
<script>
/**
 * report-toggles.js
 * Toggle Functions for Report Info, Filter, Refresh Settings, and Design Settings
 */

// Toggle report info tooltip
window.toggleReportInfo = function(event) {
    if (event) {
        event.preventDefault();
        event.stopPropagation();
    }

    const panel = document.getElementById('reportInfoPanel');
    const toggle = event ? event.target.closest('a') : document.querySelector('[data-action="toggle-report-info"]');

    if (panel && toggle) {
        // Hide all other tooltips first
        const allPanels = document.querySelectorAll('.report-info-panel');
        allPanels.forEach(p => {
            if (p !== panel) {
                p.classList.remove('show');
                p.style.setProperty('visibility', 'hidden', 'important');
                p.style.setProperty('opacity', '0', 'important');
                p.style.setProperty('pointer-events', 'none', 'important');
            }
        });

        // Toggle current panel
        if (!panel.classList.contains('show')) {
            // CRITICAL: Always move panel to body to avoid parent hiding issues
            const currentParent = panel.parentElement;
            if (!document.body.contains(panel) || (currentParent && currentParent !== document.body)) {
                // Store current styles before moving
                const currentTop = panel.style.top;
                const currentLeft = panel.style.left;
                document.body.appendChild(panel);
                // Restore styles after moving
                if (currentTop) panel.style.top = currentTop;
                if (currentLeft) panel.style.left = currentLeft;
            }
            
            // Get button position
            const toggleRect = toggle.getBoundingClientRect();
            
            // Position tooltip relative to toggle button
            panel.style.setProperty('position', 'fixed', 'important');
            panel.style.setProperty('top', (toggleRect.bottom + 8) + 'px', 'important');
            panel.style.setProperty('right', (window.innerWidth - toggleRect.right) + 'px', 'important');
            panel.style.setProperty('z-index', '10000', 'important');
            panel.style.setProperty('display', 'flex', 'important');
            panel.style.setProperty('visibility', 'visible', 'important');
            panel.style.setProperty('opacity', '1', 'important');
            panel.style.setProperty('pointer-events', 'auto', 'important');
            
            panel.classList.add('show');
            toggle.classList.add('active');
            
            // Force reflow to ensure visibility
            void panel.offsetHeight;
        } else {
            panel.classList.remove('show');
            panel.style.setProperty('visibility', 'hidden', 'important');
            panel.style.setProperty('opacity', '0', 'important');
            panel.style.setProperty('pointer-events', 'none', 'important');
            toggle.classList.remove('active');
        }
    } else {
        console.error('Report info: Panel or toggle not found', {
            panel: !!panel,
            toggle: !!toggle
        });
    }
};

// Toggle refresh settings tooltip
window.toggleRefreshSettings = function(event) {
