@using Neo.Bpms.Domain.Models.Cmmn.UI.Reports
@model ReportData

@{
    var canDesign = ViewBag.CanDesign ?? false;
    var canScheduleReports = ViewBag.CanScheduleReports ?? false;
}

@* ============================================
   Main Feature Modals
   ============================================ *@

@* Report Designs Modal - Tree view for managing report configurations *@
@* Note: canDesign check is also inside _Modal.designs.cshtml for standalone usage *@
<partial name="Partials/_Modal.designs" model="Model" />

@* Scheduling Modal - Tree view for managing scheduled reports *@
@* Note: canScheduleReports check is also inside _Modal.scheduling.cshtml for standalone usage *@
@if (canScheduleReports)
{
    <partial name="Partials/_Modal.scheduling" model="Model" />
}

@* ============================================
   Configuration Modals
   ============================================ *@

@* Report Settings Modal - Configure report settings (name, access, etc.) *@
@if (canDesign)
{
    <partial name="Partials/_modal.settings" model="Model" />
}

@* Sleeping Modals - Config config modal, folder modal, scheduled report modal *@
<partial name="Partials/_Modal.sleeping" model="Model" />

@* Add Sub Report Modal - Add sub-report to main report *@
<partial name="Partials/_Modal.add-sub-report" />

@* ============================================
   Column and Display Modals
   ============================================ *@

@* Column Settings Modal - Configure column settings *@
<partial name="Partials/_Modal.column-settings" model="Model" />

@* Order By Modal - Configure sorting order *@
<partial name="Partials/_Modal.order-by" model="Model" />

@* Colors Modal - Configure conditional formatting colors *@
<partial name="Partials/_Modal.colors" model="Model" />

@* ============================================
   UI Helper Modals and Tooltips
   ============================================ *@

@* Drill Down Menu - Context menu for drill-down functionality *@
<partial name="Partials/_Modal.drill-down" />

@* Filter Tooltip - Tooltip for filter configuration *@
<partial name="Partials/_Modal.filter-tooltip" model="Model" />

@* Design Settings - Design settings panel *@
<partial name="Partials/_Modal.design-settings" model="Model" />

@* Report Info - Report information tooltip *@
<partial name="Partials/_Modal.report-info" />

@* Refresh Settings - Refresh settings panel *@
<partial name="Partials/_Modal.refresh-settings" />
