<partial name="~/Views/Report/Partials/_Modal.add-sub-report.cshtml"/>

<style>
	.label-right { text-align: right !important; }
	
	/* ============================================
	   MODERN SCHEDULE MODAL - COMPLETE REDESIGN
	   ============================================ */
	
	.schedule-modal-container {
		border-radius: 20px;
		overflow: hidden;
		box-shadow: 0 25px 70px rgba(0, 0, 0, 0.2);
		border: none;
		background: #ffffff;
	}
	
	/* Header */
	.schedule-modal-header {
		background: linear-gradient(135deg, #1869AA 0%, #1e40af 100%);
		color: white;
		padding: 24px 32px;
		border-bottom: none;
		position: relative;
		overflow: hidden;
	}
	
	.schedule-modal-header::before {
		content: '';
		position: absolute;
		top: -50%;
		right: -50%;
		width: 200%;
		height: 200%;
		background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
		animation: pulse 8s ease-in-out infinite;
	}
	
	@@keyframes pulse {
		0%, 100% { transform: scale(1); opacity: 0.5; }
		50% { transform: scale(1.1); opacity: 0.8; }
	}
	
	.header-content {
		display: flex;
		align-items: center;
		gap: 16px;
		position: relative;
		z-index: 1;
	}
	
	.header-icon {
		width: 48px;
		height: 48px;
		background: rgba(255,255,255,0.2);
		border-radius: 12px;
		display: flex;
		align-items: center;
		justify-content: center;
		backdrop-filter: blur(10px);
	}
	
	.header-icon svg {
		width: 24px;
		height: 24px;
		color: white;
	}
	
	.header-text {
		flex: 1;
	}
	
	.schedule-modal-header .modal-title {
		margin: 0;
		font-size: 22px;
		font-weight: 700;
		color: white;
		letter-spacing: -0.5px;
	}
	
	.modal-subtitle {
		margin: 4px 0 0 0;
		font-size: 14px;
		color: rgba(255,255,255,0.9);
		font-weight: 400;
	}
	
	.close-btn {
		position: relative;
		z-index: 1;
		width: 40px;
		height: 40px;
		border-radius: 10px;
		background: rgba(255,255,255,0.1);
		border: none;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		transition: all 0.3s ease;
		padding: 0;
	}
	
	.close-btn svg {
		width: 20px;
		height: 20px;
		color: white;
		stroke-width: 2.5;
	}
	
	.close-btn:hover {
		background: rgba(255,255,255,0.2);
		transform: rotate(90deg);
	}
	
	/* Body */
	.schedule-modal-body {
		padding: 32px;
		max-height: 75vh;
		overflow-y: auto;
		background: #f8fafc;
	}
	
	.schedule-modal-body::-webkit-scrollbar {
		width: 8px;
	}
	
	.schedule-modal-body::-webkit-scrollbar-track {
		background: #e2e8f0;
		border-radius: 4px;
	}
	
	.schedule-modal-body::-webkit-scrollbar-thumb {
		background: #cbd5e1;
		border-radius: 4px;
	}
	
	.schedule-modal-body::-webkit-scrollbar-thumb:hover {
		background: #94a3b8;
	}
	
	/* Sections */
	.schedule-section {
		background: white;
		border-radius: 16px;
		margin-bottom: 24px;
		box-shadow: 0 2px 8px rgba(0,0,0,0.04);
		overflow: hidden;
		transition: all 0.3s ease;
		border: 1px solid #e2e8f0;
	}
	
	.schedule-section:hover {
		box-shadow: 0 4px 16px rgba(0,0,0,0.08);
		transform: translateY(-2px);
	}
	
	.section-header {
		background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
		padding: 20px 24px;
		border-bottom: 2px solid #e2e8f0;
		display: flex;
		align-items: center;
		gap: 12px;
	}
	
	.section-icon {
		width: 40px;
		height: 40px;
		background: linear-gradient(135deg, #1869AA 0%, #1e40af 100%);
		border-radius: 10px;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}
	
	.section-icon svg {
		width: 20px;
		height: 20px;
		color: white;
		stroke-width: 2.5;
	}
	
	.section-title {
		margin: 0;
		font-size: 16px;
		font-weight: 700;
		color: #1e293b;
		letter-spacing: -0.3px;
	}
	
	.section-body {
		padding: 24px;
	}
	
	/* Form Rows */
	.form-row {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 20px;
		margin-bottom: 20px;
	}
	
	.form-row:last-child {
		margin-bottom: 0;
	}
	
	.form-field {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}
	
	.field-label {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 13px;
		font-weight: 600;
		color: #475569;
		text-transform: uppercase;
		letter-spacing: 0.5px;
	}
	
	.label-icon {
		width: 18px;
		height: 18px;
		display: flex;
		align-items: center;
		justify-content: center;
		color: #1869AA;
		flex-shrink: 0;
	}
	
	.label-icon svg {
		width: 100%;
		height: 100%;
		stroke-width: 2;
	}
	
	.field-input,
	.field-select {
		width: 100%;
		padding: 12px 16px;
		border: 2px solid #e2e8f0;
		border-radius: 10px;
		font-size: 14px;
		color: #1e293b;
		background: white;
		transition: all 0.2s ease;
		font-family: inherit;
	}
	
	.field-input:focus,
	.field-select:focus {
		outline: none;
		border-color: #1869AA;
		box-shadow: 0 0 0 4px rgba(24, 105, 170, 0.1);
	}
	
	.field-input::placeholder {
		color: #94a3b8;
	}
	
	.field-hint {
		font-size: 11px;
		color: #64748b;
		margin-top: 4px;
	}
	
	/* Radio Groups */
	.radio-group {
		display: flex;
		gap: 12px;
		flex-wrap: wrap;
		margin-top: 8px;
	}
	
	.radio-option {
		position: relative;
		display: flex;
		align-items: center;
		cursor: pointer;
	}
	
	.radio-option input[type="radio"] {
		position: absolute;
		opacity: 0;
		width: 0;
		height: 0;
	}
	
	.radio-custom {
		width: 20px;
		height: 20px;
		border: 2px solid #cbd5e1;
		border-radius: 50%;
		background: white;
		position: relative;
		transition: all 0.2s ease;
		flex-shrink: 0;
		margin-left: 8px;
	}
	
	.radio-option input[type="radio"]:checked + .radio-custom {
		border-color: #1869AA;
		background: #1869AA;
	}
	
	.radio-option input[type="radio"]:checked + .radio-custom::after {
		content: '';
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		width: 8px;
		height: 8px;
		background: white;
		border-radius: 50%;
	}
	
	.radio-label {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 14px;
		font-weight: 500;
		color: #475569;
		padding: 10px 16px;
		border: 2px solid #e2e8f0;
		border-radius: 10px;
		background: white;
		transition: all 0.2s ease;
		flex: 1;
		min-width: 120px;
		justify-content: center;
	}
	
	.radio-label svg {
		width: 16px;
		height: 16px;
		color: #64748b;
		stroke-width: 2;
	}
	
	.radio-option input[type="radio"]:checked ~ .radio-label {
		background: linear-gradient(135deg, #1869AA 0%, #1e40af 100%);
		color: white;
		border-color: #1869AA;
		box-shadow: 0 4px 12px rgba(24, 105, 170, 0.2);
	}
	
	.radio-option input[type="radio"]:checked ~ .radio-label svg {
		color: white;
	}
	
	.radio-option:hover .radio-label {
		border-color: #1869AA;
		background: #f8fafc;
	}
	
	/* Schedule Type Group */
	.schedule-type-group {
		margin-top: 12px;
	}
	
	.schedule-type-group .radio-label {
		min-width: 150px;
	}
	
	/* Frequency Group */
	.frequency-group {
		flex: 1;
		margin-top: 0;
	}
	
	.frequency-group .radio-label {
		min-width: 90px;
	}
	
	/* Repetition Wrapper */
	.repetition-wrapper {
		display: flex;
		align-items: center;
		gap: 12px;
		flex-wrap: wrap;
		padding: 16px;
		background: #f8fafc;
		border-radius: 12px;
		border: 2px solid #e2e8f0;
	}
	
	.repetition-text {
		font-size: 14px;
		font-weight: 600;
		color: #475569;
	}
	
	.repetition-input {
		width: 80px;
		text-align: center;
		font-weight: 600;
	}
	
	/* Weekdays */
	.weekdays-grid {
		display: grid;
		grid-template-columns: repeat(7, 1fr);
		gap: 10px;
		margin-top: 12px;
	}
	
	.weekday-option {
		position: relative;
		cursor: pointer;
	}
	
	.weekday-checkbox {
		position: absolute;
		opacity: 0;
		width: 0;
		height: 0;
	}
	
	.weekday-label {
		display: block;
		padding: 12px 8px;
		border: 2px solid #e2e8f0;
		border-radius: 10px;
		background: white;
		text-align: center;
		font-size: 12px;
		font-weight: 600;
		color: #475569;
		transition: all 0.2s ease;
		cursor: pointer;
	}
	
	.weekday-checkbox:checked + .weekday-label {
		background: linear-gradient(135deg, #1869AA 0%, #1e40af 100%);
		color: white;
		border-color: #1869AA;
		box-shadow: 0 4px 12px rgba(24, 105, 170, 0.2);
		transform: translateY(-2px);
	}
	
	.weekday-label:hover {
		border-color: #1869AA;
		background: #f8fafc;
	}
	
	/* Month Frequency */
	.month-frequency-wrapper {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 16px;
		margin-top: 12px;
	}
	
	.month-option {
		padding: 16px;
		background: #f8fafc;
		border-radius: 12px;
		border: 2px solid #e2e8f0;
		display: flex;
		flex-direction: column;
		gap: 12px;
		transition: all 0.2s ease;
	}
	
	.month-option:hover {
		border-color: #cbd5e1;
		background: white;
	}
	
	.week-select-wrapper {
		display: flex;
		gap: 10px;
		margin-top: 8px;
	}
	
	.week-counter-select,
	.weekday-select {
		flex: 1;
	}
	
	.day-of-month-input {
		width: 100%;
		margin-top: 8px;
	}
	
	/* Daily Frequency */
	.daily-frequency-wrapper {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 16px;
		margin-bottom: 20px;
	}
	
