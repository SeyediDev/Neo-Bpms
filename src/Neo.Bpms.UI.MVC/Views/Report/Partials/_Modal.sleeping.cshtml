					</div>
				</div>
			</div>
			<div class="time-range-wrapper">
				<div class="form-field">
					<label for="scheduled-report-starttime" class="field-label">
						<span class="label-icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<polygon points="5 3 19 12 5 21 5 3"/>
							</svg>
						</span>
						ساعت شروع
					</label>
					<input class="field-input time-input" id="scheduled-report-starttime" name="startTime" type="time" value="" disabled/>
				</div>
				<div class="form-field">
					<label for="scheduled-report-endtime" class="field-label">
						<span class="label-icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<rect x="6" y="4" width="4" height="16"/>
								<rect x="14" y="4" width="4" height="16"/>
							</svg>
						</span>
						ساعت پایان
					</label>
					<input class="field-input time-input" id="scheduled-report-endtime" name="endTime" type="time" value="" disabled/>
				</div>
			</div>
		</div>
	</div>
	
	@* Duration Section *@
	<div class="schedule-section duration">
		<div class="section-header">
			<div class="section-icon">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
					<line x1="16" y1="2" x2="16" y2="6"/>
					<line x1="8" y1="2" x2="8" y2="6"/>
					<line x1="3" y1="10" x2="21" y2="10"/>
					<path d="M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01M16 18h.01"/>
				</svg>
			</div>
			<h5 class="section-title">طول دوره گزارش گیری</h5>
		</div>
		<div class="section-body">
			<div class="form-row">
				<div class="form-field">
					<label for="scheduled-report-startdate" class="field-label">
						<span class="label-icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<circle cx="12" cy="12" r="10"/>
								<polyline points="12 6 12 12 16 14"/>
							</svg>
						</span>
						تاریخ شروع
					</label>
					<input class="field-input dateField date-input @calendar" dont-convert="true" id="scheduled-report-startdate" name="startDate" type="text" value=""/>
				</div>
				<div class="form-field">
					<label for="scheduled-report-enddate" class="field-label">
						<span class="label-icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<circle cx="12" cy="12" r="10"/>
								<line x1="12" y1="8" x2="12" y2="12"/>
								<line x1="16" y1="12" x2="12" y2="12"/>
								<line x1="16" y1="16" x2="12" y2="16"/>
							</svg>
						</span>
						تاریخ منقضی شدن
					</label>
					<input class="field-input dateField date-input @calendar" dont-convert="true" id="scheduled-report-enddate" name="endDate" type="text" value=""/>
				</div>
			</div>
		</div>
	</div>
	
	@* Output Settings Section *@
	<div class="schedule-section output-settings">
		<div class="section-header">
			<div class="section-icon">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
					<polyline points="17 8 12 3 7 8"/>
					<line x1="12" y1="3" x2="12" y2="15"/>
				</svg>
			</div>
			<h5 class="section-title">تعیین عملیات و خروجی</h5>
		</div>
		<div class="section-body">
			<div class="form-row">
				<div class="form-field">
					<label for="output-type" class="field-label">
						<span class="label-icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
								<polyline points="7 10 12 15 17 10"/>
								<line x1="12" y1="15" x2="12" y2="3"/>
							</svg>
						</span>
						نوع خروجی گزارش
					</label>
					<select class="field-select" id="output-type" name="outputType" onchange="showOrHideJobScheduleFeatures();">
						<option value="2">ایمیل</option>
						<option value="4">پیامک</option>
						<option value="5">اطلاع رسانی</option>
						<option value="1">دایرکتوری فایل</option>
						<option value="3">پیوست سابقه</option>
					</select>
				</div>
				<div class="form-field">
					<label for="file-type" class="field-label">
						<span class="label-icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/>
								<polyline points="13 2 13 9 20 9"/>
							</svg>
						</span>
						فرمت گزارش
					</label>
					<select class="field-select" id="file-type" name="fileType">
						<option value="1">HTML</option>
						<option value="2">Excel</option>
						<option value="3">Text</option>
						<option value="4">CSV</option>
					</select>
				</div>
			</div>
			
			<div class="form-row">
				<div class="form-field">
					<label for="action-name" class="field-label">
						<span class="label-icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
								<polyline points="14 2 14 8 20 8"/>
								<line x1="16" y1="13" x2="8" y2="13"/>
								<line x1="16" y1="17" x2="8" y2="17"/>
								<polyline points="10 9 9 9 8 9"/>
							</svg>
						</span>
						عنوان در خروجی
					</label>
					<input class="field-input" id="action-name" name="actionName" type="text" value="" placeholder="عنوان گزارش"/>
				</div>
				<div class="form-field">
					<label for="max-record" class="field-label">
						<span class="label-icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<line x1="8" y1="6" x2="21" y2="6"/>
								<line x1="8" y1="12" x2="21" y2="12"/>
								<line x1="8" y1="18" x2="21" y2="18"/>
								<line x1="3" y1="6" x2="3.01" y2="6"/>
								<line x1="3" y1="12" x2="3.01" y2="12"/>
								<line x1="3" y1="18" x2="3.01" y2="18"/>
							</svg>
						</span>
						حداکثر تعداد رکورد
					</label>
					<input class="field-input max-record-input" id="max-record" name="maxRecord" min="0" max="100000" type="number" value="" placeholder="تعداد رکورد"/>
				</div>
			</div>
			
			<div class="form-row user-group-div">
				<div class="form-field">
					<label for="scheduled-report-roles" class="field-label">
						<span class="label-icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
								<circle cx="9" cy="7" r="4"/>
								<path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
								<path d="M16 3.13a4 4 0 0 1 0 7.75"/>
							</svg>
						</span>
						نقش
					</label>
					<select class="field-select roles-select" id="scheduled-report-roles" name="roles" multiple>
						@if (availableRoles != null && availableRoles.Any())
						{
							@foreach (var role in availableRoles)
							{
								<option value="@role.Name">
									@role.DisplayName
								</option>
							}
						}
						else
						{
							<option disabled>هیچ نقشی در این کانفیگ تعریف نشده است</option>
						}
					</select>
					<small class="field-hint">می‌توانید چند نقش را انتخاب کنید (با نگه داشتن Ctrl)</small>
				</div>
				<div class="form-field">
					<label for="scheduled-report-user" class="field-label">
						<span class="label-icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
								<circle cx="12" cy="7" r="4"/>
							</svg>
						</span>
						ارسال به کاربر
					</label>
					<input class="field-input" id="scheduled-report-user" name="user" type="text" value="" placeholder="نام کاربری"/>
				</div>
			</div>
			
			<div class="form-row output-type">
				<div class="form-field">
					<label for="destination-user-name" class="field-label">
						<span class="label-icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
								<circle cx="12" cy="7" r="4"/>
							</svg>
						</span>
						نام کاربری (دایرکتوری)
					</label>
					<input class="field-input" id="destination-user-name" type="text" value="" placeholder="نام کاربری"/>
				</div>
				<div class="form-field">
					<label for="destination-password" class="field-label">
						<span class="label-icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
								<path d="M7 11V7a5 5 0 0 1 10 0v4"/>
							</svg>
						</span>
						رمز عبور (دایرکتوری)
					</label>
					<input class="field-input" id="destination-password" type="password" value="" placeholder="رمز عبور"/>
				</div>
			</div>
			
			<div class="form-row output-type">
				<div class="form-field">
					<label for="destination-path" class="field-label">
						<span class="label-icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
							</svg>
						</span>
						مسیر خروجی
					</label>
					<input class="field-input" id="destination-path" type="text" value="" placeholder="\\TetaScheduledReport" dir="ltr"/>
				</div>
			</div>
		</div>
	</div>
	</form>
	</div>
	<div class="modal-footer schedule-modal-footer">
		<button type="button" class="btn btn-cancel" data-dismiss="modal">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<line x1="18" y1="6" x2="6" y2="18"/>
				<line x1="6" y1="6" x2="18" y2="18"/>
			</svg>
			انصراف
		</button>
		<button type="button" id="schedule-without-filter-submit" class="btn btn-save-secondary" onclick="ScheduledReport.submitForm(false)">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
				<polyline points="17 21 17 13 7 13 7 21"/>
				<polyline points="7 3 7 8 15 8"/>
			</svg>
			ذخیره بدون تغییر فیلتر
		</button>
		<button type="button" class="btn btn-save-primary" onclick="ScheduledReport.submitForm(true)">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
				<polyline points="17 21 17 13 7 13 7 21"/>
				<polyline points="7 3 7 8 15 8"/>
			</svg>
			ذخیره به همراه فیلتر
		</button>
	</div>
	</div>
	</div>
	</div>
}

