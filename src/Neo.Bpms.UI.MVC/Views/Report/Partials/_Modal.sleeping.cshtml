								<line x1="7" y1="7" x2="7.01" y2="7"/>
							</svg>
						</span>
						@ViewTexts.Name
					</label>
					<input class="field-input" id="scheduled-report-name" name="name" type="text" value="" placeholder="نام زمانبندی"/>
				</div>
			</div>
			
			<div class="form-row">
				<div class="form-field">
					<label class="field-label">
						<span class="label-icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
								<line x1="16" y1="2" x2="16" y2="6"/>
								<line x1="8" y1="2" x2="8" y2="6"/>
								<line x1="3" y1="10" x2="21" y2="10"/>
							</svg>
						</span>
						@ViewTexts.ScheduleType
					</label>
					<div class="radio-group schedule-type-group">
						<label class="radio-option">
							<input type="radio" name="scheduleType" id="scheduleType1" value="1" onchange="showOrHideJobScheduleFeatures();">
							<span class="radio-custom"></span>
							<span class="radio-label">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
									<rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
									<line x1="16" y1="2" x2="16" y2="6"/>
									<line x1="8" y1="2" x2="8" y2="6"/>
									<line x1="3" y1="10" x2="21" y2="10"/>
								</svg>
								@ViewTexts.Once
							</span>
						</label>
						<label class="radio-option">
							<input type="radio" name="scheduleType" id="scheduleType2" value="2" onchange="showOrHideJobScheduleFeatures();">
							<span class="radio-custom"></span>
							<span class="radio-label">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
									<polyline points="23 4 23 10 17 10"/>
									<polyline points="1 20 1 14 7 14"/>
									<path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>
								</svg>
								@ViewTexts.Repetetive
							</span>
						</label>
					</div>
				</div>
				
				<div class="form-field">
					<label class="field-label">
						<span class="label-icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
							</svg>
						</span>
						وضعیت
					</label>
					<label class="switch-field">
						<input type="checkbox" name="isDisable" id="schedule-is-disabled" value="0">
						<span class="switch-slider"></span>
						<span class="switch-label">@ViewTexts.Disabled</span>
					</label>
				</div>
			</div>
			
			<div class="form-row scheduled-report-DateTime">
				<div class="form-field">
					<label for="scheduled-report-date" class="field-label">
						<span class="label-icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
								<line x1="16" y1="2" x2="16" y2="6"/>
								<line x1="8" y1="2" x2="8" y2="6"/>
								<line x1="3" y1="10" x2="21" y2="10"/>
							</svg>
						</span>
						@ViewTexts.Day
					</label>
					<input class="field-input dateField date-input @calendar" dont-convert="true" id="scheduled-report-date" name="date" type="text" value=""/>
				</div>
				<div class="form-field">
					<label for="scheduled-report-time" class="field-label">
						<span class="label-icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<circle cx="12" cy="12" r="10"/>
								<polyline points="12 6 12 12 16 14"/>
							</svg>
						</span>
						@ViewTexts.Hour
					</label>
					<input class="field-input time-input" id="scheduled-report-time" name="time" type="time" value=""/>
				</div>
			</div>
		</div>
	</div>
	
	@* Repeat Period Section *@
	<div class="schedule-section job-frequency">
		<div class="section-header">
			<div class="section-icon">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<polyline points="23 4 23 10 17 10"/>
					<polyline points="1 20 1 14 7 14"/>
					<path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>
				</svg>
			</div>
			<h5 class="section-title">@ViewTexts.RepeatPeriod</h5>
		</div>
		<div class="section-body">
			<div class="form-row">
				<div class="form-field">
					<label class="field-label">
						<span class="label-icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<polyline points="23 4 23 10 17 10"/>
								<polyline points="1 20 1 14 7 14"/>
								<path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>
							</svg>
						</span>
						تکرار
					</label>
					<div class="repetition-wrapper">
						<span class="repetition-text">هر</span>
						<input class="field-input repetition-input" id="scheduled-report-repetition" name="every" type="number" value="" min="1" placeholder="1"/>
						<div class="radio-group frequency-group">
							<label class="radio-option">
								<input type="radio" name="jobfrequency" id="frequency1" value="1" onchange="showOrHideJobScheduleFeatures();">
								<span class="radio-custom"></span>
								<span class="radio-label">@ViewTexts.Day</span>
							</label>
							<label class="radio-option">
								<input type="radio" name="jobfrequency" id="frequency2" value="2" onchange="showOrHideJobScheduleFeatures();">
								<span class="radio-custom"></span>
								<span class="radio-label">@ViewTexts.Week</span>
							</label>
							<label class="radio-option">
								<input type="radio" name="jobfrequency" id="frequency3" value="3" onchange="showOrHideJobScheduleFeatures();">
								<span class="radio-custom"></span>
								<span class="radio-label">@ViewTexts.Month</span>
							</label>
						</div>
					</div>
				</div>
			</div>
			
			<div class="form-row week-days">
				<div class="form-field">
					<label class="field-label">
						<span class="label-icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
								<line x1="16" y1="2" x2="16" y2="6"/>
								<line x1="8" y1="2" x2="8" y2="6"/>
								<line x1="3" y1="10" x2="21" y2="10"/>
							</svg>
						</span>
						روزهای هفته
					</label>
					<div class="weekdays-grid">
						<label class="weekday-option">
							<input type="checkbox" name="onWeekDays" id="onWeekDays1" value="1" class="weekday-checkbox">
							<span class="weekday-label">شنبه</span>
						</label>
						<label class="weekday-option">
							<input type="checkbox" name="onWeekDays" id="onWeekDays2" value="2" class="weekday-checkbox">
							<span class="weekday-label">یکشنبه</span>
						</label>
						<label class="weekday-option">
							<input type="checkbox" name="onWeekDays" id="onWeekDays4" value="4" class="weekday-checkbox">
							<span class="weekday-label">دوشنبه</span>
						</label>
						<label class="weekday-option">
							<input type="checkbox" name="onWeekDays" id="onWeekDays8" value="8" class="weekday-checkbox">
							<span class="weekday-label">سه‌شنبه</span>
						</label>
						<label class="weekday-option">
							<input type="checkbox" name="onWeekDays" id="onWeekDays16" value="16" class="weekday-checkbox">
							<span class="weekday-label">چهارشنبه</span>
						</label>
						<label class="weekday-option">
							<input type="checkbox" name="onWeekDays" id="onWeekDays32" value="32" class="weekday-checkbox">
							<span class="weekday-label">پنجشنبه</span>
						</label>
						<label class="weekday-option">
							<input type="checkbox" name="onWeekDays" id="onWeekDays64" value="64" class="weekday-checkbox">
							<span class="weekday-label">جمعه</span>
						</label>
					</div>
				</div>
			</div>
			
			<div class="form-row month-frequency">
				<div class="form-field">
					<label class="field-label">
						<span class="label-icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
								<line x1="16" y1="2" x2="16" y2="6"/>
								<line x1="8" y1="2" x2="8" y2="6"/>
								<line x1="3" y1="10" x2="21" y2="10"/>
							</svg>
						</span>
						تنظیمات ماهانه
					</label>
					<div class="month-frequency-wrapper">
						<div class="month-option">
							<label class="radio-option">
								<input class="day-of-month" type="radio" name="monthFrequency" id="monthFreq1" value="1" onclick="showOrHideJobScheduleFeatures();">
								<span class="radio-custom"></span>
								<span class="radio-label">روز ماه</span>
							</label>
							<input class="field-input day-of-month-input" id="scheduled-report-dayOfMonth" name="dayOfMonth" type="number" value="" disabled placeholder="روز ماه (1-31)"/>
						</div>
						<div class="month-option">
							<label class="radio-option">
								<input class="mf" type="radio" name="monthFrequency" id="monthFreq2" value="2" onclick="showOrHideJobScheduleFeatures();"/>
								<span class="radio-custom"></span>
								<span class="radio-label">در هفته مشخص</span>
							</label>
							<div class="week-select-wrapper">
								<select class="field-select week-counter-select" id="week-counter" name="monthlyFrequency" disabled>
									<option value="1">اولین</option>
									<option value="2">دومین</option>
									<option value="3">سومین</option>
									<option value="4">چهارمین</option>
									<option value="5">آخرین</option>
								</select>
								<select class="field-select weekday-select" name="WeekDays" disabled>
									<option value="1">شنبه</option>
									<option value="2">یکشنبه</option>
									<option value="3">دوشنبه</option>
									<option value="4">سه شنبه</option>
									<option value="5">چهارشنبه</option>
									<option value="6">پنجشنبه</option>
									<option value="7">جمعه</option>
									<option value="8">روز کاری</option>
									<option value="9">آخر هفته</option>
								</select>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
	
	@* Daily Frequency Section *@
	<div class="schedule-section daily-frequency">
		<div class="section-header">
			<div class="section-icon">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<circle cx="12" cy="12" r="10"/>
					<polyline points="12 6 12 12 16 14"/>
				</svg>
			</div>
			<h5 class="section-title">زمان گزارش گیری در روز</h5>
		</div>
		<div class="section-body">
			<div class="daily-frequency-wrapper">
				<div class="frequency-card">
					<label class="radio-option">
						<input type="radio" class="specific-time" name="dailyFrequency" id="dailyFreq1" value="1" onclick="showOrHideJobScheduleFeatures();">
						<span class="radio-custom"></span>
						<span class="radio-label">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<circle cx="12" cy="12" r="10"/>
								<polyline points="12 6 12 12 16 14"/>
							</svg>
							در ساعت مشخص
						</span>
					</label>
					<input class="field-input time-input" id="daily-frequency-hour" name="time" type="time" value=""/>
				</div>
				<div class="frequency-card">
					<label class="radio-option">
						<input type="radio" class="hourly-every" name="dailyFrequency" id="dailyFreq2" value="2" onclick="showOrHideJobScheduleFeatures();">
						<span class="radio-custom"></span>
						<span class="radio-label">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<polyline points="23 4 23 10 17 10"/>
								<polyline points="1 20 1 14 7 14"/>
								<path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>
							</svg>
							هر چند ساعت
						</span>
