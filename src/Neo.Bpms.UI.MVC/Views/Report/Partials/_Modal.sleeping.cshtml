<script>
// Enhanced show/hide logic for schedule features
$(document).ready(function() {
	// Store original function if it exists
	var originalShowOrHide = window.showOrHideJobScheduleFeatures;
	
	// Enhanced show/hide function
	window.showOrHideJobScheduleFeatures = function() {
		// Get values from radio buttons
		var scheduleType = $('input[name="scheduleType"]:checked').val();
		var jobFrequency = $('input[name="jobfrequency"]:checked').val();
		var dailyFrequency = $('input[name="dailyFrequency"]:checked').val();
		var monthFrequency = $('input[name="monthFrequency"]:checked').val();
		
		// Call original function if it exists
		if (typeof originalShowOrHide === 'function') {
			originalShowOrHide();
		}
		
		// Handle schedule type (Once vs Repetitive)
		if (scheduleType === '1') {
			// Once - hide repeat period section
			$('.job-frequency').closest('.schedule-section').hide();
		} else if (scheduleType === '2') {
			// Repetitive - show repeat period section
			$('.job-frequency').closest('.schedule-section').show();
		}
		
		// Handle job frequency (Day/Week/Month)
		if (jobFrequency === '2') {
			// Week - show week days, hide month frequency
			$('.week-days').show();
			$('.month-frequency').hide();
		} else if (jobFrequency === '3') {
			// Month - show month frequency, hide week days
			$('.week-days').hide();
			$('.month-frequency').show();
		} else {
			// Day - hide both
			$('.week-days').hide();
			$('.month-frequency').hide();
		}
		
		// Handle daily frequency
		if (dailyFrequency === '1') {
			// Specific time
			$('#daily-frequency-hour').prop('disabled', false);
			$('#scheduled-report-hourlyEvery').prop('disabled', true);
			$('#scheduled-report-starttime').prop('disabled', true);
			$('#scheduled-report-endtime').prop('disabled', true);
		} else if (dailyFrequency === '2') {
			// Hourly
			$('#daily-frequency-hour').prop('disabled', true);
			$('#scheduled-report-hourlyEvery').prop('disabled', false);
			$('#scheduled-report-starttime').prop('disabled', false);
			$('#scheduled-report-endtime').prop('disabled', false);
		}
		
		// Handle month frequency
		if (monthFrequency === '1') {
			// Day of month
			$('#scheduled-report-dayOfMonth').prop('disabled', false);
			$('#week-counter').prop('disabled', true);
			$('[name="WeekDays"]').prop('disabled', true);
		} else if (monthFrequency === '2') {
			// Specific week
			$('#scheduled-report-dayOfMonth').prop('disabled', true);
			$('#week-counter').prop('disabled', false);
			$('[name="WeekDays"]').prop('disabled', false);
		}
		
		// Handle output type visibility
		var outputType = $('#output-type').val();
		if (outputType === '1') {
			// File directory - show directory fields
			$('.output-type').show();
		} else {
			// Other types - hide directory fields
			$('.output-type').hide();
		}
	};
	
	// Sync hidden inputs with radio buttons for compatibility
	$('input[name="scheduleType"]').on('change', function() {
		$('#schedule-type').val($(this).val());
		showOrHideJobScheduleFeatures();
	});
	
	$('input[name="jobfrequency"]').on('change', function() {
		$('#schedule-job-frequency').val($(this).val());
		showOrHideJobScheduleFeatures();
	});
	
	// Sync radio buttons from hidden inputs (for form loading compatibility)
	var syncFromHiddenInputs = function() {
		var scheduleTypeVal = $('#schedule-type').val();
		var jobFreqVal = $('#schedule-job-frequency').val();
		
		if (scheduleTypeVal) {
			$('input[name="scheduleType"][value="' + scheduleTypeVal + '"]').prop('checked', true);
		}
		if (jobFreqVal) {
			$('input[name="jobfrequency"][value="' + jobFreqVal + '"]').prop('checked', true);
		}
	};
	
	// Patch the existing fillTheForm function if it exists
	if (typeof ScheduledReport !== 'undefined' && ScheduledReport.fillTheForm) {
		var originalFillTheForm = ScheduledReport.fillTheForm;
		ScheduledReport.fillTheForm = function(data, isNew) {
			originalFillTheForm.call(this, data, isNew);
			setTimeout(function() {
				syncFromHiddenInputs();
				showOrHideJobScheduleFeatures();
			}, 100);
		};
	}
	
	// Sync on modal show
	$('#scheduled-report-modal').on('shown.bs.modal', function() {
		setTimeout(function() {
			syncFromHiddenInputs();
			showOrHideJobScheduleFeatures();
		}, 200);
	});
	
	$('input[name="dailyFrequency"]').on('change', function() {
		showOrHideJobScheduleFeatures();
	});
	
	$('input[name="monthFrequency"]').on('change', function() {
		showOrHideJobScheduleFeatures();
	});
	
	$('#output-type').on('change', function() {
		showOrHideJobScheduleFeatures();
	});
	
	// Initialize on modal show
	$('#scheduled-report-modal').on('shown.bs.modal', function() {
		showOrHideJobScheduleFeatures();
	});
	
	// Initialize on page load if modal is already visible
	if ($('#scheduled-report-modal').hasClass('show')) {
		showOrHideJobScheduleFeatures();
	}
});
</script>
</script>