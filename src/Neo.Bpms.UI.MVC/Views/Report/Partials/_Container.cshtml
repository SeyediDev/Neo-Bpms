@using Neo.Bpms.Domain.Models.Cmmn.UI.Reports
@using Neo.Bpms.Domain.Model.Project
@using Neo.Bpms.Infrastructure.Features.Cmmn.Forms.Logic
@using Neo.Bpms.Infrastructure.Features.Cmmn.Forms.Common
@using Neo.Bpms.UI.MVC.Controls
@inject IFormLogicHelper formLogicHelper
@model ReportData

@{
    var structure = Model?.Structure;
    var canDesign = ViewBag.CanDesign ?? false;
    var calendar = (string)(ViewBag.calendarType ?? ViewBag.calendar ?? ProjectDefinition.Project.DefaultCalendar);
    var refreshTime = structure?.FilterValues?.GetLong("__RefreshTime") ?? 0;
    
    var options = new RendererOptions
    {
        IsFilter = true
    };
    var controlsRendererData = structure != null 
        ? new ControlsRendererData(structure, structure.FilterValues, options, ViewBag.user, Url)
        : null;
}

@if (structure != null)
{
    @using (Html.BeginForm("Index", "Report",
    new
    {
       structure.NamespaceId,
       structure.EntityId,
       ReportId = structure.Form_ReportId,
       structure.ConfigId
    }, FormMethod.Post, true, new { enctype = "multipart/form-data", id = "filter-form" }))
    {
        @Html.Hidden("ParentReportIds", structure.ParentReportIds)
        @Html.Hidden("calendar", calendar)
        <input type="hidden" name="calendarYear" value="@(ViewBag.calendarYear)" />
        <input type="hidden" name="calendarMonth" value="@(ViewBag.calendarMonth)" />
        <input type="hidden" name="newPage" value="1" />
        <input type="hidden" name="Page" value="@ViewBag.Page" />
        <input type="hidden" id="soValues" name="sortFields" value="@ViewBag.SortFields" />
        <input type="hidden" name="__RefreshTime" value="@refreshTime" />
        @Html.AntiForgeryToken()

        <div @formLogicHelper.HtmlLogicEvent(structure, null, null)>
            <div class="row no-margin-row" id="ReportContainer">
                <div class="col-md-12 col-sm-12 noPadding">
                    <div class="customDiv">
                        <div class="row no-margin-row" id="ReportBody">
                            <div class="col-md-12 col-sm-12 reportBody">
                                @if (Model != null)
                                {
                                    switch (structure.ReportViewType)
                                    {
                                        case ReportViewType.Chart:
                                            switch (structure.ChartType)
                                            {
                                                case ChartType.IranMap:
                                                    <partial name="~/Views/Report/Map/_IranMap.cshtml" model="Model" />
                                                    break;
                                                case ChartType.WorldMap:
                                                    <partial name="~/Views/Report/Map/_WorldMap.cshtml" model="Model" />
                                                    break;
                                                case ChartType.BpmnDiagram:
                                                    <partial name="~/Views/Report/Charts/_bpmn.cshtml" model="Model" />
                                                    break;
                                                default:
                                                    <div style="direction: ltr !important;">
                                                        <partial name="~/Views/Report/Charts/_chartView.cshtml" model="Model" />
                                                    </div>
                                                    break;
                                            }
                                            break;
                                        default:
                                            <div>
                                                <partial name="~/Views/Report/ListView/_listView.cshtml" model="Model" />
                                            </div>
                                            break;
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            @* Column Settings, Order By, and Colors modals are now in _Modals.cshtml *@
            @if (canDesign)
            {
                <script src="@CommonBundles.ReportDesignJsBundle" asp-append-version="true"></script>
            }
            
            <partial name="Logic/_Logic" model="structure" />
            
            @if (controlsRendererData?.IncludeNeedingControls != null)
            {
                <partial name="Controls/_ControlIncludes" model="controlsRendererData.IncludeNeedingControls" />
            }
            
            <script>
                var persistentIsNull = @(ViewBag.PersistentIsNull == null || ViewBag.PersistentIsNull == true ? "true" : "false");
                $(function () {
                    if (persistentIsNull) {
                        // Only auto-submit if filter panel is not visible (to prevent unwanted clicks)
                        var $filterPanel = $('#filterTooltipPanel');
                        if (!$filterPanel || !$filterPanel.hasClass('show')) {
                            // Wait a bit to ensure page is fully loaded before submitting
                            setTimeout(function() {
                                var $submitBtn = $('#submit-filter');
                                if ($submitBtn.length > 0 && !$submitBtn.hasClass('ladda-loading')) {
                                    $submitBtn.click();
                                }
                            }, 100);
                        }
                        var $emptyRequiredFields = $(':invalid:required');
                        if ($emptyRequiredFields.length !== 0) {
                            window.toast.warning(window.tetaI18n.t('PleaseSetRequiredFilters'));
                        }
                    }
                    
                    // CRITICAL: Fix scroll issues after page is fully loaded
                    function fixAllScrollIssues() {
                        // Force remove min-height from html and body
                        $('html, body').css({
                            'min-height': 'auto',
                            'height': 'auto',
                            'padding-bottom': '0',
                            'margin-bottom': '0'
                        });
                        
                        // Fix page-body
                        $('#page-body').css({
                            'min-height': 'auto',
                            'height': 'auto',
                            'padding-bottom': '0',
                            'margin-bottom': '0'
                        });
                        
                        // Fix ReportContainer and all its children
                        $('#ReportContainer, #ReportContainer *').css({
                            'min-height': 'auto',
                            'padding-bottom': '0',
                            'margin-bottom': '0'
                        });
                        
                        // Remove any computed min-height that uses vh or %
                        $('#ReportContainer *').each(function() {
                            var $el = $(this);
                            var computedStyle = window.getComputedStyle(this);
                            if (computedStyle.minHeight && (computedStyle.minHeight.indexOf('vh') !== -1 || computedStyle.minHeight.indexOf('%') !== -1)) {
                                $el.css('min-height', 'auto');
                            }
                            if (computedStyle.height && (computedStyle.height.indexOf('vh') !== -1 || computedStyle.height.indexOf('%') !== -1)) {
                                var height = this.scrollHeight;
                                if (height > 0) {
                                    $el.css('height', height + 'px');
                                } else {
                                    $el.css('height', 'auto');
                                }
                            }
                        });
                        
                        // Calculate actual content height
                        var contentHeight = Math.max(
                            document.body.scrollHeight,
                            document.body.offsetHeight,
                            document.documentElement.clientHeight,
                            document.documentElement.scrollHeight,
                            document.documentElement.offsetHeight
                        );
                        
                        var viewportHeight = window.innerHeight;
                        
                        // If content is smaller than viewport, set exact height
                        if (contentHeight <= viewportHeight) {
                            $('html, body').css('height', contentHeight + 'px');
                        } else {
                            $('html, body').css('height', 'auto');
                        }
                    }
                    
                    // Run immediately
                    fixAllScrollIssues();
                    
                    // Run after a delay to catch any late-loading styles
                    setTimeout(fixAllScrollIssues, 100);
                    setTimeout(fixAllScrollIssues, 500);
                    setTimeout(fixAllScrollIssues, 1000);
                    
                    // Run on window resize
                    $(window).on('resize', fixAllScrollIssues);
                });
            </script>
            
            @* CRITICAL: Final CSS override to fix scroll - Must be at the end *@
            <style>
                html.report-page {
                    min-height: auto !important;
                    height: auto !important;
                    padding-bottom: 0 !important;
                    margin-bottom: 0 !important;
                }
                
                body.report-page {
                    min-height: auto !important;
                    height: auto !important;
                    padding-bottom: 0 !important;
                    margin-bottom: 0 !important;
                    overflow-x: hidden !important;
                }
                
                body.report-page #page-body {
                    min-height: auto !important;
                    height: auto !important;
                    padding-bottom: 0 !important;
                    margin-bottom: 0 !important;
                }
                
                body.report-page #ReportContainer,
                body.report-page #ReportContainer * {
                    min-height: auto !important;
                    padding-bottom: 0 !important;
                    margin-bottom: 0 !important;
                }
                
                body.report-page form,
                body.report-page #filter-form {
                    margin-bottom: 0 !important;
                    padding-bottom: 0 !important;
                }
                
                body.report-page > *:last-child {
                    margin-bottom: 0 !important;
                    padding-bottom: 0 !important;
                }
            </style>
        </div>
    }
}
else
{
    <div class="alert alert-danger">
        <h4>خطا</h4>
        <p>ساختار گزارش موجود نیست. لطفاً با مدیر سیستم تماس بگیرید.</p>
    </div>
}

