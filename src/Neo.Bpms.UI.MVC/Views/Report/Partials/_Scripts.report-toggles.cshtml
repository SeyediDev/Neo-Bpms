@* report-toggles.js - Toggle Functions for Report Info, Filter, Refresh Settings, and Design Settings *@
<script>
/**
 * report-toggles.js
 * Toggle Functions for Report Info, Filter, Refresh Settings, and Design Settings
 */

// Toggle report info tooltip
window.toggleReportInfo = function(event) {
    if (event) {
        event.preventDefault();
        event.stopPropagation();
    }

    const panel = document.getElementById('reportInfoPanel');
    const toggle = event ? event.target.closest('a') : document.querySelector('[onclick*="toggleReportInfo"]');

    if (panel && toggle) {
        // Hide all other tooltips first
        const allPanels = document.querySelectorAll('.report-info-panel');
        allPanels.forEach(p => {
            if (p !== panel) {
                p.style.display = 'none';
            }
        });

        // Toggle current panel
        if (!panel.classList.contains('show')) {
            panel.classList.add('show');
            toggle.classList.add('active');
            
            // Position tooltip relative to toggle button
            const toggleRect = toggle.getBoundingClientRect();
            panel.style.position = 'fixed';
            panel.style.top = (toggleRect.bottom + 8) + 'px';
            panel.style.right = (window.innerWidth - toggleRect.right) + 'px';
            panel.style.zIndex = '10000';
            
            console.log('Report info tooltip shown');
        } else {
            panel.classList.remove('show');
            toggle.classList.remove('active');
            console.log('Report info tooltip hidden');
        }
    }
};

