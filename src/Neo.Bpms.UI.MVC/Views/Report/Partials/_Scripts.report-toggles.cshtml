// Toggle filter tooltip - Make globally accessible
window.toggleFilterTooltip = function(event) {
    console.log('toggleFilterTooltip called');
    if (event) {
        event.preventDefault();
        event.stopPropagation();
    }

    const panel = document.getElementById('filterTooltipPanel');
    const toggle = event ? event.target.closest('a') : document.querySelector('[onclick*="toggleFilterTooltip"]');
    
    console.log('Panel found:', !!panel);
    console.log('Toggle found:', !!toggle);

    if (panel && toggle) {
        // Hide all other tooltips first
        const allPanels = document.querySelectorAll('.filter-tooltip-panel');
        allPanels.forEach(p => {
            if (p !== panel) {
                p.classList.remove('show');
            }
        });

        // Toggle current panel
        if (!panel.classList.contains('show')) {
            console.log('Showing filter tooltip');
            panel.classList.add('show');
            toggle.classList.add('active');
            
            // Position tooltip below the filter icon
            const toggleRect = toggle.getBoundingClientRect();
            panel.style.position = 'fixed';
            panel.style.top = (toggleRect.bottom + 8) + 'px';
            panel.style.left = toggleRect.left + 'px';
            panel.style.right = 'auto';
            panel.style.transform = 'none';
            panel.style.zIndex = '10000';
            
            // Adjust if goes off-screen horizontally
            const panelWidth = Math.min(800, window.innerWidth * 0.95);
            const rightEdge = toggleRect.left + panelWidth;
            if (rightEdge > window.innerWidth) {
                panel.style.left = (window.innerWidth - panelWidth - 16) + 'px';
            }
            
            // Adjust if goes off-screen vertically
            const panelHeight = 400; // estimated height
            const bottomEdge = toggleRect.bottom + 8 + panelHeight;
            if (bottomEdge > window.innerHeight) {
                panel.style.top = (toggleRect.top - panelHeight - 8) + 'px';
            }
            
            console.log('Filter tooltip shown');
            
            // Initialize popular filters tree
            if (typeof window.initializePopularFiltersTree === 'function') {
                window.initializePopularFiltersTree();
            }
            
            // Initialize multi-select after showing tooltip
            if (typeof window.initializeMultiSelectInTooltip === 'function') {
                window.initializeMultiSelectInTooltip();
            }
        } else {
            console.log('Hiding filter tooltip');
            panel.classList.remove('show');
            toggle.classList.remove('active');
            console.log('Filter tooltip hidden');
        }
    } else {
        console.error('Panel or toggle not found');
    }
};

// Toggle design settings tooltip - Make globally accessible
window.toggleDesignSettings = function(event) {
    if (event) {
        event.preventDefault();
        event.stopPropagation();
    }

    const panel = document.getElementById('designSettingsPanel');
    const toggle = event ? event.target.closest('a') : document.querySelector('[onclick*="toggleDesignSettings"]');

    if (panel && toggle) {
        // Hide all other tooltips first
        const allPanels = document.querySelectorAll('.design-settings-panel');
        allPanels.forEach(p => {
            if (p !== panel) {
                p.classList.remove('show');
            }
        });

        // Toggle current panel
        if (!panel.classList.contains('show')) {
            panel.classList.add('show');
            toggle.classList.add('active');
            
            // Position tooltip relative to toggle button (left-aligned)
            const toggleRect = toggle.getBoundingClientRect();
            panel.style.position = 'fixed';
            panel.style.top = (toggleRect.bottom + 8) + 'px';
            panel.style.left = toggleRect.left + 'px';
            panel.style.right = 'auto';
            panel.style.zIndex = '10000';
            
            // Ensure tooltip doesn't go off-screen to the right
            const panelWidth = 380; // max-width from CSS
            const rightEdge = toggleRect.left + panelWidth;
            if (rightEdge > window.innerWidth) {
                panel.style.left = (window.innerWidth - panelWidth - 16) + 'px';
            }
        } else {
            panel.classList.remove('show');
            toggle.classList.remove('active');
        }
    }
};

// Hide design settings tooltip
window.hideDesignSettingsTooltip = function() {
    const panel = document.getElementById('designSettingsPanel');
    const toggle = document.querySelector('[onclick*="toggleDesignSettings"]');
    
    if (panel && panel.classList.contains('show')) {
        panel.classList.remove('show');
        if (toggle) {
            toggle.classList.remove('active');
        }
    }
};
</script>

