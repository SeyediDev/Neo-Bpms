    @* JavaScript functions are now in Report.js *@
    
    <script>
    // Combo box size enforcement - override controls-modern.css (60px -> 38px)
    window.enforceComboBoxSizes = function() {
        const panel = document.getElementById('filterTooltipPanel');
        if (!panel) return;
        
        // CRITICAL: Fix .neo-control select (controls-modern.css line 840 sets 60px)
        const neoControlSelects = panel.querySelectorAll('.neo-control select:not([multiple])');
        neoControlSelects.forEach(function(select) {
            select.style.setProperty('min-height', '38px', 'important');
            select.style.setProperty('height', '38px', 'important');
            select.style.setProperty('max-height', '38px', 'important');
            select.style.setProperty('padding', '8px 12px', 'important');
            select.style.setProperty('padding-top', '8px', 'important');
            select.style.setProperty('padding-bottom', '8px', 'important');
            select.style.setProperty('line-height', '1.5', 'important');
            select.style.setProperty('box-sizing', 'border-box', 'important');
        });
        
        // Fix all SELECT elements, not inputs
        const selects = panel.querySelectorAll('select:not([multiple]):not([size])');
        selects.forEach(function(select) {
            select.style.setProperty('min-height', '38px', 'important');
            select.style.setProperty('height', '38px', 'important');
            select.style.setProperty('max-height', '38px', 'important');
            select.style.setProperty('padding', '8px 12px', 'important');
            select.style.setProperty('padding-top', '8px', 'important');
            select.style.setProperty('padding-bottom', '8px', 'important');
            select.style.setProperty('line-height', '1.5', 'important');
            select.style.setProperty('box-sizing', 'border-box', 'important');
        });
        
        // CRITICAL: Fix Select2 (controls-modern.css line 850 sets 60px)
        const select2Containers = panel.querySelectorAll('.select2-container');
        select2Containers.forEach(function(container) {
            container.style.setProperty('min-height', '38px', 'important');
            container.style.setProperty('height', 'auto', 'important');
        });
        
        const select2Selections = panel.querySelectorAll('.select2-container .select2-selection--single');
        select2Selections.forEach(function(selection) {
            selection.style.setProperty('height', '38px', 'important');
            selection.style.setProperty('min-height', '38px', 'important');
            selection.style.setProperty('max-height', '38px', 'important');
            selection.style.setProperty('display', 'flex', 'important');
            selection.style.setProperty('align-items', 'center', 'important');
            selection.style.setProperty('padding', '0', 'important');
            
            const rendered = selection.querySelector('.select2-selection__rendered');
            if (rendered) {
                rendered.style.setProperty('line-height', '38px', 'important');
                rendered.style.setProperty('height', '38px', 'important');
                rendered.style.setProperty('min-height', '38px', 'important');
                rendered.style.setProperty('padding', '0 12px', 'important');
                rendered.style.setProperty('display', 'flex', 'important');
                rendered.style.setProperty('align-items', 'center', 'important');
            }
            
            const arrow = selection.querySelector('.select2-selection__arrow');
            if (arrow) {
                arrow.style.setProperty('height', '38px', 'important');
                arrow.style.setProperty('min-height', '38px', 'important');
                arrow.style.setProperty('top', '0', 'important');
                arrow.style.setProperty('right', '8px', 'important');
                arrow.style.setProperty('left', 'auto', 'important');
            }
        });
        
        // Fix Apply Filter button - Comprehensive enforcement
        const submitFilterBtn = panel.querySelector('#submit-filter');
        if (submitFilterBtn) {
            // Button base styles
            submitFilterBtn.style.setProperty('display', 'inline-flex', 'important');
            submitFilterBtn.style.setProperty('align-items', 'center', 'important');
            submitFilterBtn.style.setProperty('justify-content', 'center', 'important');
            submitFilterBtn.style.setProperty('gap', '6px', 'important');
            submitFilterBtn.style.setProperty('padding', '8px 16px', 'important');
            submitFilterBtn.style.setProperty('font-size', '14px', 'important');
            submitFilterBtn.style.setProperty('font-weight', '600', 'important');
            submitFilterBtn.style.setProperty('font-family', "'Segoe UI', Tahoma, Geneva, Verdana, sans-serif", 'important');
            submitFilterBtn.style.setProperty('color', '#ffffff', 'important');
            submitFilterBtn.style.setProperty('background', 'linear-gradient(135deg, #3b82f6 0%, #2563eb 100%)', 'important');
            submitFilterBtn.style.setProperty('border', 'none', 'important');
            submitFilterBtn.style.setProperty('border-radius', '6px', 'important');
            submitFilterBtn.style.setProperty('min-height', 'auto', 'important');
            submitFilterBtn.style.setProperty('height', 'auto', 'important');
            submitFilterBtn.style.setProperty('line-height', '1.5', 'important');
            submitFilterBtn.style.setProperty('box-shadow', '0 2px 4px rgba(59, 130, 246, 0.2)', 'important');
            
            // Button span (text)
            const btnSpan = submitFilterBtn.querySelector('span');
            if (btnSpan) {
                btnSpan.style.setProperty('display', 'inline-block', 'important');
                btnSpan.style.setProperty('font-size', '14px', 'important');
                btnSpan.style.setProperty('font-weight', '600', 'important');
                btnSpan.style.setProperty('font-family', "'Segoe UI', Tahoma, Geneva, Verdana, sans-serif", 'important');
                btnSpan.style.setProperty('color', '#ffffff', 'important');
                btnSpan.style.setProperty('line-height', '1.5', 'important');
                btnSpan.style.setProperty('opacity', '1', 'important');
                btnSpan.style.setProperty('visibility', 'visible', 'important');
                btnSpan.style.setProperty('white-space', 'nowrap', 'important');
            }
            
            // Button SVG icon
            const btnSvg = submitFilterBtn.querySelector('svg');
            if (btnSvg) {
                btnSvg.style.setProperty('width', '18px', 'important');
                btnSvg.style.setProperty('height', '18px', 'important');
                btnSvg.style.setProperty('display', 'inline-block', 'important');
                btnSvg.style.setProperty('vertical-align', 'middle', 'important');
                btnSvg.style.setProperty('fill', '#ffffff', 'important');
                btnSvg.style.setProperty('stroke', '#ffffff', 'important');
                btnSvg.style.setProperty('color', '#ffffff', 'important');
                btnSvg.style.setProperty('flex-shrink', '0', 'important');
            }
        }
    }
    
        // Run when panel is shown - Aggressive enforcement
        $(document).ready(function() {
            const panel = document.getElementById('filterTooltipPanel');
            if (panel) {
                // Watch for panel visibility changes
                const observer = new MutationObserver(function(mutations) {
                    if (panel.classList.contains('show')) {
                        // Run multiple times with delays to catch all dynamic content
                        [50, 150, 300, 500, 800].forEach(function(delay) {
                            setTimeout(function() { 
                                if (window.enforceComboBoxSizes) {
                                    window.enforceComboBoxSizes(); 
                                }
                            }, delay);
                        });
                    }
                });
                
                observer.observe(panel, {
                    attributes: true,
                    attributeFilter: ['class'],
                    childList: true,
                    subtree: true
                });
                
                // Also watch for Select2 initialization
                $(document).on('select2:open select2:select select2:unselect', function() {
                    setTimeout(function() {
                        if (window.enforceComboBoxSizes) {
                            window.enforceComboBoxSizes();
                        }
                    }, 50);
                });
            }
        });
    </script>
}
