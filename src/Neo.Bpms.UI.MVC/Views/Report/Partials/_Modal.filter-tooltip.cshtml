@using Neo.Bpms.UI.MVC.PartialModels.Report
@using Neo.Bpms.UI.MVC.PartialModels.Filter

@inject IControlsRenderer controlsRenderer;

@model ReportData

@{
    var structure = Model.Structure;
    var options = new RendererOptions
    {
        IsFilter = true
    };
    ControlsRendererData controlsRendererData = new(structure, ViewBag.FilterValues, options, ViewBag.user, Url);
}

@if (structure.Fields != null && structure.Fields.Count > 0)
{
    <!-- Filter Tooltip Panel -->
    <div id="filterTooltipPanel" class="filter-tooltip-panel">
        <!-- Header with Close Button -->
        <div class="filter-panel-header">
            <h5 style="margin: 0; font-weight: 600; color: #2d3748;">@ViewTexts.Filter</h5>
            <button type="button" class="filter-panel-close" onclick="window.toggleFilterTooltip()" title="@ViewTexts.Close" aria-label="@ViewTexts.Close">
                <i class="fa fa-times"></i>
            </button>
        </div>
        
        <!-- Main Content Area - Two Columns -->
        <div class="filter-panel-content-wrapper">
            <!-- Right Column - Popular Filters Section (RTL: Right side) -->
            <div class="popular-filters-section">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 style="margin: 0; font-weight: 600; color: #2d3748;">@ViewTexts.UsefulFilters</h6>
                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="FilterTreeManager.newFolder()" title="@ViewTexts.AddFolder">
                        <i class="fa fa-folder-plus"></i> @ViewTexts.AddFolder
                    </button>
                </div>
                <div class="search-box mb-3">
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text"><i class="fa fa-search"></i></span>
                        </div>
                        <input type="text" class="form-control" id="popular-filters-search-input" placeholder="@ViewTexts.Search" />
                    </div>
                </div>
                <div id="popular-filters-tree" class="report-tree-container"></div>
            </div>
            
            <!-- Left Column - Main Filter Controls -->
            <div class="filter-main-content">
                <div class="modern-filter-content">
                    @{
                        var htmlInputStr = controlsRenderer.Render(controlsRendererData);
                    }
                    @htmlInputStr
                </div>
                
                <div class="modern-filter-buttons">
                    <partial name="Common/FilterEraseButton" />
                    @if (ViewBag.ScheduledId != null && ViewBag.ScheduledId > 0)
                    {
                        <button type="button" onclick="ScheduledReport.saveFilterValues(@(ViewBag.ScheduledId ?? 0));" class="btn btn-outline-warning">
                            <span>@ViewTexts.SaveScheduleFilter @(ViewBag.ScheduledName ?? "")</span>
                        </button>
                    }
                    <partial name="Filter/FilterSaveButtons" model="new FilterSaveButtonsModel{filterId = ViewBag.FilterId, filterName = ViewBag.FilterName}" />
                    <partial name="Filter/ApplyButton" />
                    <input type="submit" id="submitBtn" value="" style="display:none; position:absolute; left:-9999px;" aria-hidden="true" />
                </div>
            </div>
        </div>
    </div>

    <style>
        /* ===== Filter Tooltip Panel ===== */
        .filter-tooltip-panel {
          position: fixed !important;
          background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%) !important;
          border: 2px solid #e2e8f0 !important;
          border-radius: 12px !important;
          box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15) !important;
          padding: 20px !important;
          z-index: 1050 !important;
          min-width: 1800px !important;
          max-width: 98vw !important;
          max-height: 90vh !important;
          /* width set dynamically by JavaScript to avoid conflicts with position: fixed */
          backdrop-filter: blur(10px) !important;
          display: flex !important;
          flex-direction: column !important;
          gap: 0 !important;
          /* Font settings - Ensure proper font rendering */
          font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif !important;
          font-size: 14px !important;
          line-height: 1.5 !important;
          color: #2d3748 !important;
          /* Use visibility and opacity instead of display for better control */
          visibility: hidden !important;
          opacity: 0 !important;
          pointer-events: none !important;
          transition: opacity 0.3s ease-out, visibility 0.3s ease-out !important;
          overflow: hidden !important;
        }
        
        .filter-panel-header {
          display: flex !important;
          justify-content: space-between !important;
          align-items: center !important;
          margin-bottom: 16px !important;
          padding-bottom: 12px !important;
          border-bottom: 2px solid #e2e8f0 !important;
          flex-shrink: 0 !important;
        }
        
        .filter-panel-close {
          background: transparent !important;
          border: none !important;
          font-size: 20px !important;
          color: #64748b !important;
          cursor: pointer !important;
          padding: 4px 8px !important;
          border-radius: 4px !important;
          transition: all 0.2s ease !important;
          line-height: 1 !important;
        }
        
        .filter-panel-close:hover {
          background: #f1f5f9 !important;
          color: #1e293b !important;
        }

        .filter-tooltip-panel.show {
          visibility: visible !important;
          opacity: 1 !important;
          pointer-events: auto !important;
          display: flex !important;
        }

        .filter-tooltip-panel .modern-form {
          display: block !important;
          margin: 0 !important;
          padding: 0 !important;
          font-family: inherit !important;
          font-size: inherit !important;
        }

        .filter-tooltip-panel .modern-filter-wrapper {
          margin-bottom: 16px !important;
          font-family: inherit !important;
          font-size: inherit !important;
        }
        
        /* Ensure all inputs, selects, and controls have proper font */
        .filter-tooltip-panel input,
        .filter-tooltip-panel select,
        .filter-tooltip-panel textarea,
        .filter-tooltip-panel .form-control,
        .filter-tooltip-panel .modern-multi-select-control,
        .filter-tooltip-panel .modern-multi-select-input {
          font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif !important;
          font-size: 14px !important;
          line-height: 1.5 !important;
          color: #2d3748 !important;
        }
        
        /* ============================================
           COMBO BOX SIZES - UNIFIED HEIGHT
           ============================================ */
        
        /* Standard select and form controls */
        .filter-tooltip-panel select,
        .filter-tooltip-panel .form-control,
        .filter-tooltip-panel .cBox,
        .filter-tooltip-panel input[type="text"],
        .filter-tooltip-panel input[type="number"],
        .filter-tooltip-panel input[type="date"],
        .filter-tooltip-panel input[type="time"] {
          min-height: 38px !important;
          height: 38px !important;
          padding: 8px 12px !important;
          font-size: 13px !important;
          line-height: 1.5 !important;
          box-sizing: border-box !important;
        }
        
        /* Select2 combo sizes */
        .filter-tooltip-panel .select2-container {
          min-height: 38px !important;
          height: auto !important;
        }
        
        .filter-tooltip-panel .select2-container .select2-selection--single {
          height: 38px !important;
          min-height: 38px !important;
          border-radius: 6px !important;
        }
        
        .filter-tooltip-panel .select2-container .select2-selection--single .select2-selection__rendered {
          line-height: 38px !important;
          padding: 0 12px !important;
          font-size: 13px !important;
          height: 38px !important;
        }
        
        .filter-tooltip-panel .select2-container .select2-selection--single .select2-selection__arrow {
          height: 38px !important;
          top: 0 !important;
          right: 8px !important;
        }
        
        .filter-tooltip-panel .select2-container .select2-selection--multiple {
          min-height: 38px !important;
          padding: 2px 8px !important;
        }
        
        .filter-tooltip-panel .select2-container .select2-selection--multiple .select2-selection__choice {
          margin-top: 4px !important;
          margin-bottom: 4px !important;
          padding: 2px 8px !important;
          font-size: 12px !important;
        }
        
        /* Bootstrap Select */
        .filter-tooltip-panel .bootstrap-select {
          min-height: 38px !important;
        }
        
        .filter-tooltip-panel .bootstrap-select .dropdown-toggle {
          height: 38px !important;
          min-height: 38px !important;
          padding: 8px 12px !important;
          font-size: 13px !important;
          line-height: 1.5 !important;
        }
        
        .filter-tooltip-panel .bootstrap-select .dropdown-toggle .filter-option {
          line-height: 1.5 !important;
          padding: 0 !important;
        }
        
        /* Modern Multi-Select */
        .filter-tooltip-panel .modern-multi-select-container {
          min-height: 38px !important;
          height: auto !important;
        }
        
        .filter-tooltip-panel .modern-multi-select-control {
          min-height: 38px !important;
          height: 38px !important;
          padding: 8px 12px !important;
          font-size: 13px !important;
          line-height: 1.5 !important;
        }
        
        .filter-tooltip-panel .modern-multi-select-input {
          min-height: 38px !important;
          height: 38px !important;
          padding: 8px 12px !important;
          font-size: 13px !important;
          line-height: 1.5 !important;
        }
        
        .filter-tooltip-panel .modern-multi-select-control .modern-multi-select-selected-item {
          padding: 4px 8px !important;
          margin: 2px 4px 2px 0 !important;
          font-size: 12px !important;
          line-height: 1.4 !important;
        }
        
        /* Ensure all combos have consistent styling */
        .filter-tooltip-panel .select2-container,
        .filter-tooltip-panel .bootstrap-select,
        .filter-tooltip-panel .modern-multi-select-container {
          font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif !important;
          font-size: 13px !important;
        }
        
        /* Ensure labels are properly styled */
        .filter-tooltip-panel label,
        .filter-tooltip-panel .form-label,
        .filter-tooltip-panel .modern-filter-label {
          font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif !important;
          font-size: 14px !important;
          font-weight: 500 !important;
          color: #2d3748 !important;
          margin-bottom: 4px !important;
        }

        .filter-tooltip-panel .modern-filter-buttons {
          display: flex !important;
          gap: 8px !important;
          justify-content: flex-end !important;
          margin-top: auto !important;
          padding: 16px 0 0 0 !important;
          border-top: 1px solid #e2e8f0 !important;
          flex-shrink: 0 !important;
          flex-grow: 0 !important;
          background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%) !important;
          position: relative !important;
          z-index: 10 !important;
          width: 100% !important;
        }

        .filter-tooltip-panel .btn {
          padding: 8px 16px !important;
          font-size: 14px !important;
          border-radius: 6px !important;
          transition: all 0.2s ease !important;
          font-weight: 500 !important;
        }

        .filter-tooltip-panel .btn:hover {
          transform: translateY(-1px) !important;
          box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1) !important;
        }
        
        .filter-tooltip-panel .btn-primary,
        .filter-tooltip-panel #submit-filter {
          background-color: #3b82f6 !important;
          border-color: #3b82f6 !important;
          color: #ffffff !important;
          font-weight: 600 !important;
        }
        
        .filter-tooltip-panel .btn-primary:hover,
        .filter-tooltip-panel #submit-filter:hover {
          background-color: #2563eb !important;
          border-color: #2563eb !important;
          color: #ffffff !important;
        }
        
        .filter-tooltip-panel .btn-primary span,
        .filter-tooltip-panel #submit-filter span {
          color: #ffffff !important;
          font-weight: 600 !important;
          display: inline-block !important;
        }
        
        .filter-tooltip-panel .btn-primary svg,
        .filter-tooltip-panel #submit-filter svg {
          fill: #ffffff !important;
          stroke: #ffffff !important;
        }
        
        /* Premium Apply Filter Button - Matching other buttons */
        .filter-tooltip-panel #submit-filter {
          color: #ffffff !important;
          font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif !important;
          font-size: 14px !important;
          font-weight: 600 !important;
          padding: 8px 16px !important;
          background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%) !important;
          border: none !important;
          box-shadow: 0 2px 4px rgba(59, 130, 246, 0.2) !important;
          transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1) !important;
        }
        
        .filter-tooltip-panel #submit-filter:hover {
          background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%) !important;
          box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3) !important;
          transform: translateY(-1px) !important;
        }
        
        .filter-tooltip-panel #submit-filter:active {
          transform: translateY(0) !important;
          box-shadow: 0 2px 6px rgba(59, 130, 246, 0.3) !important;
        }
        
        .filter-tooltip-panel #submit-filter * {
          color: #ffffff !important;
        }
        
        .filter-tooltip-panel #submit-filter span {
          color: #ffffff !important;
          opacity: 1 !important;
          visibility: visible !important;
          font-family: inherit !important;
          font-size: 14px !important;
          font-weight: 600 !important;
          margin-left: 6px !important;
        }
        
        .filter-tooltip-panel #submit-filter svg {
          width: 16px !important;
          height: 16px !important;
          vertical-align: middle !important;
        }
        
        /* Prevent Ladda button from auto-loading */
        .filter-tooltip-panel #submit-filter.ladda-button:not(.ladda-loading) {
          position: relative !important;
        }
        
        /* Ensure Ladda spinner doesn't interfere when not loading */
        .filter-tooltip-panel #submit-filter.ladda-button:not(.ladda-loading) .ladda-spinner {
          display: none !important;
        }
        
        .filter-tooltip-panel .btn-outline-warning {
          color: #f59e0b !important;
          border-color: #f59e0b !important;
          background-color: transparent !important;
        }
        
        .filter-tooltip-panel .btn-outline-warning:hover {
          background-color: #f59e0b !important;
          color: #ffffff !important;
        }
        
        /* Ensure all text in buttons is visible */
        .filter-tooltip-panel .btn * {
          color: inherit !important;
        }
        
        .filter-tooltip-panel .btn-primary *,
        .filter-tooltip-panel #submit-filter * {
          color: #ffffff !important;
        }
        
        /* Ensure Ladda button spinner is visible */
        .filter-tooltip-panel .ladda-button .ladda-spinner > div {
          background-color: #ffffff !important;
        }
        
        /* Ensure button text is always visible */
        .filter-tooltip-panel button span {
          display: inline-block !important;
          color: inherit !important;
        }
        
        /* Ensure dropdowns and comboboxes appear above the panel */
        .filter-tooltip-panel .dropdown-menu,
        .filter-tooltip-panel .select2-dropdown,
        .filter-tooltip-panel .bootstrap-select .dropdown-menu,
        .filter-tooltip-panel [class*="dropdown"] {
          z-index: 1051 !important;
        }
        
        /* Ensure modern multi-select dropdowns appear correctly */
        .filter-tooltip-panel .modern-multi-select-dropdown {
          z-index: 1051 !important;
        }
        
        /* Two Column Layout - RTL: Popular filters on right */
        .filter-panel-content-wrapper {
          display: flex !important;
          gap: 24px !important;
          align-items: stretch !important;
          width: 100% !important;
          flex: 1 1 auto !important;
          min-height: 0 !important;
          max-height: 100% !important;
          overflow: hidden !important;
          height: 100% !important;
        }
        
        .filter-main-content {
          flex: 1 1 75% !important;
          min-width: 0 !important;
          display: flex !important;
          flex-direction: column !important;
          min-height: 0 !important;
          max-height: 100% !important;
          height: 100% !important;
          overflow: hidden !important;
          position: relative !important;
        }
        
        .popular-filters-section {
          flex: 0 0 25% !important;
          min-width: 300px !important;
          max-width: 400px !important;
          padding: 16px !important;
          background: #f8fafc !important;
          border-radius: 8px !important;
          border: 1px solid #e2e8f0 !important;
          display: flex !important;
          flex-direction: column !important;
          min-height: 0 !important;
          max-height: 100% !important;
          overflow: hidden !important;
        }
        
        .popular-filters-section .report-tree-container {
          flex: 1 1 auto !important;
          min-height: 0 !important;
          overflow-y: auto !important;
          overflow-x: hidden !important;
        }
        
        .modern-filter-content {
          width: 100% !important;
          flex: 1 1 auto !important;
          min-height: 0 !important;
          overflow-y: auto !important;
          overflow-x: auto !important;
          padding-bottom: 8px !important;
          padding-right: 4px !important;
        }
        
        .filter-panel-content-wrapper {
          max-height: none !important;
          height: 100% !important;
        }
        
        /* Premium Scrollbar Design */
        .filter-tooltip-panel .modern-filter-content::-webkit-scrollbar,
        .filter-tooltip-panel .popular-filters-section .report-tree-container::-webkit-scrollbar {
          width: 10px !important;
          height: 10px !important;
        }
        
        .filter-tooltip-panel .modern-filter-content::-webkit-scrollbar-track,
        .filter-tooltip-panel .popular-filters-section .report-tree-container::-webkit-scrollbar-track {
          background: #f1f5f9 !important;
          border-radius: 5px !important;
        }
        
        .filter-tooltip-panel .modern-filter-content::-webkit-scrollbar-thumb,
        .filter-tooltip-panel .popular-filters-section .report-tree-container::-webkit-scrollbar-thumb {
          background: linear-gradient(180deg, #cbd5e1 0%, #94a3b8 100%) !important;
          border-radius: 5px !important;
          border: 2px solid #f1f5f9 !important;
        }
        
        .filter-tooltip-panel .modern-filter-content::-webkit-scrollbar-thumb:hover,
        .filter-tooltip-panel .popular-filters-section .report-tree-container::-webkit-scrollbar-thumb:hover {
          background: linear-gradient(180deg, #94a3b8 0%, #64748b 100%) !important;
        }
        
        /* Horizontal scrollbar */
        .filter-tooltip-panel .modern-filter-content::-webkit-scrollbar:horizontal {
          height: 6px !important;
        }
        
        /* Reduce filter type icon size to match back icon (20px) */
        .filter-tooltip-panel .choice-form-link {
          width: 20px !important;
          height: 20px !important;
        }
        
        .filter-tooltip-panel .choice-form-link svg {
          width: 12px !important;
          height: 12px !important;
        }
        
        /* Reduce filter parameter icon size to match back icon */
        .filter-tooltip-panel .filter-parameter-icon {
          width: 20px !important;
          height: 20px !important;
        }
        
        .filter-tooltip-panel .filter-parameter-icon svg {
          width: 12px !important;
          height: 12px !important;
        }
    </style>

    @* JavaScript functions are now in Report.js *@
}
