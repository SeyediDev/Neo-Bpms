@using Neo.Bpms.UI.MVC.PartialModels.Report
@using Neo.Bpms.UI.MVC.PartialModels.Filter
@inject IControlsRenderer controlsRenderer;
@model ReportData

@{
    var structure = Model.Structure;
    var options = new RendererOptions
    {
        IsFilter = true
    };
    ControlsRendererData controlsRendererData = new(structure, ViewBag.FilterValues, options, ViewBag.user, Url);
}

@if (structure.Fields != null && structure.Fields.Count > 0)
{
    <!-- Filter Tooltip Panel -->
    <div id="filterTooltipPanel" class="filter-tooltip-panel popular-filters-hidden">
        <!-- Header with Close Button -->
        <div class="filter-panel-header">
            <h5 style="margin: 0; font-weight: 600; color: #2d3748;">@ViewTexts.Filter</h5>
            <button type="button" class="filter-panel-close" onclick="window.toggleFilterTooltip()" title="@ViewTexts.Close" aria-label="@ViewTexts.Close">
                <i class="fa fa-times"></i>
            </button>
        </div>
        
        <!-- Main Content Area - Two Columns -->
        <div class="filter-panel-content-wrapper">
            <!-- Right Column - Popular Filters Section (RTL: Right side) - Dock View with Auto Hide -->
            <div class="popular-filters-dock-container auto-hide">
                <!-- Auto Hide Tab (shown when panel is hidden) -->
                <div class="popular-filters-auto-hide-tab" id="popular-filters-auto-hide-tab" onclick="window.togglePopularFiltersAutoHide()" title="@ViewTexts.UsefulFilters">
                    <i class="fa fa-filter"></i>
                    <span class="auto-hide-tab-text">@ViewTexts.UsefulFilters</span>
                </div>
                
                <!-- Popular Filters Panel -->
                <div class="popular-filters-section" id="popular-filters-section">
                    <div class="popular-filters-header">
                        <div class="d-flex justify-content-between align-items-center">
                            <h6 style="margin: 0; font-weight: 600; color: #2d3748;">@ViewTexts.UsefulFilters</h6>
                            <div class="popular-filters-actions">
                                <button type="button" class="btn btn-sm btn-outline-primary" onclick="FilterTreeManager.newFolder()" title="@ViewTexts.AddFolder">
                                    <i class="fa fa-folder-plus"></i> @ViewTexts.AddFolder
                                </button>
                                <button type="button" class="popular-filters-toggle-btn" id="popular-filters-pin-btn" onclick="window.togglePopularFiltersAutoHide()" title="مخفی کردن فیلترهای پرکاربرد">
                                    <i class="fa fa-eye-slash"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="popular-filters-content">
                        <div class="search-box mb-3">
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text"><i class="fa fa-search"></i></span>
                                </div>
                                <input type="text" class="form-control" id="popular-filters-search-input" placeholder="@ViewTexts.Search" />
                            </div>
                        </div>
                        <div id="popular-filters-tree" class="report-tree-container"></div>
                    </div>
                </div>
            </div>
            
            <!-- Left Column - Main Filter Controls -->
            <div class="filter-main-content">
                <div class="modern-filter-content">
                    @{
                        var htmlInputStr = controlsRenderer.Render(controlsRendererData);
                    }
                    @htmlInputStr
                </div>
                
                <div class="modern-filter-buttons">
                    <partial name="Common/FilterEraseButton" />
                    @if (ViewBag.ScheduledId != null && ViewBag.ScheduledId > 0)
                    {
                        <button type="button" onclick="ScheduledReport.saveFilterValues(@(ViewBag.ScheduledId ?? 0));" class="btn btn-outline-warning">
                            <span>@ViewTexts.SaveScheduleFilter @(ViewBag.ScheduledName ?? "")</span>
                        </button>
                    }
                    <partial name="Filter/FilterSaveButtons" model="new FilterSaveButtonsModel{filterId = ViewBag.FilterId, filterName = ViewBag.FilterName}" />
                    <partial name="Filter/ApplyButton" />
                    <input type="submit" id="submitBtn" value="" style="display:none; position:absolute; left:-9999px;" aria-hidden="true" />
                </div>
            </div>
        </div>
    </div>

    <style>
        /* ===== Filter Tooltip Panel ===== */
        .filter-tooltip-panel {
          position: fixed !important;
          background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%) !important;
          border: 2px solid #e2e8f0 !important;
          border-radius: 12px !important;
          box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15) !important;
          padding: 20px !important;
          z-index: 1050 !important;
          min-width: 1800px !important;
          max-width: 98vw !important;
          max-height: 90vh !important;
          /* width set dynamically by JavaScript to avoid conflicts with position: fixed */
          backdrop-filter: blur(10px) !important;
          display: flex !important;
          flex-direction: column !important;
          gap: 0 !important;
          /* Font settings - Ensure proper font rendering */
          font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif !important;
          font-size: 14px !important;
          line-height: 1.5 !important;
          color: #2d3748 !important;
          /* Use visibility and opacity instead of display for better control */
          visibility: hidden !important;
          opacity: 0 !important;
          pointer-events: none !important;
          transition: opacity 0.3s ease-out, visibility 0.3s ease-out !important;
          overflow: hidden !important;
        }
        
        .filter-panel-header {
          display: flex !important;
          justify-content: space-between !important;
          align-items: center !important;
          margin-bottom: 16px !important;
          padding-bottom: 12px !important;
          border-bottom: 2px solid #e2e8f0 !important;
          flex-shrink: 0 !important;
        }
        
        
        .filter-panel-close {
          background: transparent !important;
          border: none !important;
          font-size: 20px !important;
          color: #64748b !important;
          cursor: pointer !important;
          padding: 4px 8px !important;
          border-radius: 4px !important;
          transition: all 0.2s ease !important;
          line-height: 1 !important;
        }
        
        .filter-panel-close:hover {
          background: #f1f5f9 !important;
          color: #1e293b !important;
        }

        .filter-tooltip-panel.show {
          visibility: visible !important;
          opacity: 1 !important;
          pointer-events: auto !important;
          display: flex !important;
        }

        .filter-tooltip-panel .modern-form {
          display: block !important;
          margin: 0 !important;
          padding: 0 !important;
          font-family: inherit !important;
          font-size: inherit !important;
        }

        .filter-tooltip-panel .modern-filter-wrapper {
          margin-bottom: 16px !important;
          font-family: inherit !important;
          font-size: inherit !important;
        }
        
        /* Ensure all inputs, selects, and controls have proper font */
        .filter-tooltip-panel input,
        .filter-tooltip-panel select,
        .filter-tooltip-panel textarea,
        .filter-tooltip-panel .form-control,
        .filter-tooltip-panel .modern-multi-select-control,
        .filter-tooltip-panel .modern-multi-select-input {
          font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif !important;
          font-size: 14px !important;
          line-height: 1.5 !important;
          color: #2d3748 !important;
        }
        
        /* ============================================
           COMBO BOX SIZES - SIMPLE & CLEAN - 38px
           Override controls-modern.css (60px)
           Only for native selects and Modern Multi-Select
           Select2 is disabled in filter panel
           ============================================ */
        
        /* CRITICAL: Override controls-modern.css line 840 - ALL possible selectors */
        #filterTooltipPanel .modern-form .neo-control select,
        #filterTooltipPanel .modern-form .neo-control select.form-control,
        #filterTooltipPanel .modern-form .neo-control select.cBox,
        #filterTooltipPanel .modern-form select,
        #filterTooltipPanel .modern-form select.form-control,
        #filterTooltipPanel .modern-form select.cBox,
        #filterTooltipPanel .neo-control select,
        #filterTooltipPanel .neo-control select.form-control,
        #filterTooltipPanel .neo-control select.cBox,
        #filterTooltipPanel select:not([multiple]):not([size]),
        #filterTooltipPanel select.form-control:not([multiple]),
        #filterTooltipPanel select.cBox:not([multiple]),
        #filterTooltipPanel .form-control:not([multiple]),
        #filterTooltipPanel .cBox:not([multiple]),
        #filterTooltipPanel .modern-filter-wrapper select,
        #filterTooltipPanel .modern-filter-wrapper .form-control,
        #filterTooltipPanel .modern-filter-wrapper .cBox,
        #filterTooltipPanel .modern-filter-content select,
        #filterTooltipPanel .modern-filter-content .form-control,
        #filterTooltipPanel .modern-filter-content .cBox {
          min-height: 38px !important;
          height: 38px !important;
          max-height: 38px !important;
          padding: 8px 12px !important;
          line-height: 1.5 !important;
          font-size: 13px !important;
          box-sizing: border-box !important;
          vertical-align: middle !important;
        }
        
        /* Modern Multi-Select - The only enhanced select we use */
        #filterTooltipPanel .modern-multi-select-control,
        #filterTooltipPanel .modern-multi-select-input {
          min-height: 38px !important;
          height: 38px !important;
          max-height: 38px !important;
          padding: 8px 12px !important;
          font-size: 13px !important;
          line-height: 1.5 !important;
          box-sizing: border-box !important;
        }
        
        /* Hide Select2 if it gets initialized (shouldn't happen) */
        #filterTooltipPanel .select2-container {
          display: none !important;
          visibility: hidden !important;
          opacity: 0 !important;
          pointer-events: none !important;
        }
        
        /* Show native select if Select2 was hiding it */
        #filterTooltipPanel select.select2-hidden-accessible {
          display: block !important;
          visibility: visible !important;
          opacity: 1 !important;
        }
        
        /* Ensure labels are properly styled */
        .filter-tooltip-panel label,
        .filter-tooltip-panel .form-label,
        .filter-tooltip-panel .modern-filter-label {
          font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif !important;
          font-size: 14px !important;
          font-weight: 500 !important;
          color: #2d3748 !important;
          margin-bottom: 4px !important;
        }

        .filter-tooltip-panel .modern-filter-buttons {
          display: flex !important;
          gap: 8px !important;
          justify-content: flex-end !important;
          margin-top: auto !important;
          padding: 16px 0 0 0 !important;
          border-top: 1px solid #e2e8f0 !important;
          flex-shrink: 0 !important;
          flex-grow: 0 !important;
          background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%) !important;
          position: relative !important;
          z-index: 10 !important;
          width: 100% !important;
        }

        /* General button styles */
        .filter-tooltip-panel .btn {
          padding: 8px 16px !important;
          font-size: 14px !important;
          border-radius: 6px !important;
          transition: all 0.2s ease !important;
          font-weight: 500 !important;
          font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif !important;
        }

        .filter-tooltip-panel .btn:hover {
          transform: translateY(-1px) !important;
          box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1) !important;
        }
        
        /* Apply Filter Button - Clean and Complete Styling */
        .filter-tooltip-panel #submit-filter,
        .filter-tooltip-panel #submit-filter.btn,
        .filter-tooltip-panel #submit-filter.btn-primary,
        .filter-tooltip-panel #submit-filter.ladda-button,
        .filter-tooltip-panel #submit-filter.save-button {
          /* Base button styles */
          display: inline-flex !important;
          align-items: center !important;
          justify-content: center !important;
          gap: 6px !important;
          padding: 8px 16px !important;
          margin: 0 !important;
          
          /* Typography */
          font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif !important;
          font-size: 14px !important;
          font-weight: 600 !important;
          line-height: 1.5 !important;
          color: #ffffff !important;
          text-align: center !important;
          
          /* Visual styling */
          background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%) !important;
          background-color: #3b82f6 !important;
          border: none !important;
          border-color: #3b82f6 !important;
          border-radius: 6px !important;
          box-shadow: 0 2px 4px rgba(59, 130, 246, 0.2) !important;
          
          /* Layout */
          min-height: auto !important;
          height: auto !important;
          width: auto !important;
          max-width: none !important;
          vertical-align: middle !important;
          
          /* Behavior */
          cursor: pointer !important;
          transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1) !important;
          position: relative !important;
          overflow: visible !important;
        }
        
        .filter-tooltip-panel #submit-filter:hover,
        .filter-tooltip-panel #submit-filter.btn:hover,
        .filter-tooltip-panel #submit-filter.btn-primary:hover,
        .filter-tooltip-panel #submit-filter.ladda-button:hover {
          background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%) !important;
          background-color: #2563eb !important;
          border-color: #2563eb !important;
          box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3) !important;
          transform: translateY(-1px) !important;
          color: #ffffff !important;
        }
        
        .filter-tooltip-panel #submit-filter:active,
        .filter-tooltip-panel #submit-filter.btn:active,
        .filter-tooltip-panel #submit-filter.btn-primary:active,
        .filter-tooltip-panel #submit-filter.ladda-button:active {
          transform: translateY(0) !important;
          box-shadow: 0 2px 6px rgba(59, 130, 246, 0.3) !important;
        }
        
        /* Button text (span) */
        .filter-tooltip-panel #submit-filter span,
        .filter-tooltip-panel #submit-filter.btn span,
        .filter-tooltip-panel #submit-filter.btn-primary span,
        .filter-tooltip-panel #submit-filter.ladda-button span {
          display: inline-block !important;
          color: #ffffff !important;
          font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif !important;
          font-size: 14px !important;
          font-weight: 600 !important;
          line-height: 1.5 !important;
          opacity: 1 !important;
          visibility: visible !important;
          margin: 0 !important;
          padding: 0 !important;
          white-space: nowrap !important;
        }
        
        /* Button SVG icon */
        .filter-tooltip-panel #submit-filter svg,
        .filter-tooltip-panel #submit-filter.btn svg,
        .filter-tooltip-panel #submit-filter.btn-primary svg,
        .filter-tooltip-panel #submit-filter.ladda-button svg {
          width: 18px !important;
          height: 18px !important;
          display: inline-block !important;
          vertical-align: middle !important;
          fill: #ffffff !important;
          stroke: #ffffff !important;
          color: #ffffff !important;
          margin: 0 !important;
          padding: 0 !important;
          flex-shrink: 0 !important;
        }
        
        /* Override all child elements */
        .filter-tooltip-panel #submit-filter *,
        .filter-tooltip-panel #submit-filter.btn *,
        .filter-tooltip-panel #submit-filter.btn-primary *,
        .filter-tooltip-panel #submit-filter.ladda-button * {
          color: #ffffff !important;
        }
        
        /* Ladda button specific fixes */
        .filter-tooltip-panel #submit-filter.ladda-button:not(.ladda-loading) {
          position: relative !important;
        }
        
        .filter-tooltip-panel #submit-filter.ladda-button:not(.ladda-loading) .ladda-spinner {
          display: none !important;
        }
        
        .filter-tooltip-panel #submit-filter.ladda-button .ladda-spinner > div {
          background-color: #ffffff !important;
        }
        
        /* Other primary buttons */
        .filter-tooltip-panel .btn-primary:not(#submit-filter) {
          background-color: #3b82f6 !important;
          border-color: #3b82f6 !important;
          color: #ffffff !important;
          font-weight: 600 !important;
        }
        
        .filter-tooltip-panel .btn-primary:not(#submit-filter):hover {
          background-color: #2563eb !important;
          border-color: #2563eb !important;
          color: #ffffff !important;
        }
        
        .filter-tooltip-panel .btn-outline-warning {
          color: #f59e0b !important;
          border-color: #f59e0b !important;
          background-color: transparent !important;
        }
        
        .filter-tooltip-panel .btn-outline-warning:hover {
          background-color: #f59e0b !important;
          color: #ffffff !important;
        }
        
        /* Ensure all text in buttons is visible */
        .filter-tooltip-panel .btn:not(#submit-filter) * {
          color: inherit !important;
        }
        
        .filter-tooltip-panel .btn-primary:not(#submit-filter) * {
          color: #ffffff !important;
        }
        
        /* Ensure button text is always visible */
        .filter-tooltip-panel button:not(#submit-filter) span {
          display: inline-block !important;
          color: inherit !important;
        }
        
        /* Ensure dropdowns and comboboxes appear above the panel */
        .filter-tooltip-panel .dropdown-menu,
        .filter-tooltip-panel .select2-dropdown,
        .filter-tooltip-panel .bootstrap-select .dropdown-menu,
        .filter-tooltip-panel [class*="dropdown"] {
          z-index: 1051 !important;
        }
        
        /* Ensure modern multi-select dropdowns appear correctly */
        .filter-tooltip-panel .modern-multi-select-dropdown {
          z-index: 1051 !important;
        }
        
        /* Two Column Layout - RTL: Popular filters on right */
        .filter-panel-content-wrapper {
          display: flex !important;
          gap: 24px !important;
          align-items: stretch !important;
          width: 100% !important;
          flex: 1 1 auto !important;
          min-height: 0 !important;
          max-height: 100% !important;
          overflow: hidden !important;
          height: 100% !important;
        }
        
        .filter-main-content {
          flex: 1 1 75% !important;
          min-width: 0 !important;
          display: flex !important;
          flex-direction: column !important;
          min-height: 0 !important;
          max-height: 100% !important;
          height: 100% !important;
          overflow: hidden !important;
          position: relative !important;
        }
        
        /* Popular Filters Dock Container */
        .popular-filters-dock-container {
          position: relative !important;
          flex: 0 0 auto !important;
          display: flex !important;
          align-items: stretch !important;
          height: 100% !important;
        }
        
        /* Auto Hide Tab - Shown when panel is hidden */
        /* Default: For LTR, show on right */
        .popular-filters-auto-hide-tab {
          position: fixed !important;
          right: 20px !important;
          top: 50% !important;
          transform: translateY(-50%) rotate(180deg) !important;
          writing-mode: vertical-rl !important;
          text-orientation: mixed !important;
          background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%) !important;
          color: #ffffff !important;
          padding: 12px 8px !important;
          border-radius: 8px 0 0 8px !important;
          cursor: pointer !important;
          z-index: 1051 !important;
          box-shadow: -2px 0 8px rgba(0, 0, 0, 0.15) !important;
          transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
          display: flex !important;
          align-items: center !important;
          justify-content: center !important;
          gap: 8px !important;
          min-width: 40px !important;
          font-size: 13px !important;
          font-weight: 600 !important;
          font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif !important;
          opacity: 0 !important;
          visibility: hidden !important;
          pointer-events: none !important;
        }
        
        /* RTL Support for Auto Hide Tab - Show on RIGHT side for RTL */
        [dir="rtl"] .popular-filters-auto-hide-tab {
          right: 20px !important;
          left: auto !important;
          border-radius: 8px 0 0 8px !important;
          box-shadow: -2px 0 8px rgba(0, 0, 0, 0.15) !important;
        }
        
        /* Also check for RTL on body or html */
        body[dir="rtl"] .popular-filters-auto-hide-tab,
        html[dir="rtl"] .popular-filters-auto-hide-tab {
          right: 20px !important;
          left: auto !important;
          border-radius: 8px 0 0 8px !important;
          box-shadow: -2px 0 8px rgba(0, 0, 0, 0.15) !important;
        }
        
        .popular-filters-auto-hide-tab:hover {
          background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%) !important;
          box-shadow: -4px 0 12px rgba(0, 0, 0, 0.2) !important;
          transform: translateY(-50%) translateX(-4px) rotate(180deg) !important;
        }
        
        /* RTL hover - keep on right side */
        [dir="rtl"] .popular-filters-auto-hide-tab:hover,
        body[dir="rtl"] .popular-filters-auto-hide-tab:hover,
        html[dir="rtl"] .popular-filters-auto-hide-tab:hover {
          box-shadow: -4px 0 12px rgba(0, 0, 0, 0.2) !important;
          transform: translateY(-50%) translateX(-4px) rotate(180deg) !important;
        }
        
        /* Hide auto-hide tab when filter panel is hidden */
        .filter-tooltip-panel:not(.show) .popular-filters-auto-hide-tab {
          opacity: 0 !important;
          visibility: hidden !important;
          pointer-events: none !important;
        }
        
        .popular-filters-auto-hide-tab i {
          font-size: 16px !important;
          transform: rotate(90deg) !important;
        }
        
        .popular-filters-auto-hide-tab .auto-hide-tab-text {
          white-space: nowrap !important;
          letter-spacing: 0.5px !important;
        }
        
        /* Popular Filters Section - Main Panel */
        .popular-filters-section {
          flex: 0 0 25% !important;
          min-width: 300px !important;
          max-width: 400px !important;
          background: #f8fafc !important;
          border-radius: 8px !important;
          border: 1px solid #e2e8f0 !important;
          display: flex !important;
          flex-direction: column !important;
          min-height: 0 !important;
          max-height: 100% !important;
          overflow: hidden !important;
          transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
          opacity: 1 !important;
          visibility: visible !important;
          margin-right: 0 !important;
        }
        
        /* Auto Hide State - Panel Hidden */
        .popular-filters-dock-container.auto-hide .popular-filters-section {
          width: 0 !important;
          min-width: 0 !important;
          max-width: 0 !important;
          padding: 0 !important;
          margin: 0 !important;
          border: none !important;
          opacity: 0 !important;
          visibility: hidden !important;
          overflow: hidden !important;
        }
        
        /* Show auto-hide tab when popular filters is auto-hidden AND filter panel is visible */
        .filter-tooltip-panel.show .popular-filters-dock-container.auto-hide .popular-filters-auto-hide-tab {
          opacity: 1 !important;
          visibility: visible !important;
          pointer-events: auto !important;
        }
        
        /* Popular Filters Header */
        .popular-filters-header {
          padding: 16px 16px 12px 16px !important;
          border-bottom: 1px solid #e2e8f0 !important;
          flex-shrink: 0 !important;
          background: #ffffff !important;
        }
        
        .popular-filters-actions {
          display: flex !important;
          gap: 4px !important;
          align-items: center !important;
        }
        
        /* Popular Filters Toggle Button - Next to Add Folder */
        .popular-filters-toggle-btn {
          background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%) !important;
          border: none !important;
          font-size: 14px !important;
          color: #ffffff !important;
          cursor: pointer !important;
          padding: 6px 12px !important;
          border-radius: 6px !important;
          transition: all 0.2s ease !important;
          line-height: 1 !important;
          display: inline-flex !important;
          align-items: center !important;
          justify-content: center !important;
          min-width: 36px !important;
          min-height: 32px !important;
          box-shadow: 0 2px 4px rgba(59, 130, 246, 0.2) !important;
          margin-right: 8px !important;
        }
        
        .popular-filters-toggle-btn:hover {
          background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%) !important;
          color: #ffffff !important;
          box-shadow: 0 4px 8px rgba(59, 130, 246, 0.3) !important;
          transform: translateY(-1px) !important;
        }
        
        .popular-filters-toggle-btn:active {
          transform: translateY(0) !important;
          box-shadow: 0 2px 4px rgba(59, 130, 246, 0.2) !important;
        }
        
        /* Change background color when popular filters is hidden */
        .popular-filters-dock-container.auto-hide .popular-filters-toggle-btn {
          background: linear-gradient(135deg, #10b981 0%, #059669 100%) !important;
        }
        
        .popular-filters-dock-container.auto-hide .popular-filters-toggle-btn:hover {
          background: linear-gradient(135deg, #059669 0%, #047857 100%) !important;
        }
        
        .popular-filters-toggle-btn i {
          transition: all 0.3s ease !important;
        }
        
        /* Popular Filters Content */
        .popular-filters-content {
