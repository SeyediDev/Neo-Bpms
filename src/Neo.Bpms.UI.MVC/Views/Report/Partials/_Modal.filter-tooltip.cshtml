        /* Override controls-modern.css line 866-871 */
        .filter-tooltip-panel.filter-tooltip-panel .modern-form .select2-container .select2-selection--single .select2-selection__arrow,
        .filter-tooltip-panel .modern-form .select2-container .select2-selection--single .select2-selection__arrow,
        .filter-tooltip-panel .modern-form .select2-container--default .select2-selection--single .select2-selection__arrow,
        .filter-tooltip-panel .select2-container .select2-selection--single .select2-selection__arrow,
        .filter-tooltip-panel .select2-container--default .select2-selection--single .select2-selection__arrow {
