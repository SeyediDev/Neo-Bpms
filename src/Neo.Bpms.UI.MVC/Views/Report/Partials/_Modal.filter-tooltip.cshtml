                });
                
                observer.observe(panel, {
                    attributes: true,
                    attributeFilter: ['class'],
                    childList: true,
                    subtree: true
                });
                
                // Also watch for Select2 initialization
                $(document).on('select2:open select2:select select2:unselect', function() {
                    setTimeout(function() {
                        if (window.enforceComboBoxSizes) {
                            window.enforceComboBoxSizes();
                        }
                    }, 50);
                });
            }
        });
    </script>
}
