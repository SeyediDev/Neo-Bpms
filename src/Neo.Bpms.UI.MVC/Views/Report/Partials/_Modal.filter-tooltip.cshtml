          max-height: 38px !important;
          border-radius: 6px !important;
          display: flex !important;
          align-items: center !important;
          padding: 0 !important;
        }
        
        /* Override controls-modern.css line 856-864 */
        .filter-tooltip-panel.filter-tooltip-panel .modern-form .select2-container .select2-selection--single .select2-selection__rendered,
        .filter-tooltip-panel .modern-form .select2-container .select2-selection--single .select2-selection__rendered,
        .filter-tooltip-panel .modern-form .select2-container--default .select2-selection--single .select2-selection__rendered,
        .filter-tooltip-panel .select2-container .select2-selection--single .select2-selection__rendered,
        .filter-tooltip-panel .select2-container--default .select2-selection--single .select2-selection__rendered {
