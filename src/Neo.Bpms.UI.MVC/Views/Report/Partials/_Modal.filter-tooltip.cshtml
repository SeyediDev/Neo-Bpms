        .filter-tooltip-panel.filter-tooltip-panel .modern-form .select2-container--default .select2-selection--single,
        .filter-tooltip-panel .modern-form .select2-container .select2-selection--single,
        .filter-tooltip-panel .modern-form .select2-container--default .select2-selection--single,
