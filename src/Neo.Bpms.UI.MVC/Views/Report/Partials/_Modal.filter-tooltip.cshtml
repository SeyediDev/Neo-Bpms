    </style>

    @* JavaScript functions are now in Report.js *@
    
    <script>
    // Prevent Select2 initialization in filter panel - MUST be defined first
    window.preventSelect2InFilterPanel = function() {
        const panel = document.getElementById('filterTooltipPanel');
        if (!panel) return;
        
        // Destroy any existing Select2 instances in the panel
        try {
            if (typeof $ !== 'undefined' && $.fn.select2) {
                $(panel).find('select').each(function() {
                    if ($(this).data('select2')) {
                        $(this).select2('destroy');
                    }
                });
            }
        } catch (e) {
            // Ignore errors if Select2 is not available
        }
        
        // Hide any Select2 containers that might exist
        const select2Containers = panel.querySelectorAll('.select2-container');
        select2Containers.forEach(function(container) {
            container.style.setProperty('display', 'none', 'important');
        });
        
        // Show native selects that Select2 might have hidden
        const hiddenSelects = panel.querySelectorAll('select.select2-hidden-accessible');
        hiddenSelects.forEach(function(select) {
            select.style.setProperty('display', 'block', 'important');
            select.classList.remove('select2-hidden-accessible');
        });
        
        // Prevent future Select2 initialization by intercepting jQuery select2 calls
        if (typeof $ !== 'undefined' && $.fn.select2) {
            const originalSelect2 = $.fn.select2;
            $.fn.select2 = function(options) {
                // Check if this select is inside the filter panel
                const $this = $(this);
                const isInFilterPanel = $this.closest('#filterTooltipPanel').length > 0;
                
                if (isInFilterPanel) {
                    // Don't initialize Select2 in filter panel
                    return $this;
                }
                
                // Otherwise, use original Select2
                return originalSelect2.apply(this, arguments);
            };
        }
    };
    
    // Popular Filters Auto Hide Toggle Function
    window.togglePopularFiltersAutoHide = function() {
        const dockContainer = document.querySelector('.popular-filters-dock-container');
        const filterPanel = document.getElementById('filterTooltipPanel');
        const toggleBtn = document.getElementById('popular-filters-pin-btn');
        
        if (!dockContainer) {
            console.warn('[PopularFilters] Dock container not found!');
            return;
        }
        
        const isAutoHide = dockContainer.classList.contains('auto-hide');
        
        if (isAutoHide) {
            // Show panel
            dockContainer.classList.remove('auto-hide');
            if (filterPanel) {
                filterPanel.classList.remove('popular-filters-hidden');
            }
            if (toggleBtn) {
                toggleBtn.setAttribute('title', 'مخفی کردن فیلترهای پرکاربرد');
                const icon = toggleBtn.querySelector('i');
                if (icon) {
                    icon.className = 'fa fa-eye-slash';
                }
            }
            if (typeof Storage !== 'undefined') {
                localStorage.setItem('popularFiltersAutoHide', 'false');
            }
        } else {
            // Hide panel
            dockContainer.classList.add('auto-hide');
            if (filterPanel) {
                filterPanel.classList.add('popular-filters-hidden');
            }
            if (toggleBtn) {
                toggleBtn.setAttribute('title', 'نمایش فیلترهای پرکاربرد');
                const icon = toggleBtn.querySelector('i');
                if (icon) {
                    icon.className = 'fa fa-eye';
                }
            }
            if (typeof Storage !== 'undefined') {
                localStorage.setItem('popularFiltersAutoHide', 'true');
            }
        }
        
        void dockContainer.offsetHeight;
    };
    
    // Initialize Popular Filters Auto Hide state from localStorage
    window.initializePopularFiltersAutoHide = function() {
        const dockContainer = document.querySelector('.popular-filters-dock-container');
        const filterPanel = document.getElementById('filterTooltipPanel');
        const toggleBtn = document.getElementById('popular-filters-pin-btn');
        
        if (!dockContainer) {
            setTimeout(function() {
                window.initializePopularFiltersAutoHide();
            }, 100);
            return;
        }
        
        // Check localStorage for saved state - Default to hidden (true)
        if (typeof Storage !== 'undefined') {
            const savedState = localStorage.getItem('popularFiltersAutoHide');
            const shouldHide = savedState === null ? true : savedState === 'true';
            
            if (shouldHide) {
                dockContainer.classList.add('auto-hide');
                if (filterPanel) {
                    filterPanel.classList.add('popular-filters-hidden');
                }
                if (toggleBtn) {
                    toggleBtn.setAttribute('title', 'نمایش فیلترهای پرکاربرد');
                    const icon = toggleBtn.querySelector('i');
                    if (icon) {
                        icon.className = 'fa fa-eye';
                    }
                }
            } else {
                dockContainer.classList.remove('auto-hide');
                if (filterPanel) {
                    filterPanel.classList.remove('popular-filters-hidden');
                }
                if (toggleBtn) {
                    toggleBtn.setAttribute('title', 'مخفی کردن فیلترهای پرکاربرد');
                    const icon = toggleBtn.querySelector('i');
                    if (icon) {
                        icon.className = 'fa fa-eye-slash';
                    }
                }
            }
        } else {
            // Default to hidden if localStorage not available
            dockContainer.classList.add('auto-hide');
            if (filterPanel) {
                filterPanel.classList.add('popular-filters-hidden');
            }
            if (toggleBtn) {
                toggleBtn.setAttribute('title', 'نمایش فیلترهای پرکاربرد');
                const icon = toggleBtn.querySelector('i');
                if (icon) {
                    icon.className = 'fa fa-eye';
                }
            }
        }
        
        void dockContainer.offsetHeight;
    };
    
    // Initialize on document ready
    $(document).ready(function() {
        // Initialize auto-hide state
        if (typeof window.initializePopularFiltersAutoHide === 'function') {
            window.initializePopularFiltersAutoHide();
        }
        
        // Also watch for panel visibility changes
        const panel = document.getElementById('filterTooltipPanel');
        if (panel) {
            const observer = new MutationObserver(function(mutations) {
                mutations.forEach(function(mutation) {
                    if (mutation.type === 'attributes' && mutation.attributeName === 'class') {
                        if (panel.classList.contains('show')) {
                            // Panel is now visible, initialize auto-hide state
                            setTimeout(function() {
                                if (typeof window.initializePopularFiltersAutoHide === 'function') {
                                    window.initializePopularFiltersAutoHide();
                                }
                                // Update auto-hide tab visibility
                                window.updatePopularFiltersAutoHideTabVisibility();
                            }, 100);
                        } else {
                            // Panel is hidden, hide auto-hide tab
                            window.updatePopularFiltersAutoHideTabVisibility();
                        }
                    }
                });
            });
            
            observer.observe(panel, {
                attributes: true,
                attributeFilter: ['class']
            });
        }
    });
    
    // Update Auto Hide Tab Visibility
    window.updatePopularFiltersAutoHideTabVisibility = function() {
        const panel = document.getElementById('filterTooltipPanel');
        const dockContainer = document.querySelector('.popular-filters-dock-container');
        const autoHideTab = document.getElementById('popular-filters-auto-hide-tab');
        
        if (!panel || !dockContainer) return;
        
        const isPanelVisible = panel.classList.contains('show');
        const isAutoHide = dockContainer.classList.contains('auto-hide');
        
        // Show tab only if panel is visible AND popular filters is auto-hidden
        if (isPanelVisible && isAutoHide && autoHideTab) {
            autoHideTab.style.setProperty('opacity', '1', 'important');
            autoHideTab.style.setProperty('visibility', 'visible', 'important');
            autoHideTab.style.setProperty('pointer-events', 'auto', 'important');
        } else if (autoHideTab) {
            autoHideTab.style.setProperty('opacity', '0', 'important');
            autoHideTab.style.setProperty('visibility', 'hidden', 'important');
            autoHideTab.style.setProperty('pointer-events', 'none', 'important');
        }
    };
    
    // Update tab visibility when toggle is called
    const originalToggle = window.togglePopularFiltersAutoHide;
    window.togglePopularFiltersAutoHide = function() {
        originalToggle();
        setTimeout(function() {
            window.updatePopularFiltersAutoHideTabVisibility();
        }, 50);
    };
    
    // Combo box size enforcement - Comprehensive and aggressive
    // Override controls-modern.css (60px -> 38px) for ALL selects
    window.enforceComboBoxSizes = function() {
        const panel = document.getElementById('filterTooltipPanel');
        if (!panel || !panel.classList.contains('show')) return;
        
        // Ensure Select2 is disabled first
        window.preventSelect2InFilterPanel();
        
        // Find ALL select elements (comprehensive selectors)
        const allSelectors = [
            'select:not([multiple]):not([size])',
            '.neo-control select:not([multiple])',
            '.modern-form select:not([multiple])',
            '.modern-form .neo-control select:not([multiple])',
            'select.form-control:not([multiple])',
            'select.cBox:not([multiple])',
            '.form-control:not([multiple])',
            '.cBox:not([multiple])',
            '.modern-filter-wrapper select',
            '.modern-filter-content select'
        ];
        
        const selects = new Set();
        allSelectors.forEach(function(selector) {
            const found = panel.querySelectorAll(selector);
            found.forEach(function(sel) {
                selects.add(sel);
            });
        });
        
        // Fix all native SELECT elements
        selects.forEach(function(select) {
            // Remove Select2 classes if present
            if (select.classList.contains('select2-hidden-accessible')) {
                select.style.setProperty('display', 'block', 'important');
                select.style.setProperty('visibility', 'visible', 'important');
                select.classList.remove('select2-hidden-accessible');
            }
            
            // Force 38px height regardless of current height
            select.style.setProperty('min-height', '38px', 'important');
            select.style.setProperty('height', '38px', 'important');
            select.style.setProperty('max-height', '38px', 'important');
            select.style.setProperty('padding', '8px 12px', 'important');
            select.style.setProperty('line-height', '1.5', 'important');
            select.style.setProperty('box-sizing', 'border-box', 'important');
            select.style.setProperty('vertical-align', 'middle', 'important');
            
            // Also fix parent containers if they exist
            const parent = select.parentElement;
            if (parent && (parent.classList.contains('neo-control') || parent.classList.contains('modern-form'))) {
                parent.style.setProperty('min-height', 'auto', 'important');
                parent.style.setProperty('height', 'auto', 'important');
            }
        });
        
        // Fix Modern Multi-Select (the only enhanced select we use)
        const modernMultiSelects = panel.querySelectorAll('.modern-multi-select-control, .modern-multi-select-input');
        modernMultiSelects.forEach(function(mms) {
            mms.style.setProperty('min-height', '38px', 'important');
            mms.style.setProperty('height', '38px', 'important');
            mms.style.setProperty('max-height', '38px', 'important');
            mms.style.setProperty('padding', '8px 12px', 'important');
            mms.style.setProperty('box-sizing', 'border-box', 'important');
        });
    }
    
        // Initialize when document is ready
        $(document).ready(function() {
            const panel = document.getElementById('filterTooltipPanel');
            if (!panel) return;
            
            // Prevent Select2 initialization immediately
            window.preventSelect2InFilterPanel();
            
            let enforcementTimeout = null;
            let lastEnforcement = 0;
            
            // Throttled enforcement function (max once per 150ms)
            function throttledEnforcement() {
                const now = Date.now();
                if (now - lastEnforcement < 150) return;
                lastEnforcement = now;
                
                if (enforcementTimeout) {
                    clearTimeout(enforcementTimeout);
                }
                
                enforcementTimeout = setTimeout(function() {
                    if (panel.classList.contains('show')) {
                        window.preventSelect2InFilterPanel();
                        if (window.enforceComboBoxSizes) {
                            window.enforceComboBoxSizes();
                        }
                        // Run again after a short delay to catch any late-loading elements
                        setTimeout(function() {
                            if (panel.classList.contains('show') && window.enforceComboBoxSizes) {
                                window.enforceComboBoxSizes();
                            }
                        }, 200);
                    }
                }, 50);
            }
            
            // Watch for panel visibility and DOM changes
            const observer = new MutationObserver(function(mutations) {
                if (!panel.classList.contains('show')) return;
                
                let shouldEnforce = false;
                mutations.forEach(function(mutation) {
                    if (mutation.addedNodes.length > 0 || mutation.type === 'attributes') {
                        shouldEnforce = true;
                    }
                });
                
                if (shouldEnforce) {
                    throttledEnforcement();
                }
            });
            
            observer.observe(panel, {
                attributes: true,
                attributeFilter: ['class'],
                childList: true,
                subtree: true
            });
        });
    </script>
