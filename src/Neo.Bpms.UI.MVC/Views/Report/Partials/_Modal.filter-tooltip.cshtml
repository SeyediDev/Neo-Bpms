    <script>
    // Popular Filters Auto Hide Toggle Function
    window.togglePopularFiltersAutoHide = function() {
        console.log('[PopularFilters] togglePopularFiltersAutoHide called');
        const dockContainer = document.querySelector('.popular-filters-dock-container');
        const filterPanel = document.getElementById('filterTooltipPanel');
        const toggleBtn = document.getElementById('popular-filters-pin-btn');
        
        if (!dockContainer) {
            console.error('[PopularFilters] Dock container not found!');
            return;
        }
        
        const isAutoHide = dockContainer.classList.contains('auto-hide');
        console.log('[PopularFilters] Current state:', { isAutoHide });
        
        if (isAutoHide) {
            // Show panel
            console.log('[PopularFilters] Showing panel...');
            dockContainer.classList.remove('auto-hide');
            if (filterPanel) {
                filterPanel.classList.remove('popular-filters-hidden');
            }
            if (toggleBtn) {
                toggleBtn.setAttribute('title', 'مخفی کردن فیلترهای پرکاربرد');
                // Change icon to eye-slash
                const icon = toggleBtn.querySelector('i');
                if (icon) {
                    icon.className = 'fa fa-eye-slash';
                }
            }
            // Save state to localStorage
            if (typeof Storage !== 'undefined') {
                localStorage.setItem('popularFiltersAutoHide', 'false');
            }
        } else {
            // Hide panel
            console.log('[PopularFilters] Hiding panel...');
            dockContainer.classList.add('auto-hide');
            if (filterPanel) {
                filterPanel.classList.add('popular-filters-hidden');
            }
            if (toggleBtn) {
                toggleBtn.setAttribute('title', 'نمایش فیلترهای پرکاربرد');
                // Change icon to eye
                const icon = toggleBtn.querySelector('i');
                if (icon) {
                    icon.className = 'fa fa-eye';
                }
            }
            // Save state to localStorage
            if (typeof Storage !== 'undefined') {
                localStorage.setItem('popularFiltersAutoHide', 'true');
            }
        }
        
        // Force reflow
        void dockContainer.offsetHeight;
        console.log('[PopularFilters] State changed. New classes:', dockContainer.className);
    };
    
    // Initialize Popular Filters Auto Hide state from localStorage
    window.initializePopularFiltersAutoHide = function() {
        console.log('[PopularFilters] initializePopularFiltersAutoHide called');
        const dockContainer = document.querySelector('.popular-filters-dock-container');
        const filterPanel = document.getElementById('filterTooltipPanel');
        const toggleBtn = document.getElementById('popular-filters-pin-btn');
        
        if (!dockContainer) {
            console.warn('[PopularFilters] Dock container not found, will retry...');
            // Retry after a short delay
            setTimeout(function() {
                window.initializePopularFiltersAutoHide();
            }, 100);
            return;
        }
        
        console.log('[PopularFilters] Dock container found');
        
        // Check localStorage for saved state - Default to hidden (true)
        if (typeof Storage !== 'undefined') {
            const savedState = localStorage.getItem('popularFiltersAutoHide');
            console.log('[PopularFilters] Saved state from localStorage:', savedState);
            // Default to 'true' (hidden) if no saved state exists
            const shouldHide = savedState === null ? true : savedState === 'true';
            
            if (shouldHide) {
                dockContainer.classList.add('auto-hide');
                if (filterPanel) {
                    filterPanel.classList.add('popular-filters-hidden');
                }
                if (toggleBtn) {
                    toggleBtn.setAttribute('title', 'نمایش فیلترهای پرکاربرد');
                    // Change icon to eye
                    const icon = toggleBtn.querySelector('i');
                    if (icon) {
                        icon.className = 'fa fa-eye';
                    }
                }
                console.log('[PopularFilters] Applied auto-hide state (default: hidden)');
            } else {
                dockContainer.classList.remove('auto-hide');
                if (filterPanel) {
                    filterPanel.classList.remove('popular-filters-hidden');
                }
                if (toggleBtn) {
                    toggleBtn.setAttribute('title', 'مخفی کردن فیلترهای پرکاربرد');
                    // Change icon to eye-slash
                    const icon = toggleBtn.querySelector('i');
                    if (icon) {
                        icon.className = 'fa fa-eye-slash';
                    }
                }
                console.log('[PopularFilters] Removed auto-hide state');
            }
        } else {
            console.warn('[PopularFilters] localStorage not available, defaulting to hidden');
            // Default to hidden if localStorage not available
            dockContainer.classList.add('auto-hide');
            if (filterPanel) {
                filterPanel.classList.add('popular-filters-hidden');
            }
            if (toggleBtn) {
                toggleBtn.setAttribute('title', 'نمایش فیلترهای پرکاربرد');
                // Change icon to eye
                const icon = toggleBtn.querySelector('i');
                if (icon) {
                    icon.className = 'fa fa-eye';
                }
            }
        }
        
        // Force reflow
        void dockContainer.offsetHeight;
    };
    
    // Initialize on document ready
    $(document).ready(function() {
        // Initialize auto-hide state
        if (typeof window.initializePopularFiltersAutoHide === 'function') {
            window.initializePopularFiltersAutoHide();
        }
        
        // Also watch for panel visibility changes
        const panel = document.getElementById('filterTooltipPanel');
        if (panel) {
            const observer = new MutationObserver(function(mutations) {
                mutations.forEach(function(mutation) {
                    if (mutation.type === 'attributes' && mutation.attributeName === 'class') {
                        if (panel.classList.contains('show')) {
                            // Panel is now visible, initialize auto-hide state
                            setTimeout(function() {
                                if (typeof window.initializePopularFiltersAutoHide === 'function') {
                                    window.initializePopularFiltersAutoHide();
                                }
                                // Update auto-hide tab visibility
                                window.updatePopularFiltersAutoHideTabVisibility();
                            }, 100);
                        } else {
                            // Panel is hidden, hide auto-hide tab
                            window.updatePopularFiltersAutoHideTabVisibility();
                        }
                    }
                });
            });
            
            observer.observe(panel, {
                attributes: true,
                attributeFilter: ['class']
            });
        }
    });
    
    // Update Auto Hide Tab Visibility
