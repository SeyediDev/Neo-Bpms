@using System
@using System.Linq
@using Neo.Bpms.Domain.Entities.Cmmn
@using Neo.Bpms.Domain.Entities.Cmmn.UI
@using Neo.Bpms.Domain.Model.Project
@using Neo.Bpms.Domain.Model.UI
@using Neo.Bpms.Domain.Models.Cmmn
@using Neo.Bpms.Domain.Models.Cmmn.UI.Reports
@using Neo.Bpms.Infrastructure.Features.Cmmn.Reports
@model ReportData
@{
	var structure = Model.Structure;
	var modalKey = structure.ConfigId;

	var calendar = ProjectDefinition.Project.DefaultCalendar;
}
<script language="javascript">
	if (!window.top.modalObjects)
		window.top.modalObjects = {};
	window.top.modalObjects["@modalKey"] = {
		NamespaceId: "@structure.NamespaceId",
		EntityId: "@structure.EntityId",
		ReportId: "@structure.Form_ReportId",
		ConfigId: "@structure.ConfigId"
	};
	var formulaAggrId = "@(eAggregationFunctions.AggregationFormula)";
	var inputsCount = @(structure.Levels != null ? structure.Levels.Count : 0);
</script>


<form id="report-settings-form" method="post" asp-action="ApplyProperties">
	<div class="reportSettingsModal modal fade" id="reportSettingsModal-@modalKey" tabindex="-1" role="dialog" aria-labelledby="reportSettingsModal-label">
		<div class="modal-dialog modal-lg" role="document">
			<div class="modal-content">
				<div class="modal-header">
					<h4 class="modal-title" id="reportSettingsModal-label-@modalKey">@ViewTexts.Settings</h4>
					<button type="button" class="close" data-dismiss="modal" data-target="#reportSettingsModal-@modalKey" aria-label="Close">
						<span aria-hidden="true">&times;</span>
					</button>
				</div>
				<div class="modal-body">
					@Html.Hidden("NamespaceId", structure.NamespaceId)
					@Html.Hidden("EntityId", structure.EntityId)
					@Html.Hidden("ReportId", structure.Form_ReportId)
					@Html.Hidden("ConfigId", structure.ConfigId)

					<div class="row">
						@if (structure.ReportViewType == ReportViewType.Chart && structure.ChartType == ChartType.MetricBox)
						{
							<div class="col-md-12">
								<h4>Metric Box</h4>
							</div>
							<div class="col-sm-6">
								<input type="hidden" name="Properties[0].PropertyId" value="@((long) ReportConfigProperty.IconClass)">
								<label for="iconClass">@ViewTexts.Icon:</label>
								<input type="text" class="form-control" id="iconClass" name="Properties[0].Value"
								       value="@structure.GetReportProperty((long) ReportConfigProperty.IconClass)">
							</div>
							<div class="col-sm-12 pt-2">
								<input type="hidden" name="Properties[1].PropertyId" value="@((long) ReportConfigProperty.BackgroundColor)">
								<label for="backgroundColor">@ViewTexts.BackgroundColor:</label>
								<input type="color" id="backgroundColor" name="Properties[1].Value"
								       value="@structure.GetReportProperty((long) ReportConfigProperty.BackgroundColor)">

								<input type="hidden" name="Properties[2].PropertyId" value="@((long) ReportConfigProperty.TextColor)">
								<label for="textColor">@ViewTexts.TextColor:</label>
								<input type="color" id="textColor" name="Properties[2].Value"
								       value="@structure.GetReportProperty((long) ReportConfigProperty.TextColor)">
							</div>
						}
						@if (structure.ReportViewType == ReportViewType.Chart && structure.ChartType == ChartType.Gauge)
						{
							<div class="col-sm-12">
								<h4>Gauge</h4>
							</div>
							<div class="col-md-6">

								<input type="hidden" name="Properties[0].PropertyId" value="@((long) ReportConfigProperty.Unit)">
								<label for="unit">@ViewTexts.Unit:</label>
								<input type="text" class="form-control" id="unit" name="Properties[0].Value"
								       value="@structure.GetReportProperty((long) ReportConfigProperty.Unit)">
							</div>
							<div class="col-sm-6">
								<fieldset>
									<input type="hidden" name="range.MinType" value="Fixed">
									<div class="form-group">
										<label for="usr1">@ViewTexts.ConstantMinValue:</label>
										<input type="number" step="any" step="any" class="form-control" id="usr1" name="range.MinFixedValue" value="@(structure.ValueRange == null ? "" : structure.ValueRange.MinValue)">
									</div>
								</fieldset>
							</div>
							<div class="col-sm-6">
								<fieldset>
									<input type="hidden" name="range.MaxType" value="Fixed">
									<div class="form-group">
										<label for="usr2">@ViewTexts.ConstantMaxValue:</label>
										<input type="number" step="any" class="form-control" id="usr2" name="range.MaxFixedValue" value="@(structure.ValueRange == null ? "" : structure.ValueRange.MaxValue)">
									</div>
								</fieldset>
							</div>
						}
					</div>
					@if (structure.ReportViewType == ReportViewType.Chart && structure.ChartType == ChartType.Gauge)
					{
						<div id="range-levels">
							<i class="fa fa-plus" onclick="addLevelInputs()"></i>

							<h4>@ViewTexts.Levels:</h4>
							@if (structure.Levels != null)
							{
								var levelIndex = 0;
								foreach (var level in structure.Levels)
								{
									<div class="row">
										<div class="col-sm-6">
											<fieldset>
												<input type="hidden" name="levels[@levelIndex].MinType" value="@ValueRange.ValueType.Fixed">
												<div class="form-group">
													<label for="usr01">@ViewTexts.ConstantMinValue:</label>
													<input type="number" step="any" class="form-control" id="usr01" name="levels[@levelIndex].MinFixedValue" value="@structure.Levels[levelIndex].MinValue">
												</div>

											</fieldset>
										</div>
										<div class="col-sm-6">
											<fieldset>
												<input type="hidden" name="levels[@levelIndex].MaxType" value="@ValueRange.ValueType.Fixed">
												<div class="form-group">
													<label for="usr02">@ViewTexts.ConstantMaxValue:</label>
													<input type="number" step="any" class="form-control" id="usr02" name="levels[@levelIndex].MaxFixedValue" value="@structure.Levels[levelIndex].MaxValue">
												</div>
											</fieldset>
										</div>
										<div class="col-md-12">
											<div class="form-group">
												<label for="clr0">@ViewTexts.Color:</label>
												<input type="color" class="form-control" id="clr0" name="levels[@levelIndex].Color" value="@structure.Levels[levelIndex].Color">
											</div>
										</div>
									</div>

									levelIndex++;
								}
							}
						</div>
					}
					@if (structure.ReportViewType == ReportViewType.Chart && structure.ChartType != ChartType.Gauge && structure.ChartType != ChartType.MetricBox)
					{
						var advancedOptionsRaw = structure.GetReportProperty((long)ReportConfigProperty.ChartAdvancedOptions) ?? "";
						var advancedOptions = advancedOptionsRaw.Split(',', StringSplitOptions.RemoveEmptyEntries)
							.Select(o => o.Trim().ToLower())
							.ToList();
						bool HasOption(string key) => advancedOptions.Contains(key);
						<div class="row mt-3">
							<div class="col-sm-12">
								<h4>تنظیمات ظاهر نمودار</h4>
								<input type="hidden" name="Properties[0].PropertyId" value="@((long)ReportConfigProperty.ChartAdvancedOptions)">
								<input type="hidden" id="chartAdvancedOptionsValue-@modalKey" name="Properties[0].Value" value="@advancedOptionsRaw" />
							</div>
							<div class="col-sm-12" id="chartAdvancedOptions-@modalKey" data-target="#chartAdvancedOptionsValue-@modalKey">
								<div class="form-check">
									<input class="form-check-input chart-option" type="checkbox" data-option="stacked" id="chart-option-stacked-@modalKey" @(HasOption("stacked") ? "checked" : "") />
									<label class="form-check-label" for="chart-option-stacked-@modalKey">نمایش ستون‌ها به صورت انباشته</label>
								</div>
								<div class="form-check">
									<input class="form-check-input chart-option" type="checkbox" data-option="percent" id="chart-option-percent-@modalKey" @(HasOption("percent") ? "checked" : "") />
									<label class="form-check-label" for="chart-option-percent-@modalKey">ستون‌های درصدی (۱۰۰٪)</label>
								</div>
								<div class="form-check">
									<input class="form-check-input chart-option" type="checkbox" data-option="smooth" id="chart-option-smooth-@modalKey" @(HasOption("smooth") ? "checked" : "") />
									<label class="form-check-label" for="chart-option-smooth-@modalKey">نرمی خطوط (Spline)</label>
								</div>
								<div class="form-check">
									<input class="form-check-input chart-option" type="checkbox" data-option="line-overlay" id="chart-option-line-@modalKey" @(HasOption("line-overlay") ? "checked" : "") />
									<label class="form-check-label" for="chart-option-line-@modalKey">نمایش آخرین سری به صورت خط</label>
								</div>
								<div class="form-check">
									<input class="form-check-input chart-option" type="checkbox" data-option="markers" id="chart-option-markers-@modalKey" @(HasOption("markers") ? "checked" : "") />
									<label class="form-check-label" for="chart-option-markers-@modalKey">نمایش مارکر نقاط</label>
								</div>
								<div class="form-check">
									<input class="form-check-input chart-option" type="checkbox" data-option="labels" id="chart-option-labels-@modalKey" @(HasOption("labels") ? "checked" : "") />
									<label class="form-check-label" for="chart-option-labels-@modalKey">نمایش مقدار روی نمودار</label>
								</div>
							</div>
						</div>
						<script>
							(function() {
								// Wait for jQuery to be available
								if (typeof jQuery === 'undefined') {
									setTimeout(arguments.callee, 100);
									return;
								}
								var container = jQuery('#chartAdvancedOptions-@modalKey');
								var hiddenInput = jQuery('#chartAdvancedOptionsValue-@modalKey');
								function syncChartOptions() {
									var values = [];
									container.find('.chart-option:checked').each(function() {
										values.push(jQuery(this).data('option'));
									});
									hiddenInput.val(values.join(','));
								}
								container.on('change', '.chart-option', syncChartOptions);
								syncChartOptions();
							})();
						</script>
					}
					
					@* Design Settings Section - Quick Links to Other Settings *@
					@if (structure.ReportViewType == ReportViewType.Chart || structure.ReportViewType == ReportViewType.GroupByList || structure.ReportViewType == ReportViewType.List)
					{
						<div class="row mt-4">
							<div class="col-sm-12">
								<h4>تنظیمات اضافی</h4>
								<div class="list-group">
									<a href="#" class="list-group-item list-group-item-action" data-toggle="modal" data-target="#columnsSettingsModal-@modalKey">
										<div class="d-flex w-100 justify-content-between">
											<h6 class="mb-1">تنظیمات ستون‌ها</h6>
											<small>مدیریت نمایش ستون‌ها</small>
										</div>
									</a>
									<a href="#" class="list-group-item list-group-item-action" data-toggle="modal" data-target="#ordersSettingsModal-@modalKey">
										<div class="d-flex w-100 justify-content-between">
											<h6 class="mb-1">تنظیمات ترتیب</h6>
											<small>مدیریت مرتب‌سازی داده‌ها</small>
										</div>
									</a>
									@if (structure.ReportViewType.In(ReportViewType.List, ReportViewType.GroupByList))
									{
										<a href="#" class="list-group-item list-group-item-action" data-toggle="modal" data-target="#colorsSettingsModal-@modalKey">
											<div class="d-flex w-100 justify-content-between">
												<h6 class="mb-1">تنظیمات رنگ</h6>
												<small>مدیریت رنگ‌بندی سطرهای گزارش</small>
											</div>
										</a>
									}
								</div>
							</div>
						</div>
					}
				</div>
				<div class="modal-footer">
					<div class="float-right">
						<a class="btn btn-secondary" data-dismiss="modal" data-target="#reportSettingsModal-@modalKey">@ViewTexts.Cancel</a>
						<button type="submit" class="btn btn-primary">@ViewTexts.Apply</button>
					</div>
				</div>
			</div>
		</div>
	</div>
</form>

@if (Model.Rows.Count != 0)
{
	var row = Model.Rows[0];
	if (row.SubReports != null)
	{
		foreach (var subReport in row.SubReports)
		{
			@Html.Partial("~/Views/Report/Partials/_Modal.settings.cshtml", subReport)
		}
	}
}


@* Report Settings Form Handler is now in _Scripts.report-settings.cshtml *@