@using Microsoft.AspNetCore.Html
@using Neo.Bpms.Domain.Entities.Cmmn
@using Neo.Bpms.Domain.Entities.Cmmn.UI
@using Neo.Bpms.Domain.Model.Project
@using Neo.Bpms.Domain.Model.UI
@using Neo.Bpms.Domain.Models.Cmmn
@using Neo.Bpms.Domain.Models.Cmmn.UI.Reports
@using Neo.Bpms.Infrastructure.Features.Cmmn.Reports
@using Neo.Bpms.UI.MVC.Controls
@using Neo.Bpms.UI.MVC.PartialModels
@using Neo.Bpms.UI.MVC.PartialModels.Report
@model ReportData
@{
	var calendar = ProjectDefinition.Project.DefaultCalendar;
	var reportInfo = Model;
	var canDesign = ViewBag.CanDesign ?? false;
	var isDrillDown = ViewBag.DrillDown ?? false;
	var reportKey = reportInfo.Structure.ConfigId;
	var bFromDashboard = ViewBag.bFromDashboard ?? false;
	var drilldownSubReports = reportInfo.Structure.SubReports.Where(sr => sr.Type == Report.SubReportType.DrillDown).ToList();
}

@* Design Tools *@
@if (canDesign && !bFromDashboard && !isDrillDown && Model.Config.IsSubReport)
{
	<partial name="~/Views/Report/Helpers/RenderDesignTools.cshtml" model="new RenderDesignToolsModel {report = Model, forInlineSubReport = true}"/>
}

@* Load JVector Map Scripts *@
<link rel="stylesheet" href="~/Content/common-assets-includes/common-plugins/global/jvector-map/jquery-jvectormap-2.0.5.css"/>
<script src="~/Scripts/common-assets-includes/common-plugins/global/jvector-map/jquery-jvectormap-2.0.5.min.js"></script>
@if (Model.Structure.ChartType == ChartType.WorldMap)
{
	<script src="~/Scripts/common-assets-includes/common-plugins/global/jvector-map/jquery-jvectormap-world-mill.js"></script>
}
else if (Model.Structure.ChartType == ChartType.IranMap)
{
	<script src="~/Scripts/common-assets-includes/common-plugins/global/jvector-map/jquery-jvectormap-iran-mill.js"></script>
}

<partial name="~/Views/Report/Helpers/WindowTopJs.cshtml" model="new WindowTopJsModel {drillDownSubReports = drilldownSubReports, reportKey = reportKey, reportInfo = reportInfo, filterValues = ViewBag.FilterValues as ElasticObject}"/>

@* Map Styles *@
<partial name="~/Views/Report/Helpers/_MapStyles.cshtml" model="Model"/>

@* Map HTML Structure *@
<partial name="~/Views/Report/Helpers/_MapHtml.cshtml" model="Model"/>

@* Map JavaScript *@
<script>
	var isWorldMap = @((Model.Structure.ChartType == ChartType.WorldMap).ToString().ToLower());
	var mapData = {};
	var mapInfo = {};

	@{
		var colorColumn = reportInfo.Structure.SelectedColumns.FirstOrDefault(s => s.aggrType != eAggregationFunctions.GroupByItem && s.aggrType != eAggregationFunctions.InColumn);
		var iso2Column = reportInfo.Structure.SelectedColumns.FirstOrDefault(s => s.aggrType != eAggregationFunctions.GroupByItem && s.aggrType == eAggregationFunctions.InColumn && s.ColumnName == "Iso2")
			?? reportInfo.Structure.SelectedColumns.FirstOrDefault(s => s.aggrType != eAggregationFunctions.GroupByItem && s.aggrType == eAggregationFunctions.InColumn && s.Alias == "Iso2");
		var subReportsCount = reportInfo.Structure.SubReports.Count(sr => sr.Type == Report.SubReportType.DrillDown);
	}

	var subReportsCount = @subReportsCount;
	var reportKey = "@reportKey";

	@* Process map data from server - with special handling for IranMap *@
	<partial name="~/Views/Report/Helpers/_MapDataProcessing.cshtml" model="Model"/>

	@* Initialize map markers based on map type *@
	<partial name="~/Views/Report/Helpers/_MapMarkers.cshtml" model="Model"/>

	var mapMarkers = [];
	var tableData = [];
	var filteredTableData = [];
	var selectedRegionCode = null;
	var currentSortColumn = null;
	var currentSortDirection = 'asc';

	// Prepare markers
	for (var i = 0; i < iso2sWhichShouldBeMarkers.length; i++) {
		var t = iso2sWhichShouldBeMarkers[i];
		mapMarkers[i] = {
			code: t.iso2,
			latLng: t.latLng,
			name: t.name,
			markerType: t.markerType
		};
	}

	// Prepare table columns
	@{
		var tableColumns = reportInfo.Structure.SelectedColumns.Where(s =>
			s.aggrType != eAggregationFunctions.GroupByItem &&
			s.ColumnName != "Iso2" &&
			s.Alias != "Iso2").ToList();
	}
	var tableColumns = [
		@foreach (var col in tableColumns)
		{
			<text>{ name: '@col.Alias', columnName: '@col.ColumnTypeName' },</text>
		}
	];

	// Build table data
	for (var code in mapInfo) {
		if (mapInfo.hasOwnProperty(code)) {
			var info = mapInfo[code];
			var row = { code: code, name: code, data: {} };
			if (info.tooltipValues) {
				var nameFound = false;
				for (var field in info.tooltipValues) {
					if (info.tooltipValues.hasOwnProperty(field)) {
						var cleanValue = info.tooltipValues[field].replace(/<[^>]*>/g, '').trim();
						row.data[field] = info.tooltipValues[field];
						if (!nameFound && (field.toLowerCase().indexOf('name') >= 0 || 
							field.toLowerCase().indexOf('title') >= 0 ||
							field.toLowerCase().indexOf('province') >= 0 ||
							field.indexOf('استان') >= 0 ||
							field.indexOf('منطقه') >= 0) && cleanValue) {
							row.name = cleanValue;
							nameFound = true;
						}
					}
				}
				if (!nameFound) {
					for (var field in info.tooltipValues) {
						if (info.tooltipValues.hasOwnProperty(field)) {
							var cleanValue = info.tooltipValues[field].replace(/<[^>]*>/g, '').trim();
							if (cleanValue) {
								row.name = cleanValue;
								break;
							}
						}
					}
				}
			}
			tableData.push(row);
		}
	}

	// Table functions
	function filterTableData(searchText) {
		if (!searchText || searchText.trim() === '') {
			filteredTableData = tableData.slice();
		} else {
			searchText = searchText.toLowerCase();
			filteredTableData = tableData.filter(function(row) {
				if (row.name.toLowerCase().indexOf(searchText) >= 0) return true;
				if (row.code.toLowerCase().indexOf(searchText) >= 0) return true;
				for (var field in row.data) {
					if (row.data.hasOwnProperty(field)) {
						var value = row.data[field].replace(/<[^>]*>/g, '').toLowerCase();
						if (value.indexOf(searchText) >= 0) return true;
					}
				}
				return false;
			});
		}
		updateTableDisplay();
	}

	function sortTableData(columnIndex, direction) {
		var colName = tableColumns[columnIndex].name;
		filteredTableData.sort(function(a, b) {
			var aVal = (a.data[colName] || '').replace(/<[^>]*>/g, '').toLowerCase();
			var bVal = (b.data[colName] || '').replace(/<[^>]*>/g, '').toLowerCase();
			var aNum = parseFloat(aVal);
			var bNum = parseFloat(bVal);
			if (!isNaN(aNum) && !isNaN(bNum)) {
				return direction === 'asc' ? aNum - bNum : bNum - aNum;
			}
			return direction === 'asc' ? aVal.localeCompare(bVal) : bVal.localeCompare(aVal);
		});
		updateTableDisplay();
	}

	function updateTableDisplay() {
		var tbody = $('#map-table-body');
		var stats = $('#map-table-stats');
		tbody.empty();
		
		if (filteredTableData.length === 0) {
			tbody.append('<tr><td colspan="' + tableColumns.length + '" style="text-align: center; padding: 20px; color: #6c757d;">هیچ داده‌ای یافت نشد</td></tr>');
			stats.text('0 مورد از ' + tableData.length);
			return;
		}
		
		var selectedRowIndex = -1;
		for (var i = 0; i < filteredTableData.length; i++) {
			var row = filteredTableData[i];
			var tr = $('<tr>').attr('data-code', row.code).attr('data-name', row.name);
			if (selectedRegionCode === row.code) {
				tr.addClass('selected');
				selectedRowIndex = i;
			}
			for (var j = 0; j < tableColumns.length; j++) {
				var colName = tableColumns[j].name;
				var value = row.data[colName] || '-';
				tr.append('<td>' + value + '</td>');
			}
			tbody.append(tr);
		}
		
		if (selectedRowIndex >= 0) {
			setTimeout(function() {
				var selectedRow = tbody.find('tr.selected').first();
				if (selectedRow.length > 0) {
					var tableContainer = $('#map-data-table');
					var rowPosition = selectedRow.position().top;
					var containerScrollTop = tableContainer.scrollTop();
					var containerHeight = tableContainer.height();
					var rowHeight = selectedRow.outerHeight();
					var rowTop = rowPosition + containerScrollTop;
					var rowBottom = rowTop + rowHeight;
					var containerTop = containerScrollTop;
					var containerBottom = containerTop + containerHeight;
					if (rowTop < containerTop || rowBottom > containerBottom) {
						var targetScroll = rowPosition + containerScrollTop - (containerHeight / 2) + (rowHeight / 2);
						tableContainer.scrollTop(Math.max(0, targetScroll));
					}
				}
			}, 100);
		}
		
		tbody.find('tr').on('click', function(e) {
			var code = $(this).attr('data-code');
			if (code && e.detail === 1) {
				selectRegion(code);
			}
		});
		
		tbody.find('tr').on('dblclick', function() {
			var code = $(this).attr('data-code');
			var name = $(this).attr('data-name');
			if (code && subReportsCount > 0) {
				showMapDrillDown(code, name);
			}
		});
		
		stats.text(filteredTableData.length + ' مورد از ' + tableData.length);
	}

	function renderTable() {
		var headerRow = $('#map-table-header');
		headerRow.empty();
		if (tableData.length === 0) {
			headerRow.append('<th>هیچ داده‌ای یافت نشد</th>');
			return;
		}
		for (var i = 0; i < tableColumns.length; i++) {
			var colIndex = i;
			var colHeader = $('<th>').addClass('sortable').text(tableColumns[i].name);
			colHeader.on('click', function(idx) {
				return function() {
					if (currentSortColumn === idx) {
						currentSortDirection = currentSortDirection === 'asc' ? 'desc' : 'asc';
					} else {
						currentSortColumn = idx;
						currentSortDirection = 'asc';
					}
					updateSortHeaders();
					sortTableData(currentSortColumn, currentSortDirection);
				};
			}(colIndex));
			headerRow.append(colHeader);
		}
		filteredTableData = tableData.slice();
		if (tableColumns.length > 0) {
			currentSortColumn = 0;
			currentSortDirection = 'asc';
			updateSortHeaders();
			sortTableData(0, 'asc');
		} else {
			updateTableDisplay();
		}
		$('#map-table-search-input').on('input', function() {
			filterTableData($(this).val());
		});
	}

	function updateSortHeaders() {
		$('#map-table-header th').removeClass('asc desc');
		if (currentSortColumn !== null) {
			var header = $('#map-table-header th').eq(currentSortColumn);
			header.addClass(currentSortDirection);
		}
	}
	
	function toggleRightPanel() {
		var panel = $('#map-right-panel');
		var btn = $('#map-toggle-panel-btn');
		var icon = $('#map-toggle-panel-icon');
		var isIranMap = @((Model.Structure.ChartType == ChartType.IranMap).ToString().ToLower());
		var tableName = isIranMap ? 'استان‌ها' : 'کشورها';
		if (panel.hasClass('active')) {
			panel.removeClass('active');
			icon.text('▶');
			btn.attr('title', 'نمایش جدول ' + tableName);
		} else {
			panel.addClass('active');
			icon.text('◀');
			btn.attr('title', 'مخفی کردن جدول ' + tableName);
		}
	}
	
	@if (Model.Structure.ChartType == ChartType.IranMap || Model.Structure.ChartType == ChartType.WorldMap)
	{
		<text>
		$('#map-toggle-panel-btn').on('click', function() {
			toggleRightPanel();
		});
		</text>
	}

	function showRegionInfo(code) {
		if (!mapInfo[code]) {
			$('#map-info-panel-top').removeClass('active');
			return;
		}
		var info = mapInfo[code];
		var content = $('#map-info-content-top');
		content.empty();
		if (info.tooltipValues) {
			for (var field in info.tooltipValues) {
				if (info.tooltipValues.hasOwnProperty(field)) {
					var item = $('<div>').addClass('info-item');
					var label = $('<span>').addClass('info-label').text(field + ':');
					var value = $('<span>').addClass('info-value').html(info.tooltipValues[field]);
					item.append(label).append(value);
					content.append(item);
				}
			}
		}
		$('#map-info-panel-top').addClass('active');
	}

	function selectRegion(code) {
		if (!code) return;
		selectedRegionCode = code;
		$('#map-table-body tr').removeClass('selected');
		var selectedRow = $('#map-table-body tr[data-code="' + code + '"]');
		if (selectedRow.length > 0) {
			selectedRow.addClass('selected');
			setTimeout(function() {
				var tableContainer = $('#map-data-table');
				var rowPosition = selectedRow.position().top;
				var containerScrollTop = tableContainer.scrollTop();
				var containerHeight = tableContainer.height();
				var rowHeight = selectedRow.outerHeight();
				var rowTop = rowPosition + containerScrollTop;
				var rowBottom = rowTop + rowHeight;
				var containerTop = containerScrollTop;
				var containerBottom = containerTop + containerHeight;
				if (rowTop < containerTop || rowBottom > containerBottom) {
					var targetScroll = rowPosition + containerScrollTop - (containerHeight / 2) + (rowHeight / 2);
					tableContainer.animate({ scrollTop: Math.max(0, targetScroll) }, 300);
				}
			}, 50);
		}
		showRegionInfo(code);
		var mapInstance = $('#world-map .jvectormap-container').data('mapObject');
		if (mapInstance && mapInstance.regions && mapInstance.regions[code]) {
			try {
				for (var regCode in mapInstance.regions) {
					if (mapInstance.regions.hasOwnProperty(regCode) && 
						mapInstance.regions[regCode].element && 
						typeof mapInstance.regions[regCode].element.setSelected === 'function') {
						mapInstance.regions[regCode].element.setSelected(false);
					}
				}
				if (mapInstance.regions[code].element && 
					typeof mapInstance.regions[code].element.setSelected === 'function') {
					mapInstance.regions[code].element.setSelected(true);
				}
			} catch (e) {
				console.log('Could not highlight region:', e);
			}
		}
	}

	var showTip = function(event, label, code) {
		var countryName = $(label).text();
		if (!code) code = countryName;
		$(label).empty();
		$(label).css('min-width', '200px');
		if (isWorldMap) {
			$(label).append($("<img/>", {
				'src': window.top.rootUrl + 'Content/common-assets-includes/flags/' + countryNamesBasedOnIso2[code] + '.svg',
				'style': 'display: inline; height: 36px; height: 36px; margin-left: 4px; margin-top:-7px; margin-bottom:-6px;'
			}));
		}
		$(label).append($("<span/>", {
			'html': countryName,
			'style': ' font-size: 1.5em; margin-top:3px; float: ' + (isWorldMap ? 'left' : 'right') + '; color: #FFFADC'
		}));
		if (!!mapInfo[code]) {
			var tooltipsObj = mapInfo[code]["tooltipValues"];
			$(label).append($("<hr/>", { 'style': 'margin: 3px 0;' }));
			for (var field in tooltipsObj) {
				if (tooltipsObj.hasOwnProperty(field)) {
					$(label).append($("<span/>", {
						'html': field + ' : ' + '<span style="color: #f7eeb9;">' + tooltipsObj[field] + '</span>',
						'class': 'teta-bidi'
					}));
					$(label).append($("<br/>"));
				}
			}
			@if (Model.Structure.ChartType == ChartType.IranMap || Model.Structure.ChartType == ChartType.WorldMap)
			{
				<text>
				if (subReportsCount > 0) {
					$(label).append($("<hr/>", { 'style': 'margin: 5px 0 3px 0; border-color: rgba(255,255,255,0.3);' }));
					$(label).append($("<span/>", {
						'html': '<span style="color: #f7eeb9; font-size: 0.9em; font-style: italic;">💡 برای مشاهده گزارش زیرمجموعه: دوبار کلیک کنید</span>',
						'class': 'teta-bidi'
					}));
				}
				</text>
			}
		}
	};

	var showMarkerTip = function(event, label, code) {
		showTip(event, label, mapMarkers[code].code);
	}

	function showMapDrillDown(code, regionName) {
		if (!code || !mapInfo[code] || subReportsCount === 0) return;
		$('#map-drilldown-overlay').addClass('active');
		$('#map-drilldown-panel').addClass('active');
		$('body').css('overflow', 'hidden');
		$('#map-drilldown-title').text('گزارش زیرمجموعه: ' + (regionName || code));
		var content = $('#map-drilldown-content');
		content.html('<div style="text-align: center; padding: 40px; color: #6c757d;"><div style="font-size: 48px; margin-bottom: 20px;">⏳</div><div>در حال بارگذاری...</div></div>');
		var mapInstanceData = $('#world-map .jvectormap-container').data('mapObject');
		if (mapInstanceData && typeof openSubReportFrame2 !== 'undefined') {
			var iframeContainer = $('<div>').css({ width: '100%', height: '100%', border: 'none' });
			content.html(iframeContainer);
			try {
				openSubReportFrame2(subReportsCount, mapInfo[code]['ids'], reportKey, window.top.reportInfo['@reportKey']["parentFilter"], iframeContainer[0], null);
			} catch (e) {
				console.error('Error loading drilldown:', e);
				content.html('<div style="text-align: center; padding: 40px; color: #dc3545;"><div style="font-size: 48px; margin-bottom: 20px;">❌</div><div>خطا در بارگذاری گزارش</div><div style="margin-top: 10px; font-size: 12px;">' + e.message + '</div></div>');
			}
		} else {
			var reportUrl = window.top.rootUrl + 'Report/Index?configId=' + reportKey + '&ids=' + mapInfo[code]['ids'] + '&isDrillDown=true';
			content.html('<iframe src="' + reportUrl + '" style="width: 100%; height: 100%; border: none;"></iframe>');
		}
	}

	function closeMapDrillDown() {
		$('#map-drilldown-overlay').removeClass('active');
		$('#map-drilldown-panel').removeClass('active');
		$('body').css('overflow', '');
		$('#map-drilldown-content').html('<div style="text-align: center; padding: 40px; color: #6c757d;"><div style="font-size: 48px; margin-bottom: 20px;">⏳</div><div>در حال بارگذاری...</div></div>');
	}
	window.closeMapDrillDown = closeMapDrillDown;

	var showDrillDown = function(event, code, docObj) {
		if (!code && event && event.target) {
			var mapInstance = $('#world-map .jvectormap-container').data('mapObject');
			if (mapInstance) {
				for (var regCode in mapInstance.regions) {
					if (mapInstance.regions.hasOwnProperty(regCode)) {
						var region = mapInstance.regions[regCode];
						if (region.element && region.element.shape && 
							(region.element.shape.node === event.target || 
							 $(region.element.shape.node).find(event.target).length > 0)) {
							code = regCode;
							break;
						}
					}
				}
			}
		}
		if (code && mapInfo[code]) {
			var regionName = code;
			for (var i = 0; i < tableData.length; i++) {
				if (tableData[i].code === code) {
					regionName = tableData[i].name;
					break;
				}
			}
			showMapDrillDown(code, regionName);
		}
	}

	var showMarkerDrillDown = function(event, code) {
		showDrillDown(event, mapMarkers[code].code, this);
	}

	@* Initialize map with appropriate map type *@
	<partial name="~/Views/Report/Helpers/_MapInitialization.cshtml" model="Model"/>

	// Initialize map responsiveness and zoom scroll handling
	setTimeout(function() {
		var mapContainer = $('#world-map .jvectormap-container');
		var mapWrapper = $('#world-map');
		var mapInstance = mapContainer.data('mapObject');
		
		if (mapInstance) {
			@if (Model.Structure.ChartType == ChartType.IranMap)
			{
				<text>
				// Handle scroll prevention for zoomed Iran map
				// The zoom state is managed in onViewportChange callback
				// Here we just ensure proper scroll behavior
				
				// mapWrapper is the same element as .world-map-container (id="world-map" class="world-map-container")
				var mapContainerElement = mapWrapper[0];
				
				// Prevent body scroll when mouse is over zoomed map
				if (mapContainerElement) {
					mapWrapper.on('mouseenter', function() {
						if (mapWrapper.hasClass('map-zoomed')) {
							$('body').addClass('map-zoom-active');
						}
					});
					
					mapWrapper.on('mouseleave', function() {
						if (!mapWrapper.hasClass('map-zoomed')) {
							$('body').removeClass('map-zoom-active');
						}
					});
					
					// Prevent touch scroll on body when interacting with zoomed map
					mapContainerElement.addEventListener('touchstart', function(e) {
						if (mapWrapper.hasClass('map-zoomed')) {
							$('body').addClass('map-zoom-active');
						}
					}, { passive: true });
					
					mapContainerElement.addEventListener('touchend', function(e) {
						setTimeout(function() {
							if (!mapWrapper.hasClass('map-zoomed')) {
								$('body').removeClass('map-zoom-active');
							}
						}, 100);
					}, { passive: true });
					
					// Prevent wheel event from scrolling body when map is zoomed
					mapContainerElement.addEventListener('wheel', function(e) {
						if (mapWrapper.hasClass('map-zoomed')) {
							// Check if we're at the edge of scrollable area
							var container = this;
							var scrollTop = container.scrollTop;
							var scrollHeight = container.scrollHeight;
							var height = container.clientHeight;
							var scrollLeft = container.scrollLeft;
							var scrollWidth = container.scrollWidth;
							var width = container.clientWidth;
							
							var isScrollingUp = e.deltaY < 0;
							var isScrollingDown = e.deltaY > 0;
							var isScrollingLeft = e.deltaX < 0;
							var isScrollingRight = e.deltaX > 0;
							
							// If at edge and trying to scroll further, prevent body scroll
							if ((scrollTop <= 0 && isScrollingUp) || 
								(scrollTop + height >= scrollHeight && isScrollingDown) ||
								(scrollLeft <= 0 && isScrollingLeft) ||
								(scrollLeft + width >= scrollWidth && isScrollingRight)) {
								// Let jvectormap handle panning, but prevent body scroll
								e.stopPropagation();
							}
						}
					}, { passive: false });
				}
				</text>
			}
			
			if (typeof ResizeObserver !== 'undefined') {
				var resizeObserver = new ResizeObserver(function(entries) {
					if (mapInstance && mapInstance.updateSize) {
						setTimeout(function() { mapInstance.updateSize(); }, 100);
					}
				});
				resizeObserver.observe(mapContainer[0]);
			} else {
				var resizeTimer;
				$(window).on('resize', function() {
					clearTimeout(resizeTimer);
					resizeTimer = setTimeout(function() {
						if (mapInstance && mapInstance.updateSize) {
							mapInstance.updateSize();
						}
					}, 250);
				});
			}
		}
		renderTable();
		@if (Model.Structure.ChartType == ChartType.IranMap || Model.Structure.ChartType == ChartType.WorldMap)
		{
			<text>
			if (tableData.length > 0) {
				$('#map-right-panel').addClass('active');
			}
			</text>
		}
	}, 500);

	@* Click handlers for IranMap and WorldMap *@
	<partial name="~/Views/Report/Helpers/_MapClickHandlers.cshtml" model="Model"/>
</script>

<partial name="~/Views/Report/Helpers/PartialsCommon.cshtml" model="new PartialsCommonModel {reportInfo = Model}"/>
