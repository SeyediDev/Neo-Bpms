<script>
/**
 * PivotTable - یک کامپوننت ساده و سبک برای ساخت Pivot Table سمت کلاینت
 * بدون وابستگی به کتابخانه‌های خارجی
 */
(function() {
    'use strict';
    if (typeof window.PivotTable !== 'undefined') {
        return; // قبلاً تعریف شده
    }
    
    window.PivotTable = class PivotTable {
    constructor(containerId, options = {}) {
        this.container = document.getElementById(containerId);
        if (!this.container) {
            throw new Error('Container with id "' + containerId + '" not found');
        }

        this.options = {
            data: options.data || [],
            rowFields: options.rowFields || [],
            columnFields: options.columnFields || [],
            valueFields: options.valueFields || [],
            aggregator: options.aggregator || 'sum',
            locale: options.locale || 'fa-IR',
            direction: options.direction || 'rtl',
            hasSubReport: options.hasSubReport || false,
            subReportId: options.subReportId || '',
            reportKey: options.reportKey || '',
            showTotal: options.showTotal !== undefined ? options.showTotal : false,
            showTotalRow: options.showTotalRow !== undefined ? options.showTotalRow : false,
            ...options
        };

        this.pivotData = null;
        this.init();
    }

    init() {
        if (this.options.data.length === 0) {
            this.container.innerHTML = '<div class="pivot-empty">داده‌ای برای نمایش موجود نیست</div>';
            return;
        }

        if (this.options.rowFields.length === 0 && this.options.columnFields.length === 0) {
            this.container.innerHTML = '<div class="pivot-empty">لطفاً حداقل یک فیلد سطر یا ستون انتخاب کنید</div>';
            return;
        }

        if (this.options.valueFields.length === 0) {
            this.container.innerHTML = '<div class="pivot-empty">لطفاً حداقل یک فیلد مقدار انتخاب کنید</div>';
            return;
        }

        this.processData();
        this.render();
    }
    processData() {
        const { data, rowFields, columnFields, valueFields } = this.options;

        // colKeysList به صورت object برای ذخیره اطلاعات هر colKey
        this.colKeysList = {};
        this.pivotData = {};

        if (!data || !Array.isArray(data) || data.length === 0) {
            return;
        }

        data.forEach((row, index) => {
            if (!row || typeof row !== 'object') return;
            
            const rowKey = this.buildKey(row, rowFields);
            const colKey = this.buildKey(row, columnFields);
            
            // جمع‌آوری colKeys در colKeysList
            if (colKey) {
                // اگر showTotal فعال است، Total را هم اضافه کن، در غیر این صورت فقط غیر Total
                if (colKey === 'Total') {
                    if (this.options.showTotal) {
                        if (!this.colKeysList[colKey]) {
                            this.colKeysList[colKey] = {};
                            this.colKeysList[colKey].colKey = colKey;
                            this.colKeysList[colKey].label = this.formatKey(colKey);
                            this.colKeysList[colKey].count = 0;
                        }
                        this.colKeysList[colKey].count = this.colKeysList[colKey].count + 1;
                    }
                } else {
                    if (!this.colKeysList[colKey]) {
                        this.colKeysList[colKey] = {};
                        this.colKeysList[colKey].colKey = colKey;
                        this.colKeysList[colKey].label = this.formatKey(colKey); // استفاده از formatKey برای label
                        this.colKeysList[colKey].count = 0;
                    }
                    this.colKeysList[colKey].count = this.colKeysList[colKey].count + 1;
                }
            }

            // ایجاد ساختار pivotData - داده‌ها از سرور aggregate شده می‌آیند
            if (!this.pivotData[rowKey]) {
                this.pivotData[rowKey] = {};
            }
            
            // اگر colKey قبلاً وجود ندارد، ایجاد کن
            if (!this.pivotData[rowKey][colKey]) {
                this.pivotData[rowKey][colKey] = {};
            }

            // مستقیماً مقادیر را از row بگیر (بدون aggregate)
            // داده‌ها از سرور aggregate شده می‌آیند، پس هر row یک مقدار نهایی دارد
            valueFields.forEach(field => {
                const fieldName = typeof field === 'object' && field.name ? field.name : field;
                const value = this.parseValue(row[fieldName]);
                // مستقیماً مقدار را قرار بده (اگر چند ردیف با rowKey و colKey یکسان وجود داشته باشد، آخرین مقدار overwrite می‌شود)
                this.pivotData[rowKey][colKey][fieldName] = value;
            });
        });

        // محاسبه Total برای هر rowKey - اگر showTotal فعال باشد
        if (this.options.showTotal && columnFields.length > 0) {
            // برای هر rowKey، Total را محاسبه کن
            Object.keys(this.pivotData).forEach(rowKey => {
                if (!this.pivotData[rowKey]['Total']) {
                    this.pivotData[rowKey]['Total'] = {};
                }

                // برای هر valueField، مجموع یا میانگین همه colKeyها (به جز Total) را محاسبه کن
                valueFields.forEach(field => {
                    const fieldName = typeof field === 'object' && field.name ? field.name : field;
                    const aggregationType = typeof field === 'object' && field.aggregationType ? field.aggregationType.toString().toLowerCase() : 'sum';
                    const isAverage = aggregationType === 'average' || aggregationType === 'avg' || aggregationType === 'mean';
                    
                    let total = 0;
                    let count = 0;
                    
                    // جمع یا شمارش مقادیر همه colKeyها (به جز Total)
                    Object.keys(this.pivotData[rowKey]).forEach(colKey => {
                        if (colKey !== 'Total' && this.pivotData[rowKey][colKey] && this.pivotData[rowKey][colKey][fieldName] !== null && this.pivotData[rowKey][colKey][fieldName] !== undefined) {
                            const value = this.parseValue(this.pivotData[rowKey][colKey][fieldName]);
                            if (value !== null && !isNaN(value)) {
                                total += value;
                                count++;
                            }
                        }
                    });
                    
                    // اگر میانگین است، تقسیم بر تعداد کن
                    if (isAverage && count > 0) {
                        this.pivotData[rowKey]['Total'][fieldName] = total / count;
                    } else {
                        this.pivotData[rowKey]['Total'][fieldName] = total;
                    }
                });

                // اضافه کردن Total به colKeysList
                if (!this.colKeysList['Total']) {
                    this.colKeysList['Total'] = {};
                    this.colKeysList['Total'].colKey = 'Total';
                    this.colKeysList['Total'].label = this.formatKey('Total');
                    this.colKeysList['Total'].count = 0;
                }
            });
        } else {
            // اگر showTotal غیرفعال است، Total را از colKeysList حذف کن
            if (this.colKeysList['Total']) {
                delete this.colKeysList['Total'];
            }
        }

        // محاسبه Total Row برای هر colKey - اگر showTotalRow فعال باشد
        if (this.options.showTotalRow && rowFields.length > 0) {
            // ایجاد سطر Total در pivotData
            if (!this.pivotData['Total']) {
                this.pivotData['Total'] = {};
            }

            // برای هر colKey (به جز Total)، Total row را محاسبه کن
            Object.keys(this.colKeysList).forEach(colKey => {
                if (colKey !== 'Total') {
                    if (!this.pivotData['Total'][colKey]) {
                        this.pivotData['Total'][colKey] = {};
                    }

                    // برای هر valueField، مجموع یا میانگین همه rowKeyها (به جز Total) را محاسبه کن
                    valueFields.forEach(field => {
                        const fieldName = typeof field === 'object' && field.name ? field.name : field;
                        const aggregationType = typeof field === 'object' && field.aggregationType ? field.aggregationType.toString().toLowerCase() : 'sum';
                        const isAverage = aggregationType === 'average' || aggregationType === 'avg' || aggregationType === 'mean';
                        
                        let total = 0;
                        let count = 0;
                        
                        // جمع یا شمارش مقادیر همه rowKeyها (به جز Total)
                        Object.keys(this.pivotData).forEach(rowKey => {
                            if (rowKey !== 'Total' && this.pivotData[rowKey] && this.pivotData[rowKey][colKey] && this.pivotData[rowKey][colKey][fieldName] !== null && this.pivotData[rowKey][colKey][fieldName] !== undefined) {
                                const value = this.parseValue(this.pivotData[rowKey][colKey][fieldName]);
                                if (value !== null && !isNaN(value)) {
                                    total += value;
                                    count++;
                                }
                            }
                        });
                        
                        // اگر میانگین است، تقسیم بر تعداد کن
                        if (isAverage && count > 0) {
                            this.pivotData['Total'][colKey][fieldName] = total / count;
                        } else {
                            this.pivotData['Total'][colKey][fieldName] = total;
                        }
                    });
                }
            });

            // محاسبه Total برای ستون Total (اگر showTotal هم فعال باشد)
            if (this.options.showTotal && this.colKeysList['Total']) {
                if (!this.pivotData['Total']['Total']) {
                    this.pivotData['Total']['Total'] = {};
                }

                valueFields.forEach(field => {
                    const fieldName = typeof field === 'object' && field.name ? field.name : field;
                    const aggregationType = typeof field === 'object' && field.aggregationType ? field.aggregationType.toString().toLowerCase() : 'sum';
                    const isAverage = aggregationType === 'average' || aggregationType === 'avg' || aggregationType === 'mean';
                    
                    let total = 0;
                    let count = 0;
                    
                    // جمع یا شمارش مقادیر همه rowKeyها و colKeyها (به جز Total)
                    Object.keys(this.pivotData).forEach(rowKey => {
                        if (rowKey !== 'Total') {
                            Object.keys(this.pivotData[rowKey]).forEach(colKey => {
                                if (colKey !== 'Total' && this.pivotData[rowKey][colKey] && this.pivotData[rowKey][colKey][fieldName] !== null && this.pivotData[rowKey][colKey][fieldName] !== undefined) {
                                    const value = this.parseValue(this.pivotData[rowKey][colKey][fieldName]);
                                    if (value !== null && !isNaN(value)) {
                                        total += value;
                                        count++;
                                    }
                                }
                            });
                        }
                    });
                    
                    // اگر میانگین است، تقسیم بر تعداد کن
                    if (isAverage && count > 0) {
                        this.pivotData['Total']['Total'][fieldName] = total / count;
                    } else {
                        this.pivotData['Total']['Total'][fieldName] = total;
                    }
                });
            }
        }
        
    }

    buildKey(row, fields) {
        if (fields.length === 0) return 'Total';
        const keyParts = fields.map(field => {
            const fieldName = typeof field === 'object' && field.name ? field.name : field;
            const value = row[fieldName];
            // نرمال‌سازی مقدار: trim و حذف فاصله‌های اضافی
            if (value === null || value === undefined) {
                return '(خالی)';
            }
            // تبدیل به string و نرمال‌سازی
            //const normalizedValue = String(value).trim().replace(/\s+/g, ' ');
            return value;
        });
        const key = keyParts.join('|');
        return key;
    }

    parseValue(value) {
        if (value === null || value === undefined || value === '') return null;
        if (typeof value === 'number') return value;
        const parsed = parseFloat(String(value).replace(/,/g, ''));
        return isNaN(parsed) ? null : parsed;
    }

	render() {
		const { rowFields, columnFields, valueFields } = this.options;

		// فیلتر کردن rowKeys - Total را همیشه حذف کن (در انتها جداگانه اضافه می‌شود)
		let rowKeys = Object.keys(this.pivotData).filter(key => key !== 'Total').sort();

		if (rowKeys.length === 0 || !this.colKeysList || Object.keys(this.colKeysList).length === 0) {
				this.container.innerHTML = '<div class="pivot-empty">داده‌ای برای نمایش موجود نیست</div>';
			return;
		}

		// مرتب‌سازی colKeys - Total همیشه در انتها
		const sortedColKeys = Object.keys(this.colKeysList).sort((a, b) => {
			if (a === 'Total') return 1; // Total همیشه آخر
			if (b === 'Total') return -1;
			return a.localeCompare(b);
		});

		// کنترل‌های Hide/Show برای شاخص‌ها - قرار دادن در container جداگانه
		const controlsContainer = document.getElementById('pivot-controls-container');
		if (controlsContainer) {
			let controlsHtml = '<div class="pivot-controls">';
			controlsHtml += '<div class="pivot-control-group">';
			controlsHtml += '<label>نمایش شاخص‌ها:</label>';
			valueFields.forEach((valueField, index) => {
				const valueFieldName = typeof valueField === 'object' && valueField.name ? valueField.name : valueField;
				const label = this.getFieldLabel(valueField);
				controlsHtml += '<label class="pivot-checkbox-label"><input type="checkbox" class="pivot-value-field-toggle" data-value-field="' + valueFieldName + '" checked> ' + label + '</label>';
			});
			controlsHtml += '</div>';
			// کنترل نمایش ستون Total
			controlsHtml += '<div class="pivot-control-group">';
			controlsHtml += '<label class="pivot-checkbox-label"><input type="checkbox" class="pivot-total-toggle" ' + (this.options.showTotal ? 'checked' : '') + '> نمایش ستون کل</label>';
			controlsHtml += '</div>';
			// کنترل نمایش سطر Total
			controlsHtml += '<div class="pivot-control-group">';
			controlsHtml += '<label class="pivot-checkbox-label"><input type="checkbox" class="pivot-total-row-toggle" ' + (this.options.showTotalRow ? 'checked' : '') + '> نمایش سطر کل</label>';
			controlsHtml += '</div>';
			controlsHtml += '</div>';
			controlsContainer.innerHTML = controlsHtml;
		}

		// شروع ساخت جدول
		let html = '<table class="pivot-table" dir="' + this.options.direction + '">';

		html += '<thead>';

		// محاسبه تعداد سطرهای header
		// سطر اول: header اصلی
		// سطر دوم: colKeys (مقادیر ستون‌ها) - فقط یک بار
		let headerRowCount = 2;

		// سطر اول: سلول‌های اصلی
		html += '<tr>';

		// سلول "ریوارد" (عنوان rowFields) - rowspan برای تمام سطرهای header
		const rowFieldsLabel = rowFields.length > 0 ? rowFields.map(f => this.getFieldLabel(f)).join(' / ') : "ریوارد";
			html += '<th class="pivot-row-dimension-header" rowspan="' + headerRowCount + '">' + rowFieldsLabel + '</th>';

			// سلول "شاخص‌ها" (عنوان valueFields) - فقط اگر تعداد شاخص‌ها بیشتر از 1 باشد نمایش بده
		if (valueFields.length > 1) {
			const valueFieldsLabel = "شاخص‌ها";
			html += '<th class="pivot-value-dimension-header" rowspan="' + headerRowCount + '">' + valueFieldsLabel + '</th>';
		}

		// سلول بزرگ که کل columnFields را می‌پوشاند - همه ابعاد را با / جدا می‌کنیم
		const colKeysCount = Object.keys(this.colKeysList).length;
		const totalCols = colKeysCount * valueFields.length;
		if (columnFields.length > 0) {
			const columnFieldsLabel = columnFields.map(f => this.getFieldLabel(f)).join(' / ');
			html += '<th class="pivot-header" colspan="' + totalCols + '">' + columnFieldsLabel + '</th>';
		} else {
			html += '<th class="pivot-header" colspan="' + totalCols + '">ستون</th>';
		}

		html += '</tr>';

		// سطر دوم: colKeys (مقادیر ستون‌ها) - برای هر colKey، یک ستون برای هر valueField
		html += '<tr>';
		for (const colKey of sortedColKeys) {
			const colKeyInfo = this.colKeysList[colKey];
			const colKeyLabel = colKeyInfo.label || this.formatKey(colKey);
			const isTotalColumn = colKey === 'Total';
			const totalClass = isTotalColumn ? ' pivot-col-value--total' : '';
			html += '<th class="pivot-col-value' + totalClass + '" data-col-key="' + colKey + '" >' + colKeyLabel + '</th>';
		}
		html += '</tr>';

		html += '</thead>';

		html += '<tbody>';

		// گروه‌بندی rowKeys بر اساس اولین dimension برای تفکیک بصری
		const groupedRowKeys = this.groupRowKeysByFirstDimension(rowKeys);

		groupedRowKeys.forEach((group, groupIndex) => {
			group.forEach((rowKey, keyIndex) => {
				const rowSpan = valueFields.length;
				const isFirstInGroup = keyIndex === 0;
				const isLastInGroup = keyIndex === group.length - 1;

				valueFields.forEach((valueField, vfIndex) => {
					const isFirstRow = vfIndex === 0;
					const isLastRow = vfIndex === valueFields.length - 1;

							html += '<tr class="' + (isFirstInGroup && isFirstRow ? 'pivot-row-group-start' : '') + ' ' + (isLastInGroup && isLastRow ? 'pivot-row-group-end' : '') + '">';

					if (vfIndex === 0) {
						html += '<th class="pivot-row-header" rowspan="' + rowSpan + '">' + this.formatKey(rowKey) + '</th>';
					}

					if (valueFields.length > 1) {
						const valueFieldName = typeof valueField === 'object' && valueField.name ? valueField.name : valueField;
						const aggregationType = typeof valueField === 'object' && valueField.aggregationType ? valueField.aggregationType : null;
						const icon = this.getAggregationIcon(aggregationType);
						const iconHtml = icon ? '<span class="pivot-value-label__icon" aria-hidden="true">' + icon + '</span>' : '';
						const labelHtml = '<span class="pivot-value-label__text">' + this.getFieldLabel(valueField) + '</span>';
						html += '<th class="pivot-value-label" data-value-field="' + valueFieldName + '">' + labelHtml + iconHtml + '</th>';
					}

					// برای هر colKey، یک سلول برای هر valueField
					// استفاده از sortedColKeys برای حفظ ترتیب (Total در انتها)
					for (const colKey of sortedColKeys) {
						const valueFieldName = typeof valueField === 'object' && valueField.name ? valueField.name : valueField;
						const value = this.pivotData[rowKey]?.[colKey]?.[valueFieldName] ?? null;
						const hasValue = value !== null && value !== undefined;
						const tooltip = this.buildTooltip(this.getFieldLabel(valueField), value, rowKey, colKey);
						// فقط برای سطر اول (vfIndex === 0) و فقط برای colKeyهایی که Total نیستند، آیکون drill down را نمایش بده
						const showDrillDown = this.options.hasSubReport && hasValue && vfIndex === 0 && colKey !== 'Total';
						const isTotalColumn = colKey === 'Total';
						let cellClass = showDrillDown ? 'pivot-value pivot-value-clickable' : 'pivot-value';
						if (isTotalColumn) {
							cellClass += ' pivot-value--total-column';
						}
						const dataAttrs = showDrillDown ?
							' data-row-key="' + rowKey + '" data-col-key="' + colKey + '" data-value-field="' + valueFieldName + '"' : '';
						const drillDownIcon = showDrillDown ? '<span class="pivot-drill-down-icon">🔍</span>' : '';
						html += '<td class="' + cellClass + '" title="' + tooltip + '" data-value-field="' + valueFieldName + '"' + dataAttrs + '">' +
									'<span class="pivot-value-text">' + this.formatValue(value) + '</span>' +
								drillDownIcon +
								'</td>';
					}

					html += '</tr>';
				});
			});
		});

		// اضافه کردن سطر Total - اگر showTotalRow فعال باشد
		if (this.options.showTotalRow && this.pivotData['Total']) {
			const rowSpan = valueFields.length;
			valueFields.forEach((valueField, vfIndex) => {
				const isFirstRow = vfIndex === 0;
				const isLastRow = vfIndex === valueFields.length - 1;
				const rowKey = 'Total';
				
				html += '<tr class="pivot-total-row' + (isFirstRow ? ' pivot-row-group-start' : '') + (isLastRow ? ' pivot-row-group-end' : '') + '">';

				if (vfIndex === 0) {
					html += '<th class="pivot-row-header pivot-row-header--total" rowspan="' + rowSpan + '">' + this.formatKey(rowKey) + '</th>';
				}

				if (valueFields.length > 1) {
					const valueFieldName = typeof valueField === 'object' && valueField.name ? valueField.name : valueField;
					const aggregationType = typeof valueField === 'object' && valueField.aggregationType ? valueField.aggregationType : null;
					const icon = this.getAggregationIcon(aggregationType);
					const iconHtml = icon ? '<span class="pivot-value-label__icon" aria-hidden="true">' + icon + '</span>' : '';
					const labelHtml = '<span class="pivot-value-label__text">' + this.getFieldLabel(valueField) + '</span>';
					html += '<th class="pivot-value-label" data-value-field="' + valueFieldName + '">' + labelHtml + iconHtml + '</th>';
				}

				// برای هر colKey، یک سلول برای هر valueField
				for (const colKey of sortedColKeys) {
					const valueFieldName = typeof valueField === 'object' && valueField.name ? valueField.name : valueField;
					const value = this.pivotData[rowKey]?.[colKey]?.[valueFieldName] ?? null;
					const hasValue = value !== null && value !== undefined;
					const tooltip = this.buildTooltip(this.getFieldLabel(valueField), value, rowKey, colKey);
					// drill down برای سطر Total غیرفعال است - هیچ data attribute و آیکونی اضافه نمی‌کنیم
					const isTotalColumn = colKey === 'Total';
					let cellClass = 'pivot-value pivot-value--total-row';
					if (isTotalColumn) {
						cellClass += ' pivot-value--total-column';
					}
					html += '<td class="' + cellClass + '" title="' + tooltip + '" data-value-field="' + valueFieldName + '">' +
								'<span class="pivot-value-text">' + this.formatValue(value) + '</span>' +
							'</td>';
				}

				html += '</tr>';
			});
		}

		html += '</tbody>';
		html += '</table>';

		this.container.innerHTML = html;

		this.attachDrillDownHandlers();
		this.attachToggleHandlers();
		this.updateDimensionCounts();
		this.adjustStickyHeaders();
	}

    attachToggleHandlers() {
        // ایجاد CSS rules برای hide/show هر valueField
        const { valueFields } = this.options;
        if (!document.getElementById('pivot-value-field-toggle-styles')) {
            const style = document.createElement('style');
            style.id = 'pivot-value-field-toggle-styles';
            let cssRules = '';
            valueFields.forEach(valueField => {
                const valueFieldName = typeof valueField === 'object' && valueField.name ? valueField.name : valueField;
                // Escape کردن کاراکترهای خاص در نام فیلد برای استفاده در CSS selector
                const safeFieldName = valueFieldName.replace(/[^a-zA-Z0-9]/g, '_');
                cssRules += `.pivot-table.hide-value-field-${safeFieldName} [data-value-field="${valueFieldName}"] { display: none !important; }`;
            });
            style.textContent = cssRules;
            document.head.appendChild(style);
        }

        // Toggle برای شاخص‌ها - استفاده از CSS برای hide/show
        // جستجو در controls container به جای container اصلی
        const controlsContainer = document.getElementById('pivot-controls-container');
        const searchContainer = controlsContainer || this.container;
        const valueFieldToggles = searchContainer.querySelectorAll('.pivot-value-field-toggle');
        valueFieldToggles.forEach(toggle => {
            toggle.addEventListener('change', (e) => {
                const valueFieldName = toggle.getAttribute('data-value-field');
                const safeFieldName = valueFieldName.replace(/[^a-zA-Z0-9]/g, '_');
                const table = this.container.querySelector('.pivot-table');
                if (toggle.checked) {
                    table.classList.remove('hide-value-field-' + safeFieldName);
                } else {
                    table.classList.add('hide-value-field-' + safeFieldName);
                }
            });
        });

        // Toggle برای ستون Total - نیاز به re-render کامل
        const totalToggle = searchContainer.querySelector('.pivot-total-toggle');
        if (totalToggle) {
            totalToggle.addEventListener('change', (e) => {
                this.options.showTotal = totalToggle.checked;
                this.processData();
                this.render();
            });
        }

        // Toggle برای سطر Total - نیاز به re-render کامل
        const totalRowToggle = searchContainer.querySelector('.pivot-total-row-toggle');
        if (totalRowToggle) {
            totalRowToggle.addEventListener('change', (e) => {
                this.options.showTotalRow = totalRowToggle.checked;
                this.processData();
                this.render();
            });
        }
    }

    adjustStickyHeaders() {
        // محاسبه ارتفاع سطر اول header و تنظیم top برای سطر دوم
        const firstHeaderRow = this.container.querySelector('.pivot-table thead tr:first-child');
        const secondHeaderRow = this.container.querySelector('.pivot-table thead tr:last-child');
        
        if (firstHeaderRow && secondHeaderRow) {
            const firstRowHeight = firstHeaderRow.offsetHeight;
            const colValueCells = secondHeaderRow.querySelectorAll('.pivot-col-value');
            colValueCells.forEach(cell => {
                cell.style.top = firstRowHeight + 'px';
            });
        }
    }
    
    updateDimensionCounts() {
        // محاسبه تعداد سلول‌های pivot-row-header
        const rowHeaders = this.container.querySelectorAll('.pivot-row-header');
        const rowHeaderCount = rowHeaders ? rowHeaders.length : 0;
        
        // محاسبه تعداد سلول‌های pivot-column-header از colKeysList
        let columnHeaderCount = 0;
        for (const colKey in this.colKeysList) {
            columnHeaderCount++;
        }
        
        // به‌روزرسانی مقادیر در footer
        const rowHeaderValueEl = document.querySelector('.pivot-row-header-value');
        if (rowHeaderValueEl) {
            rowHeaderValueEl.textContent = rowHeaderCount;
        }
        
        const columnHeaderValueEl = document.querySelector('.pivot-column-header-value');
        if (columnHeaderValueEl) {
            columnHeaderValueEl.textContent = columnHeaderCount;
        }
    }
    
    attachDrillDownHandlers() {
        if (!this.options.hasSubReport) return;
        
        const clickableCells = this.container.querySelectorAll('.pivot-value-clickable');
        clickableCells.forEach(cell => {
            // فقط روی آیکون کلیک شود
            const icon = cell.querySelector('.pivot-drill-down-icon');
            if (icon) {
                icon.addEventListener('click', (e) => {
                    e.stopPropagation();
                    e.preventDefault();
                    const rowKey = cell.getAttribute('data-row-key');
                    const colKey = cell.getAttribute('data-col-key');
                    const valueField = cell.getAttribute('data-value-field');
                    
                    if (rowKey && colKey && valueField) {
                        this.navigateToDrillDown(rowKey, colKey, valueField);
                    }
                });
            }
            
            // دابل کلیک روی سلول
            cell.addEventListener('dblclick', (e) => {
                e.stopPropagation();
                e.preventDefault();
                const rowKey = cell.getAttribute('data-row-key');
                const colKey = cell.getAttribute('data-col-key');
                const valueField = cell.getAttribute('data-value-field');
                
                if (rowKey && colKey && valueField) {
                    this.navigateToDrillDown(rowKey, colKey, valueField);
                } else {
                    console.warn('Missing data attributes for drill down:', { rowKey, colKey, valueField });
                }
            });
        });
    }
    
    navigateToDrillDown(rowKey, colKey, valueField) {
        if (!this.options.hasSubReport || !this.options.reportKey) {
            return;
        }
        
        const combinedKey = rowKey + '||' + colKey;
        const rowIdsMap = this.options.rowIdsMap || {};
        const ids = rowIdsMap[combinedKey] || '';
        const reportKey = this.options.reportKey;
        
        if (!window.top || !window.top.subConfigIds || !window.top.subConfigIds[reportKey]) {
            return;
        }
        
        const subConfigId = window.top.subConfigIds[reportKey].split(',')[0];
        const subReportNamespaceId = window.top.subReportNamespaceIds[reportKey]?.split(',')[0] || '';
        const subReportEntityId = window.top.subReportEntityIds[reportKey]?.split(',')[0] || '';
        const subReportReportId = window.top.subReportReportIds[reportKey]?.split(',')[0] || '';
        const subReportConfigName = window.top.subReportConfigNames[reportKey]?.split(',')[0] || 'زیر گزارش';
        const parentFilter = window.top.reportInfo && window.top.reportInfo[reportKey] 
            ? window.top.reportInfo[reportKey]['parentFilter'] 
            : null;
        
        // ساخت فیلتر بر اساس rowKey و colKey
        let filterValues = parentFilter ? JSON.parse(parentFilter) : {};
        
        // اضافه کردن فیلترهای dimension از rowKey
        const rowKeyParts = rowKey.split('|');
        this.options.rowFields.forEach((field, index) => {
            const fieldName = typeof field === 'object' && field.name ? field.name : field;
            if (rowKeyParts[index] && rowKeyParts[index] !== '(خالی)' && rowKeyParts[index] !== 'Total') {
                const value = rowKeyParts[index].trim();
                if (value) {
                    filterValues[fieldName] = value;
                }
            }
        });
        
        // اضافه کردن فیلترهای dimension از colKey
        const colKeyParts = colKey.split('|');
        this.options.columnFields.forEach((field, index) => {
            const fieldName = typeof field === 'object' && field.name ? field.name : field;
            if (colKeyParts[index] && colKeyParts[index] !== '(خالی)' && colKeyParts[index] !== 'Total') {
                const value = colKeyParts[index].trim();
                if (value) {
                    filterValues[fieldName] = value;
                }
            }
        });
        
        if (typeof window.top.OpenDrillDownModal !== 'undefined') {
            window.top.OpenDrillDownModal(
                subReportNamespaceId,
                subReportEntityId,
                subReportReportId,
                subConfigId,
                ids || '',
                subReportConfigName,
                filterValues
            );
        }
    }


    formatKey(key) {
        if (key === 'Total') return 'کل';
        return key.split('|').join(' / ');
    }
    
    buildTooltip(valueFieldLabel, value, rowKey, colKey) {
        const formattedValue = this.formatValue(value);
        const formattedRowKey = this.formatKey(rowKey);
        const formattedColKey = this.formatKey(colKey);
        let tooltip = valueFieldLabel + ': ' + formattedValue + ' برای ' + formattedRowKey + ' در ' + formattedColKey;
        if (this.options.hasSubReport && value !== null && value !== undefined) {
            tooltip += ' | 🔍 نمایش ریز اطلاعات';
        }
        return tooltip;
    }
    
    groupRowKeysByFirstDimension(rowKeys) {
        if (rowKeys.length === 0) return [];
        if (this.options.rowFields.length === 0) return [rowKeys];
        
        const groups = {};
        rowKeys.forEach(key => {
            const firstDimensionValue = key.split('|')[0] || 'Other';
            if (!groups[firstDimensionValue]) {
                groups[firstDimensionValue] = [];
            }
            groups[firstDimensionValue].push(key);
        });
        
        return Object.values(groups);
    }

    formatValue(value) {
        if (value === null || value === undefined) return '—';
        if (typeof value === 'number') {
            return value.toLocaleString(this.options.locale, {
                minimumFractionDigits: 0,
                maximumFractionDigits: 2
            });
        }
        return String(value);
    }

    getFieldLabel(field) {
        if (typeof field === 'object' && field.label) {
            return field.label;
        }
        if (typeof field === 'object' && field.name) {
            return field.name;
        }
        return String(field);
    }

    getAggregationIcon(aggregationType) {
        if (!aggregationType) return '';
        
        const type = aggregationType.toLowerCase();
        const icons = {
            'count': '#',       // تعداد
            'sum': 'Σ',         // جمع
            'average': 'x̄',    // متوسط
            'avg': 'x̄',       // متوسط (مخفف)
            'min': '📉',       // حداقل
            'max': '📈',       // حداکثر
            'first': '🔝',     // اولین
            'last': '🔚'       // آخرین
        };
        
        return icons[type] || '📋';
    }

    updateData(data) {
        this.options.data = data;
        this.init();
    }

    setDimensions(rowFields, columnFields, valueFields) {
        this.options.rowFields = rowFields;
        this.options.columnFields = columnFields;
        this.options.valueFields = valueFields;
        this.init();
    }

    setAggregator(aggregator) {
        this.options.aggregator = aggregator;
        this.init();
    }

};
})(); // end of IIFE

// اطمینان از دسترسی در scope global (بدون window prefix)
if (typeof PivotTable === 'undefined' && typeof window.PivotTable !== 'undefined') {
    var PivotTable = window.PivotTable;
}
</script>