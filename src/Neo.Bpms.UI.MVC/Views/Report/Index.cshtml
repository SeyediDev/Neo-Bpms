<script>
    // Open column settings modal
    function openColumnSettingsModal(modalKey) {
        const modalId = 'columnsSettingsModal-' + modalKey;
        const modal = document.getElementById(modalId);
            
        if (modal) {
            // Show modal using vanilla JavaScript
            modal.style.display = 'block';
            modal.classList.add('show');
            modal.setAttribute('aria-hidden', 'false');
                
            // Add backdrop
            const backdrop = document.createElement('div');
            backdrop.className = 'modal-backdrop fade show';
            backdrop.id = 'modal-backdrop-' + modalKey;
            document.body.appendChild(backdrop);
                
            // Prevent body scroll
            document.body.classList.add('modal-open');
                
            console.log('Column settings modal opened:', modalId);
        } else {
            console.error('Modal not found:', modalId);
        }
    }
        
    // Close modal function
    function closeModal(modalId) {
        const modal = document.getElementById(modalId);
        if (modal) {
            modal.style.display = 'none';
            modal.classList.remove('show');
            modal.setAttribute('aria-hidden', 'true');
                
            // Remove backdrop
            const backdrop = document.getElementById('modal-backdrop-' + modalId.replace('columnsSettingsModal-', ''));
            if (backdrop) {
                backdrop.remove();
            }
                
            // Restore body scroll
            document.body.classList.remove('modal-open');
        }
    }
        
    // Fix dropdown positioning
    document.addEventListener('DOMContentLoaded', function() {
        // Handle dropdown positioning
        const dropdownToggles = document.querySelectorAll('[data-toggle="dropdown"]');
        dropdownToggles.forEach(function(toggle) {
            toggle.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                    
                const dropdown = this.nextElementSibling;
                if (dropdown && dropdown.classList.contains('dropdown-menu')) {
                    // Calculate position
                    const rect = this.getBoundingClientRect();
                    const dropdownRect = dropdown.getBoundingClientRect();
                        
                    // Position dropdown
                    dropdown.style.position = 'fixed';
                    dropdown.style.top = (rect.bottom + 5) + 'px';
                    dropdown.style.left = (rect.left) + 'px';
                    dropdown.style.zIndex = '999999';
                        
                    // Toggle dropdown
                    dropdown.classList.toggle('show');
                        
                    console.log('Dropdown positioned:', {
                        button: rect,
                        dropdown: dropdownRect,
                        top: dropdown.style.top,
                        left: dropdown.style.left
                    });
                }
            });
        });
            
            // Close dropdown when clicking outside
            document.addEventListener('click', function(e) {
                // Hide report info tooltip
                if (!e.target.closest('[onclick*="toggleReportInfo"]') && !e.target.closest('#reportInfoPanel')) {
                    const panel = document.getElementById('reportInfoPanel');
                    const toggle = document.querySelector('[onclick*="toggleReportInfo"]');
                    if (panel && panel.classList.contains('show')) {
                        panel.classList.remove('show');
                        if (toggle) {
                            toggle.classList.remove('active');
                        }
                        console.log('Report info tooltip hidden by outside click');
                    }
                }
                
                // Hide design settings tooltip
                if (!e.target.closest('[onclick*="toggleDesignSettings"]') && !e.target.closest('#designSettingsPanel')) {
                    const panel = document.getElementById('designSettingsPanel');
                    const toggle = document.querySelector('[onclick*="toggleDesignSettings"]');
                    if (panel && panel.classList.contains('show')) {
                        panel.classList.remove('show');
                        if (toggle) {
                            toggle.classList.remove('active');
                        }
                        console.log('Design settings tooltip hidden by outside click');
                    }
                }
                
                // Hide filter tooltip
                if (!e.target.closest('[onclick*="toggleFilterTooltip"]') && !e.target.closest('#filterTooltipPanel')) {
                    const panel = document.getElementById('filterTooltipPanel');
                    const toggle = document.querySelector('[onclick*="toggleFilterTooltip"]');
                    if (panel && panel.classList.contains('show')) {
                        panel.classList.remove('show');
                        if (toggle) {
                            toggle.classList.remove('active');
                        }
                        console.log('Filter tooltip hidden by outside click');
                    }
                }
                
                if (!e.target.closest('.dropdown')) {
                    const openDropdowns = document.querySelectorAll('.dropdown-menu.show');
                    openDropdowns.forEach(function(dropdown) {
                        dropdown.classList.remove('show');
                    });
                }
                
            });
    });
    
    // Show icons and tabs after page is fully loaded to prevent FOUC
    (function() {
        var iconsShown = false;
        
        function showIconsAndTabs() {
            if (iconsShown) return;
            iconsShown = true;
            
            // Force a reflow to ensure styles are applied
            document.body.offsetHeight;
            
            // Add the class to show elements
            document.body.classList.add('page-ready');
            
            // Force another reflow
            document.body.offsetHeight;
            
            // Initialize SideNavi and activate first tab after a short delay
            setTimeout(function() {
                // Ensure SideNavi is initialized
                if (typeof SideNavi !== 'undefined') {
                    // Activate the first tab (popular filters) by default
                    var $firstTab = $('.side-navi-tab:first');
                    var $firstItem = $('.side-navi-item:first');
                    var $sideNaviData = $('.side-navi-data');
                    
                    // Ensure side-navi-data is visible
                    if ($sideNaviData.length) {
                        $sideNaviData.css({
                            'display': 'block',
                            'z-index': '30001',
                            'visibility': 'visible',
                            'opacity': '1'
                        });
                    }
                    
                    if ($firstTab.length && !$firstTab.hasClass('active')) {
                        $('.side-navi-tab').removeClass('active');
                        $('.side-navi-item').removeClass('active');
                        $firstTab.addClass('active');
                        $firstItem.addClass('active');
                        console.log('First tab (Popular Filters) activated', {
                            tabVisible: $firstTab.is(':visible'),
                            dataVisible: $sideNaviData.is(':visible'),
                            dataZIndex: $sideNaviData.css('z-index')
                        });
                    }
                }
            }, 100);
            
            console.log('Page ready - Icons and tabs shown');
        }
        
        function checkStylesheetsLoaded() {
            var stylesheets = document.querySelectorAll('link[rel="stylesheet"]');
            var loadedCount = 0;
            var totalCount = stylesheets.length;
            
            if (totalCount === 0) {
                return true;
            }
            
            for (var i = 0; i < stylesheets.length; i++) {
                var sheet = stylesheets[i];
                try {
                    // Check if stylesheet is loaded
                    if (sheet.sheet) {
                        loadedCount++;
                    } else if (sheet.readyState === 'complete' || sheet.readyState === 'loaded') {
                        loadedCount++;
                    }
                } catch (e) {
                    // Cross-origin stylesheet, assume loaded
                    loadedCount++;
                }
            }
            
            return loadedCount === totalCount;
        }
        
        // Method 1: Wait for window load (all resources including CSS)
        if (document.readyState === 'complete') {
            // Page already loaded
            setTimeout(function() {
                if (checkStylesheetsLoaded()) {
                    showIconsAndTabs();
                } else {
                    // Wait a bit more for stylesheets
                    setTimeout(showIconsAndTabs, 300);
                }
            }, 100);
        } else {
            window.addEventListener('load', function() {
                setTimeout(function() {
                    if (checkStylesheetsLoaded()) {
                        showIconsAndTabs();
                    } else {
                        setTimeout(showIconsAndTabs, 200);
                    }
                }, 200);
            });
        }
        
        // Method 2: Check when DOM is ready and stylesheets are loaded
        function checkAndShow() {
            if (checkStylesheetsLoaded()) {
                setTimeout(showIconsAndTabs, 300);
            } else {
                setTimeout(checkAndShow, 100);
            }
        }
        
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', function() {
                setTimeout(checkAndShow, 200);
            });
        } else {
            setTimeout(checkAndShow, 200);
        }
        
        // Fallback: Show after maximum delay (2 seconds)
        setTimeout(function() {
            showIconsAndTabs();
        }, 2000);
    })();
</script>

