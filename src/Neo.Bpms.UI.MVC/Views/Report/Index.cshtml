@* Critical CSS to prevent FOUC - Must be at the very top *@
<style id="fouc-prevention-style">
	/* Hide icons, tabs, and side navigation initially - Critical inline styles */
	/* Use display: none to prevent rendering until styles are loaded */
	.icons-tables,
	.top-bar-anchor-icon,
	.sideNavi-top-bar .icons-tables,
	.side-navi-body .icons-tables,
	#sideNavi,
	.side-navi-item,
	.side-navi-data {
		display: none !important;
	}
	
	/* Show side navigation after page is ready with critical styles */
	body.page-ready #sideNavi {
		display: block !important;
		position: fixed !important;
		right: 50px !important;
		z-index: 30000 !important;
	}
	
	body.page-ready .side-navi-item {
		display: inline-block !important;
		position: absolute !important;
		left: 20px !important;
		width: 150px !important;
		height: 50px !important;
		transform: rotate(-90deg) !important;
		transform-origin: left top 0 !important;
		cursor: pointer !important;
		box-shadow: 0px 0px 5px #888888 !important;
		border-radius: 5px 5px 0 0 !important;
		background-color: white !important;
	}
	
	body.page-ready .side-navi-item.active {
		background-color: #f8f9fa !important;
	}
	
	body.page-ready .side-navi-item > div {
		text-align: center !important;
		font-size: smaller !important;
	}
	
	body.page-ready .side-navi-data {
		display: block !important;
		position: absolute !important;
		top: 0 !important;
		left: 50px !important;
		width: 400px !important;
		height: 100vh !important;
		box-shadow: 0px 0px 5px #888888 !important;
		z-index: 30001 !important;
		background-color: white !important;
		overflow: visible !important;
	}
	
	/* Ensure tabs are properly displayed when active */
	body.page-ready .side-navi-tab {
		display: none !important;
	}
	
	body.page-ready .side-navi-tab.active {
		display: block !important;
		width: 100% !important;
		height: 100% !important;
	}
	
	/* Ensure side-navi-data is always visible when page is ready and sideNavi is shown */
	body.page-ready #sideNavi .side-navi-data {
		display: block !important;
		z-index: 30001 !important;
		visibility: visible !important;
		opacity: 1 !important;
	}
	
	/* Show icons and tabs after page is ready with critical styles */
	body.page-ready .icons-tables {
		display: inline-flex !important;
		align-items: center !important;
		justify-content: center !important;
		width: 36px !important;
		height: 36px !important;
		border-radius: 8px !important;
		opacity: 1 !important;
		transition: all 0.2s ease !important;
		margin: 0 4px !important;
	}
	
	body.page-ready .top-bar-anchor-icon,
	body.page-ready .sideNavi-top-bar .icons-tables,
	body.page-ready .side-navi-body .icons-tables {
		display: inline-block !important;
		opacity: 1 !important;
		transition: opacity 0.2s ease-in;
		/* Critical styles to prevent unstyled appearance */
		color: #1869AA;
		cursor: pointer;
		text-decoration: none !important;
		vertical-align: middle;
	}
	
	/* Special handling for SVG icons */
	body.page-ready .icons-tables svg {
		width: 18px !important;
		height: 18px !important;
		display: block !important;
	}
	
	body.page-ready .top-bar-anchor-icon svg {
		display: inline-block !important;
		width: 16px;
		height: 16px;
		vertical-align: middle;
	}
	
	/* Text colors for different icon types */
	body.page-ready .icons-tables.text-success,
	body.page-ready .top-bar-anchor-icon.text-success {
		color: #28a745 !important;
	}
	
	body.page-ready .icons-tables.text-primary,
	body.page-ready .top-bar-anchor-icon.text-primary {
		color: #1869AA !important;
	}
	
	body.page-ready .icons-tables.text-danger,
	body.page-ready .top-bar-anchor-icon.text-danger {
		color: #dc3545 !important;
	}
</style>

