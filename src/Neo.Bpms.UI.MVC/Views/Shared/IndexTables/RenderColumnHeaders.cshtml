@using Neo.Bpms.Infrastructure.Features.Cmmn.Forms
@using Neo.Bpms.Domain.Model.UI;
@model CommonFormStructure

@{
	var shouldShowNumbers = Model.ColumnInfos.Count(ci => ci.IsSorted) > 1;
	foreach (var item in Model.ColumnInfos)
	{
		var hasFilter = Model.Fields.Any(f => f.FormFieldType == FormField.Type.FilterField && f.FieldName == item.ColumnName);
		<th class="cColumn" data-column-name="@item.ColumnName" @SummationAttributes(item)>
			<div class="neo-column-header-actions">
				@if (Model.FormSortType == FormSortType.DoNotSort)
				{
					<span class="sort-button-text">@item.Alias</span>
				}
				else
				{
					<button class="modern-sort-button"
					        data-refer="@item.ColumnName" type="button"
					        data-sort="@(item.IsSorted ? (item.Descending ? "DESC" : "ASC") : "noSort")"
					        onclick="SortingManager.changeSort(event, this)"
					        title="@(item.IsSorted ? (item.Descending ? ViewTexts.Descending : ViewTexts.Ascending) : "کلیک برای مرتب‌سازی")">
						<span class="sort-button-content">
							<span class="sort-button-text">@item.Alias</span>
							<span class="sort-button-icons">
							@if (item.IsSorted)
							{
								if (item.Descending)
								{
									<svg class="sort-icon sort-icon-active sort-icon-desc" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<path d="M3 6h18"/>
										<path d="M7 12h10"/>
										<path d="M10 18h4"/>
									</svg>
									@if (shouldShowNumbers)
									{
										<span class="sort-order-badge">@item.SortOrder</span>
									}
								}
								else
								{
									<svg class="sort-icon sort-icon-active sort-icon-asc" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<path d="M3 6h18"/>
										<path d="M7 12h10"/>
										<path d="M10 18h4"/>
									</svg>
									@if (shouldShowNumbers)
									{
										<span class="sort-order-badge">@item.SortOrder</span>
									}
								}
							}
							else
							{
								<svg class="sort-icon sort-icon-inactive" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M3 6h18"/>
									<path d="M7 12h10"/>
									<path d="M10 18h4"/>
								</svg>
							}
							</span>
						</span>
					</button>
				}
				@if (hasFilter)
				{
					<button type="button" class="neo-column-filter" data-filter-column="@item.ColumnName"
					        aria-label="فیلتر @item.Alias" aria-pressed="false" title="فیلتر @item.Alias">
                        <svg class="neo-column-filter-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M4 5h16l-6 7v5l-4 2v-7L4 5z" />
						</svg>
					</button>
				}
			</div>
		</th>
	}

	string SummationAttributes(ColumnFieldDefinition item)
	{
		if (item.IsSummable)
		{
			return "data-summable data-summation-method=\"" + @item.SummationMethod + "\"";
		}
		return "";
	}
}
