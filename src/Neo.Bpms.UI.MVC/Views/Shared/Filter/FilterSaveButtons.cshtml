@using Neo.Bpms.UI.MVC.PartialModels.Filter
@model FilterSaveButtonsModel

@if (Model.filterId != null && Model.filterId > 0)
{
    <button type="button" onclick="FilterConfig.saveFilterValues(@Model.filterId);" class="btn btn-outline-success" style="border:1px solid #94A3B8; background-color:#EFF6FF;border-radius:8px;">
        <svg style="width: 18px;height: 18px;vertical-align: middle;" viewBox="0 0 18 18">
            <use xlink:href="/Content/common-assets-includes/icons/svgSprite.svg#filter2-button" />
        </svg>
        <span style="color: #2563EB;font-size:14px;">@ViewTexts.SaveFilterValues @Model.filterName</span>
    </button>
}
<button type="button" onclick="FilterConfig.showFiltersModal();" class="btn btn-success add-button">
    <svg style="width: 18px;height: 18px;vertical-align: middle;" viewBox="0 0 18 18">
        <use xlink:href="/Content/common-assets-includes/icons/svgSprite.svg#add-button" />
    </svg>
    <span>@ViewTexts.SaveNewFilter</span>
</button>

