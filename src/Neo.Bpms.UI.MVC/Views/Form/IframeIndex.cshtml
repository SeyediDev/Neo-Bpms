@using Microsoft.AspNetCore.Html
@using Microsoft.AspNetCore.Routing
@using Neo.Bpms.Domain.Model.UI
@using Neo.Bpms.Domain.Models.Cmmn.UI.Components
@using Neo.Bpms.Domain.Models.Cmmn.UI.Forms
@using Neo.Bpms.Infrastructure.Features.Cmmn.Forms
@using Neo.Bpms.Infrastructure.Features.Cmmn.Forms.Logic
@using Neo.Bpms.UI.MVC.Controllers
@using Neo.Bpms.UI.MVC.Controls
@using Neo.Bpms.UI.MVC.Helpers
@using Neo.Bpms.UI.MVC.PartialModels
@using Neo.Bpms.UI.MVC.PartialModels.Common
@using Neo.Bpms.UI.MVC.PartialModels.IndexTables
@using Neo.Common.Extensions

@inject IFormLogicHelper formLogicHelper;
@inject IControlsRenderer controlsRenderer;

@model IndexFormData

@{
    var shouldShowTopBar = !(bool)ViewBag.WithoutTopBar;
}

@functions {

    private static RouteValueDictionary GetRouteValues(CommonFormStructure structure, string formId, ElasticObject filterValues)
    {
        var routeValues = new RouteValueDictionary
        {
            {"NamespaceId", structure.NamespaceId},
            {"EntityId", structure.EntityId},
            {"FormId", formId},
            {"indexFormId", structure.Form_ReportId},
        };

        if (structure.PassingParameters != null)
        {
            foreach (var parameter in structure.PassingParameters)
            {
                routeValues[parameter] = filterValues[parameter];
            }
        }
        return routeValues;
    }

}

@{
    Layout = null;
    CommonFormStructure structure = ViewBag.structure;

    var canDesign = ViewBag.CanDesign ?? false;
    var pageName = ViewBag.PagePackId as string;
    var pageIcon = PageIconHelper.GetPageMenuIcon(pageName);

    var options = new RendererOptions
    {
        IsFilter = true
    };
    ControlsRendererData controlsRendererData = new(structure, ViewBag.FilterValues, options, ViewBag.user, Url);

    var bulkEdits = structure.BulkEdits;
    var bulkProcessCreates = structure.BulkProcessCreates;
    var needsSelection = bulkEdits.NotNullNorEmpty() || bulkProcessCreates.NotNullNorEmpty();

    Func<dynamic, HelperResult> TopBarTools =
        @<text>
    @if (bulkEdits.NotNullNorEmpty())
    {
        BulkEditsDropdown(bulkEdits);
    }

    @if (bulkProcessCreates.NotNullNorEmpty())
    {
        BulkCreateProcessesDropdown(bulkProcessCreates);
    }

    @if (structure.HasCreate)
    {
            <a href="@Url.Action("IframeForm", "Form", GetRouteValues(structure, structure.CreateFormId, Model.FilterValues))"
               class="top-bar-anchor-icon text-success">
                <i title="@ViewTexts.AddNewRecord" class="fa fa-plus-circle top-bar-icon"></i>
            </a>
    }
    @{
        ExcelDropdown(structure);
    }
    @if (structure.Fields.Any(f => f.FormFieldType == FormField.Type.FilterField))
    {
            <a href="#" role="button" id="showFilter" class="top-bar-anchor-icon text-primary">
                <i class="fa fa-filter top-bar-icon"></i>
            </a>
    }

    @if (canDesign && false)
    {
            <a href="~/Form/Design?@string.Format("NamespaceId={0}&EntityId={1}&FormId={2}", structure.NamespaceId, structure.EntityId, structure.Form_ReportId)"
               class="top-bar-anchor-icon text-danger">
                <i title="@ViewTexts.FilterSettings"
                   class="top-bar-icon bpms-flaticon-filter-design">
                </i>
            </a>
    }
    </text>;
}

<partial name="Layout/MinimalIframeIncludes" />
<script src="~/Scripts/common-assets-includes/common-plugins/global/iframe-resizer/iframeResizer.contentWindow.min.js"></script>

<style>
    .t-table-wrapper {
        max-height: calc(100vh - 150px) !important;
    }
    
    /* Reduce font size of filter controls by 25% */
    .filterDiv {
        font-size: 0.75em !important;
    }
    
    .filterDiv input,
    .filterDiv select,
    .filterDiv textarea,
    .filterDiv label,
    .filterDiv .form-control,
    .filterDiv .form-label,
    .filterDiv .form-group,
    .filterDiv .control-label,
    .filterDiv .help-block,
    .filterDiv button,
    .filterDiv .btn,
    .filterDiv span,
    .filterDiv div,
    .filterDiv p {
        font-size: 1em !important;
    }
</style>

<script>
    @await Html.PartialAsync("Common/SetPageAddress", structure);
</script>

@using (Html.BeginForm("IframeIndex", "Form",
    new
    {
        structure.NamespaceId,
        structure.EntityId,
        FormId = structure.Form_ReportId,
        structure.FormSubjectId
    }, FormMethod.Post, true, new { enctype = "multipart/form-data", id = "filter-form" }))
{
    var pageLinkCount = 10;
    var pageCount = (Model.recordCount + (ViewBag.recordsPerPage - 1)) / ViewBag.recordsPerPage;
    int pageNo = ViewBag.Page;
    ViewBag.Title = string.Format("{0} {1} {2} {3} {4}", structure.Name, ViewTexts.Page, pageNo, ViewTexts.PageOf, pageCount);
    //    ViewBag.Title = "موجودیت " + structure.EntityId
    HiddenInputs(structure, options.CalendarType, pageNo, Model.AlreadySelectedsJson);

    if (shouldShowTopBar)
    {
        var topBarModel = new TopBarModel { Title = structure.Name, PageIcon = pageIcon, Tools = TopBarTools(null), IconsContainerClass = "mt-2" };
        <partial name="Common/TopBar" model="topBarModel" />
    }

    <body class="internal-body" @formLogicHelper.HtmlLogicEvent(structure, null, null)>

        @if (structure.Fields != null && structure.Fields.Count > 0)
        {
            await Filter(controlsRendererData);
        }
        <div class="@(shouldShowTopBar ? "customDiv" : "") col-lg-12" style="overflow-x: auto;">
            @{
                await IndexTable(structure, options.CalendarType, needsSelection);
            }
            <partial name="Common/Pagination" model="new PaginationModel { pageNo = pageNo, maxPageLinksToShow = pageLinkCount, recordsPerPage = ViewBag.recordsPerPage, thisPageRowsCount = Model.Rows.Count, totalRecordsCount = Model.recordCount }" />
        </div>

        <partial name="Logic/_Logic" model="structure" />

        @if (controlsRendererData.IncludeNeedingControls != null)
        {
            <partial name="Controls/_ControlIncludes" model="controlsRendererData.IncludeNeedingControls" />
        }
    </body>
}

@if (needsSelection)
{
    <script src="@CommonBundles.RowSelectionJsBundle" asp-append-version="true"></script>
}
<script src="~/Scripts/common-assets-includes/features/common-features/sorting.js"></script>
