<partial name="Layout/JsGlobalConfigs" />

@functions {

    void ExcelImportModal()
    {
        <div class="modal fade" id="excel-import-modal" tabindex="-1" role="dialog" aria-labelledby="excel-import-modal-label">
            <div class="modal-dialog modal-lg" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h4 class="modal-title" id="excel-import-modal-label">@ViewTexts.ExcelImport</h4>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <div class="d-inline-block">
                            <div class="custom-file">
                                <input type="file" class="custom-file-input" id="excel-import-file">
                                <label class="custom-file-label" for="excel-import-file">@ViewTexts.ChooseFile</label>
                            </div>
                        </div>
                        <button class="btn btn-secondary btn-sm d-inline-block mt-2" type="button" onclick="ExcelManager.downloadTemplate()">
                            @ViewTexts.DownloadTemplate
                            <i class="fa fa-download"></i>
                        </button>
                        <div id="operation-result">
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">@ViewTexts.Cancel</button>
                        <button type="button" id="import-save-button" class="btn btn-success ladda-button" data-style="zoom-in" onclick="ExcelManager.importFile()">@ViewTexts.Save</button>
                    </div>
                </div>
            </div>
        </div>
    }

    async Task Filter(ControlsRendererData controlsRendererData)
    {
        <div class="row no-margin-row">
            <div class="col-lg-12 col-sm-12 filterDiv" id="filterDiv">
                @{
                    var htmlInputStr = controlsRenderer.Render(controlsRendererData);
                }
                @htmlInputStr
                <br />
                <div class="col-md-12 col-sm-12 filter-buttons">
                    <partial name="Common/FilterEraseButton" />
                    <partial name="Filter/ApplyButton" />
                    <input type="submit" id="submitBtn" style="display: none;" />
                </div>
            </div>
        </div>
    }

    async Task IndexTable(CommonFormStructure structure, string calendar, bool showCheckBoxes)
    {
        <div class="t-table-wrapper custom-scroll">
            <table id="tblRecords" class="table table-hover">
                <thead>
                    <tr class="sticky-row">
                        @if (showCheckBoxes)
                        {
                            <partial name="IndexTables/RenderCheckboxesHeader" />
                        }
                        <partial name="IndexTables/RenderColumnHeaders" model="structure" />
                        @{
                            foreach (var sbj in structure.Subjects)
                            {
                                <th class="cColumn">
                                    <span style="color: #0e71b9;">@sbj.Alias</span>
                                </th>
                            }

                            foreach (var link in structure.Fields.Where(f => f.ControlType == eControlTypeId.SpecificLinkColumn)
                            ) //todo too specific
                            {
                                <th class="cColumn">
                                    @*                <button style="background: none; border: none;" type="button">*@

                                    <span style="color: #0e71b9;">
                                        @link.Label
                                    </span>
                                    @*                </button>*@

                                </th>
                            }
                        }
                        <th class="cColumn">
                            <span style="color: #0e71b9;">
                                @* @ViewTexts.Pages *@
                            </span>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        if (Model.Rows.Count == 0)
                        {
                            <tr>
                                <td colspan="@(structure.ColumnInfos.Count + 2)">
                                    <span>@ViewTexts.IndexNoData</span>
                                </td>
                            </tr>
                        }

                        var rowIdx = 0;
                        foreach (var rowData in Model.Rows)
                        {
                            var rowIds = "";
                            foreach (var key in structure.KeyFields)
                            {
                                object rowId;
                                rowData.GetField(key, out rowId);
                                if (!string.IsNullOrEmpty(rowIds))
                                {
                                    rowIds += ",";
                                }
                                rowIds += rowId == null ? "" : rowId.ToString();
                            }
                            <tr class="selectable-table-row" data-ids="@rowIds">
                                @if (showCheckBoxes)
                                {
                                    <td class="cColumn">
                                        <input class="row-checkbox" data-ids="@rowIds" type="checkbox" id="checkbox-row-@rowIdx">
                                    </td>
                                }
                                <partial name="IndexTables/RenderValueCells" model="new RenderValueCellsModel { structure = structure, calendar = calendar, rowData = rowData }" />

                                @{
                                    foreach (var subjectInfo in structure.Subjects)
                                    {
                                        object subjectText = "";
                                        var subjectTextExists =
                                        subjectInfo.HasText && rowData.GetField(subjectInfo.Name, out subjectText);
                                        if (!subjectTextExists)
                                        {
                                            subjectText = " ";
                                        }
                                        object subjectTooltip = "";
                                        var subjectTooltipExists = subjectInfo.HasTooltip && rowData.GetField(subjectInfo.Name + "_Tooltip", out subjectTooltip);
                                        if (!subjectTooltipExists)
                                        {
                                            subjectTooltip = " ";
                                        }
                                        var hasEditForm = subjectInfo.HasEditForm;
                                        var hasDetailsForm = subjectInfo.HasDetailsForm;
                                        <td class="cColumn">
                                            <span title="@subjectTooltip">@subjectText</span>
                                            &nbsp;

                                            @if (hasDetailsForm)
                                            {
                                                RenderDetailsLink(rowIds, subjectInfo.Name, subjectInfo.DetailFormId, subjectInfo.DetailAction);
                                            }

                                            @if (hasEditForm)
                                            {
                                                RenderEditLink(rowIds, subjectInfo.Name, subjectInfo.EditFormId, subjectInfo.EditAction);
                                            }
                                        </td>
                                    }

                                    foreach (var link in structure.Fields.Where(f =>
                                    f.ControlType == eControlTypeId.SpecificLinkColumn && f.GetProperties() != null))
                                    {
                                        <td>
                                            @{
                                                var parameters = "";
                                                foreach (var property in link.GetProperties(eControlPropertyId.LinkParameter))
                                                {
                                                    var fields = property.Value.ToString().Split('=');
                                                    if (fields.Length > 1)
                                                    {
                                                        if (!string.IsNullOrEmpty(parameters))
                                                        {
                                                            parameters += "&";
                                                        }
                                                        object fieldValue;
                                                        if (!rowData.GetField(fields[1], out fieldValue) || fieldValue == null)
                                                        {
                                                            if (fields[1] == "Id")
                                                            {
                                                                rowData.GetField("Ids", out fieldValue);
                                                            }
                                                            if (fieldValue == null)
                                                            {
                                                                fieldValue = fields[1];
                                                            }
                                                        }
                                                        parameters += fields[0] + "=" + fieldValue;
                                                    }
                                                }
                                                var linkUrl = link.PropertyValue(eControlPropertyId.LinkTarget) +
                                                "?" + parameters;
                                            }
                                            <a href="~/@(new HtmlString(linkUrl))">
                                                <i class="fa fa-link"></i>
                                            </a>
                                        </td>
                                    }
                                }
                                <td class="cColumn">

                                    @if (structure.HasDetails)
                                    {
                                        RenderDetailsLink(rowIds, structure.FormSubjectId, structure.DetailFormId, structure.DetailAction);
                                    }

                                    @if (structure.HasEdit)
                                    {
                                        RenderEditLink(rowIds, structure.FormSubjectId, structure.EditFormId, structure.EditAction);
                                    }

                                    @if (structure.HasDelete)
                                    {
                                        RenderDeleteLink(rowIds, structure.FormSubjectId, structure.DeleteFormId);
                                    }
                                </td>
                            </tr>
                            rowIdx++;
                        }
                    }
                </tbody>
            </table>
        </div>
    }

    void HiddenInputs(CommonFormStructure structure, string calendar, int pageNo,
        string alreadySelectedsJson)
    {
        @Html.Hidden("calendar", calendar)
        <input type="hidden" name="Page" value="@pageNo" />
        <input type="hidden" name="newPage" value="1" />
        <input type="hidden" id="soValues" name="SortFields" value="@ViewBag.SortFields" />
        <input type="hidden" id="alreadySelectedsJson" name="alreadySelectedsJson" value='@alreadySelectedsJson' />
    }

    void ExcelDropdown(CommonFormStructure commonFormStructure)
    {
        <a title="@ViewTexts.ExcelExport" href="#" role="button" onclick="ExcelManager.downloadExportFile()"
           class="top-bar-anchor-icon text-info icons-tables">
            <svg title="@ViewTexts.ExcelExport" style="width:16px;height:16px;vertical-align:middle">
                <use xlink:href="/Content/common-assets-includes/icons/svgSprite.svg#download-green" />
            </svg>
        </a>
    }

    void BulkEditsDropdown(List<FormLinkId> bulkEdits)
    {
        if (bulkEdits.Count == 1)
        {
            var bulkFormId = bulkEdits[0];
            <a href="#" class="top-bar-anchor-icon">
                <i title="@bulkFormId.Alias"
                   onclick="BulkOperationsManager.bulkEdit('@bulkFormId.FormId')"
                   class="fa fa-edit top-bar-icon">
                </i>
            </a>
        }
        else
        {
            <div class="dropdown inline-dropdown">
                <span class="btn btn-sm btn-outline-success dropdown-toggle topbar-dropdown-btn" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    @ViewTexts.BulkOperations
                </span>
                <div class="dropdown-menu">
                    @foreach (var bulkFormId in bulkEdits)
                    {
                        <a class="dropdown-item" href="#" onclick="BulkOperationsManager.bulkEdit('@bulkFormId.FormId')">
                            <span>
                                @bulkFormId.Alias
                            </span>
                            <i title="@bulkFormId.Alias" class="fa fa-edit text-success">
                            </i>
                        </a>
                    }
                </div>
            </div>
        }
    }

    void BulkCreateProcessesDropdown(List<ProcessCreateFormLinkId> bulkProcessCreates)
    {
        if (bulkProcessCreates.Count == 1)
        {
            var bulkFormId = bulkProcessCreates[0];

            <a class="btn btn-sm btn-outline-primary topbar-dropdown-btn" title="@(bulkFormId.Alias + "\n" + bulkFormId.FormAlias)"
               onclick="BulkOperationsManager.bulkCreateProcess('@bulkFormId.NamespaceId', '@bulkFormId.EntityId', '@bulkFormId.FormId', '@bulkFormId.TaskId', '@bulkFormId.ProcessId', '@bulkFormId.ProcessVersion', '@bulkFormId.AssociationFieldId')"
               href="#">
                @(!string.IsNullOrEmpty(bulkFormId.FormAlias) ? bulkFormId.FormAlias : bulkFormId.Alias)
            </a>
        }
        else
        {
            <div class="dropdown inline-dropdown">
                <span class="btn btn-sm btn-outline-primary dropdown-toggle topbar-dropdown-btn" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    @ViewTexts.StartProcess
                </span>
                <div class="dropdown-menu">
                    @foreach (var bulkFormId in bulkProcessCreates)
                    {
                        <a class="dropdown-item" href="#" onclick="BulkOperationsManager.bulkCreateProcess('@bulkFormId.NamespaceId', '@bulkFormId.EntityId', '@bulkFormId.FormId', '@bulkFormId.TaskId', '@bulkFormId.ProcessId', '@bulkFormId.ProcessVersion', '@bulkFormId.AssociationFieldId')">
                            <span>
                                @bulkFormId.Alias
                            </span>
                            <i title="@bulkFormId.FormAlias" class="fa fa-edit text-primary">
                            </i>
                        </a>
                    }
                </div>
            </div>
        }
    }

    void RenderDetailsLink(string rowIds, string formSubjectId, string formId, string action = "Details", string target = "_self")
    {
        RenderActionLink(rowIds, formSubjectId, formId,
            ResolveIframeAction(action), ViewTexts.Details,
            "fa-info", "text-info", target);
    }

    void RenderEditLink(string rowIds, string formSubjectId, string formId, string action = "Edit", string target = "_self")
    {
        RenderActionLink(rowIds, formSubjectId, formId,
            ResolveIframeAction(action), ViewTexts.Edit,
            "fa-pencil", "text-success", target);
    }

    void RenderDeleteLink(string rowIds, string formSubjectId, string formId, string target = "_self")
    {
        RenderActionLink(rowIds, formSubjectId, formId,
            ResolveIframeAction("Delete"), ViewTexts.Delete,
            "fa-times", "text-danger", target);
    }

    void RenderActionLink(string rowIds, string formSubjectId, string formId, string action,
        string title, string icon, string linkClass, string targetName)
    {
        CommonFormStructure structure = ViewBag.structure;

        <a class="icon-link form-link table-form-link" target="@targetName" href="@Url.Action(action, "Form", GetRouteValues(structure, formId, Model.FilterValues))&Id=@rowIds">

            <span class="@(linkClass)" title="@title">
                <i class="fa @icon"></i>
            </span>
        </a>
    }

    string ResolveIframeAction(string action)
    {
        if (string.IsNullOrWhiteSpace(action))
        {
            return "IframeForm";
        }

        return action is "Edit" or "Details" or "Delete"
            ? "IframeForm"
            : action;
    }

}
