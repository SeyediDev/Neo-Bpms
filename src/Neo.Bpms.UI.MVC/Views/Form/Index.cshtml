@functions {

    void ExcelImportModal()
    {
            <div class="modal fade" id="excel-import-modal" tabindex="-1" role="dialog" aria-labelledby="excel-import-modal-label">
                <div class="modal-dialog modal-lg" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h4 class="modal-title" id="excel-import-modal-label">@ViewTexts.ExcelImport</h4>
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                        <div class="modal-body">
                            <div class="d-inline-block">
                                <div class="custom-file">
                                    <input type="file" class="custom-file-input" id="excel-import-file">
                                    <label class="custom-file-label" for="excel-import-file">@ViewTexts.ChooseFile</label>
                                </div>
                            </div>
                            <button class="btn btn-secondary btn-sm d-inline-block mt-2" type="button" onclick="ExcelManager.downloadTemplate()">
                                @ViewTexts.DownloadTemplate
                                <i class="fa fa-download"></i>
                            </button>
                            <button class="btn btn-secondary btn-sm d-inline-block mt-2" type="button" onclick="ExcelManager.downloadTemplateWithData()">
                                @ViewTexts.DownloadTemplateWithData
                                <i class="fa fa-download"></i>
                            </button>
                            <div id="operation-result">
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-dismiss="modal">@ViewTexts.Cancel</button>
                            <button type="button" id="import-save-button" class="btn btn-success ladda-button" data-style="zoom-in" onclick="ExcelManager.importFile()">@ViewTexts.Save</button>
                        </div>
                    </div>
                </div>
            </div>
    }

    async Task Filter(ControlsRendererData controlsRendererData, bool anonymous)
    {
        <div class="modern-filter-wrapper" id="filterDiv" style="display: none;">
                    <div class="modern-filter-header">
                        <svg class="modern-filter-icon" viewBox="0 0 24 24">
                            <use href="/Content/common-assets-includes/icons/svgSprite.svg#filter-blue" />
                        </svg>
                        <h4>فیلترها</h4>
                    </div>
                    
                    <div class="modern-filter-content">
                    @{
                    var htmlInputStr = controlsRenderer.Render(controlsRendererData);
                    }
                 @htmlInputStr 
                    </div>
                    
                    <div class="modern-filter-buttons">
                       <partial name="Common/FilterEraseButton" /> 
                        @if (!anonymous)
                        {
                        <partial name="Filter/FilterSaveButtons" model="new FilterSaveButtonsModel { filterId = ViewBag.FilterId, filterName = ViewBag.FilterName }" />
                        }
                        <partial name="Filter/ApplyButton" />
                </div>
            </div>
    }


    async Task IndexTable(CommonFormStructure structure, string calendar, bool showCheckBoxes)
    {
            <div class="modern-table-wrapper">
                <table id="tblRecords" class="modern-table @(showCheckBoxes ? "has-checkbox" : "")">
                    <thead>
                    <tr>
                        <th></th>
                            @if (showCheckBoxes)
                        {
                                <partial name="IndexTables/RenderCheckboxesHeader" />
                        }
                            <partial name="IndexTables/RenderColumnHeaders" model="structure" />
                            @{
                            foreach (var sbj in structure.Subjects)
                            {
                                        <th class="cColumn">
                                            <span style="color: black;">@sbj.Alias</span>
                                        </th>
                            }

                            foreach (var link in structure.Fields.Where(f => f.ControlType == eControlTypeId.SpecificLinkColumn && f.GetProperties() != null))
                            {
                                        <th class="cColumn">
                                            <span style="color: black;">@link.Label</span>
                                        </th>
                            }
                            }
                            <th class="cColumn">
                                    @ViewTexts.Pages
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                        if (Model.Rows.Count == 0)
                        {
                                    <tr>
                                        <td colspan="@(structure.ColumnInfos.Count + 2)">
                                            <span>@ViewTexts.IndexNoData</span>
                                        </td>
                                    </tr>
                        }

                        var rowIdx = 0;
                        foreach (var rowData in Model.Rows)
                        {
                            var rowIds = "";
                            foreach (var key in structure.KeyFields)
                            {
                                object rowId;
                                rowData.GetField(key, out rowId);
                                if (!string.IsNullOrEmpty(rowIds))
                                {
                                    rowIds += ",";
                                }
                                rowIds += rowId == null ? "" : rowId.ToString();
                            }
                                    <tr class="selectable-table-row" data-ids="@rowIds">
                                        @if (showCheckBoxes)
                                {
                                            <td class="cColumn">
                                                <input class="row-checkbox" data-ids="@rowIds" type="checkbox" id="checkbox-row-@rowIdx">
                                            </td>
                                }
                                <partial name="IndexTables/RenderValueCells" model="new RenderValueCellsModel { structure = structure, calendar = calendar, rowData = rowData }" />

                                        @{
                                    foreach (var subjectInfo in structure.Subjects)
                                    {
                                        object subjectText = "";
                                        var subjectTextExists =
                                        subjectInfo.HasText && rowData.GetField(subjectInfo.Name, out subjectText);
                                        if (!subjectTextExists)
                                        {
                                            subjectText = " ";
                                        }
                                        object subjectTooltip = "";
                                        var subjectTooltipExists = subjectInfo.HasTooltip && rowData.GetField(subjectInfo.Name + "_Tooltip", out subjectTooltip);
                                        if (!subjectTooltipExists)
                                        {
                                            subjectTooltip = " ";
                                        }
                                        var hasEditForm = subjectInfo.HasEditForm;
                                        var hasDetailsForm = subjectInfo.HasDetailsForm;
                                                    <td class="cColumn">
                                                        <span title="@subjectTooltip">@subjectText</span>
                                                        &nbsp;
                                                        @if (hasDetailsForm)
                                            {
                                                RenderDetailsLink(rowIds, subjectInfo.Name, subjectInfo.DetailFormId, subjectInfo.DetailAction);
                                            }
                                                        @if (hasEditForm)
                                            {
                                                RenderEditLink(rowIds, subjectInfo.Name, subjectInfo.EditFormId, subjectInfo.EditAction);
                                            }
                                                    </td>
                                    }

                                    foreach (var link in structure.Fields.Where(f => f.ControlType == eControlTypeId.SpecificLinkColumn && f.GetProperties() != null))
                                    {
                                                    <td>
                                                        @{
                                                var parameters = "";
                                                foreach (var property in link.GetProperties(eControlPropertyId.LinkParameter))
                                                {
                                                    var fields = property.Value.ToString().Split('=');
                                                    if (fields.Length > 1)
                                                    {
                                                        if (!string.IsNullOrEmpty(parameters))
                                                        {
                                                            parameters += "&";
                                                        }
                                                        object fieldValue;
                                                        if (!rowData.GetField(fields[1], out fieldValue) || fieldValue == null)
                                                        {
                                                            if (fields[1] == "Id")
                                                            {
                                                                rowData.GetField("Ids", out fieldValue);
                                                            }
                                                            if (fieldValue == null)
                                                            {
                                                                fieldValue = fields[1];
                                                            }
                                                        }
                                                        parameters += fields[0] + "=" + fieldValue;
                                                    }
                                                }
                                                var linkUrl = link.PropertyValue(eControlPropertyId.LinkTarget) +
                                                "?" + parameters;
                                                        }
                                                        <a href="~/@(new HtmlString(linkUrl))">
                                                            <i class="fa fa-link"></i>
                                                        </a>
                                                    </td>
                                    }
                                        }
                                        <td class="cColumn">

                                            @if (structure.HasDetails)
                                    {
                                        RenderDetailsLink(rowIds, structure.FormSubjectId, structure.DetailFormId, structure.DetailAction);
                                    }

                                            @if (structure.HasEdit)
                                    {
                                        RenderEditLink(rowIds, structure.FormSubjectId, structure.EditFormId, structure.EditAction);
                                    }

                                            @if (structure.HasDelete)
                                    {
                                        RenderDeleteLink(rowIds, structure.FormSubjectId, structure.DeleteFormId);
                                    }
                                        </td>
                                    </tr>
                            rowIdx++;
                        }
                        }
                    </tbody>
                </table>
            </div>
    }

