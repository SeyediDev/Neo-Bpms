@section scripts {
    <script>
        function filterParametersChange(element, actionFilter, elementName){
            let contentSvg = element.children[0].outerHTML;
            let changeElement = element.parentElement.parentElement.children[0].children[0];
            changeElement.innerHTML = contentSvg;
            document.getElementsByName(elementName + '__FilterParameter')[0].value = actionFilter;
        }

        // Simple toggle function for filter
        function toggleFilter() {
            console.log('toggleFilter called'); // Debug log
            const filterDiv = document.getElementById('filterDiv');
            const filterButton = document.getElementById('showFilter');
            
            console.log('filterDiv:', filterDiv); // Debug log
            console.log('filterButton:', filterButton); // Debug log

            if (filterDiv && filterButton) {

                console.log('isVisible:', window.FilterShow); // Debug log

                if (window.FilterShow) {
                    // Hide filter
                    filterDiv.style.display = 'none';
                    filterDiv.classList.remove('show');
                    filterButton.classList.remove('active');
                    console.log('Filter hidden'); // Debug log
                    window.FilterShow = false;
                } else {
                    // Show filter
                    filterDiv.style.display = 'block';
                    filterDiv.classList.add('show');
                    filterButton.classList.add('active');
                    console.log('Filter shown'); // Debug log
                    window.FilterShow = true;
                    
                    // Ensure form association when filter is shown
                    setTimeout(function() {
                        ensureFormAssociation();
                    }, 100);
                }
            } else {
                console.error('filterDiv or filterButton not found'); // Debug log
            }
        }
        
        // Function to ensure form association
        function ensureFormAssociation() {
            const filterForm = document.getElementById('filter-form');
            if (filterForm) {
                const filterInputs = document.querySelectorAll('#filterDiv input, #filterDiv select, #filterDiv textarea');
                filterInputs.forEach(function(input) {
                    input.setAttribute('form', 'filter-form');
                    console.log('Form Index: Associated input with form:', input.name || input.id);
                });
            }
        }
        
        // Function to collect all filter values and ensure they're in the form
        function collectFilterValues() {
            const filterForm = document.getElementById('filter-form');
            if (!filterForm) return;
            
            console.log('Form Index: Collecting filter values...');
            
            // Find all filter inputs (including hidden ones)
            const allFilterInputs = document.querySelectorAll('#filterDiv input, #filterDiv select, #filterDiv textarea');
            
            allFilterInputs.forEach(function(input) {
                // Ensure input is associated with form
                input.setAttribute('form', 'filter-form');
                
                // For hidden inputs or inputs with special handling
                if (input.type === 'hidden' || input.style.display === 'none') {
                    console.log('Form Index: Found hidden input:', input.name, '=', input.value);
                } else {
                    console.log('Form Index: Found visible input:', input.name, '=', input.value);
                }
                
                // For select elements, ensure values are properly set
                if (input.tagName === 'SELECT') {
                    const selectedOptions = Array.from(input.selectedOptions).map(option => option.value);
                    console.log('Form Index: Select values for', input.name, ':', selectedOptions);
                }
            });
            
            // Also check for any dynamically created inputs
            const dynamicInputs = document.querySelectorAll('input[name*="FilterParameter"], input[name*="[]"]');
            dynamicInputs.forEach(function(input) {
                if (!input.getAttribute('form')) {
                    input.setAttribute('form', 'filter-form');
                    console.log('Form Index: Associated dynamic input:', input.name, '=', input.value);
                }
            });
        }
        
        // Function to stop loading animation
        function stopLoadingAnimation() {
            const submitButton = document.getElementById('submit-filter');
            if (submitButton) {
                const laddaButton = $(submitButton).ladda();
                laddaButton.ladda('stop');
                console.log('Form Index: Loading animation stopped');
            }
        }
        
        // Debug function to check form state
        function debugFormState() {
            const filterForm = document.getElementById('filter-form');
            console.log('Form Index: Debug form state:');
            console.log('- Form found:', !!filterForm);
            console.log('- Form valid:', filterForm ? filterForm.checkValidity() : 'N/A');
            console.log('- Form action:', filterForm ? filterForm.action : 'N/A');
            console.log('- Form method:', filterForm ? filterForm.method : 'N/A');
            
            const filterInputs = document.querySelectorAll('#filterDiv input, #filterDiv select, #filterDiv textarea');
            console.log('- Filter inputs count:', filterInputs.length);
            filterInputs.forEach(function(input, index) {
                console.log(`  ${index + 1}. ${input.name || input.id}: ${input.value || 'empty'}`);
            });
        }
        
        // Make debug function globally available
        window.debugFormState = debugFormState;
        
        // Test function to manually submit form
        window.testFormSubmit = function() {
            console.log('Form Index: Manual form submit test');
            const filterForm = document.getElementById('filter-form');
            if (filterForm) {
                console.log('Form Index: Form found, submitting...');
                filterForm.submit();
            } else {
                console.error('Form Index: Form not found');
            }
        };

        // Ensure function is available globally
        window.toggleFilter = toggleFilter;
        window.FilterShow = false;
        
        // Override submitFilter to ensure form association before submission
        const originalSubmitFilter = window.submitFilter;
        window.submitFilter = function() {
            console.log('Form Index: submitFilter called');
            
            // Collect all filter values and ensure they're properly associated
            collectFilterValues();
            
            // Check form validity
            const filterForm = document.getElementById('filter-form');
            if (!filterForm) {
                console.error('Form Index: Filter form not found');
                return;
            }
            
            // Check if form is valid
            if (!filterForm.checkValidity()) {
                console.log('Form Index: Form validation failed');
                return;
            }
            
            // Start loading animation
            const submitButton = document.getElementById('submit-filter');
            if (submitButton) {
                const laddaButton = $(submitButton).ladda();
                laddaButton.ladda('start');
            }
            
            // Reset page to 1
            const pageInput = document.querySelector('input[name="Page"]');
            if (pageInput) {
                pageInput.value = '1';
            }
            
            // Submit the form
            console.log('Form Index: Submitting form...');
            console.log('Form Index: Form action:', filterForm.action);
            console.log('Form Index: Form method:', filterForm.method);
            
            // Add a small delay to ensure all inputs are processed
            setTimeout(function() {
                filterForm.submit();
            }, 100);
        };
        
        // Add event listener when DOM is ready
        document.addEventListener('DOMContentLoaded', function() {
            const filterButton = document.getElementById('showFilter');
            if (filterButton) {
                console.log('Adding click event listener to filter button');
                // Remove any existing event listeners
                filterButton.removeEventListener('click', toggleFilter);
                // Add single click event listener
                filterButton.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    console.log('Filter button clicked');
                    toggleFilter();
                });
            } else {
                console.error('Filter button not found');
            }
            
            // Add form submit event listener to handle errors
            const filterForm = document.getElementById('filter-form');
            if (filterForm) {
                filterForm.addEventListener('submit', function(e) {
                    console.log('Form Index: Form submit event triggered');
                    // Let the form submit normally
                });
                
                // Add error handling for form submission
                filterForm.addEventListener('error', function(e) {
                    console.error('Form Index: Form submission error');
                    stopLoadingAnimation();
                });
            }
            
            // Add timeout to stop loading animation if it gets stuck
            setTimeout(function() {
                stopLoadingAnimation();
            }, 10000); // Stop after 10 seconds
        });
    </script>
}

<script>
    // Define filter parameter tooltip functions directly in the page
    let openTooltip = null;
    
    window.toggleFilterParameterTooltip = function(uniqueFieldId) {
        console.log('Filter Parameter Tooltip: toggleFilterParameterTooltip called for', uniqueFieldId);
        const tooltipId = `#${uniqueFieldId}-fp-tooltip`;
        const $tooltip = $(tooltipId);
        const $icon = $(`#${uniqueFieldId}-fp-icon`).closest('.filter-parameter-icon');
        
        if (openTooltip === tooltipId) {
            closeTooltip(tooltipId);
        } else {
            // Close any other open tooltip
            if (openTooltip) {
                closeTooltip(openTooltip);
            }
            
            // Position tooltip relative to icon
            const iconOffset = $icon.offset();
            const iconWidth = $icon.outerWidth();
            const iconHeight = $icon.outerHeight();
            
            // Check if offset is available (fallback for older browsers)
            if (iconOffset && iconOffset.top !== undefined) {
                $tooltip.css({
                    'display': 'block',
                    'position': 'absolute',
                    'top': (iconHeight + 8) + 'px',
                    'left': '0px',
                    'z-index': '2002' // Higher than modern-filter-wrapper (2000)
                });
            } else {
                // Fallback positioning
                $tooltip.css({
                    'display': 'block',
                    'position': 'absolute',
                    'top': '32px',
                    'left': '0px',
                    'z-index': '2002' // Higher than modern-filter-wrapper (2000)
                });
            }
            
            openTooltip = tooltipId;
        }
    };
    
    function closeTooltip(tooltipId) {
        if (tooltipId) {
            $(tooltipId).css('display', 'none');
            openTooltip = null;
        }
    }
    
    window.selectFilterParameter = function(parameter, uniqueFieldId) {
        console.log('Filter Parameter Tooltip: Selecting parameter', parameter, 'for field', uniqueFieldId);
        
        // Extract field name from unique ID (remove the GUID part)
        const fieldName = uniqueFieldId.split('_')[0];
        
        // Update hidden input
        const hiddenInputName = `${fieldName}_filterParameter`;
        $(`input[name="${hiddenInputName}"]`).val(parameter);
        
        // Update icon
        const iconId = `#${uniqueFieldId}-fp-icon`;
        const $icon = $(iconId);
        
        // Get the SVG for the selected parameter
        const svg = getFilterParameterIconSvg(parameter);
        $icon.html(svg);
        
        // Update visual state
        const $tooltip = $(`#${uniqueFieldId}-fp-tooltip`);
        $tooltip.find('.filter-parameter-item').removeClass('selected').css('background', '');
        $tooltip.find(`[onclick*="${parameter}"]`).addClass('selected').css('background', 'linear-gradient(135deg, #3b82f6 0%, #2563eb 100%)');
        
        // Close tooltip
        closeTooltip(`#${uniqueFieldId}-fp-tooltip`);
        
        // Trigger change event for any dependent logic
        $(`input[name="${hiddenInputName}"]`).trigger('change');
        
        console.log('Filter Parameter Tooltip: Parameter selected successfully');
    };
    
