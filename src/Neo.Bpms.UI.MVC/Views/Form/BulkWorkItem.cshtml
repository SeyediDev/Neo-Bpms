@using Neo.Bpms.Infrastructure.Features.Bpms.Processes.FilterModels
@using Neo.Bpms.Infrastructure.Features.Cmmn.Forms
@using Neo.Bpms.Infrastructure.Features.Cmmn.Forms.Logic
@using Neo.Bpms.Infrastructure.Features.Cmmn.Forms.FormStructures
@using Neo.Bpms.UI.MVC.Controllers
@using Neo.Bpms.UI.MVC.Controls
@using Neo.Bpms.UI.MVC.Helpers
@using Neo.Bpms.UI.MVC.PartialModels
@using Neo.Bpms.UI.MVC.PartialModels.Common
@using Neo.Bpms.UI.MVC.PartialModels.FormDesign
@using Neo.Bpms.UI.MVC.ViewModels
@using Neo.Bpms.UI.MVC.ViewModels.Forms
@using Neo.Bpms.UI.MVC.ViewModels.ProcessModels
@using static Neo.Bpms.Domain.Model.UI.Forms.Form
@inject IFormLogicHelper formLogicHelper;
@inject IControlsRenderer controlsRenderer;
@inject ISBVRRenderer sbvrRenderer;

@model BulkWorkItemFormViewModel
@{
    CommonFormStructure structure = ViewBag.structure;
    var canDesign = ViewBag.CanDesign ?? false;

    var pageName = ViewBag.PagePackId as string;
    var pageIcon = PageIconHelper.GetPageMenuIcon(pageName);
    var elModel = Model.Record;
    var processId = Model.Filter.ProcessId;
    var taskId = Model.Filter.Activity;
    var versionId = Model.Filter.ProcessVersionId;
    var canSeeBpmn = ViewBag.CanSeeBpmn ?? false;
    var options = new RendererOptions
    {
        IsBulk = true
    };
    ControlsRendererData controlsRendererData = new(structure, elModel, options, ViewBag.user, Url);

    var aisCount = Model.AiList == null ? 0 : Model.AiList.Count;
}
@{
    Func<dynamic, HelperResult> TopBarTools =
        @<text>
            @if (item.processId != null && item.taskId != null && item.canSeeBpmn)
            {
                <a onclick="TetaBpmnViewerManager.openBpmnViewerModal('@item.processId', '@item.taskId', '@item.versionId')"
                   class="top-bar-anchor-icon text-info">
                    <i class="top-bar-icon bpms-flaticon-flow-chart" title="@ViewTexts.ViewFormInWorkFlow"></i>
                </a>
            }
            <partial name="Helpers/FormDesignLink" model="new FormDesignLinkModel {structure = item.structure, canDesign = item.canDesign}"/>
         </text>;

    async Task TopBar(CommonFormStructure structure, bool canDesign, string pageIcon,
        dynamic recordIdsCount, string processId, string taskId, string versionId, bool canSeeBpmn)
    {
        string filteredBy = ViewBag.QueryType == BulkQueryType.Query ? "بر اساس فیلتر" :
            string.Format("برای {0} رکورد انتخاب شده", recordIdsCount);

        var topBarToolsModel = new {structure, canDesign, processId, taskId, versionId, canSeeBpmn};

        <partial name="Common/TopBar" model="new TopBarModel {Title = structure.Name, PageIcon = pageIcon, Tools = TopBarTools(topBarToolsModel), FilteredBy = filteredBy}"/>
    }
}

<!-- Modern CSS Framework -->
<link rel="stylesheet" href="/CommonAssets/Styles/Features/Modern/controls-modern.css" />
<link rel="stylesheet" href="/Content/common-assets-includes/common-plugins/global/ladda/ladda-themeless.min.css" />
<script src="@CommonBundles.LaddaJsBundle" asp-append-version="true"></script>
<script>
    @await Html.PartialAsync("Common/SetPageAddress", structure);
</script>

@using (Html.BeginForm("DoWorkItems", "Process", FormMethod.Post, new {enctype = "multipart/form-data", id = "bulk-work-items-form", @class = "modern-form"}))
{
    ViewBag.Title = ViewTexts.BulkEditEntity + " " + structure.EntityId + " " + ViewTexts.Page + " " + ViewBag.Page;

    HiddenInputs(structure, options.CalendarType);

    <body @formLogicHelper.HtmlLogicEvent(structure, null, null)>

    <div id="mm-main-page" class="modern-main-container">
        <div class="modern-container">
            <!-- Modern Title Box -->
            <div class="modern-title-box">
                <div class="modern-title-content">
                    <div class="modern-title-text">
                        <h2 class="modern-title">
                            @if (!string.IsNullOrEmpty(pageIcon))
                            {
                                <span class="page-header-icon">
                                    @Html.Raw(MenuHelper.IconSvg(pageIcon))
                                </span>
                            }
                            ویرایش گروهی WorkItem @structure.Name @Html.Raw(sbvrRenderer.RenderEntitySBVR(structure.EntityId, structure.Name))
                        </h2>
                    </div>
                    <div class="modern-title-actions">
                        @if (processId != null && taskId != null && canSeeBpmn)
                        {
                            <a class="modern-settings-btn" onclick="TetaBpmnViewerManager.openBpmnViewerModal('@processId', '@taskId', '@versionId')" title="@ViewTexts.ViewFormInWorkFlow">
                                <svg viewBox="0 0 24 24">
                                    <use href="/Content/common-assets-includes/icons/svgSprite.svg#flow-chart-icon" />
                                </svg>
                            </a>
                        }
                        <a href="/Form/Design?NamespaceId=@structure.NamespaceId&EntityId=@structure.EntityId&FormId=@structure.Form_ReportId" title="تنظیمات" class="modern-settings-btn">
                            <svg viewBox="0 0 24 24">
                                <use href="/Content/common-assets-includes/icons/svgSprite.svg#setting-blue" />
                            </svg>
                        </a>
                    </div>
                </div>
            </div>
            
            <div class="modern-form-wrapper">
                @{ await MainPartOfTheForm(controlsRendererData, structure); }
            </div>
        </div>
    </div>

    </body>
    if (!string.IsNullOrEmpty(processId) && !string.IsNullOrEmpty(taskId))
    {
        @await Html.PartialAsync("_BpmnViewer")
    }
    <partial name="Logic/_Logic" model="structure"/>
    if (controlsRendererData.IncludeNeedingControls != null)
    {
        <partial name="Controls/_ControlIncludes" model="controlsRendererData.IncludeNeedingControls" />
    }
    <script src="@CommonBundles.FormJsBundle" asp-append-version="true"></script>
}

@functions{

    void HiddenInputs(CommonFormStructure structure, string calendar)
    {
        @Html.Hidden("NamespaceId", structure.NamespaceId)
        @Html.Hidden("EntityId", structure.EntityId)
        @Html.Hidden("FormId", structure.Form_ReportId)
        @Html.Hidden("FormSubjectId", structure.FormSubjectId)
        @Html.Hidden("calendar", calendar)
        @Html.Hidden("EditType", EditTypeId.SaveAndReturn)
        @Html.Hidden("returnUrl", "")
        @Html.Hidden("queryType", (Model.QueryType as BulkQueryType?).ToString())
        @Html.Hidden("caller", (Model.QueryType as BulkQueryType?).ToString())

        var recordsIdIndex = 0;
        foreach (var ai in Model.AiList ?? Enumerable.Empty<string>())
        {
            @:<input type="hidden" name="aiList[@recordsIdIndex]" value="@ai">
            recordsIdIndex++;
        }

        WorkItemsFilterHiddenFilters(Model.Filter);

        if (Model.IndexStructure != null)
        {
            @Html.Hidden("indexFormId", Model.IndexStructure.Form_ReportId)
        }
        @Html.Hidden("indexFormFilterValues", Model.IndexFormFilterValues)

        <input type="hidden" name="isApply" value="0"/>

        @*    if (structure.FormType == Neo.Bpms.Domain.Model.UI.Form.eFormType.WorkItem)*@
        @*    { todo *@
        @*        <input type="hidden" name="wid" value="@wid"/>*@
        @*        <input type="hidden" name="TaskId" value="@taskId"/>*@
        @*        <input type="hidden" name="ProcessId" value="@processId"/>*@
        @*    }*@

        if (ViewBag.bSubTable != null && ViewBag.bSubTable)
        {
            <input type="hidden" name="bSubTable" value="1"/>
        }
        else
        {
            <input type="hidden" name="bSubTable" value="0"/>
        }
    }

    async Task MainPartOfTheForm(ControlsRendererData controlsRendererData, CommonFormStructure structure)
    {
        <div class="col-sm-12 customDiv">
            <span style="color: red; font-weight: bold;">@Html.ValidationSummary(true)</span>
            <partial name="Utility/RenderLoading"/>
            <div id="mainPartOfTheForm" class="form-group hidden">
                <div class="col-md-12 col-sm-12 col-xs-12">
                    @{
                        var htmlInputStr = controlsRenderer.Render(controlsRendererData);
                    }
                    @htmlInputStr
                </div>
                <br/>
            </div>
            @{ ActionButtons(structure); }

        </div>
    }

    void ActionButtons(CommonFormStructure structure)
    {
        <div class="row">
            <div class="col-md-12 col-sm-12 buttons-sub-row">
                @if (structure.FormType == eFormType.WorkItem)
                {
                    <div class="col-md-12 col-sm-12">
                        <button type="button" data-etype="@EditTypeId.Save" onclick="edit(this)" class="btn btn-success float-left ladda-button" style="border-radius:10px" data-style="zoom-in">
                            <span>ذخیره</span> <i class="fa fa-save"></i>
                        </button>

                        <button type="button" onclick="apply(this)" class="btn btn-primary float-left ladda-button" style="border-radius:10px" data-style="zoom-in">
                            <span>انجام</span> <i class="fa fa-check"></i>
                        </button>
                    </div>
                    <input type="submit" id="submitBtn" style="display: none;"/>
                }
            </div>
        </div>
    }

    void WorkItemsFilterHiddenFilters(WorkItemsFilter currentFilter)
    {
        <input type="hidden" name="__ProcessId" value="@currentFilter.ProcessId"/>
        <input type="hidden" name="__Activity" value="@currentFilter.Activity"/>
        <input type="hidden" name="__Description" value="@currentFilter.Description"/>
        <input type="hidden" name="__FromCreationDateText" value="@currentFilter.FromCreationDateText"/>
        <input type="hidden" name="__ToCreationDateText" value="@currentFilter.ToCreationDateText"/>
        <input type="hidden" name="__Offered" value="@currentFilter.Offered.ToString()"/>
        <input type="hidden" name="__Allocated" value="@currentFilter.Allocated.ToString()"/>
        <input type="hidden" name="__Suspended" value="@currentFilter.Suspended.ToString()"/>
        <input type="hidden" name="__Finished" value="@currentFilter.Finished.ToString()"/>
        <input type="hidden" name="__Created" value="@currentFilter.Created.ToString()">
        <input type="hidden" name="__PageType" value="@currentFilter.PageType"/>
    }

}