@using Neo.Bpms.UI.Resources.Resources
<div class="modal fade" id="propertiesModal" tabindex="-1" role="dialog" aria-labelledby="propertiesModal-label">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
	            <h4 class="modal-title" id="propertiesModal-label">@ViewTexts.Properties</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label=@ViewTexts.Close>
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row"></div>
                <!--<div id="controllerDesignerApp"></div> -->
            </div>
        </div>
    </div>
</div>