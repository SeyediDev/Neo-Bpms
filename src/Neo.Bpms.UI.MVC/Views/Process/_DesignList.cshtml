                                <i class="fa fa-plus"></i>
                                New Signal
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <div id="signal-tree"></div>
        </div>
        <div id="escalate-tab" class="tab-pane fade" role="tabpanel">
            <div class="navbar navbar-default bg-light">
                <h6 class="m-0" href="#">Escalations</h6>
                <div class="container-fluid">
                    <div class="row w-100">
                        <div class="col-7">
                            <div class="input-group" dir="ltr">
                                <input id="escalate-search-input" type="text" class="form-control" placeholder="Search">
                                <div class="input-group-append">
                                    <span class="input-group-text">
                                        <i class="fa fa-search"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="col-5">
                            <button type="button" class="btn btn-outline-success" onclick="EscalateEventManager.showModal()">
                                <i class="fa fa-plus"></i>
                                New Escalation
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <div id="escalate-tree"></div>
        </div>
        <div id="interface-tab" class="tab-pane fade" role="tabpanel">
            <div class="navbar navbar-default bg-light">
                <h6 class="m-0" href="#">Interfaces</h6>
                <div class="container-fluid">
                    <div class="row w-100">
                        <div class="col-7">
                            <div class="input-group" dir="ltr">
                                <input id="interface-search-input" type="text" class="form-control" placeholder="Search">
                                <div class="input-group-append">
                                    <span class="input-group-text">
                                        <i class="fa fa-search"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="col-5">
                            <button type="button" class="btn btn-outline-success" onclick="InterfaceManager.showModal('interface', '#')">
                                <i class="fa fa-plus"></i>
                                New Interface
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <div id="interface-tree"></div>
        </div>
        <div id="datastore-tab" class="tab-pane fade" role="tabpanel">
            <div class="navbar navbar-default bg-light">
                <h6 class="m-0" href="#">Data Stores</h6>
                <div class="container-fluid">
                    <div class="row w-100">
                        <div class="col-7">
                            <div class="input-group" dir="ltr">
                                <input id="datastore-search-input" type="text" class="form-control" placeholder="Search">
                                <div class="input-group-append">
                                    <span class="input-group-text">
                                        <i class="fa fa-search"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="col-5">
                            <button type="button" class="btn btn-outline-success" onclick="DataStoreManager.showModal()">
                                <i class="fa fa-plus"></i>
                                New Data-Store
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <div id="datastore-tree"></div>
        </div>
    </div>
</div>
</div>
</div>

<script>
    function openNav() {
        $('#side-tabs').width("560px");

    }

    function closeNavs() {
        $('#side-tabs').width("0");
    }
</script>

@*modals*@

<div class="modal fade" id="business-rule-modal" tabindex="-1" role="dialog" aria-labelledby="business-rule-modal-label">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="business-rule-modal-label">Settings</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="business-rule-id" value=""/>
                <input type="hidden" id="business-rule-node-type" value=""/>
                <input type="hidden" id="business-rule-parent-id" value=""/>
                <input type="hidden" id="business-rule-order-id" value=""/>
                <div id="business-rule-name-div" class="form-group">
                    <label for="business-rule-name">Name</label>
                    <input class="form-control" id="business-rule-name" name="businessRuleName" type="text"/>
                </div>
                <div class="form-group">
                    <label for="standard-code">Code</label>
                    <input class="form-control" id="business-rule-standard-code" name="standardCode" type="text"/>
                </div>
                <div id="business-rule-purpose-div" class="form-group">
                    <label for="business-rule-purpose">Purpose</label>
                    <input class="form-control" id="business-rule-purpose" name="businessRulePurpose" type="text"/>
                </div>
                <div id="business-rule-description-div" class="form-group">
                    <label for="">Description</label>
                    <input class="form-control" id="business-rule-description" name="businessRuleDescription" type="text"/>
                </div>
                <div id="business-rule-type-div" class="form-group">
                    <label for="business-rule-type">Type</label>
                    <select class="form-control" id="business-rule-type" style="float: right;">
                        <option value="1">DataFlow</option>
                        <option value="2">DMN</option>
                        <option value="3">PRR</option>
                        <option value="4">PMML - Future</option>
                        <option value="5">Solving Model - Future</option>
                        <option value="101">NonExecutable</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" onclick="ProcessesManager.submitForm('#business-rule-modal')">Save</button>
            </div>
        </div>
    </div>
</div>

