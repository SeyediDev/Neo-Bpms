@using Neo.Bpms.UI.MVC.Helpers

<script src="@CommonBundles.JsTreeJsBundle" asp-append-version="true"></script>
<script src="~/Scripts/common-assets-includes/features/process/ProcessTree.js"></script>
<script src="~/Scripts/common-assets-includes/features/design/other-process/EventTrees.js"></script>
<script src="~/Scripts/common-assets-includes/common-plugins/global/moment/moment.js"></script>
<script src="~/Scripts/common-assets-includes/features/design/other-process/ISOConvertor.js">
</script>
<link href="@CommonBundles.JsTreeCssBundle" asp-append-version="true" rel="stylesheet" />
<link href="@CommonBundles.TabulatorCssBundle" asp-append-version="true" rel="stylesheet" />
<script src="@CommonBundles.TabulatorJsBundle" asp-append-version="true"></script>

<style>

    svg, text, span { font-family: 'Yekan', Calibri, Tahoma !important; }

    body {
        font-size: small;
        font-family: 'Yekan', Calibri, Tahoma;
        margin-bottom: 30px;
        -webkit-text-size-adjust: none;
    }

    .sidenav {
        height: 100%;
        width: 0;
        position: fixed;
        z-index: 1030;
        top: 0;
        right: 0;
        background-color: white;
        overflow-x: hidden;
        transition: 0.5s;
        padding-top: 30px;
    }

    .closebtn {
        position: absolute;
        top: 10px;
        font-size: 14px;
    }

    .vakata-context { z-index: 1031 !important; }
</style>


<div id="side-tabs" class="sidenav">
    <button class="closebtn btn btn-link text-secondary" onclick="closeNavs()">
        <i class="fa fa-times">
        </i>
    </button>

<ul class="nav nav-tabs">
    <li class="active nav-item" role="tablist">
            <a data-toggle="tab" role="tab" aria-controls="Process Classification" aria-selected="true" href="#process-category-tab" class="nav-link active">Process Classification</a>
    </li>
    <li class="nav-item">
        <a data-toggle="tab" role="tab" aria-controls="Root Elements" aria-selected="false" href="#elements-tab" class="nav-link">Root Elements</a>
    </li>
</ul>


<div class="tab-content">

<div id="process-category-tab" class="tab-pane fade in active show text-right" role="tabpanel">
    <div class="navbar navbar-default bg-light">
        <div class="container-fluid">
            <div class="row w-100">
                <div class="col-7">
                    <div class="input-group" dir="ltr">
                        <input id="process-search-input" type="text" class="form-control" placeholder="Search">
                        <div class="input-group-append">
                            <span class="input-group-text">
                                <i class="fa fa-search"></i>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="col-5">
                    <button type="button" class="btn btn-outline-secondary" onclick="ProcessesManager.closeAllNodes()">
                        <i class="fa fa-minus-square"></i>
                        Collapse
                    </button>
                    <button type="button" class="btn btn-outline-secondary" onclick="ProcessesManager.showModal(1, '#')">
                        <i class="fa fa-plus"></i>
                        New Folder
                    </button>
                </div>
            </div>
        </div>


    </div>
    <div id="process-tree" dir="rtl"></div>
</div>
<div id="elements-tab" class="tab-pane fade" role="tabpanel">
    <ul class="nav nav-tabs">
        <li class="nav-item active">
            <a class="nav-link active" data-toggle="tab" href="#error-tab">
                <i class="bpmn-icon-intermediate-event-catch-error" style="font-size: 24px" title="Error"></i>
                @*Error*@
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-toggle="tab" href="#message-tab">
                <i class="bpmn-icon-intermediate-event-throw-message" style="font-size: 24px" title="Message"></i>
                @*Message*@
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-toggle="tab" href="#signal-tab">
                <i class="bpmn-icon-intermediate-event-throw-signal" style="font-size: 24px" title="Signal"></i>
                @*Signal*@
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-toggle="tab" href="#escalate-tab">
                <i class="bpmn-icon-intermediate-event-throw-escalation" style="font-size: 24px" title="Escalation"></i>
                @*Escalation*@
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-toggle="tab" href="#interface-tab">
                <i title="Interface">
                    <img src="~/Content/common-assets-includes/icons/interface2.svg" style="width: 32px; height: 24px"/>
                </i>
                @*Interface*@
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-toggle="tab" href="#datastore-tab">
                <i class="bpmn-icon-data-store" style="font-size: 24px" title="DataStore"></i>
                @*DataStore*@
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" href="~/MetaDesign/App/resources" target="_blank">Resources</a>
        </li>
    </ul>

    <div class="tab-content">
        <div id="error-tab" class="tab-pane fade active in show" role="tabpanel">
            <div class="navbar navbar-default bg-light">
                <h6 class="m-0" href="#">Errors</h6>
                <div class="container-fluid">
                    <div class="row w-100">
                        <div class="col-7">
                            <div class="input-group" dir="ltr">
                                <input id="error-search-input" type="text" class="form-control" placeholder="Search">
                                <div class="input-group-append">
                                    <span class="input-group-text">
                                        <i class="fa fa-search"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="col-5">
                            <button type="button" class="btn btn-outline-success" onclick="ErrorEventManager.showModal()">
                                <i class="fa fa-plus"></i>
                                New Error
                            </button>
                            @*<button type="button" class="btn btn-outline-success" onclick="ISOConvertor.exportDuration()"> تبدیل تاریخ</button>*@
                        </div>

                    </div>
                </div>
            </div>
            <div id="error-tree"></div>
        </div>
        <div id="message-tab" class="tab-pane fade" role="tabpanel">
            <div class="navbar navbar-default bg-light">
                <h6 class="m-0" href="#">Messages</h6>
                <div class="container-fluid">
                    <div class="row w-100">
                        <div class="col-7">
                            <div class="input-group" dir="ltr">
                                <input id="message-search-input" type="text" class="form-control" placeholder="Search">
                                <div class="input-group-append">
                                    <span class="input-group-text">
                                        <i class="fa fa-search"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="col-5">
                            <button type="button" class="btn btn-outline-success" onclick="MessageEventManager.showModal()">
                                <i class="fa fa-plus"></i>
                                New Message
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <div id="message-tree"></div>
        </div>
        <div id="signal-tab" class="tab-pane fade" role="tabpanel">
            <div class="navbar navbar-default bg-light">
                <h6 class="m-0" href="#">Signals</h6>
                <div class="container-fluid">
                    <div class="row w-100">
                        <div class="col-7">
                            <div class="input-group" dir="ltr">
                                <input id="signal-search-input" type="text" class="form-control" placeholder="Search">
                                <div class="input-group-append">
                                    <span class="input-group-text">
                                        <i class="fa fa-search"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="col-5">
