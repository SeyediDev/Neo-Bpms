@{
    var dashboardTabs = ViewBag.DashboardTabs as IEnumerable<dynamic>;
    var canDesign = ViewBag.CanDesign ?? false;
}

@if (ViewBag.TabBadgeStyles == null)
{
    ViewBag.TabBadgeStyles = true;
    <style>
        .dashboard-tab-badge {
            margin-inline-start: 0.5rem;
            padding: 0.15rem 0.55rem;
            border-radius: 999px;
            background: rgba(59, 130, 246, 0.18);
            color: #1d4ed8;
            font-size: 0.7rem;
            font-weight: 600;
        }
    </style>
}

<ul class="dashboard-tabs-list" role="tablist">
    @if (dashboardTabs != null)
    {
        foreach (var tab in dashboardTabs)
        {
            var iconId = string.IsNullOrWhiteSpace(tab.Icon) ? "home-dashboard" : tab.Icon;
            <li 
                role="tab"
                aria-selected="@tab.IsActive.ToString().ToLower()"
                data-config-id="@tab.ConfigId"
                data-client-only="@tab.IsClientOnly.ToString().ToLower()">
                <button type="button"
						class="dashboard-tab-item @(tab.IsActive ? "active" : "") dashboard-tab-link"
                        data-config-id="@tab.ConfigId"
                        onclick="dashboard_switchConfig('@tab.ConfigId'); return false;">
                    <span class="dashboard-tab-visual">
                        <svg class="dashboard-tab-icon" viewBox="0 0 24 24">
                            <use xlink:href="/Content/custom-icons/custom-sprite.svg#@iconId"></use>
                        </svg>
                    </span>
                    <span class="dashboard-tab-name">@tab.Name</span>
                    @if (tab.IsClientOnly)
                    {
                        <span class="dashboard-tab-badge">نمونه</span>
                    }
                </button>
                @if (canDesign && tab.IsActive && !tab.IsMeta && !tab.IsClientOnly)
                {
                    <button type="button"
                            class="dashboard-tab-edit-icon dashboard-design-only"
                            onclick="event.stopPropagation(); editConfig('@tab.ConfigId'); return false;"
                            title="ویرایش نام"
                            style="display: none;">
                        ✎
                    </button>
                    <button type="button"
                            class="dashboard-tab-delete-icon dashboard-design-only"
                            onclick="event.stopPropagation(); deleteConfig('@tab.ConfigId'); return false;"
                            title="حذف"
                            style="display: none;">
                        ✕
                    </button>
                }
            </li>
        }
    }

    @if (canDesign)
    {
        <partial name="~/Views/Dashboard/_WidgetPalette.cshtml" />

        <li class="neo-dashboard-header-right">
            <button class="neo-dashboard-design-toggle" id="design-toggle-btn"
                onclick="dashboard_toggleDesignMode()"
                title="فعال کردن حالت طراحی">
                <svg class="neo-dashboard-design-icon" viewBox="0 0 24 24">
                    <use xlink:href="/Content/common-assets-includes/icons/svgSprite.svg#edit-dashboard" />
                </svg>
                <span id="design-toggle-text">حالت طراحی</span>
            </button>
        </li>
        <li>
            <button class="neo-dashboard-btn neo-dashboard-btn-success hidden"
                    id="seeChanges"
                    style="margin-left: auto;">
                <svg class="neo-dashboard-btn-icon" viewBox="0 0 16 16">
                    <use xlink:href="/Content/common-assets-includes/icons/svgSprite.svg#refresh-blue" />
                </svg>
                <span>@ViewTexts.SeeChanges</span>
            </button>
        </li>
    }
</ul>



