@using Neo.Bpms.Domain.Entities.Cmmn.UI
@using Neo.Bpms.Domain.Models.Cmmn.UI.Components
@using Neo.Bpms.Domain.Models.Cmmn.UI.ConfiguredItems
@using Neo.Bpms.Domain.Models.Cmmn.UI.Reports
@using Neo.Bpms.Infrastructure.Features.Cmmn.Dashboards
@using Neo.Bpms.UI.MVC.Models.Dashboard
@model DashboardData

@{
    var structure = Model?.Structure;
    var currentConfig = structure?.ActiveConfig;
    var hasWidgets = currentConfig?.Divs?.Any() ?? false;
    var canDesign = ViewBag.CanDesign ?? false;
}

@* ===== MODERN DASHBOARD MAIN CONTENT ===== *@
@* ===== DASHBOARD CONTENT AREA ===== *@
@if (hasWidgets)
{
    <div class="neo-dashboard-grid" id="ReportBody">
        @foreach (var divConfig in currentConfig.Divs)
        {
            var divRenderModel = new DashboardDivRenderModel(Model, divConfig, canDesign);
            @await Html.PartialAsync("~/Views/Dashboard/Partials/_DashboardDiv.cshtml", divRenderModel)
        }
    </div>
}
else
{
    <div class="neo-dashboard-empty">
        <svg viewBox="0 0 24 24">
            <use xlink:href="/Content/common-assets-includes/icons/svgSprite.svg#file-icon" />
        </svg>
        <h3 class="neo-dashboard-empty-title">هیچ ویجتی موجود نیست</h3>
        <p class="neo-dashboard-empty-description">برای شروع، اولین ویجت خود را اضافه کنید</p>
    </div>
}

<script>
    // Apply widget height from data-widget-height attribute
    document.addEventListener('DOMContentLoaded', function() {
        const widgets = document.querySelectorAll('.neo-dashboard-widget-container[data-widget-height]');
        widgets.forEach(function(widget) {
            const height = widget.getAttribute('data-widget-height');
            if (height) {
                const contentDiv = widget.querySelector('.neo-dashboard-widget-content');
                if (contentDiv) {
                    contentDiv.style.minHeight = height;
                    contentDiv.style.height = height;
                }
            }
        });
    });
</script>