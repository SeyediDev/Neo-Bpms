@using Neo.Bpms.Domain.Entities.Cmmn.UI
@using Neo.Bpms.Domain.Models.Cmmn.UI.Components
@using Neo.Bpms.Domain.Models.Cmmn.UI.ConfiguredItems
@using Neo.Bpms.Domain.Models.Cmmn.UI.Reports
@using Neo.Bpms.Infrastructure.Features.Cmmn.Dashboards
@model DashboardData

@{
    var structure = Model?.Structure;
    var currentConfig = structure?.ActiveConfig;
    var hasWidgets = currentConfig?.Divs?.Any() ?? false;
    var canDesign = ViewBag.CanDesign ?? false;
}

@* ===== MODERN DASHBOARD MAIN CONTENT ===== *@
@* ===== DASHBOARD CONTENT AREA ===== *@
@if (hasWidgets)
{
    <div class="neo-dashboard-grid" id="ReportBody">
        @{
            await RenderDashboardWidgets(currentConfig.Divs, canDesign);
        }
    </div>
}
else
{
    <div class="neo-dashboard-empty">
        <svg viewBox="0 0 24 24">
            <use xlink:href="/Content/common-assets-includes/icons/svgSprite.svg#file-icon" />
        </svg>
        <h3 class="neo-dashboard-empty-title">هیچ ویجتی موجود نیست</h3>
        <p class="neo-dashboard-empty-description">برای شروع، اولین ویجت خود را اضافه کنید</p>
    </div>
}

@functions
{
    // ===== MODERN WIDGET RENDERING =====
    async Task RenderDashboardWidgets(List<ConfiguredDashboard.ConfigDiv> divConfigurations, bool canDesign)
    {
        try
        {
            if (divConfigurations == null || !divConfigurations.Any())
            {
                return;
            }

            foreach (var divConfig in divConfigurations)
            {
                if (divConfig.IsRow)
                {
                    <div class="neo-dashboard-row">
                        
                        @{
                            await RenderDiv(divConfig, canDesign);
                        }

                    </div>
                }
                else
                {
                    await RenderDiv(divConfig, canDesign);
                }
            }
        }
        catch (Exception ex)
        {
            // Log error but don't break the page
            <div class="neo-dashboard-error">
                <p>خطا در نمایش ویجت: @ex.Message</p>
            </div>
        }
    }

    async Task RenderDiv(ConfiguredDashboard.ConfigDiv divConfig, bool canDesign)
    {
        if (divConfig.Children != null && divConfig.Children.Count>1)
        {
            if (!string.IsNullOrEmpty(divConfig.Title))
            {
                await WidgetTitle(divConfig, canDesign, null);
            }
            await RenderDashboardWidgets(divConfig.Children, canDesign);
        }
        else
        {
            await RenderDashboardWidget(divConfig, canDesign);
        }
    }


    // ===== INDIVIDUAL WIDGET RENDERING =====
    async Task RenderDashboardWidget(ConfiguredDashboard.ConfigDiv divConfig, bool canDesign)
    {
        try
        {
            var widget = divConfig.Widget ??
            Model?.Structure?.ActiveConfig?.Widgets?.FirstOrDefault(w => w.Id == divConfig.WidgetId);

            var widgetHeight = widget?.GetPropertyValueInt(eControlPropertyId.HeightInPixels)??0;
            if (widgetHeight == 0) widgetHeight = 300;

            var maxRecord = widget != null ? DashboardDataRoutines.GetWidgetMaxRecord(widget, ReportViewType.Chart) : 15;
            ReportData reportData = GetReportData(widget, maxRecord);

        <div class="neo-dashboard-widget-container neo-dashboard-column-@divConfig.Width" 
             widgetId="@divConfig.WidgetId"
             data-widget-height="@widgetHeight px">
            
            @* Widget Title (Always Visible) *@
            @{
                await WidgetTitle(divConfig, canDesign, reportData);
            }

            @* Widget Content *@
            <div class="neo-dashboard-widget-content">
                @if (reportData != null && reportData.structure != null)
                {
                     await WidgetContent(divConfig, canDesign, reportData);
                }
                else
                {
                    await WidgetEmpty(divConfig, canDesign, widget);
                }
            </div>

            @* Widget Settings Modal *@
            @{
                ViewBag.DivConfiguration = divConfig;
                ViewBag.Widget = widget;
                ViewBag.ReportData = reportData;
                ViewBag.MaxRecord = maxRecord;
                ViewBag.WidgetHeight = widgetHeight;
            }
            <partial name="~/Views/Dashboard/_WidgetSettingsModal.cshtml" />
        </div>
        }
        catch (Exception ex)
        {
            <div class="neo-dashboard-widget-container neo-dashboard-column-@divConfig.Width" 
                 widgetId="@divConfig.WidgetId">
                <div class="neo-dashboard-widget-title-bar">
                    <div class="neo-dashboard-widget-title-content">
                        <h4 class="neo-dashboard-widget-title-text">خطا در ویجت</h4>
                    </div>
                </div>
                <div class="neo-dashboard-widget-content">
                    <svg viewBox="0 0 24 24">
                        <use xlink:href="/Content/common-assets-includes/icons/svgSprite.svg#error-icon" />
                    </svg>
                    <span>خطا: @ex.Message</span>
                </div>
            </div>
        }
    }

    async Task WidgetTitle(ConfiguredDashboard.ConfigDiv divConfig, bool canDesign, ReportData reportData)
    {
        var divTitle = divConfig.Title ?? reportData?.structure?.Name ?? divConfig.Id;

        <div class="neo-dashboard-widget-title-bar">
            <div class="neo-dashboard-widget-title-content">
                <svg class="neo-dashboard-widget-title-icon" viewBox="0 0 24 24">
                    <use xlink:href="/Content/common-assets-includes/icons/svgSprite.svg#chart-icon" />
                </svg>
                <h4 class="neo-dashboard-widget-title-text">@divTitle</h4>
            </div>
            @if (canDesign && !string.IsNullOrEmpty(divConfig.WidgetId))
            {
                <div class="neo-dashboard-widget-title-actions dashboard-design-only" style="display: none;">
                    @if (reportData?.structure != null)
                    {
                        <a href="@("Report/Index?NamespaceId=" + reportData.structure.NamespaceId + "&EntityId=" + reportData.structure.EntityId + "&ReportId=" + reportData.structure.Form_ReportId + "&ConfigId=" + reportData.structure.ConfigId)"
                           class="neo-dashboard-widget-title-action"
                           target="_blank"
                           title="باز کردن گزارش">
                            <svg viewBox="0 0 24 24">
                                <use xlink:href="/Content/common-assets-includes/icons/svgSprite.svg#link-dashboard" />
                            </svg>
                        </a>
                    }
                    <button class="neo-dashboard-widget-title-action"
                            data-toggle="modal"
                            data-target="#widgetSettingsModal-@divConfig.WidgetId"
                            title="@ViewTexts.WidgetSettings">
                        <svg viewBox="0 0 24 24">
                            <use xlink:href="/Content/common-assets-includes/icons/svgSprite.svg#setting-dashboard" />
                        </svg>
                    </button>
                    <button class="neo-dashboard-widget-title-action neo-dashboard-widget-delete"
                            widgetId="@divConfig.WidgetId"
                            onclick="dashboard_removeWidget(this)"
                            title="@ViewTexts.Delete">
                        <svg viewBox="0 0 24 24">
                            <use xlink:href="/Content/common-assets-includes/icons/svgSprite.svg#close-dashboard" />
                        </svg>
                    </button>
                </div>
            }
        </div>
    }
    async Task WidgetContent(ConfiguredDashboard.ConfigDiv divConfig, bool canDesign, ReportData reportData)
    {
        ViewBag.Counter = (ViewBag.Counter ?? 0) + 1;
        ViewBag.bFromDashboard = true;
        ViewBag.CanDesign = false;

        if (reportData.structure.ReportViewType == ReportViewType.Chart)
        {
            if (reportData.structure.ChartType == Report.ChartType.WorldMap ||
            reportData.structure.ChartType == Report.ChartType.IranMap)
            {
                <partial name="~/Views/Report/_map.cshtml" model="reportData" />
            }
            else if (reportData.structure.ChartType == Report.ChartType.BpmnDiagram)
            {
                <partial name="~/Views/Report/_bpmn.cshtml" model="reportData" />
            }
            else
            {
                <partial name="~/Views/Report/_chartView.cshtml" model="reportData" />
            }
        }
        else
        {
            <partial name="~/Views/Report/_listView.cshtml" model="reportData" />
        }
    }
    async Task WidgetEmpty(ConfiguredDashboard.ConfigDiv divConfig, bool canDesign, ConfiguredDashboard.ConfigWidget widget)
    {
        <div class="neo-dashboard-widget-error">
            <svg viewBox="0 0 24 24">
                <use xlink:href="/Content/common-assets-includes/icons/svgSprite.svg#error-icon" />
            </svg>
            <div style="text-align: center;">
                @if (widget==null)
                {
                    <p style="margin: 8px 0; font-weight: bold;">ویجتی تنظیم نشده است</p>
                }
                else
                {
                    <p style="margin: 8px 0; font-weight: bold;">داده ویجت در دسترس نیست</p>
                }
                @if (canDesign)
                {
                    <details style="font-size: 12px; color: #666; text-align: right; margin-top: 12px;">
                        <summary style="cursor: pointer; user-select: none;">🐛 اطلاعات Debug</summary>
                        <div style="background: #f5f5f5; padding: 12px; border-radius: 4px; margin-top: 8px;">
                            <p><strong>Widget ID:</strong> @divConfig.WidgetId</p>
                            <p><strong>Widget:</strong> @(widget != null ? "✓ یافت شد" : "✗ null")</p>
                            @if (widget != null)
                            {
                                <p><strong>ReportConfigId:</strong> @(string.IsNullOrEmpty(widget.ReportConfigId) ? "✗ خالی" : widget.ReportConfigId)</p>
                                <p><strong>ReportId:</strong> @(string.IsNullOrEmpty(widget.ReportId) ? "✗ خالی" : widget.ReportId)</p>
                                <p><strong>ReportNamespaceId:</strong> @widget.ReportNamespaceId</p>
                                <p><strong>ReportEntityId:</strong> @widget.ReportEntityId</p>
                            }
                            <p><strong>Model.ReportsData:</strong> @(Model?.ReportsData != null ? $"{Model.ReportsData.Count()} گزارش" : "✗ null")</p>
                            @if (Model?.ReportsData?.Any() == true)
                            {
                                <p><strong>گزارشات موجود:</strong></p>
                                <ul style="text-align: right; font-size: 11px;">
                                    @foreach (var rd in Model.ReportsData)
                                    {
                                        <li>ConfigId: @rd.structure?.ConfigId, ReportId: @rd.structure?.Form_ReportId, Count: @rd.RecordCount</li>
                                    }
                                </ul>
                            }
                        </div>
                    </details>
                }
            </div>
        </div>
    }

    ReportData GetReportData(ConfiguredDashboard.ConfigWidget widget, int maxRecord )
    {
        ReportData reportData = null;

        if (widget != null && Model?.ReportsData != null)
        {
            // Try exact match first
            reportData = Model.ReportsData.FirstOrDefault(rd =>
                rd.structure?.ConfigId == widget.ReportConfigId &&
                rd.RecordCount == maxRecord);

            // If not found, try with same config but different record count
            if (reportData == null)
            {
                reportData = Model.ReportsData.FirstOrDefault(rd =>
                    rd.structure?.ConfigId == widget.ReportConfigId);
            }

            // If still not found, try by report ID
            if (reportData == null && !string.IsNullOrEmpty(widget.ReportId))
            {
                reportData = Model.ReportsData.FirstOrDefault(rd =>
                    rd.structure?.Form_ReportId == widget.ReportId);
            }
        }
        return reportData;
    }
}

