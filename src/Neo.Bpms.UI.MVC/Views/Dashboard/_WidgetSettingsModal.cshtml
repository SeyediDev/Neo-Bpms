@using Neo.Bpms.Domain.Entities.Cmmn.UI
@using Neo.Bpms.Domain.Models.Cmmn.UI.ConfiguredItems
@using Neo.Bpms.Domain.Models.Cmmn.UI.Reports

@{
    var divConfiguration = ViewBag.DivConfiguration as ConfiguredDashboard.ConfigDiv;
    var widget = ViewBag.Widget as ConfiguredDashboard.ConfigWidget;
    var reportData = ViewBag.ReportData as ReportData;
    var maxRecord = ViewBag.MaxRecord ?? 15;
    var widgetHeight = ViewBag.widgetHeight ?? 300;
}

@if (divConfiguration != null)
{
    <div class="modal fade neo-dashboard-modal" 
         id="widgetSettingsModal-@divConfiguration.WidgetId" 
         role="dialog" 
         tabindex="100">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title">
                        <svg class="neo-dashboard-modal-icon" viewBox="0 0 24 24">
                            <use xlink:href="/Content/common-assets-includes/icons/svgSprite.svg#setting-dashboard" />
                        </svg>
                        تنظیمات ویجت
                    </h4>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                
                <div class="modal-body">
                    @if (reportData?.Structure?.ReportViewType == ReportViewType.Chart)
                    {
                        <div class="neo-dashboard-form-group">
                            <label for="selectChart-@divConfiguration.WidgetId" class="neo-dashboard-form-label">
                                نوع نمودار
                            </label>
                            <select id="selectChart-@divConfiguration.WidgetId" class="neo-dashboard-form-input">
                                @foreach (ChartType chartType in Enum.GetValues<ChartType>())
                                {
                                    <option value="@chartType" selected="@(reportData.Structure.ChartType == chartType)">
                                        @chartType
                                    </option>
                                }
                            </select>
                        </div>
                    }
                    
                    @* Records Count *@
                    <div class="neo-dashboard-form-group">
                        <label for="recordsCount-@divConfiguration.WidgetId" class="neo-dashboard-form-label">
                            تعداد رکوردها
                        </label>
                        <input type="number" 
                               class="neo-dashboard-form-input" 
                               id="recordsCount-@divConfiguration.WidgetId" 
                               value="@maxRecord"
                               min="1"
                               max="10000">
                    </div>
                    
                    @* Widget Dimensions *@
                    <div class="neo-dashboard-form-row">
                        <div class="neo-dashboard-form-group">
                            <label for="widgetWidth-@divConfiguration.WidgetId" class="neo-dashboard-form-label">
                                عرض ویجت
                            </label>
                            <input type="number" 
                                   min="1" 
                                   max="12" 
                                   id="widgetWidth-@divConfiguration.WidgetId" 
                                   value="@divConfiguration.Width" 
                                   class="neo-dashboard-form-input">
                        </div>
                        
                        <div class="neo-dashboard-form-group">
                            <label for="widgetHeight-@divConfiguration.WidgetId" class="neo-dashboard-form-label">
                                ارتفاع ویجت
                            </label>
                            <input type="number" 
                                   id="widgetHeight-@divConfiguration.WidgetId" 
                                   class="neo-dashboard-form-input"
                                   value="@widgetHeight"
                                   min="200"
                                   max="1000">
                        </div>
                    </div>
                </div>
                
                <div class="modal-footer">
                    <button type="button" 
                            class="neo-dashboard-btn neo-dashboard-btn-secondary" 
                            data-dismiss="modal">
                        لغو
                    </button>
                    <button type="button" 
                            class="neo-dashboard-btn neo-dashboard-btn-primary" 
                            widgetId="@divConfiguration.WidgetId"
                            onclick="dashboard_submitWidgetSettings(this, event)">
                        تایید
                    </button>
                </div>
            </div>
        </div>
    </div>
}

