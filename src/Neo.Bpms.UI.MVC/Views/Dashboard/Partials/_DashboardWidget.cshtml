@using Neo.Bpms.Domain.Models.Cmmn.UI.Reports
@using Neo.Bpms.UI.MVC.Helpers
@using Neo.Bpms.UI.MVC.Models.Dashboard
@model DashboardWidgetRenderModel

@{
    var divConfig = Model.DivConfig;
    var widget = Model.Widget;
    var reportData = Model.ReportData;
    var widgetHeight = Model.WidgetHeight;
    var width = DashboardRenderHelpers.ResolveWidth(divConfig);
    var isMetricWidget = reportData?.Structure?.ChartType == ChartType.MetricBox;
    var contentClasses = "neo-dashboard-widget-content" + (isMetricWidget ? " neo-dashboard-widget-content--metric" : string.Empty);
    var reportUrl = reportData?.Structure != null 
        ? $"Report/Index?NamespaceId={reportData.Structure.NamespaceId}&EntityId={reportData.Structure.EntityId}&ReportId={reportData.Structure.Form_ReportId}&ConfigId={reportData.Structure.ConfigId}"
        : null;
}

<div class="neo-dashboard-widget-container neo-dashboard-column-@width"
     data-widget-height="@(widgetHeight)px"
     widgetId="@divConfig.WidgetId">

    @await Html.PartialAsync("~/Views/Dashboard/Partials/_DashboardWidgetTitle.cshtml", Model)

    <div class="@contentClasses" style="--neo-dashboard-widget-min-height: @(widgetHeight)px; min-height: @(widgetHeight)px; height: @(widgetHeight)px;">
        @if (reportData != null && reportData.Structure != null)
        {
            @await Html.PartialAsync("~/Views/Dashboard/Partials/_DashboardWidgetContent.cshtml", Model)
        }
        else
        {
            @await Html.PartialAsync("~/Views/Dashboard/Partials/_DashboardWidgetEmpty.cshtml", Model)
        }
    </div>

    @{
        ViewData["DivConfiguration"] = divConfig;
        ViewData["Widget"] = widget;
        ViewData["ReportData"] = reportData;
        ViewData["MaxRecord"] = Model.MaxRecord;
        ViewData["widgetHeight"] = widgetHeight;
    }
    <partial name="~/Views/Dashboard/_WidgetSettingsModal.cshtml" />
</div>
