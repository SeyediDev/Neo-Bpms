@using Neo.Bpms.Domain.Entities.Cmmn.UI
@using Neo.Bpms.Domain.Models.Cmmn.UI.Components
@using Neo.Bpms.Domain.Models.Cmmn.UI.Reports
@using Neo.Bpms.UI.MVC.Models.Dashboard
@model DashboardWidgetRenderModel

@{
    ViewBag.Counter = (ViewBag.Counter ?? 0) + 1;
    ViewBag.bFromDashboard = true;
    ViewBag.CanDesign = false;

    var reportData = Model.ReportData;
    var widget = Model.Widget;
}

@if (reportData.Errors != null && reportData.Errors.Count > 0)
{
    if (ViewBag.DashboardWidgetErrorStylesInjected == null)
    {
        ViewBag.DashboardWidgetErrorStylesInjected = true;
        <style>
            .neo-dashboard-widget-error {
                display: flex;
                gap: 1rem;
                padding: 1.5rem;
                border-radius: 1rem;
                border: 1px solid rgba(239, 68, 68, 0.3);
                background: linear-gradient(135deg, rgba(254, 202, 202, 0.9), rgba(254, 226, 226, 0.9));
                box-shadow: 0 15px 35px -25px rgba(0, 0, 0, 0.4);
                color: #B91C1C;
                direction: rtl;
                text-align: right;
            }

            .neo-dashboard-widget-error__icon {
                width: 48px;
                height: 48px;
                border-radius: 50%;
                background: rgba(248, 113, 113, 0.25);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.5rem;
            }

            .neo-dashboard-widget-error__body {
                flex: 1;
            }

            .neo-dashboard-widget-error__title {
                font-size: 1rem;
                font-weight: 600;
                margin-bottom: 0.35rem;
            }

            .neo-dashboard-widget-error__subtitle {
                font-size: 0.9rem;
                margin-bottom: 0.75rem;
                color: #7F1D1D;
            }

            .neo-dashboard-widget-error__list {
                margin: 0;
                padding-inline-start: 1.25rem;
                display: flex;
                flex-direction: column;
                gap: 0.35rem;
                list-style: disc;
            }

            .neo-dashboard-widget-error__item {
                font-size: 0.9rem;
                line-height: 1.5;
            }

            .neo-dashboard-widget-error__code {
                display: inline-flex;
                align-items: center;
                gap: 0.25rem;
                margin-right: 0.5rem;
                padding: 0.05rem 0.6rem;
                border-radius: 999px;
                background: rgba(239, 68, 68, 0.14);
                font-size: 0.8rem;
            }
        </style>
    }

    <div class="neo-dashboard-widget-error">
        <div class="neo-dashboard-widget-error__icon">
            <i class="fal fa-exclamation-triangle" aria-hidden="true"></i>
        </div>
        <div class="neo-dashboard-widget-error__body">
            <div class="neo-dashboard-widget-error__title">مشکلی در نمایش این گزارش رخ داده است.</div>
            <div class="neo-dashboard-widget-error__subtitle">لطفاً پس از رفع خطا یا با مدیر سیستم تماس بگیرید.</div>
            <ul class="neo-dashboard-widget-error__list">
                @foreach (var error in reportData.Errors)
                {
                    var message = !string.IsNullOrWhiteSpace(error?.Text)
                        ? error.Text
                        : error?.GeneralText;

                    if (string.IsNullOrWhiteSpace(message))
                    {
                        message = "جزئیات خطا در دسترس نیست.";
                    }

                    <li class="neo-dashboard-widget-error__item">
                        @message
                        @if (!string.IsNullOrWhiteSpace(error?.Code))
                        {
                            <span class="neo-dashboard-widget-error__code">کد: @error.Code</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(error?.For))
                        {
                            <span class="neo-dashboard-widget-error__code">@error.For</span>
                        }
                    </li>
                }
            </ul>
        </div>
    </div>
}
else if (reportData.Structure.ReportViewType == ReportViewType.Chart)
{
    if (reportData.Structure.ChartType == ChartType.IranMap)
    {
        <partial name="~/Views/Report/Map/_IranMap.cshtml" model="reportData" />
    }
    else if (reportData.Structure.ChartType == ChartType.WorldMap)
    {
        <partial name="~/Views/Report/Map/_WorldMap.cshtml" model="reportData" />
    }
    else if (reportData.Structure.ChartType == ChartType.BpmnDiagram)
    {
        <partial name="~/Views/Report/Charts/_bpmn.cshtml" model="reportData" />
    }
    else if (reportData.Structure.ChartType == ChartType.MetricBox)
    {
        var metricValue = reportData.GetMetricBoxValue();
        var structure = reportData.Structure;
        <div class="dashboard-metric-box shadow-sm" >
            Salam<span class="dashboard-metric-box__value" data-original-value="@metricValue">@metricValue</span>
        </div>
        <script>
            // Convert English digits to Persian digits
            (function() {
                function toPersianDigits(str) {
                    if (!str) return str;
                    var persianDigits = ['۰', '۱', '۲', '۳', '۴', '۵', '۶', '۷', '۸', '۹'];
                    return str.toString().replace(/\d/g, function(w) {
                        return persianDigits[parseInt(w)];
                    });
                }
                
                // Convert all metric box values to Persian digits
                document.addEventListener('DOMContentLoaded', function() {
                    var metricValues = document.querySelectorAll('.dashboard-metric-box__value, .neo-metric-box__value');
                    metricValues.forEach(function(element) {
                        var originalValue = element.getAttribute('data-original-value') || element.textContent;
                        element.textContent = toPersianDigits(originalValue);
                    });
                });
            })();
        </script>
        <style>
            .dashboard-metric-box {
                display: flex;
                align-items: center;
                justify-content: center;
                text-align: center;
                border-radius: 1rem;
                padding: 1.5rem 2rem;
                gap: 1rem;
                min-height: 160px;
                background: transparent;
            }

            .dashboard-metric-box__value {
                font-size: clamp(1.5rem, 3vw, 2rem);
                font-weight: 700;
                line-height: 1.2;
                font-family: 'VazirDigitGroup', 'Vazir Digit', 'Vazir FD', 'Vazir', 'Yekan', 'Tahoma', 'Arial', sans-serif;
                direction: rtl;
                unicode-bidi: embed;
                color: var(--neo-dashboard-text-primary, #f1f5f9);
            }

            /* رنگ متن metric box بر اساس تم */
            .neo-dashboard-widget-container .dashboard-metric-box__value,
            .neo-dashboard-widget .dashboard-metric-box__value {
                /* به صورت پیش‌فرض، اگر ویجت بک‌گراند تیره دارد، متن باید روشن باشد */
                color: #f1f5f9;
            }

            /* برای تم روشن */
            [data-theme="light"] .neo-dashboard-widget-container .dashboard-metric-box__value,
            :root:not([data-theme="dark"]) .neo-dashboard-widget-container .dashboard-metric-box__value {
                color: #1e293b;
            }

            /* برای تم تاریک */
            [data-theme="dark"] .dashboard-metric-box__value {
                color: var(--neo-dashboard-text-primary, #f1f5f9);
            }
        </style>
    }
    else
    {
        <partial name="~/Views/Report/Charts/_chartView.cshtml" model="reportData" />
    }
}
else
{
    <partial name="~/Views/Report/ListView/_listView.cshtml" model="reportData" />
}
