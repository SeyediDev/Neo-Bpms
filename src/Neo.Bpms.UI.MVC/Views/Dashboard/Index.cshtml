@using Neo.Bpms.Domain.Entities.Cmmn.UI
@using Neo.Bpms.Domain.Features.Cmmn.ObjectStorage
@using Neo.Bpms.Domain.Model.Project
@using Neo.Bpms.Domain.Model.UI
@using Neo.Bpms.Domain.Models.Cmmn.UI.ConfiguredItems
@using Neo.Bpms.Infrastructure.Features.Cmmn.Forms.Logic
@using Neo.Bpms.Infrastructure.Features.Cmmn.Reports
@using Neo.Bpms.UI.MVC.Controllers
@using Neo.Bpms.UI.MVC.Controls
@using Neo.Bpms.UI.MVC.Helpers
@using Neo.Bpms.UI.MVC.Models.Dashboard
@using Neo.Bpms.UI.MVC.PartialModels
@using Neo.Bpms.UI.MVC.PartialModels.Common

@inject ControllerMethods controllerMethods;
@inject DashboardStructRoutines dashboardStructRoutines;
@inject DashboardDataRoutines dashboardDataRoutines;
@inject IFormLogicHelper formLogicHelper;
@inject IControlsRenderer controlsRenderer;

@model DashboardData

@{
    // ===== DASHBOARD CONFIGURATION =====
    var structure = Model?.Structure;
    var canDesign = ViewBag.CanDesign ?? false;
    canDesign = true; // Enable design mode for development
    var calendar = ProjectDefinition.Project.DefaultCalendar;
    
    // ===== RENDERER CONFIGURATION =====
    var options = new RendererOptions { IsFilter = true };
    var controlsRendererData = structure != null 
        ? new ControlsRendererData(structure, structure.FilterValues, options, ViewBag.user, Url)
        : null;
    
    // ===== DASHBOARD STATE =====
    var currentConfig = structure?.ActiveConfig;
    var availableConfigs = structure?.Configs ?? new List<ConfiguredDashboard>();
    var reports = structure?.Reports ?? new List<DashboardConfigViewModel.ReportViewModel>();
    
    // ===== UI STATE =====
    var hasFilters = structure?.Fields?.Count > 0;
    
    // ===== DASHBOARD GENERATOR STATE =====
    var activeTab = ViewBag.ActiveTab ?? (canDesign ? "display" : "display"); // Always display tab if no design access
    var selectedConfigId = ViewBag.SelectedConfigId ?? currentConfig?.ConfigId;
    
    // Ensure users without design access can't access settings tab
    if (!canDesign && activeTab == "settings") {
        activeTab = "display";
    }
    
    // ===== DASHBOARD TABS DATA =====
    var clientOnlyTabs = new List<string>();
    var dashboardTabs = availableConfigs.Select((config, index) => new {
        ConfigId = config.ConfigId,
        Name = string.IsNullOrEmpty(config.Name) ? config.ConfigId : config.Name,
        IsActive = config.ConfigId == selectedConfigId,
        IsDefault = config.IsDefault,
        IsMeta = config.IsMeta,
        Icon = DashboardRenderHelpers.ResolveDashboardIcon(config),
        Order = index,
        IsClientOnly = false
    }).ToList();

    dashboardTabs = dashboardTabs
        .OrderByDescending(t => t.IsDefault)
        .ThenBy(t => t.Order)
        .ToList();

    var persistentIsNull = ViewBag.PersistentIsNull == null || ViewBag.PersistentIsNull == true;

    var scriptModel = new DashboardPageScriptModel
    {
        CanDesign = canDesign,
        ActiveTab = activeTab,
        SelectedConfigId = selectedConfigId,
        PersistentIsNull = persistentIsNull,
        ClientOnlyConfigIds = clientOnlyTabs
    };
}

@* ===== CRITICAL CSS FOR LOADING OVERLAY ===== *@
<style>
    /* Critical CSS for loading overlay - prevents flash of unstyled content */
    .dashboard-loading-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(4px);
        z-index: 99999;
        display: none;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity 0.2s ease-in-out;
    }
    .dashboard-loading-overlay.show {
        display: flex;
        opacity: 1;
    }
    /* When overlay is shown via inline style, ensure it's visible immediately */
    .dashboard-loading-overlay[style*="display: flex"] {
        opacity: 1 !important;
    }
    .dashboard-loading-content {
        text-align: center;
        color: #1f2937;
    }
    .dashboard-loading-spinner {
        width: 48px;
        height: 48px;
        border: 4px solid #e5e7eb;
        border-top-color: #3b82f6;
        border-radius: 50%;
        animation: dashboard-spin 0.8s linear infinite;
        margin: 0 auto 16px;
    }
    .dashboard-loading-text {
        font-size: 14px;
        font-weight: 500;
        color: #6b7280;
        margin-top: 16px;
    }
    @@keyframes dashboard-spin {
        to { transform: rotate(360deg); }
    }
    /* Prevent flash of content during tab switch */
    #dashboard-main-content {
        transition: opacity 0.3s ease-in;
    }
    /* Smooth widget transitions */
    .neo-dashboard-widget-container,
    .neo-dashboard-widget {
        transition: opacity 0.3s ease-in;
    }
    /* Initially hide content if we're switching tabs (prevents flash on page load) */
    body.dashboard-switching #dashboard-main-content,
    body.dashboard-switching .neo-dashboard-widget-container,
    body.dashboard-switching .neo-dashboard-widget {
        opacity: 0;
    }
    /* Hide content initially until JavaScript confirms it's ready */
    /* Fallback: if JavaScript is disabled, show content after 2 seconds */
    #dashboard-main-content {
        opacity: 0;
        transition: opacity 0.3s ease-in;
        animation: dashboard-show-fallback 0.1s 2s forwards;
    }
    #dashboard-main-content.content-ready {
        opacity: 1;
        animation: none;
    }
    @@keyframes dashboard-show-fallback {
        to { opacity: 1; }
    }
    /* Show loading overlay initially if switching - use attribute selector for immediate effect */
    body[data-dashboard-switching="true"] .dashboard-loading-overlay {
        display: flex !important;
        opacity: 1 !important;
    }
    body[data-dashboard-switching="true"] #dashboard-main-content {
        opacity: 0 !important;
    }
</style>
<script>
    // CRITICAL: This must run immediately, before any content renders
    // Check sessionStorage and set body attribute immediately
    (function() {
        try {
            if (sessionStorage.getItem('dashboard-switching')) {
                // Set attribute on body immediately (works even if body doesn't exist yet)
                if (document.body) {
                    document.body.setAttribute('data-dashboard-switching', 'true');
                } else {
                    // If body doesn't exist yet, wait for it
                    var observer = new MutationObserver(function(mutations) {
                        if (document.body) {
                            document.body.setAttribute('data-dashboard-switching', 'true');
                            observer.disconnect();
                        }
                    });
                    observer.observe(document.documentElement, { childList: true, subtree: true });
                }
            }
        } catch(e) {
            console.error('Dashboard switching check failed:', e);
        }
    })();
</script>

@* ===== TOOLBAR ===== *@
<div class="neo-dashboard-header-toolbar">
    @* ===== FILTER TOGGLE ===== *@
    @if (hasFilters)
    {
        <button class="neo-dashboard-btn neo-dashboard-btn-secondary" 
                id="showFilter"
                title="@ViewTexts.Filter">
            <svg class="neo-dashboard-btn-icon" viewBox="0 0 16 16">
            <use xlink:href="/Content/common-assets-includes/icons/svgSprite.svg#filter-blue" />
        </svg>
            <span>@ViewTexts.Filter</span>
        </button>
    }
</div>

<script>
    @await Html.PartialAsync("Common/SetPageAddress", structure);
</script>
@using (Html.BeginForm("Index", "Dashboard",
new
{
    structure.NamespaceId,
    structure.EntityId,
    DashboardId = structure.Form_ReportId
}, FormMethod.Post, true, new { enctype = "multipart/form-data", id = "filter-form" }))
{
    @Html.Hidden("ConfigId", structure.ConfigId)
    @Html.Hidden("ParentReportId", ViewBag.ParentReportId as string)
    @Html.Hidden("ParentReportConfigId", ViewBag.ParentReportConfigId as string)
    @Html.Hidden("ParentReportIds", ViewBag.ParentReportIds as string)
    @Html.Hidden("ParentFilterValues", ViewBag.ParentFilterValues as string)

    @Html.Hidden("calendar", calendar)

    <script src="@CommonBundles.FlagsJsBundle" asp-append-version="true"></script>

    if (canDesign)
    {
        <script src="@CommonBundles.JqueryUiJsBundle" asp-append-version="true"></script>

        <link rel="stylesheet" href="~/Content/common-assets-includes/common-plugins/global/animate/animate.css" />
    }

    @* Tabs Navigation *@
    @if (structure != null)
    {
        <div class="dashboard-tabs-container" @formLogicHelper.HtmlLogicEvent(structure, null, null)>
            @{
                ViewBag.DashboardTabs = dashboardTabs;
                ViewBag.Reports = reports;
                ViewBag.CanDesign = canDesign;
            }
            <partial name="~/Views/Dashboard/_DashboardTabs.cshtml" />
        </div>

        string fStr = await dashboardStructRoutines.GetFilterNames(
            Model.Structure,
            ViewBag.ParentReportId, ViewBag.ParentReportConfigId,
            ViewBag.ParentReportIds, controllerMethods.DecodeFilterValues(ViewBag.ParentFilterValues),
            ViewBag.user, CultureHelper.GetCurrentNeutralCulture());
            ViewBag.Structure = structure;
                ViewBag.ControlsRendererData = controlsRendererData;
        <partial name="~/Views/Dashboard/_DashboardFilter.cshtml" />
    }
    else
    {
        <div class="neo-dashboard-error">
            <p>خطا: ساختار داشبورد موجود نیست.</p>
        </div>
    }

    @* ===== MODERN DASHBOARD MAIN CONTENT ===== *@
    <div id="dashboard-main-content" style="opacity: 0;">
        <partial name="~/Views/Dashboard/_DashboardContent.cshtml" model="Model" />
    </div>
    
    @* ===== LOADING OVERLAY (Shown when switching tabs) ===== *@
    <div id="dashboard-loading-overlay" class="dashboard-loading-overlay" style="display: none; opacity: 0;">
        <div class="dashboard-loading-content">
            <div class="dashboard-loading-spinner"></div>
            <div class="dashboard-loading-text">در حال بارگذاری...</div>
        </div>
    </div>
    <script>
        // Show overlay immediately if switching (runs as soon as this element is parsed)
        (function() {
            try {
                if (sessionStorage.getItem('dashboard-switching')) {
                    var overlay = document.getElementById('dashboard-loading-overlay');
                    if (overlay) {
                        overlay.style.display = 'flex';
                        overlay.style.opacity = '1';
                    }
                }
            } catch(e) {
                console.error('Dashboard overlay show failed:', e);
            }
        })();
    </script>

    @if (structure != null)
    {
        <partial name="Logic/_Logic" model="structure" />
        @if (controlsRendererData?.IncludeNeedingControls != null)
        {
            <partial name="Controls/_ControlIncludes" model="controlsRendererData.IncludeNeedingControls" />
        }
    }

        @await Html.PartialAsync("~/Views/Dashboard/Partials/_DashboardScripts.cshtml", scriptModel)
        <script src="~/Scripts/common-assets-includes/features/dashboard/Dashboard.js">
        </script>
        <script src="@CommonBundles.LaddaJsBundle" asp-append-version="true"></script>
        <link rel="stylesheet" href="~/Content/common-assets-includes/common-plugins/global/ladda/ladda-themeless.min.css" />
        <script src="@CommonBundles.IndexPagesJsBundle" asp-append-version="true"></script>
}

