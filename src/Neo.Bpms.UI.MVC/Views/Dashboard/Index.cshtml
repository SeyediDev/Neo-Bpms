@* ===== LOAD SVG SPRITES AND INJECT INTO DOM ===== *@
<script>
    // Load SVG sprites and inject into DOM so <use> elements can reference them
    (function() {
        var spriteUrls = [
            '/Content/custom-icons/custom-sprite.svg',
            '/Content/common-assets-includes/icons/svgSprite.svg'
        ];
        
        var spriteContainer = null;
        
        function createSpriteContainer() {
            if (!spriteContainer) {
                spriteContainer = document.createElement('div');
                spriteContainer.id = 'svg-sprite-container';
                spriteContainer.style.cssText = 'position: absolute; width: 0; height: 0; overflow: hidden;';
                document.body.insertBefore(spriteContainer, document.body.firstChild);
            }
            return spriteContainer;
        }
        
        function loadSprite(url, callback) {
            var xhr = new XMLHttpRequest();
            xhr.open('GET', url, true);
            xhr.overrideMimeType('image/svg+xml');
            xhr.onload = function() {
                if (xhr.status === 200 || xhr.status === 0) {
                    try {
                        var parser = new DOMParser();
                        var svgDoc = parser.parseFromString(xhr.responseText, 'image/svg+xml');
                        if (svgDoc && svgDoc.documentElement) {
                            var svg = svgDoc.documentElement;
                            svg.style.cssText = 'position: absolute; width: 0; height: 0;';
                            createSpriteContainer().appendChild(svg);
                        }
                    } catch(e) {
                        console.warn('Failed to parse SVG sprite:', url, e);
                    }
                }
                if (callback) callback();
            };
            xhr.onerror = function() {
                console.warn('Failed to load SVG sprite:', url);
                if (callback) callback();
            };
            xhr.send();
        }
        
        function refreshIcons() {
            // Force browser to re-evaluate <use> elements
            var icons = document.querySelectorAll('svg use');
            icons.forEach(function(icon) {
                var href = icon.getAttribute('xlink:href') || icon.getAttribute('href');
                if (href) {
                    // Clone and replace to force re-render
                    var newUse = icon.cloneNode(false);
                    newUse.setAttribute('xlink:href', href);
                    icon.parentNode.replaceChild(newUse, icon);
                }
            });
        }
        
        // Load all sprites
        var loadedCount = 0;
        spriteUrls.forEach(function(url) {
            loadSprite(url, function() {
                loadedCount++;
                if (loadedCount === spriteUrls.length) {
                    // All sprites loaded, refresh icons
                    setTimeout(refreshIcons, 50);
                }
            });
        });
        
        // Also try to refresh icons when DOM is ready
        function tryRefresh() {
            if (document.body) {
                setTimeout(refreshIcons, 200);
            } else {
                setTimeout(tryRefresh, 50);
            }
        }
        
        if (document.readyState === 'complete' || document.readyState === 'interactive') {
            tryRefresh();
        } else {
            document.addEventListener('DOMContentLoaded', tryRefresh);
        }
        
        // Ultimate fallback
        setTimeout(refreshIcons, 500);
    })();
</script>
@* ===== PRELOAD CRITICAL CSS FILES ===== *@
<script>
    // Polyfill for rel="preload" as="style" for older browsers
    (function() {
        var relPreloadPolyfill = function() {
            var links = document.querySelectorAll('link[rel="preload"][as="style"]');
            for (var i = 0; i < links.length; i++) {
                var link = links[i];
                if (link.onload) {
                    link.onload();
                } else {
                    link.rel = 'stylesheet';
                }
            }
        };
        if (document.readyState === 'complete') {
            relPreloadPolyfill();
        } else {
            window.addEventListener('load', relPreloadPolyfill);
        }
    })();
    
    // Force CSS application by checking stylesheet loading
    (function() {
        function ensureStylesheetsLoaded() {
            var stylesheets = document.querySelectorAll('link[rel="stylesheet"], link[rel="preload"][as="style"]');
            var loadedCount = 0;
            var totalCount = stylesheets.length;
            
            if (totalCount === 0) {
                return Promise.resolve();
            }
            
            return new Promise(function(resolve) {
                stylesheets.forEach(function(sheet) {
                    // Check if stylesheet is already loaded
                    try {
                        if (sheet.sheet || sheet.href && document.styleSheets) {
                            // Check if stylesheet is in document.styleSheets
                            var found = false;
                            for (var i = 0; i < document.styleSheets.length; i++) {
                                try {
                                    if (document.styleSheets[i].href === sheet.href) {
                                        found = true;
                                        break;
                                    }
                                } catch(e) {
                                    // Cross-origin stylesheet, assume loaded
                                    found = true;
                                    break;
                                }
                            }
                            if (found) {
                                loadedCount++;
                                if (loadedCount === totalCount) {
                                    resolve();
                                }
                            } else {
                                // Wait for load event
                                sheet.addEventListener('load', function() {
                                    loadedCount++;
                                    if (loadedCount === totalCount) {
                                        resolve();
                                    }
                                });
                                sheet.addEventListener('error', function() {
                                    loadedCount++;
                                    if (loadedCount === totalCount) {
                                        resolve();
                                    }
                                });
                            }
                        } else {
                            // Fallback: assume loaded after a short delay
                            setTimeout(function() {
                                loadedCount++;
                                if (loadedCount === totalCount) {
                                    resolve();
                                }
                            }, 100);
                        }
                    } catch(e) {
                        // Error checking, assume loaded
                        loadedCount++;
                        if (loadedCount === totalCount) {
                            resolve();
                        }
                    }
                });
                
                // Timeout fallback
                setTimeout(function() {
                    resolve();
                }, 2000);
            });
        }
        
        // Store function globally for use in dashboard scripts
        window.ensureStylesheetsLoaded = ensureStylesheetsLoaded;
    })();
</script>
