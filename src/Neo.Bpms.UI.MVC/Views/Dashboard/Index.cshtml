@inject DashboardDataRoutines dashboardDataRoutines;
@inject IFormLogicHelper formLogicHelper;
@inject IControlsRenderer controlsRenderer;

@model DashboardData

@{
    // ===== DASHBOARD CONFIGURATION =====
    var structure = Model?.Structure;
    var canDesign = ViewBag.CanDesign ?? false;
    canDesign = true; // Enable design mode for development
    var calendar = ProjectDefinition.Project.DefaultCalendar;
    
    // ===== RENDERER CONFIGURATION =====
    var options = new RendererOptions { IsFilter = true };
    var controlsRendererData = structure != null 
        ? new ControlsRendererData(structure, structure.FilterValues, options, ViewBag.user, Url)
        : null;
    
    // ===== DASHBOARD STATE =====
    var currentConfig = structure?.ActiveConfig;
    var availableConfigs = structure?.Configs ?? new List<ConfiguredDashboard>();
    var reports = structure?.Reports ?? new List<DashboardConfigViewModel.ReportViewModel>();
    
    // ===== UI STATE =====
    var hasFilters = structure?.Fields?.Count > 0;
    
    // ===== DASHBOARD GENERATOR STATE =====
    var activeTab = ViewBag.ActiveTab ?? (canDesign ? "display" : "display"); // Always display tab if no design access
    var selectedConfigId = ViewBag.SelectedConfigId ?? currentConfig?.ConfigId;
    
    // Ensure users without design access can't access settings tab
    if (!canDesign && activeTab == "settings") {
        activeTab = "display";
    }
    
    // ===== DASHBOARD TABS DATA =====
    var clientOnlyTabs = new List<string>();
    var dashboardTabs = availableConfigs.Select((config, index) => new {
        ConfigId = config.ConfigId,
        Name = string.IsNullOrEmpty(config.Name) ? config.ConfigId : config.Name,
        IsActive = config.ConfigId == selectedConfigId,
        IsDefault = config.IsDefault,
        IsMeta = config.IsMeta,
        Icon = DashboardRenderHelpers.ResolveDashboardIcon(config),
        Order = index,
        IsClientOnly = false
    }).ToList();

    dashboardTabs = dashboardTabs
        .OrderByDescending(t => t.IsDefault)
        .ThenBy(t => t.Order)
        .ToList();

    var persistentIsNull = ViewBag.PersistentIsNull == null || ViewBag.PersistentIsNull == true;

    var scriptModel = new DashboardPageScriptModel
    {
        CanDesign = canDesign,
        ActiveTab = activeTab,
        SelectedConfigId = selectedConfigId,
        PersistentIsNull = persistentIsNull,
        ClientOnlyConfigIds = clientOnlyTabs
    };
}

