                ViewBag.DashboardTabs = dashboardTabs;
                ViewBag.Reports = reports;
                ViewBag.CanDesign = canDesign;
            }
            @* Define dashboard_switchConfig early to prevent ReferenceError *@
            <script>
                // Define dashboard_switchConfig early (before tabs HTML that uses it)
                // Full implementation will be in _DashboardScripts.cshtml
                if (typeof window.dashboard_switchConfig === 'undefined') {
                    window.dashboard_switchConfig = function(configId) {
                        // Queue the call until full implementation is loaded
                        if (!window._dashboard_switchConfig_queue) {
                            window._dashboard_switchConfig_queue = [];
                        }
                        window._dashboard_switchConfig_queue.push(configId);
                        console.log('Dashboard: Queued switchConfig call for:', configId);
                    };
                }
            </script>
            <partial name="~/Views/Dashboard/_DashboardTabs.cshtml" />
        </div>

