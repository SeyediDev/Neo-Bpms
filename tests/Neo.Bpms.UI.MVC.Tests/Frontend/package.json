{
  "name": "neo-bpms-frontend-tests",
  "version": "1.0.0",
  "description": "Frontend tests for Neo.Bpms filter functionality",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": [
      "**/Frontend/**/*.test.js",
      "**/Frontend/**/*.spec.js"
    ],
    "setupFilesAfterEnv": ["<rootDir>/jest.setup.js"],
    "moduleNameMapper": {
      "^jquery$": "<rootDir>/jest.jquery.mock.js"
    }
  }
}

